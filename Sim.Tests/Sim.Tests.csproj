<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck.Xunit" Version="3.3.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The director's first played session (T1.8 visual gate) — a permanent
         replay fixture: the log that exposed the ghost-harvest spec defect. -->
    <None Include="Fixtures\first-reign-orders.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\t38-director-orders.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- ADR-045 (D-062, 2026-10-22): research.json exactly as it stood BEFORE the research-content tranche (byte-identical
         to the file at 06e0153). The tranche's attribution twin (TestConfigs.PreTreeTranche) loads it, and the converter
         docs/m6-plan/knowledge-redesign/tools/implement_tranche.py reads it as its base. -->
    <None Include="Fixtures\research-pre-adr045.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\research-pre-tranche2.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- D-054 / ADR-039: a REAL schema-v32 snapshot written by the batch-2 build, and the order log that made it
         (Fixtures/README-v32-fixture.md) — the explicit v32 -> v33 migration is tested against it. -->
    <None Include="Fixtures\v32-seed42-turn40.civsnap" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\v32-fixture-orders.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fix round 1 (D-054, verifier F1): a REAL session the batch-2 (schema v32) build recorded — manifest, order log and
         trace (Fixtures/v32-session-found/README.md). `sim inspect` and the UI resume rebuild it on the flat map it was
         played on. Sim.Ui.Tests links the same files. -->
    <None Include="Fixtures\v32-session-found\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- D-055 (schema v34): a REAL schema-v33 save and session written by the BATCH-3 build (base-b3, its CLI stamped
         b3-final-v9-0f8f45c9), the order log that made them, and the README (Fixtures/README-v33-fixture.md) — the
         v33 -> v34 migration is tested against them. Sim.Ui.Tests links the session files. -->
    <None Include="Fixtures\v33-seed42-turn2.civsnap" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\v33-fixture-orders.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\v33-session-q17\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sim.Core\Sim.Core.csproj" />
    <ProjectReference Include="..\Sim.Data\Sim.Data.csproj" />
    <!-- T1.9 founding equivalence: the tests pin the CLI's HeadlessFounding recipe. -->
    <ProjectReference Include="..\Sim.Cli\Sim.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-055 / ADR-040 (batch 4, item 3): REAL split reports (written by sim run's split-report option), a run and its default-split
         control, and the order logs that made them (Fixtures/split-report/README.md) — `sim split-check` is tested on
         them and on mutant reports derived from them. -->
    <None Include="Fixtures\split-report\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>