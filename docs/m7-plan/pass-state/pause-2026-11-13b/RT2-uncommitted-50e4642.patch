+using System.Globalization;
+using Sim.Core.State;
+using Sim.Core.Systems.Research;
+using Sim.Ui.Progression;
+using Sim.Ui.Render;
+using Sim.Ui.Theme;
+using Sim.Ui.ViewModel;
+using Xunit;
+using Xunit.Abstractions;
+
+namespace Sim.Ui.Tests;
+
+/// <summary>
+/// D-089 DH6 (lane RT2): lane RT's polish proposals N2 (the hover path's dependent edges read on every Age's field), N3 (a
+/// spine's lanes as far apart as its widest cased edge, so a pin's five edges never merge) and N4 (what holds a node besides
+/// its prerequisites, under sub-headings of its own). N6 (the route figure) is pinned with the other estimates in
+/// ResearchTreeAuditTests.ANodeNotYetOpen_GetsItsRouteFigure_….
+/// </summary>
+public class ResearchScreenPolishTests(SteppedWorldFixture fx, ITestOutputHelper output) : IClassFixture<SteppedWorldFixture>
+{
+    private static readonly PolityId Me = UiPlayer.Empire;
+    private const double W = 1600, H = 1000;
+
+    // ------------------------------------------------------------------ N2: dependent edges
+
+    [Fact]
+    public void N2_TheDependentInk_ReadsOnTheCasing_AndTheCasingOnTheField_InEveryAge()
+    {
+        // The hover path's dependent edges were drawn plain in the dependent ink, 1.82 to 4.50:1 on the tree's field (under 3:1
+        // in the early Ages; D-084 verification round 1, RT-R1-04). They are now cased as the incoming edges are: the edge reads
+        // by its dark casing on the field, and the dependent ink by its contrast with the casing — both at 3:1 or more (WCAG 2.1
+        // SC 1.4.11), MEASURED per Age below.
+        var low = new List<string>();
+        foreach (EraTheme t in EraThemes.All)
+        {
+            double plain = ThemeColor.Contrast(t.Semantic.Dependent, t.Material.Field);
+            double casing = ThemeColor.Contrast(t.Ink.Text, t.Material.Field);
+            double ink = ThemeColor.Contrast(ProgressionScreen.DependentInkOnCasing(t), t.Ink.Text);
+            output.WriteLine($"{t.Era}: dependent ink on the field {plain:0.00}:1 (plain, before), casing on the field {casing:0.00}:1, dependent ink on the casing {ink:0.00}:1"
+                + (ProgressionScreen.DependentInkOnCasing(t) == t.Semantic.Dependent ? "" : " (re-inked)"));
+            if (casing < 3.0) low.Add($"{t.Era}: casing on the field {casing:0.00}:1");
+            if (ink < 3.0) low.Add($"{t.Era}: dependent ink on the casing {ink:0.00}:1");
+        }
+        Assert.Empty(low);
+    }
+
+    [Theory]
+    [InlineData(ResearchTree.Technology)]
+    [InlineData(ResearchTree.Civics)]
+    public void N2_AHoveredCardsDependentEdges_AreCased(ResearchTree tree)
+    {
+        ResearchContent c = fx.Content;
+        var s = new ProgressionScreen(c, Me) { Config = fx.Session.Config };
+        s.Refresh(fx.Session.World);
+        s.Tab = tree == ResearchTree.Civics ? TreeTab.Civics : TreeTab.Technology;
+        s.Paint(W, H, ApproxTextMeasure.Instance);
+        s.FitAll();
+        s.Paint(W, H, ApproxTextMeasure.Instance);
+        s.Selected = -1;
+        // A visible card with a dependent.
+        int node = -1;
+        foreach (int v in s.VisibleVertices())
+            if (!s.Graph.Vertices[v].External && s.Graph.Node(v).Dependents.Count > 0) { node = s.Graph.Vertices[v].ContentIndex; break; }
+        Assert.True(node >= 0);
+        PlacedVertex p = s.Layout.Placed[s.Graph.VertexOf(node)];
+        s.PointerMove(s.Camera.ToScreenX(p.CenterX, s.Canvas.X), s.Camera.ToScreenY(p.CenterY, s.Canvas.Y));
+        Assert.Equal(node, s.Hovered);
+        DrawList d = s.Paint(W, H, ApproxTextMeasure.Instance);
+        var at = new Dictionary<LineCmd, int>(ReferenceEqualityComparer.Instance);
+        for (int i = 0; i < d.Commands.Count; i++) if (d.Commands[i] is LineCmd l) at[l] = i;
+        LineCmd[] casings = [.. d.Commands.OfType<LineCmd>().Where(l => l.Color == s.Theme.Ink.Text)];
+        LineCmd[] inks = [.. d.Commands.OfType<LineCmd>().Where(l => l.Color == ProgressionScreen.DependentInkOnCasing(s.Theme))];
+        Assert.NotEmpty(inks);
+        static bool Same(LineCmd a, LineCmd b) => Math.Abs(a.X0 - b.X0) < 1e-6 && Math.Abs(a.Y0 - b.Y0) < 1e-6 && Math.Abs(a.X1 - b.X1) < 1e-6 && Math.Abs(a.Y1 - b.Y1) < 1e-6;
+        foreach (LineCmd ink in inks)
+            Assert.Contains(casings, k => Same(k, ink) && k.Width > ink.Width && at[k] < at[ink]);
+        output.WriteLine($"{tree}: {c.Nodes[node].Id} hovered; {inks.Length} dependent strokes, each over its casing");
+    }
+
+    // ------------------------------------------------------------------ N3: spine lanes
+
+    [Fact]
+    public void N3_TheSpineLaneStep_IsTiedToTheWidestCasedEdge_OfEveryAge()
+    {
+        // The widest edge a spine carries is a pinned card's incoming edge: PinnedEdgeFactor × the edge stroke (the screen's
+        // max(2.2, the Age's icon stroke)) plus the dark casing each side. The layout's constants must be that, so a lane step
+        // of SpineEdgeWidth + SpineLaneGap keeps two neighbouring pinned edges apart in every Age.
+        double widest = 0;
+        foreach (EraTheme t in EraThemes.All)
+            widest = Math.Max(widest, ProgressionScreen.PinnedEdgeFactor * Math.Max(2.2, t.Icons.StrokePx) + 2 * ProgressionScreen.PinnedCasingRef);
+        Assert.Equal(TreeLayoutOptions.SpineEdgeWidth, widest, 9);
+        Assert.Equal(TreeLayoutOptions.SpineEdgeWidth + TreeLayoutOptions.SpineLaneGap, TreeLayoutOptions.SpineLaneStepRef, 9);
+        Assert.True(TreeLayoutOptions.SpineLaneGap >= 1.0);
+        var o = new TreeLayoutOptions();
+        // Five lanes, centred, and the widest stroke of the outer two inside the spine.
+        double first = o.Margin + o.Spine / 2.0 - 2 * o.SpineLaneStep, last = o.Margin + o.Spine / 2.0 + 2 * o.SpineLaneStep;
+        Assert.True(first - TreeLayoutOptions.SpineEdgeWidth / 2.0 >= o.Margin);
+        Assert.True(last + TreeLayoutOptions.SpineEdgeWidth / 2.0 <= o.Margin + o.Spine);
+    }
+
+    [Theory]
+    [InlineData(ResearchTree.Technology)]
+    [InlineData(ResearchTree.Civics)]
+    public void N3_APinsFiveCasedEdges_InOneSpine_AreFiveStrokes_AtZoomOne(ResearchTree tree)
+    {
+        // Pin the card with the most incoming edges routed down one spine (Technology: five or more; the Civics tree has no card
+        // with five on one side, MEASURED), at zoom 1: their casings, the widest strokes there are, never overlap — each pair of
+        // neighbouring vertical spine runs is at least one casing width plus the gap apart (MEASURED below). With the old 3 px
+        // lanes, 7.8 px strokes overlapped by 4.8 px.
+        ResearchContent c = fx.Content;
+        ResearchGraph g = ResearchGraph.Build(c, tree);
+        TreeLayout L = ResearchTreeLayout.Compute(g, TreeLayoutOptions.Scaled(1.0, 1196.0));
+        int pin = -1, most = 0;
+        for (int v = 0; v < g.OwnCount; v++)
+        {
+            int left = 0, right = 0, lane = 0;
+            foreach (GraphEdge e in g.Edges)
+            {
+                if (e.From != v && e.To != v) continue;
+                (double X, double Y)[] r = ResearchTreeLayout.Route(L, e, lane++);
+                if (e.To != v || r.Length != 6) continue;
+                if (r[2].X < L.Width / 2) left++; else right++;
+            }
+            if (Math.Max(left, right) > most) { most = Math.Max(left, right); pin = v; }
+        }
+        output.WriteLine($"{tree}: at most {most} incoming spine edges on one side of a card");
+        Assert.True(most >= (tree == ResearchTree.Technology ? 5 : 2), $"{tree}: at most {most} incoming spine edges on one side");
+        var s = new ProgressionScreen(c, Me) { Config = fx.Session.Config };
+        s.Refresh(fx.Session.World);
+        s.Tab = tree == ResearchTree.Civics ? TreeTab.Civics : TreeTab.Technology;
+        s.Paint(W, H, ApproxTextMeasure.Instance);
+        int node = g.Vertices[pin].ContentIndex;
+        s.Selected = node;
+        s.Focus(node, jump: true);
+        s.Camera.Set(1.0, s.Camera.TargetPanX, s.Camera.TargetPanY);
+        DrawList d = s.Paint(W, H, ApproxTextMeasure.Instance);
+        // The vertical casing runs of the pinned edges (the widest casing strokes painted): group by x.
+        double casingW = ProgressionScreen.PinnedEdgeFactor * Math.Max(2.2, s.Theme.Icons.StrokePx) + 2 * ProgressionScreen.PinnedCasingRef;
+        var xs = new List<double>();
+        foreach (LineCmd l in d.Commands.OfType<LineCmd>())
+            if (l.Color == s.Theme.Ink.Text && Math.Abs(l.X0 - l.X1) < 1e-6 && Math.Abs(l.Width - casingW) < 1e-6 && Math.Abs(l.Y1 - l.Y0) > 40)
+                if (!xs.Any(x => Math.Abs(x - l.X0) < 1e-6)) xs.Add(l.X0);
+        xs.Sort();
+        output.WriteLine($"{tree}: {c.Nodes[node].Id} pinned; vertical cased runs at x = {string.Join(", ", xs.Select(x => x.ToString("0.0", CultureInfo.InvariantCulture)))}; casing width {casingW:0.0}");
+        // Among them, the spine runs of one side: five or more, each neighbour at least a casing width plus the gap apart.
+        List<double> spine = SpineRuns(xs, s);
+        // Every run on screen is counted; a run whose vertical part lies outside the viewport is not painted.
+        Assert.True(spine.Count >= (tree == ResearchTree.Technology ? 5 : 2), "too few spine runs: " + string.Join(", ", spine));
+        for (int k = 1; k < spine.Count; k++)
+            Assert.True(spine[k] - spine[k - 1] >= casingW + TreeLayoutOptions.SpineLaneGap - 1e-6,
+                $"runs at {spine[k - 1]:0.0} and {spine[k]:0.0} overlap or touch (casing {casingW:0.0})");
+    }
+
+    /// <summary>The runs in the tighter of the two spine channels' x ranges (screen), whichever holds more.</summary>
+    private static List<double> SpineRuns(List<double> xs, ProgressionScreen s)
+    {
+        TreeLayoutOptions o = s.Layout.Options;
+        double z = s.Camera.Zoom;
+        double l0 = s.Camera.ToScreenX(o.Margin, s.Canvas.X), l1 = s.Camera.ToScreenX(o.Margin + o.Spine, s.Canvas.X);
+        double r0 = s.Camera.ToScreenX(s.Layout.Width - o.Margin - o.Spine, s.Canvas.X), r1 = s.Camera.ToScreenX(s.Layout.Width - o.Margin, s.Canvas.X);
+        var left = xs.Where(x => x >= l0 - 1e-6 && x <= l1 + 1e-6).ToList();
+        var right = xs.Where(x => x >= r0 - 1e-6 && x <= r1 + 1e-6).ToList();
+        _ = z;
+        return left.Count >= right.Count ? left : right;
+    }
+
+    [Fact]
+    public void N3_TheCardWidths_BeforeAndAfter_AreMeasured_AndKeepTheReadableFloor()
+    {
+        // A layout change (D-089 DH6 asks for it measured): the spines take 2 × (46 − 22) = 48 px more of the width, so where the
+        // tier rows held the same number of slots the cards narrow by 48 / slots px, and where a slot no longer fits the rows
+        // wrap instead (UR-4: never below MinCardWidth). MEASURED here for the old options (spine 22, lanes 3 apart) against the
+        // new, at the tree widths of the window sizes the screen is played at.
+        ResearchContent c = fx.Content;
+        var old = new TreeLayoutOptions() with { Spine = 22.0, SpineLaneStep = 3.0 };
+        foreach (double width in new[] { 900.0, 1196.0, 1366.0, 1600.0, 1920.0, 2560.0 })
+            foreach (ResearchTree tree in new[] { ResearchTree.Technology, ResearchTree.Civics })
+            {
+                ResearchGraph g = ResearchGraph.Build(c, tree);
+                TreeLayout before = ResearchTreeLayout.Compute(g, old with { ViewportWidth = width });
+                TreeLayout after = ResearchTreeLayout.Compute(g, new TreeLayoutOptions() with { ViewportWidth = width });
+                double wb = before.Placed[0].W, wa = after.Placed[0].W;
+                output.WriteLine($"{tree} at {width:0}: card {wb:0.0} -> {wa:0.0} px, height {before.Height:0} -> {after.Height:0}, tiers {before.Columns} -> {after.Columns}");
+                Assert.True(wa >= new TreeLayoutOptions().MinCardWidth - 1e-9, $"{tree} at {width}: card {wa:0.0} under the floor");
+                Assert.True(after.Width <= width + 1e-9);
+                Assert.Equal(before.Columns, after.Columns);   // the spine changes widths, never the tiers
+            }
+    }
+
+    // ------------------------------------------------------------------ N4: what else holds a node, under its own heading
+
+    [Fact]
+    public void N4_Longbows_Requires_PutsTheResearchStageAndTheAgeSweep_UnderSubHeadingsOfTheirOwn()
+    {
+        // Audit §6 (Longbow, diagnosed by lane RT): under REQUIRES the pane listed Simple bow, then — with no heading — the stage
+        // gate and the Age IV sweep's 60 names, which read as Longbow's prerequisites. Now each comes under its own sub-heading,
+        // after the prerequisite rows: RESEARCH STAGE, then AGE IV SWEEP.
+        ResearchContent c = fx.Content;
+        int longbow = c.IndexOfId("longbow");
+        var s = new ProgressionScreen(c, Me) { Config = fx.Session.Config };
+        s.Refresh(WithDone(c.IndexOfId("bow_simple")));
+        s.Paint(W, H, ApproxTextMeasure.Instance);
+        s.Selected = longbow;
+        DrawList d = s.Paint(W, H, ApproxTextMeasure.Instance);
+        RectD pane = s.DetailRect;
+        List<string> lines = [.. d.Commands.OfType<TextCmd>().Where(t => t.X >= pane.X && t.X <= pane.Right).Select(t => t.Text)];
+        int requires = lines.IndexOf("REQUIRES");
+        int bow = lines.FindIndex(requires, l => l.StartsWith("Simple bow", StringComparison.Ordinal));
+        int stage = lines.IndexOf(ProgressionScreen.StageSubHeading);
+        int stageLine = lines.FindIndex(l => l.StartsWith("Subtree closed", StringComparison.Ordinal));
+        int sweep = lines.IndexOf(ProgressionScreen.SweepSubHeading(4));
+        int sweepLine = lines.FindIndex(l => l.StartsWith("Age 4 sweep", StringComparison.Ordinal));
+        int idea = lines.IndexOf("IDEA");
+        output.WriteLine(string.Join(" | ", lines.GetRange(requires, Math.Min(8, lines.Count - requires))));
+        Assert.Equal("AGE IV SWEEP", ProgressionScreen.SweepSubHeading(4));
+        Assert.True(requires >= 0 && bow > requires && stage > bow && stageLine > stage && sweep > stageLine && sweepLine > sweep && idea > sweepLine,
+            $"order: REQUIRES {requires}, Simple bow {bow}, {ProgressionScreen.StageSubHeading} {stage}, stage line {stageLine}, AGE IV SWEEP {sweep}, sweep line {sweepLine}, IDEA {idea}");
+    }
+
+    /// <summary>The stepped world with node <paramref name="node"/> complete for the player.</summary>
+    private WorldState WithDone(int node)
+    {
+        WorldState w = ((WorldState)fx.Session.World).Clone();
+        ResearchNodeId key = fx.Content.Nodes[node].Key;
+        if (!ResearchQuery.IsCompleted(w, Me, key)) w.ResearchCompleted.Add(new ResearchCompletedRow(Me, key));
+        return w;
+    }
+}
