+    /// <summary>
+    /// D-089 DH6 (lane RT's proposal N6) — THE ROUTE-AWARE ESTIMATE of a node not yet open: the End Turns until
+    /// <paramref name="destination"/> completes if its lane takes it as its destination from the next End Turn on, at the
+    /// current rate, as the engine funds a destination (ResearchSystem with destination routing, overflow off): while the
+    /// destination is not open the lane funds the CURRENT node of its route — the eligible route node of its own lane with the
+    /// smallest remaining cost, ties to the lower key (<see cref="ResearchRoutePlanner.PickCurrent"/>) — one node at a time, and
+    /// once the destination is open, the destination. Each node is paid by THE SAME per-node rule as an open node
+    /// (<see cref="ResearchTurns"/>, the one estimate): its remaining cost against the lane's rate and, for a civic in the
+    /// two-lane model, the bank, spent first and carried over — what a civic leaves of the bank in the End Turn it completes
+    /// stays banked; a technology's surplus is lost (no RP overflow, D-047 Part B). The route is planned once
+    /// (<see cref="ResearchRoutePlanner.Plan"/>): paying a route node lowers the cost of exactly that minimum-cost set, so the
+    /// engine's per-step plan keeps it. Null — no figure — when the destination is complete, when a node of its route
+    /// belongs to the OTHER lane (that lane must fund it, and whether it will is the player's), when the route stalls with no
+    /// node its lane can fund, when the rate is zero and the bank short, or beyond <paramref name="maxTurns"/>. Like the
+    /// single-node estimate it does not count Ideas or foreign exposure credited meanwhile, an assist from the other lane, or
+    /// a change of the rate. A read-only query: it copies the masks it is given and changes nothing.
+    /// </summary>
+    public static long? RouteResearchTurns(ResearchContent content, bool[] completed, double[] remaining, int destination,
+        double pointsPerTurn, double banked, int maxTurns = 100_000) =>
+        RouteResearchTurns(content, completed, remaining, destination, pointsPerTurn, banked, out _, maxTurns);
+
+    /// <summary><see cref="RouteResearchTurns(ResearchContent, bool[], double[], int, double, double, int)"/>, saying in
+    /// <paramref name="needsOtherLane"/> whether it gave no figure because a node of the route belongs to the other lane.</summary>
+    public static long? RouteResearchTurns(ResearchContent content, bool[] completed, double[] remaining, int destination,
+        double pointsPerTurn, double banked, out bool needsOtherLane, int maxTurns = 100_000)
+    {
+        ArgumentNullException.ThrowIfNull(content);
+        needsOtherLane = false;
+        if (destination < 0 || destination >= content.Nodes.Count || completed[destination]) return null;
+        bool twoLanes = content.Tuning.TwoLanes;
+        int lane = ResearchRoutePlanner.LaneOf(content, destination, twoLanes);
+        bool civic = twoLanes && lane == 1;
+        var done = (bool[])completed.Clone();
+        var rem = (double[])remaining.Clone();
+        int[] route = [];
+        if (!ResearchQuery.IsAvailable(content, destination, done, ResearchQuery.StageReached(content, done)))
+        {
+            route = ResearchRoutePlanner.Plan(content, done, rem, destination).Route;
+            foreach (int r in route)
+                if (ResearchRoutePlanner.LaneOf(content, r, twoLanes) != lane) { needsOtherLane = true; return null; }   // the other lane must fund it
+        }
+        double bank = civic ? Math.Max(0.0, banked) : 0.0;
+        long turns = 0;
+        var available = new bool[content.Nodes.Count];
+        for (int step = 0; step <= route.Length; step++)
+        {
+            bool stage = ResearchQuery.StageReached(content, done);
+            int next;
+            if (ResearchQuery.IsAvailable(content, destination, done, stage)) next = destination;
+            else
+            {
+                foreach (int r in route) available[r] = !done[r] && ResearchQuery.IsAvailable(content, r, done, stage);
+                next = ResearchRoutePlanner.PickCurrent(content, route, available, rem, lane, twoLanes, -1);
+                if (next < 0) return null;   // stalled: nothing on the route its lane can fund
+            }
+            if (ResearchTurns(rem[next], 0.0, pointsPerTurn, bank) is not long k) return null;
+            turns += k;
+            if (turns > maxTurns) return null;
+            if (civic) bank = Math.Max(0.0, bank + k * pointsPerTurn - rem[next]);   // what the civic leaves stays banked
+            done[next] = true;
+            rem[next] = 0.0;
+            if (next == destination) return turns;
+        }
+        return null;   // the route was exhausted without opening the destination
+    }
+
     /// <summary>D-084 verification round 1 (RT-R1-06 b): the words of a research turns estimate — "1 turn", "9 turns" — as the
     /// card's state line, the detail pane and this card's "Open to research now" line write it.</summary>
     public static string TurnsPhrase(long turns) => Inv(turns) + (turns == 1L ? " turn" : " turns");
