+}";
+
+    /// <summary>
+    /// Polish1 (critic rank 8): cloth flutter in bind space for the hung standards (<see cref="CharInstance.Flutter"/>):
+    /// three travelling waves (across the cloth downwind, diagonally, and a fast small ripple) displace the cloth along
+    /// its normal (bind-space z), the amplitude growing from zero at the hoist to <c>Flutter.x</c> at the hem; the
+    /// analytic slope bends the normal. Only part codes 10 (cloth) and 30 (fringe) move.
+    /// </summary>
+    public const string FlutterLib = @"
+vec3 flutter(vec3 p, float partCode, inout vec3 n) {
+    if (Flutter.x <= 0.0) return p;
+    float part = floor(partCode * 255.0 + 0.5);
+    if (part != 10.0 && part != 30.0) return p;
+    float d = clamp((Flutter.z - p.y) / Flutter.w, 0.0, 1.2);
+    float t = FlutterT.x + Flutter.y * 7.31;
+    float amp = Flutter.x * d * (0.35 + 0.65 * d);
+    float damp = Flutter.x * (0.35 + 1.3 * d) * (-1.0 / Flutter.w);
+    const float k1 = 11.42397, k2 = 7.853982, k3 = 26.17994;
+    float ph1 = k1 * p.x - 5.3 * t, ph2 = k2 * (0.45 * p.x + 0.89 * p.y) - 3.6 * t, ph3 = k3 * (p.x - 0.3 * p.y) - 9.1 * t;
+    float w = 0.60 * sin(ph1) + 0.30 * sin(ph2) + 0.10 * sin(ph3);
+    float dzdx = amp * (0.60 * k1 * cos(ph1) + 0.30 * k2 * 0.45 * cos(ph2) + 0.10 * k3 * cos(ph3));
+    float dzdy = amp * (0.30 * k2 * 0.89 * cos(ph2) - 0.10 * k3 * 0.3 * cos(ph3)) + damp * w;
+    n = normalize(n + sign(n.z + 1e-6) * vec3(-dzdx, -dzdy, 0.0));
+    return p + vec3(0.0, 0.0, amp * w);
+}";
+
