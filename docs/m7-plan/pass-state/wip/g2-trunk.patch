+    /// <summary>Soldiers on their feet or knees at the end (not the heroes): what can stand in a close shot's way.</summary>
+    List<Vector3> Occluders()
+    {
+        var tr = Battle.Trace; int last = tr.StepCount - 1; var list = new List<Vector3>();
+        for (int e = 0; e < tr.Entities.Count; e++)
+        {
+            if (e == Outcome.CommanderEntity || e == Outcome.OfficerEntity) continue;
+            if (BenchBattle.Map(tr.State(last, e)) is TraceSoldierState.Dead or TraceSoldierState.Escaped) continue;
+            list.Add(Troops.Place(e, _tEnd).pos);
+        }
+        return list;
+    }
+
+    /// <summary>The centre of everyone left on the field at the end (standing, kneeling or fallen; not the escaped).</summary>
+    Vector3 FieldCentre()
+    {
+        var tr = Battle.Trace; int last = tr.StepCount - 1; var c = Vector3.Zero; int n = 0;
+        for (int e = 0; e < tr.Entities.Count; e++)
+        {
+            if (BenchBattle.Map(tr.State(last, e)) == TraceSoldierState.Escaped) continue;
+            c += Troops.Place(e, _tEnd).pos; n++;
+        }
+        return n > 0 ? c / n : _cPos;
+    }
+
+    /// <summary>The centre of the defeated prisoners within 20 m of the officer (the officer's place without them).</summary>
+    Vector3 PrisonersCentre()
+    {
+        var tr = Battle.Trace; int last = tr.StepCount - 1; var c = Vector3.Zero; int n = 0;
+        for (int e = 0; e < tr.Entities.Count; e++)
+        {
+            if (tr.Entities[e].Side != Outcome.Defeated || BenchBattle.Map(tr.State(last, e)) != TraceSoldierState.Surrendered) continue;
+            var p = Troops.Place(e, _tEnd).pos;
+            if (Vector3.Distance(p, _oPos) > 20f) continue;
