+        ("G1 units-wide5k frontline", g1("units-wide5k", "frontline"), "G2 bench-b front (noon)", g2("b", "bench-b", "front")),
+        ("G1 units-wide5k wide", g1("units-wide5k", "wide"), "G2 bench-b wide (golden hour)", g2("b", "bench-b", "wide-golden")),
+        ("G1 units-closeup variation", g1("units-closeup", "variation"), "G2 bench-b standard (golden hour)", g2("b", "bench-b", "standard")),
