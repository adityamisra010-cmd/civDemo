--- /dev/null
+++ b/prototypes/m7-gfx2/Gfx.Demo/Scenes/Bench/SceneE.cs
@@ -0,0 +1,145 @@
+using Gfx.Engine.Cameras;
+using Gfx.Engine.Scene;
+using Gfx.Proc.Environment;
+using Gfx.Proc.Environment.Structures;
+using Gfx.Proc.Environment.Trees;
+using Gfx.Proc.Presentation;
+using Microsoft.Xna.Framework;
+
+namespace Gfx.Demo.Scenes.Bench;
+
+/// <summary>
+/// Benchmark scene E, the campaign environment (stage scenes, D-078 QM8 E): a wide vista of the env temperate battlefield
+/// with its forest, river, the Iron Age village and a stone stronghold on the high ground (<see cref="Settlements.Stronghold"/>),
+/// at noon, golden hour and dusk, plus closer views of the settlement, the fortification and the river. A BENCHMARK
+/// CAPTURE ONLY: the campaign map itself is not changed (D-079 Q7 is open; this is reading (a) of Q-QM1, a 3D settlement
+/// view beside the atlas map). PRESENTATION ONLY: the grid is read, never written.
+/// </summary>
+[DemoScene("bench-e", "Benchmark E: campaign environment vista (forest, river, Iron Age village, stone stronghold), noon/golden/dusk")]
+public sealed class BenchEnvironmentScene : BenchSceneBase
+{
+    public SettlementPlan? Stronghold { get; private set; }
+
+    protected override Func<TerrainMeshData, WaterField, StructureKit?, SettlementPlan>? Settlement => (m, w, kit) =>
+    {
+        var village = Settlements.IronAgeVillage(m, w, SettlementSeed, kit);
+        var fort = Settlements.Stronghold(m, w, SettlementSeed ^ 0xF0F7u, kit, village.Exclusions, village.Centre);
+        Stronghold = fort;
+        return village with { Exclusions = village.Exclusions.Concat(fort.Exclusions).ToList() };
+    };
+
+    protected override float ShadowDistanceM => 1400f;
+
+    /// <summary>The cleared ground around the stronghold's walls (m beyond its plan radius): no trees there in this scene.</summary>
+    public const float Glacis = 70f;
+
+    /// <summary>The stronghold's plan (no kit: the same plan the scene builds) and a cleared ring of ground around its
+    /// walls, so the fortification stands in open ground with the forest at a distance (benchmark presentation).</summary>
+    protected override IReadOnlyList<Exclusion>? TreeExclusions(TerrainMeshData mesh)
+    {
+        var w = new WaterField(mesh);
+        var village = Settlements.IronAgeVillage(mesh, w, SettlementSeed, null);
+        var fort = Settlements.Stronghold(mesh, w, SettlementSeed ^ 0xF0F7u, null, village.Exclusions, village.Centre);
+        return new[] { new Exclusion(fort.Centre, fort.Radius + Glacis) };
+    }
+
+    protected override void Build() { }
+
+    Vector3 G(Vector2 p, float up) => new(p.X, Env.Terrain.HeightAt(p.X, p.Y) + up, p.Y);
+
+    /// <summary>Eyes chosen by the vista search (for the report).</summary>
+    public Vector3 VistaEye { get; private set; }
+    public Vector2? RiverAt { get; private set; }
+
+    protected override void BuildShots()
+    {
+        var v = Env.Settlement!; var f = Stronghold!;
+        var mid = (v.Centre + f.Centre) * 0.5f;
+        const float fov = 0.70f;
+        // the vista: an establishing view along the line between the two settlements, from 150 m behind the stronghold
+        // (50 m to either side, 60 m above the ground) towards a point 30 % of the way to the village: the fortification
+        // on its high ground in the foreground, the forest, the fields and the river valley beyond, the village in the
+        // distance. The clearer side wins (fewest tree crowns and no hill across the sight lines to either settlement;
+        // ties: the listed order); the view from behind the village is the fallback when both are off the map.
+        var cands = new List<(Vector2 eye, Vector2 aim)>();
+        foreach (var (near, far) in new[] { (f.Centre, v.Centre), (v.Centre, f.Centre) })
+        {
+            var ax = Vector2.Normalize(far - near); var sd = new Vector2(-ax.Y, ax.X);
+            foreach (float k in new[] { 1f, -1f })
+                cands.Add((near - ax * 150f + sd * (50f * k), Vector2.Lerp(near, far, 0.3f)));
+        }
+        Vector3 vista = G(cands[0].eye, 60f), aim = G(cands[0].aim, 0f); int best = int.MaxValue;
+        for (int i = 0; i < cands.Count; i++)
+        {
+            var (e, a) = cands[i];
+            var m = Env.Terrain.Mesh;
+            if (MathF.Abs(e.X) > m.HalfExtentX - 30f || MathF.Abs(e.Y) > m.HalfExtentZ - 30f) continue;
+            if (i >= 2 && best != int.MaxValue) break;   // the stronghold-first views are on the map
+            var eye = G(e, 60f); var target = G(a, 0f);
+            int cost = ShotCost(eye, target, fov) + 3 * SightCost(eye, G(v.Centre, 3f)) + 3 * SightCost(eye, G(f.Centre, 6f));
+            if (cost < best) { best = cost; vista = eye; aim = target; }
+        }
+        VistaEye = vista;
+        var shots = new List<CaptureShot>();
+        foreach (var (name, hour) in BenchHours.All)
+            shots.Add(new CaptureShot("vista-" + name, new CameraPose(vista, aim, fov, 0.5f, 40000f), hour, 3f));
+        // the whole campaign ground in one view: from 240 m behind the village (on the far side from the stronghold),
+        // 60 m towards the river and 120 m up, looking along the line between the settlements to a point a third of the
+        // way: the village and the river beside it in the foreground, the forest and the fields, the stronghold on its
+        // high ground beyond and the far hills on the horizon (an oblique view: from far above, the flat far field beyond
+        // the 1 km map shows)
+        var axis = Vector2.Normalize(f.Centre - v.Centre); var across = new Vector2(-axis.Y, axis.X);
+        if (NearestWater(v.Centre) is { } rn && Vector2.Dot(rn - v.Centre, across) < 0) across = -across;
+        var hTarget = G(Vector2.Lerp(v.Centre, f.Centre, 0.32f), 0f);
+        var hFrom = v.Centre - axis * 240f + across * 60f;
+        var hEye = new Vector3(hFrom.X, Env.Terrain.HeightAt(hFrom.X, hFrom.Y) + 120f, hFrom.Y);
+        shots.Add(new CaptureShot("vista-high", new CameraPose(hEye, hTarget, 0.75f, 1f, 40000f), BenchHours.Noon, 3f));
+        // the settlement from 110 m out of its gate, 32 m up; the fortification from 75 m out of its gate, 24 m up
+        var vEye = ClearEye(G(v.Centre + Vector2.Normalize(v.Gate - v.Centre) * 110f, 32f), G(v.Centre, 2f), 0.75f);
+        shots.Add(new CaptureShot("settlement", new CameraPose(vEye, G(v.Centre, 2f), 0.75f, 0.3f, 40000f), BenchHours.Golden, 3f));
+        var fEye = ClearEye(G(f.Centre + f.GateOut * 75f, 24f), G(f.Centre, 4f), 0.75f);
+        shots.Add(new CaptureShot("fortification", new CameraPose(fEye, G(f.Centre, 4f), 0.75f, 0.3f, 40000f), BenchHours.Noon, 3f));
+        // the river: from the far bank of the water nearest the village, low, the river in front and the village beyond
+        RiverAt = NearestWater(v.Centre);
+        if (RiverAt is { } r)
+        {
+            // over the water itself, 1.8 m above its surface and 12 m out from the nearest water to the village, looking
+            // at the village across the river and its bank
+            var away = Vector2.Normalize(r - v.Centre);
+            var at = r + away * 12f;
+            float surf = Env.Water.SurfaceAt(at.X, at.Y);
+            if (float.IsNaN(surf)) { at = r; surf = Env.Water.SurfaceAt(r.X, r.Y); }
+            float ground = Env.Terrain.HeightAt(at.X, at.Y);
+            var eye = new Vector3(at.X, MathF.Max(ground, float.IsNaN(surf) ? ground : surf) + 1.8f, at.Y);
+            var target = G(v.Centre, 3f);
+            shots.Add(new CaptureShot("river", new CameraPose(eye, target, 0.8f, 0.2f, 40000f), BenchHours.Golden, 3f));
+        }
+        ShotList = shots.ToArray();
+    }
+
+    /// <summary>The nearest wet ground to a point (read-only search of the generated map), or none within 400 m.</summary>
+    Vector2? NearestWater(Vector2 from)
+    {
+        var m = Env.Terrain.Mesh;
+        for (float d = 20; d < 400; d += 8)
+            for (int a = 0; a < 48; a++)
+            {
+                float ang = a * MathF.Tau / 48;
+                var p = from + new Vector2(MathF.Cos(ang), MathF.Sin(ang)) * d;
+                if (MathF.Abs(p.X) > m.HalfExtentX - 10 || MathF.Abs(p.Y) > m.HalfExtentZ - 10) continue;
+                if (m.IsWet(p.X, p.Y)) return p;
+            }
+        return null;
+    }
+
+    public override Vector3 Focus => Stronghold is { } f ? G(f.Centre, 0f) : Vector3.Zero;
+
+    public override string FrameReport()
+    {
+        var v = Env.Settlement!; var f = Stronghold!;
+        return string.Format(System.Globalization.CultureInfo.InvariantCulture,
+            "[bench-e] village ({0:F0},{1:F0}) r={2:F0} stronghold ({3:F0},{4:F0}) r={5:F0} glacis={6:F0} m vista-eye ({7:F0},{8:F1},{9:F0}) river {10}",
+            v.Centre.X, v.Centre.Y, v.Radius, f.Centre.X, f.Centre.Y, f.Radius, Glacis, VistaEye.X, VistaEye.Y, VistaEye.Z,
+            RiverAt is { } r ? string.Format(System.Globalization.CultureInfo.InvariantCulture, "({0:F0},{1:F0})", r.X, r.Y) : "none within 400 m");
+    }
+}
