+    /// <summary>
+    /// Rank 3: in an idle block of 10 files by 4 ranks, neighbours in a rank hold different poses at one scene time: for
+    /// at least 90 % of the adjacent pairs the right hand or the head (character space, before the soldier's yaw and
+    /// size) stands more than 4 cm apart; and every soldier's gaze is near level (the bowed heads of the retargeted idle
+    /// fail it: 24 degrees down, the proud idle 22 up). Presentation only: the agents are a pure function of the formation
+    /// seed and time.
+    /// </summary>
+    [CharsGfxFact]
+    public void AdjacentIdleSoldiersDifferInPoseAtOneTime()
+    {
+        TestGfx.Host.Invoke(gd =>
+        {
+            using var cast = new CrowdCast(gd, (x, z) => 0f);
+            cast.Formations.Add(new FormationSpec(Vector2.Zero, 0f, 10, 4, 0, FormationAct.Idle, 4000u));
+            cast.Update(2.0f);
+            var agents = cast.Crowd.Agents;
+            var bank = cast.Crowd.Bank;
+            var skels = new SortedDictionary<string, Skeleton>(StringComparer.Ordinal);
+            foreach (var (identity, _) in CrowdCast.Variants) if (!skels.ContainsKey(identity)) skels[identity] = Identity(identity).Item1;
+            (Vector3 hand, Vector3 head) PoseOf(in CrowdAgent a)
+            {
+                var v = cast.Crowd.Variants[a.Variant]; var sk = skels[v.Identity];
+                return (Joint(bank, sk, v.BankIdentity, sk["hand_r"], a.ClipA, a.TimeA, a.ClipB, a.TimeB, a.Blend),
+                        Joint(bank, sk, v.BankIdentity, sk["head"], a.ClipA, a.TimeA, a.ClipB, a.TimeB, a.Blend));
+            }
+            int pairs = 0, differ = 0;
+            for (int r = 0; r < 4; r++)
+                for (int c = 0; c + 1 < 10; c++)
+                {
+                    var p = PoseOf(agents[r * 10 + c]); var q = PoseOf(agents[r * 10 + c + 1]);
+                    pairs++;
+                    if (Vector3.Distance(p.hand, q.hand) > 0.04f || Vector3.Distance(p.head, q.head) > 0.04f) differ++;
+                }
+            Assert.True(differ * 10 >= pairs * 9, $"only {differ} of {pairs} adjacent pairs differ by more than 4 cm");
+            // and every soldier looks out, not at the ground or the sky: the face's gaze (head joint to a point 10 cm in
+            // front of the face, skinned) of every soldier lies between 24 degrees down and 20 up. The retargeted idles held
+            // their MEANS at 24 down and 22 up; the variants keep each clip's own head motion, so single frames still swing
+            // some 15 degrees about the mean. Control: the same block on the base clips (the agents' times and blends, the
+            // pre-polish idle and proud idle) does put soldiers outside those bounds, so the bounds tell the two apart.
+            float Gaze(in CrowdAgent a, int clipA, int clipB)
+            {
+                var v = cast.Crowd.Variants[a.Variant]; var sk = skels[v.Identity];
+                int head = sk["head"];
+                var front = sk.Head[head] + CrowdPoseVariants.FaceForward(sk) * 0.1f;
+                var (a0, a1, fa) = bank.Sample(v.BankIdentity, clipA, a.TimeA); var (b0, b1, fb) = bank.Sample(v.BankIdentity, clipB, a.TimeB);
+                var animA = new Vector4(a0, a1, fa, a.Blend); var animB = new Vector4(b0, b1, fb, 0);
+                var ph = bank.SkinCpu(sk.Head[head], new[] { head, 0, 0, 0 }, new[] { 1f, 0, 0, 0 }, animA, animB);
+                var pf = bank.SkinCpu(front, new[] { head, 0, 0, 0 }, new[] { 1f, 0, 0, 0 }, animA, animB);
+                return MathHelper.ToDegrees(MathF.Asin(Math.Clamp(Vector3.Normalize(pf - ph).Y, -1f, 1f)));
+            }
+            int baseIdle = CrowdAnimationBank.ClipIndex("idle"), baseProud = CrowdAnimationBank.ClipIndex("idle_proud");
+            float lo = float.MaxValue, hi = float.MinValue, sum = 0, loOld = float.MaxValue, hiOld = float.MinValue;
+            foreach (var a in agents)
+            {
+                float gaze = Gaze(a, a.ClipA, a.ClipB);
+                lo = MathF.Min(lo, gaze); hi = MathF.Max(hi, gaze); sum += gaze;
+                float old = Gaze(a, baseIdle, baseProud);
+                loOld = MathF.Min(loOld, old); hiOld = MathF.Max(hiOld, old);
+            }
+            float mean = sum / agents.Length;
+            _out.WriteLine($"adjacent pairs differing: {differ} of {pairs}; gaze range {lo:F1} .. {hi:F1}, mean {mean:F1} degrees; base clips {loOld:F1} .. {hiOld:F1}");
+            Assert.InRange(lo, -24f, 20f); Assert.InRange(hi, -24f, 20f);
+            Assert.True(loOld < -24f || hiOld > 20f, $"control: the base clips' gaze {loOld:F1} .. {hiOld:F1} lies inside the bounds");
+        });
+    }
