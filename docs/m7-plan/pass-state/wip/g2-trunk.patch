+/// <summary>
+/// Named weather looks for <c>--set weather=…</c> (stage scenes). Clear is every term 0 (the frame of every earlier
+/// stage). Overcast: thick cloud, dry. Mist: thin cloud, dew-wet surfaces and dense ground mist. Rain: thick cloud,
+/// soaked surfaces, puddles, rain streaks and a misty distance. PRESENTATION ONLY: weather is never read by any
+/// simulation (DR42); the battle trace and the grid are the same in every look.
+/// </summary>
+public static class WeatherPresets
+{
+    public static readonly WeatherLook Clear = new("clear", 0f, 0f, 0f, 0f);
+    public static readonly WeatherLook Overcast = new("overcast", 0.85f, 0f, 0f, 0f);
+    public static readonly WeatherLook Mist = new("mist", 0.45f, 0.35f, 0f, 1f);
+    public static readonly WeatherLook Rain = new("rain", 0.93f, 1f, 1f, 0.35f);
+    public static readonly WeatherLook[] All = { Clear, Overcast, Mist, Rain };
+
+    public static WeatherLook? Get(string name)
+    {
+        foreach (var w in All) if (w.Name == name) return w;
+        return null;
+    }
