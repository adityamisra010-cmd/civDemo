+    /// <summary>The fallen-body geometry: crossing segments touch (0), parallel ones keep their offset, collinear ones
+    /// their gap, and the distance does not depend on the order of the segments or their ends.</summary>
+    [Fact]
+    public void SegmentDistanceMeasuresCrossingParallelAndCollinearBodies()
+    {
+        Assert.Equal(0f, Gfx.Demo.Scenes.Bench.TraceCrowd.SegmentDistance(new(0, 0), new(2, 0), new(1, -1), new(1, 1)));
+        Assert.Equal(0.5f, Gfx.Demo.Scenes.Bench.TraceCrowd.SegmentDistance(new(0, 0), new(2, 0), new(0, 0.5f), new(2, 0.5f)), 5);
+        Assert.Equal(1.0f, Gfx.Demo.Scenes.Bench.TraceCrowd.SegmentDistance(new(0, 0), new(1, 0), new(2, 0), new(3, 0)), 5);
+        float d1 = Gfx.Demo.Scenes.Bench.TraceCrowd.SegmentDistance(new(0, 0), new(1.7f, 0.3f), new(0.4f, 1.1f), new(1.2f, 0.6f));
+        float d2 = Gfx.Demo.Scenes.Bench.TraceCrowd.SegmentDistance(new(1.2f, 0.6f), new(0.4f, 1.1f), new(1.7f, 0.3f), new(0, 0));
+        Assert.Equal(d1, d2, 5);
