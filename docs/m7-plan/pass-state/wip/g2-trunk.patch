+    /// <summary>
+    /// Stage scenes: a stone stronghold (fortification) on high ground for the campaign vista (benchmark scene E): a
+    /// circuit of about 58 × 44 m with chamfered corners, curtain walls 6 m to the wall walk with crenellated parapets,
+    /// roofed towers at the corners, a gatehouse facing the village (or the map centre), and a hall and houses inside.
+    /// Built from the env stage's structure kit. The site: the highest ground that is level enough (relief under 4 m
+    /// across the circuit), dry and open, keeping clear of every <paramref name="avoid"/> disc. PRESENTATION ONLY: set
+    /// dressing on the generated grid, never written to it.
+    /// </summary>
+    public static SettlementPlan Stronghold(TerrainMeshData m, WaterField water, uint seed, StructureKit? kit, IReadOnlyList<Exclusion> avoid, Vector2? facing = null)
+    {
+        var half = new Vector2(29f, 22f);
+        float r = half.Length();
+        float best = float.MaxValue; var c = Vector2.Zero;
+        for (float cz = -380; cz <= 380; cz += 12)
+            for (float cx = -380; cx <= 380; cx += 12)
+            {
+                var q = new Vector2(cx, cz);
+                if (MathF.Abs(cx) > m.HalfExtentX - r - 40 || MathF.Abs(cz) > m.HalfExtentZ - r - 40) continue;
+                bool bad = false;
+                foreach (var e in avoid) if (Vector2.Distance(e.Centre, q) < e.Radius + r + 40) bad = true;
+                if (bad) continue;
+                float lo = float.MaxValue, hi = float.MinValue, sum = 0, pen = 0; int n = 0;
+                for (float dz = -r; dz <= r; dz += 6)
+                    for (float dx = -r; dx <= r; dx += 6)
+                    {
+                        if (dx * dx + dz * dz > r * r) continue;
+                        float x = cx + dx, z = cz + dz;
+                        if (m.IsWet(x, z)) { pen += 400; continue; }
+                        pen += m.ClassAt(x, z) switch { TerrainClass.Water => 400, TerrainClass.Road => 30, TerrainClass.Forest or TerrainClass.Jungle => 4, _ => 0 };
+                        float h = m.HeightAt(x, z); lo = MathF.Min(lo, h); hi = MathF.Max(hi, h); sum += h; n++;
+                    }
+                if (n == 0 || hi - lo > 4f) continue;
+                float sc = pen + (hi - lo) * 8f - (sum / n) * 2.5f;
+                if (sc < best) { best = sc; c = q; }
+            }
+        var toward = facing.HasValue ? facing.Value - c : -c;
+        if (toward.LengthSquared() < 1) toward = Vector2.UnitY;
+        var fwd = Vector2.Normalize(toward);
+        var ax = new Vector2(fwd.Y, -fwd.X);
+        Vector2 W(float x, float z) => c + ax * x + fwd * z;
+        var (lo2, hi2) = (float.MaxValue, float.MinValue); float s2 = 0; int c2 = 0;
+        for (float z = -half.Y; z <= half.Y; z += 6) for (float x = -half.X; x <= half.X; x += 6) { float h = m.HeightAt(W(x, z).X, W(x, z).Y); lo2 = MathF.Min(lo2, h); hi2 = MathF.Max(hi2, h); s2 += h; c2++; }
+        float walk = MathF.Max(s2 / c2 + 6.0f, hi2 + 3f);
+        float ch = 7f;
+        var outline = new List<Vector2>
+        {
+            W(-half.X + ch, half.Y), W(-half.X, half.Y - ch), W(-half.X, -half.Y + ch), W(-half.X + ch, -half.Y),
+            W(half.X - ch, -half.Y), W(half.X, -half.Y + ch), W(half.X, half.Y - ch), W(half.X - ch, half.Y),
+        };
+        var gate = W(0, half.Y);
+        var plan = new SettlementPlan("stronghold", c, r, gate, fwd, outline, new[] { new Exclusion(c, r + 8f) }, walk) { Inside = W(0, 6) };
+        if (kit == null) return plan;
+        var stone = new Vector3(0.92f, 0.90f, 0.86f);
+        for (int i = 0; i < outline.Count; i++)
+        {
+            var a = outline[i]; var b = outline[(i + 1) % outline.Count];
+            if (i == outline.Count - 1)
+            {
+                kit.CurtainWall(a, gate + ax * 6.5f, walk, 2.6f, stone);
+                kit.CurtainWall(gate - ax * 6.5f, b, walk, 2.6f, stone);
+                continue;
+            }
+            kit.CurtainWall(a, b, walk, 2.6f, stone);
+        }
+        kit.TownGate(gate, fwd, 3.8f, walk, 2.6f, stone);
+        foreach (var (p, o) in new[]
+        {
+            (W(-half.X + ch * 0.5f, -half.Y + ch * 0.5f), Vector2.Normalize(-fwd - ax)), (W(half.X - ch * 0.5f, -half.Y + ch * 0.5f), Vector2.Normalize(-fwd + ax)),
+            (W(-half.X, 0), -ax), (W(half.X, 0), ax), (W(0, -half.Y), -fwd),
+        })
+            kit.Tower(p + o * 2.0f, o, 6.6f, walk, stone);
+        // the hall (two storeys, hipped roof) at the back, houses along the sides of the yard
+        var plaster = new Vector3(0.98f, 0.94f, 0.86f);
+        kit.House(W(0, -half.Y + 9f), ax, new Vector2(11f, 5.5f), 2, plaster, new Vector3(0.9f, 0.85f, 0.8f), 2, true);
+        kit.House(W(-half.X + 8f, 4f), fwd, new Vector2(5f, 3.6f), 1, plaster * 0.97f, new Vector3(1f), 1, false);
+        kit.House(W(half.X - 8f, 4f), fwd, new Vector2(5f, 3.6f), 1, plaster * 1.02f, new Vector3(0.95f), 3, false);
+        kit.Street(W(0, half.Y - 2f), W(0, -half.Y + 15f), 5f, new Vector3(0.95f));
+        return plan;
+    }
 }
