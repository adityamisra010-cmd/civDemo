+/// <summary>A Fact that SKIPS (not fails) when the exported battle trace of scenes C and D is missing.</summary>
+public sealed class BenchTraceFactAttribute : FactAttribute
+{
+    public BenchTraceFactAttribute() { if (!File.Exists(BenchBattle.DefaultPath)) Skip = "no battle-trace bake: run scripts/export-battle-trace.sh"; }
+}
+
+/// <summary>A device test that needs the stage-chars bake and the exported battle trace: SKIPS without any of them.</summary>
+public sealed class BenchCrowdFactAttribute : FactAttribute
+{
+    public BenchCrowdFactAttribute()
+    {
+        if (!TestGfx.Available) Skip = "no graphics device: " + TestGfx.Reason;
+        else if (!Gfx.Chars.Rendering.CharStage.BakeExists()) Skip = "no character bake: run scripts/bake-chars.sh";
+        else if (!File.Exists(BenchBattle.DefaultPath)) Skip = "no battle-trace bake: run scripts/export-battle-trace.sh";
