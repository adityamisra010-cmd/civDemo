diff --git a/prototypes/m7-gfx2/Gfx.Tests/Polish1Tests.cs b/prototypes/m7-gfx2/Gfx.Tests/Polish1Tests.cs
new file mode 100644
index 0000000..77b5447
--- /dev/null
+++ b/prototypes/m7-gfx2/Gfx.Tests/Polish1Tests.cs
@@ -0,0 +1,371 @@
+using Gfx.Chars.Animation;
+using Gfx.Chars.Crowd;
+using Gfx.Chars.Format;
+using Gfx.Chars.Rendering;
+using Gfx.Demo.Scenes;
+using Gfx.Engine.Assets;
+using Gfx.Engine.Cameras;
+using Gfx.Engine.Diagnostics;
+using Gfx.Engine.Effects;
+using Gfx.Engine.Rendering;
+using Gfx.Engine.Scene;
+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Graphics;
+using Xunit;
+
+namespace Gfx.Tests;
+
+/// <summary>
+/// A smooth convex dome (a sphere of 150 m radius, its centre 100 m under the ground plane's level) drawn with the
+/// engine's instanced lit effect: a convex body never shadows a point of itself that faces the sun, so on this dome every
+/// shadowed pixel whose surface faces the sun is shadow acne. Nothing else is in the scene.
+/// </summary>
+sealed class DomeScene : IRenderContent, IDisposable
+{
+    readonly GpuMesh _sphere;
+    readonly InstanceBuffer<InstanceTransform> _one;
+    public const float Radius = 150f, CentreY = -100f;
+
+    public DomeScene(GraphicsDevice gd)
+    {
+        _sphere = GpuMesh.Create(gd, Primitives.Sphere(1f, 192, Color.White));
+        _one = new InstanceBuffer<InstanceTransform>(gd, 1);
+        _one.Set(new[] { InstanceTransform.From(Matrix.CreateScale(Radius) * Matrix.CreateTranslation(0, CentreY, 0), new Vector4(0.32f, 0.36f, 0.20f, 1)) });
+    }
+
+    public void DrawShadowCasters(RenderContext rc) => _sphere.DrawInstanced(rc, rc.Effects.Get(EffectNames.InstancedDepth), _one);
+    public void DrawOpaque(RenderContext rc) => _sphere.DrawInstanced(rc, rc.Effects.Get(EffectNames.InstancedLit), _one);
+    public void Dispose() { _sphere.Dispose(); _one.Dispose(); }
+}
+
+/// <summary>Nothing but the sky (the reference frame that tells a scene's pixels from the sky's).</summary>
+sealed class EmptyScene : IRenderContent
+{
+    public void DrawShadowCasters(RenderContext rc) { }
+    public void DrawOpaque(RenderContext rc) { }
+}
+
+/// <summary>Stage polish1 (critic iteration 1): shadows, terrain, crowd variation, banners, faces, light.</summary>
+public class Polish1Tests
+{
+    readonly Xunit.Abstractions.ITestOutputHelper _out;
+    public Polish1Tests(Xunit.Abstractions.ITestOutputHelper output) { _out = output; }
+
+    const int W = 320, H = 180;
+    static readonly string OutDir = Path.Combine(AppContext.BaseDirectory, "test-output", "polish1");
+
+    static ForwardRenderer NewRenderer(GraphicsDevice gd, string switches)
+    {
+        var r = new ForwardRenderer(gd, TestGfx.Host.Effects);
+        r.Settings.FogParams = new Vector4(0f, 0.02f, 0f, 0f);
+        r.Settings.ShadowCasterBounds = new BoundingBox(new Vector3(-160, -100, -160), new Vector3(160, 60, 160));
+        r.Settings.Features.SetMany("autoexposure=0,bloom=0,grade=0,aa=none,farfield=0,ssao=0,contact=0,aerial=0");
+        if (switches.Length > 0) r.Settings.Features.SetMany(switches);
+        return r;
+    }
+
+    static float Luma(Color c) => 0.2126f * c.R + 0.7152f * c.G + 0.0722f * c.B;
+
+    /// <summary>
+    /// Rank 2: under a golden-hour sun (about 9 degrees up) the sunlit side of a smooth convex dome, seen from 260 m so its
+    /// slopes fall in the outer cascades, is not darkened by the cascaded shadows anywhere: a frame with shadows and one
+    /// without differ on fewer than 0.5 % of the dome's sunlit pixels. With the constant per-cascade bias alone the lit
+    /// slopes drew contour bands of self-shadow (acne).
+    /// </summary>
+    [GfxFact]
+    public void GrazingSunLeavesNoAcneOnASmoothLitSlope()
+    {
+        TestGfx.Host.Invoke(gd =>
+        {
+            using var scene = new DomeScene(gd);
+            using var rt = new RenderTarget2D(gd, W, H, false, SurfaceFormat.Color, DepthFormat.None);
+            var sun = SunModel.At(17.9f);
+            Assert.InRange(sun.SunElevationRadians, MathHelper.ToRadians(6f), MathHelper.ToRadians(12f));
+            var toSun = sun.DirectionToLight; var flat = Vector3.Normalize(new Vector3(toSun.X, 0, toSun.Z));
+            var side = new Vector3(-flat.Z, 0, flat.X);
+            // the camera stands sun-side of the dome and looks across its lit flank
+            var cam = new CameraPose(flat * 260f + side * 90f + new Vector3(0, 60f, 0), new Vector3(0, 20f, 0), 0.8f, 0.5f, 2000f);
+            using var on = NewRenderer(gd, "shadowdist=700");
+            using var off = NewRenderer(gd, "shadowdist=700");
+            off.Settings.Shadows = false;
+            on.Render(scene, cam, sun, rt, 0f); var a = Capture.ReadPixels(rt);
+            Directory.CreateDirectory(OutDir); Capture.SavePng(rt, Path.Combine(OutDir, "dome-shadows.png"));
+            off.Render(scene, cam, sun, rt, 0f); var b = Capture.ReadPixels(rt);
+            Capture.SavePng(rt, Path.Combine(OutDir, "dome-noshadows.png"));
+            off.Render(new EmptyScene(), cam, sun, rt, 0f); var sky = Capture.ReadPixels(rt);
+            // the dome's pixels (they differ from the empty frame) and among them the sunlit ones: clearly brighter than
+            // the dome's unlit side in the frame without shadows
+            float dark = float.MaxValue, bright = 0;
+            for (int i = 0; i < b.Length; i++)
+            {
+                if (b[i] == sky[i]) continue;
+                float l = Luma(b[i]); dark = MathF.Min(dark, l); bright = MathF.Max(bright, l);
+            }
+            float litFloor = dark + 0.35f * (bright - dark);
+            int lit = 0, acne = 0;
+            for (int i = 0; i < b.Length; i++)
+            {
+                float lb = Luma(b[i]);
+                if (b[i] == sky[i] || lb < litFloor) continue;
+                lit++;
+                if (Luma(a[i]) < lb - 3f) acne++;
+            }
+            Assert.True(lit > W * H / 5, $"only {lit} sunlit dome pixels in view");
+            Assert.True(acne < lit / 200, $"{acne} of {lit} sunlit dome pixels self-shadowed (acne)");
+        });
+    }
+
+    static (Skeleton, CharacterFile) Identity(string id)
+    {
+        string dir = AssetRoot.Baked("chars");
+        var f = CharacterFile.Load(Path.Combine(dir, id + ".g2ch"));
+        var clips = CharacterFile.Load(Path.Combine(dir, id + "__clips.g2ch"));
+        return (new Skeleton(f.Bones), clips);
+    }
+
+    /// <summary>Character-space position of a bone's joint for one crowd instance's two-clip sample (the shader's CPU twin).</summary>
+    static Vector3 Joint(CrowdAnimationBank bank, Skeleton sk, int identity, int bone, int clipA, float timeA, int clipB, float timeB, float blend)
+    {
+        var (a0, a1, fa) = bank.Sample(identity, clipA, timeA);
+        var (b0, b1, fb) = bank.Sample(identity, clipB, timeB);
+        var aA = new Vector4(a0, a1, fa, blend); var aB = new Vector4(b0, b1, fb, 0);
+        return bank.SkinCpu(sk.Head[bone], new[] { bone, 0, 0, 0 }, new[] { 1f, 0, 0, 0 }, aA, aB);
+    }
+
+    /// <summary>
+    /// Rank 3: the idle variants raise the retargeted clips' bowed heads to the variant's gaze (within 1.5 degrees of it,
+    /// mean over the clip), and the variants move the weapon hand: at one time the right hand of variants 1-3 stands
+    /// more than 5 cm from variant 0's.
+    /// </summary>
+    [CharsBakeFact]
+    public void CrowdIdleVariantsLiftTheBowedHeadAndMoveTheWeaponArm()
+    {
+        var notes = new List<string>();
+        foreach (var id in new[] { "a1", "b3" })
+        {
+            var (sk, clips) = Identity(id);
+            foreach (var name in CrowdPoseVariants.BaseClips)
+            {
+                var src = clips.Clip(name)!;
+                float before = CrowdPoseVariants.MeanHeadPitch(sk, src);
+                for (int k = 0; k < CrowdPoseVariants.Idle.Length; k++)
+                {
+                    var v = CrowdPoseVariants.Derive(sk, src, name + "@" + k, CrowdPoseVariants.Idle[k]);
+                    Assert.Equal(src.Frames, v.Frames);
+                    float after = CrowdPoseVariants.MeanHeadPitch(sk, v);
+                    Assert.InRange(after, CrowdPoseVariants.Idle[k].HeadPitch - 1.5f, CrowdPoseVariants.Idle[k].HeadPitch + 1.5f);
+                    if (k == 0) notes.Add($"{id} {name}: mean gaze {before:0.0} -> {after:0.0} deg");
+                }
+            }
+            var bank = CrowdAnimationBank.BuildCpu(new[] { (sk, clips) });
+            int hand = sk["hand_r"];
+            var h0 = Joint(bank, sk, 0, hand, CrowdAnimationBank.ClipIndex("idle@0"), 1.0f, 0, 0, 0);
+            for (int k = 1; k < CrowdPoseVariants.Idle.Length; k++)
+            {
+                var hk = Joint(bank, sk, 0, hand, CrowdAnimationBank.ClipIndex("idle@" + k), 1.0f, 0, 0, 0);
+                Assert.True(Vector3.Distance(h0, hk) > 0.05f, $"{id} idle@{k}: right hand only {Vector3.Distance(h0, hk):0.000} m from idle@0");
+            }
+        }
+        Console.WriteLine(string.Join("; ", notes));
+    }
