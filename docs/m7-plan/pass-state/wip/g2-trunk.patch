+<Project Sdk="Microsoft.NET.Sdk">
+  <!--
+    G2 stage scenes: battle-trace exporter (a TOOL, not part of M7Gfx2.slnx and never shipped).
+    It runs the battle prototype's TacticalResolver (prototypes/m7-sprint1/Proto.M7, referenced READ-ONLY and never
+    modified) on a coarse battle grid derived from the G2 authoritative terrain grid (Gfx.Proc/Authoritative), and writes
+    the m7gfx-battle-trace/1 file the presentation reads. Run it through scripts/export-battle-trace.sh.
+  -->
