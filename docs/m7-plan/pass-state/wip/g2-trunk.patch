+            (0, 1.5f, 1.5f, TraceState.Active), (0, 1.5f, -1.5f, TraceState.Active), (1, 2.5f, 1f, TraceState.Surrendered),
+            (0, 100f, 0f, TraceState.Active), (1, 103f, 0f, TraceState.Surrendered),             // the lone pair (ids 5, 6)
+            (1, 50f, 50f, TraceState.Dead), (1, 60f, 60f, TraceState.Escaped), (0, 70f, 70f, TraceState.Surrendered), (1, 80f, 80f, TraceState.Routing));
