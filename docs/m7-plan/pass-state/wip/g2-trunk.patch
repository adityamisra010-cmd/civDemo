+        List<AftermathShot> Beats(DeathContent c) => BenchAftermathScene.PlanBeats(PlanWith(c), Vector3.Zero, new Vector3(3, 0, 0), 0f,
+            new Vector3(12, 0, 9), new Vector3(30, 0, 30), new Vector3(5, 0, 2), occ, Flat);
+        var shown = Beats(DeathContent.Shown); var cut = Beats(DeathContent.CutAway);
+        string[] six = { "field", "prisoners", "surrender", "officer-face", "commander-face", "standards" };
+        Assert.Equal(six.Append("fallen"), shown.Select(b => b.Name));
+        Assert.Equal(six.Append("cutaway"), cut.Select(b => b.Name));
+        Assert.Equal(shown.Take(6), cut.Take(6));
+        Assert.DoesNotContain(cut, b => b.Depicts.Contains("fallen", StringComparison.Ordinal));
+        var noVictor = BenchAftermathScene.PlanBeats(PlanWith(DeathContent.Shown, false), Vector3.Zero, Vector3.Zero, 0f, Vector3.Zero, new Vector3(30, 0, 30), Vector3.Zero, occ, Flat);
+        Assert.Equal(new[] { "field" }, noVictor.Select(b => b.Name));
+        // each still (at StillAt of its move) looks at its subject: the surrender still frames the pair's midpoint
+        var s = shown[2];
+        var still = Vector3.Lerp(s.From.Position, s.To.Position, BenchAftermathScene.StillAt);
+        Assert.True(Vector3.Distance(still, new Vector3(1.5f, 0f, 0f)) > 4f, "the two-shot stands back from the pair");
+        Assert.Equal(new Vector3(1.5f, 1.05f, 0f), s.From.Target);
+    }
+
+    /// <summary>
+    /// The close-shot solver returns the candidate with the fewest blockers, trying the turns in a fixed order (0, +15,
+    /// -15, +30, ...) and keeping the first of equal cost. Tie-dense: occluders placed symmetrically make each +/- pair
+    /// cost the same, and the positive turn is taken; with nothing in the way, the preferred eye is kept.
+    /// </summary>
+    [Fact]
+    public void CloseShotSolverPicksTheClearestViewWithStableTies()
+    {
+        var target = new Vector3(0, 1.0f, 0); var eye = new Vector3(0, 1.6f, -5f);
+        Assert.Equal(eye, BenchAftermathScene.Solve(eye, target, new List<Vector3>(), Flat, 90f));
+        // a soldier on the line and two mirrored pairs: k = 0 is blocked, +-15 and +-30 tie by symmetry
+        var occ = new List<Vector3> { new(0, 0, -2.5f) };
+        foreach (float ang in new[] { 15f, 30f })
+        {
+            float r = MathHelper.ToRadians(ang);
+            occ.Add(new Vector3(MathF.Sin(r) * 2.5f, 0, -MathF.Cos(r) * 2.5f));
+            occ.Add(new Vector3(-MathF.Sin(r) * 2.5f, 0, -MathF.Cos(r) * 2.5f));
+        }
+        var got = BenchAftermathScene.Solve(eye, target, occ, Flat, 90f);
+        // the expected answer by brute force over the documented candidate order
+        Vector3 best = eye; int bestCost = int.MaxValue; var costs = new List<int>();
+        for (int k = 0; k * 15 <= 90; k++)
+            foreach (int sg in new[] { 1, -1 })
+            {
+                if (k == 0 && sg < 0) continue;
+                float a = MathHelper.ToRadians(15f * k * sg);
+                // the eye (0, -5) relative to the target, turned by a about the vertical axis
+                var c = new Vector3(5f * MathF.Sin(a), 1.6f, -5f * MathF.Cos(a));
+                int cost = BenchAftermathScene.ViewBlockers(c, target, occ); costs.Add(cost);
+                if (cost < bestCost) { bestCost = cost; best = c; }
+            }
+        Assert.True(costs[0] > costs.Min(), "the straight view is blocked");
+        Assert.True(costs.Count(c => c == costs.Min()) >= 2, "a tie exists at the minimum");
+        Assert.Equal(best.X, got.X, 4); Assert.Equal(best.Z, got.Z, 4);
+        Assert.True(got.X > 0f, "the positive turn wins the tie");
+        // FirstClearest keeps the list order among equal costs: the blocked straight view loses, the first clear one wins
+        var listed = new List<Vector3> { eye, new(5f, 1.6f, 0f), new(-5f, 1.6f, 0f) };
+        Assert.Equal(listed[1], BenchAftermathScene.FirstClearest(listed, target, occ));
+        listed.Reverse();
+        Assert.Equal(new Vector3(-5f, 1.6f, 0f), BenchAftermathScene.FirstClearest(listed, target, occ));
+    }
+
+    /// <summary>The death-content setting has no implicit default: default(DeathContent) is not a member, and both
+    /// states are registered as separate benchmark scenes.</summary>
+    [Fact]
+    public void DeathContentHasNoImplicitDefaultAndBothStatesAreScenes()
+    {
+        Assert.False(Enum.IsDefined(default(DeathContent)));
+        var names = SceneRegistry.Discover(typeof(Gfx.Demo.Program).Assembly).Select(e => e.Name).ToHashSet();
+        foreach (var n in new[] { "bench-a", "bench-b", "bench-c", "bench-d-shown", "bench-d-cutaway", "bench-e" }) Assert.Contains(n, names);
+    }
+
+    /// <summary>Scene A's commander's expression runs grim, then a battle cry, then calm.</summary>
+    [Fact]
+    public void CommanderExpressionRunsGrimBattleCryCalm()
+    {
+        Assert.Equal("grim", BenchCloseupScene.CommanderExpression(1f).name);
+        Assert.Equal("battlecry", BenchCloseupScene.CommanderExpression(3f).name);
+        Assert.Equal("calm", BenchCloseupScene.CommanderExpression(5f).name);
+        Assert.Equal("battlecry", BenchCloseupScene.CommanderExpression(2f).name);
+        Assert.Equal("calm", BenchCloseupScene.CommanderExpression(4f).name);
+    }
+
+    // ------------------------------------------------------------------ the densest fighting (scene C's clash and melee shots)
+
+    /// <summary>A trace whose soldiers stand still at the given places (metres) and whose events are (time ms, kind,
+    /// source index, target index).</summary>
+    static BattleTrace Blows((int side, float x, float z)[] men, params (long t, string k, int src, int tgt)[] events)
+    {
+        var sb = new StringBuilder();
+        string I(long v) => v.ToString(CultureInfo.InvariantCulture);
+        sb.Append("{\"format\":\"").Append(BattleTrace.Format).Append("\",\"label\":\"blows\",\"seed\":1,\"stepMs\":2000,\"over\":true,");
+        sb.Append("\"formations\":[{\"id\":1,\"side\":0,\"kind\":\"Spear\",\"ranged\":false,\"count\":1},{\"id\":2,\"side\":1,\"kind\":\"Spear\",\"ranged\":false,\"count\":1}],");
+        sb.Append("\"entities\":[").Append(string.Join(",", men.Select((m, i) => $"[{I(100 + i)},{I(m.side + 1)},{I(m.side)}]"))).Append("],");
+        string Pos() => string.Join(",", men.Select(m => I((long)MathF.Round(m.x * 1000f)) + "," + I((long)MathF.Round(m.z * 1000f))));
+        sb.Append("\"steps\":[{\"t\":0,\"pos\":[").Append(Pos()).Append("],\"state\":[").Append(string.Join(",", men.Select(_ => "0"))).Append("]},");
+        sb.Append("{\"t\":60000,\"pos\":[").Append(Pos()).Append("],\"state\":[").Append(string.Join(",", men.Select(_ => "0"))).Append("]}],");
+        sb.Append("\"events\":[").Append(string.Join(",", events.Select(e => $"{{\"t\":{I(e.t)},\"k\":\"{e.k}\",\"src\":{I(100 + e.src)},\"tgt\":{I(100 + e.tgt)},\"a\":1}}"))).Append("],");
+        sb.Append("\"frame\":{\"originMm\":[0,0]},\"result\":{\"reason\":\"test\",\"holdsField\":0,\"side\":-1,\"endMs\":60000}}");
+        return BattleTrace.Parse(Encoding.UTF8.GetBytes(sb.ToString()));
+    }
+
+    static Vector3? Densest(BattleTrace tr, float t, float window) =>
+        BenchBattlefieldScene.DensestFighting(tr, (e, _) => { var (x, y) = tr.PosMm(0, e); return new Vector3(x / 1000f, 0, y / 1000f); }, ms => ms / 1000f, t, window);
+
+    /// <summary>
+    /// The densest fighting is the 10 m cell with the most blows in the window, placed where each blow's source stands,
+    /// and its point is the centroid of those blows' sources and targets. Tie-dense: equal counts in many cells go to
+    /// the lowest cell (x first, then z), whatever the order the events come in; one more blow moves it; blows outside
+    /// the window, Damage events and an empty window do not count (null).
+    /// </summary>
+    [Fact]
+    public void DensestFightingCountsBlowsPerCellWithStableTies()
+    {
+        // eight soldiers, pairs in four 10 m cells: (2,0) (-1,0) (0,3) (0,-2); each source faces a target 1 m away
+        var men = new (int, float, float)[]
+        {
+            (0, 25f, 5f), (1, 26f, 5f),      // cell (2, 0)
+            (0, -5f, 5f), (1, -4f, 5f),      // cell (-1, 0)
+            (0, 5f, 35f), (1, 6f, 35f),      // cell (0, 3)
+            (0, 5f, -15f), (1, 6f, -15f),    // cell (0, -2)
+        };
+        // two blows in each cell at t = 30 s, in two event orders: the lowest cell (-1, 0) wins both times
+        var a = Blows(men, (30000, "Fire", 0, 1), (30000, "Fire", 0, 1), (30000, "Fire", 2, 3), (30000, "Fire", 2, 3),
+            (30000, "Fire", 4, 5), (30000, "Fire", 4, 5), (30000, "Fire", 6, 7), (30000, "Fire", 6, 7));
+        var b = Blows(men, (30000, "Fire", 6, 7), (30000, "Fire", 4, 5), (30000, "Fire", 2, 3), (30000, "Fire", 0, 1),
+            (30000, "Fire", 6, 7), (30000, "Fire", 4, 5), (30000, "Fire", 2, 3), (30000, "Fire", 0, 1));
+        Assert.Equal(new Vector3(-4.5f, 0, 5f), Densest(a, 30f, 6f));
+        Assert.Equal(new Vector3(-4.5f, 0, 5f), Densest(b, 30f, 6f));
+        // without cell (-1, 0): the tie between (0, 3) and (0, -2) goes to the lower z, (0, -2)
+        var c = Blows(men, (30000, "Fire", 4, 5), (30000, "Fire", 4, 5), (30000, "Fire", 6, 7), (30000, "Fire", 6, 7));
+        Assert.Equal(new Vector3(5.5f, 0, -15f), Densest(c, 30f, 6f));
+        // one more blow in (2, 0) moves it there; a blow outside the window and a Damage event do not count
+        var d = Blows(men, (30000, "Fire", 0, 1), (30000, "Fire", 0, 1), (31000, "Fire", 0, 1), (30000, "Fire", 2, 3), (30000, "Fire", 2, 3),
+            (40000, "Fire", 2, 3), (40000, "Fire", 2, 3), (30000, "Damage", 3, 2), (30000, "Damage", 3, 2));
+        Assert.Equal(new Vector3(25.5f, 0, 5f), Densest(d, 30f, 6f));
+        // the same trace seen at 40 s (window 2 s): only the two later blows in (-1, 0)
+        Assert.Equal(new Vector3(-4.5f, 0, 5f), Densest(d, 40f, 2f));
+        // no blow in the window
+        Assert.Null(Densest(d, 50f, 2f));
+        Assert.Null(Densest(Blows(men), 30f, 6f));
+    }
+}
