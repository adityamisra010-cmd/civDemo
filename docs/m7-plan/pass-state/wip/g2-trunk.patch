+    /// <summary>The side (+1/-1 along the commander-to-officer cross axis s = (-d.z, 0, d.x)) of the commander's shield
+    /// arm, from his posed left shoulder (1 without a commander).</summary>
+    int ShieldSide()
+    {
+        if (_commander == null) return 1;
+        var inst = _commander.Body; inst.SolvePose();
+        var shoulder = Vector3.Transform(inst.Heads[inst.Asset.Skeleton["upperarm_l"]], inst.World);
+        var o = Outcome.Surrender ? _oPos : _cPos + new Vector3(MathF.Sin(_cYaw), 0, MathF.Cos(_cYaw)) * 3f;
+        var d = Vector3.Normalize(new Vector3(o.X - _cPos.X, 0, o.Z - _cPos.Z));
+        return Vector3.Dot(shoulder - _cPos, new Vector3(-d.Z, 0, d.X)) >= 0f ? 1 : -1;
+    }
