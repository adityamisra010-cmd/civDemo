+++ b/prototypes/m7-gfx2/scripts/measure-polish1.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""The measured figures of reports/polish1.md §1: region statistics of the canonical captures, before and after.
+
+Usage: measure-polish1.py BEFORE_DIR AFTER_DIR
+  BEFORE_DIR, AFTER_DIR: outputs of scripts/capture-scenes.sh (1920x1080; same folder and file names).
+Per region: mean RGB, HSV hue (degrees) and saturation of the mean colour, and the median luminance standard deviation
+in 24 px windows (local contrast). The river's screen edge: the mean luminance of single columns over the water (the
+bottom 11 % of the frame). Clipping: the share of pixels with any channel at 250 or more. The cut-away's horizon: the first band of 24 rows from the top whose median local
+contrast exceeds 2 levels (the sky above it is smooth), as a fraction of the frame height.
+Every frame measured here was rendered by llvmpipe (not Victus evidence); these are prototype frames, not production art.
+"""
+import colorsys
+import sys
+
+import numpy as np
+from PIL import Image
+
+BEFORE, AFTER = sys.argv[1:3]
+REGIONS = [  # name, shot, box (x0, y0, x1, y1 as fractions of the frame)
+    ("C vista golden, foreground meadow", "c/bench-c-vista-golden", (0.05, 0.80, 0.55, 0.97)),
+    ("C vista noon, foreground meadow", "c/bench-c-vista-noon", (0.05, 0.80, 0.55, 0.97)),
+    ("C vista noon, far band", "c/bench-c-vista-noon", (0.0, 0.08, 0.45, 0.25)),
+    ("C clash golden, foreground meadow", "c/bench-c-clash-golden", (0.0, 0.80, 0.4, 0.98)),
+    ("B wide noon, mid meadow", "b/bench-b-wide-noon", (0.45, 0.55, 0.95, 0.75)),
+    ("B wide noon, meadow beyond the ground cover", "b/bench-b-wide-noon", (0.85, 0.45, 0.95, 0.50)),
+    ("E vista noon, foreground meadow", "e/bench-e-vista-noon", (0.0, 0.62, 0.45, 1.0)),
+    ("E fortification, shaded front wall", "e/bench-e-fortification", (0.583, 0.611, 0.635, 0.685)),
+    ("E fortification, parapet", "e/bench-e-fortification", (0.26, 0.528, 0.333, 0.556)),
+    ("D officer, raised left palm", "d-shown/bench-d-shown-03-officer-face", (0.22, 0.01, 0.30, 0.09)),
+    ("B rain wide noon, the distance (tree line and hills)", "b-rain/bench-b-wide-noon", (0.0, 0.11, 0.65, 0.27)),
+    ("C rain clash noon, far band", "c-rain/bench-c-clash-noon", (0.0, 0.13, 0.60, 0.30)),
+]
+
+
+def luminance(rgb):
+    return 0.2126 * rgb[..., 0] + 0.7152 * rgb[..., 1] + 0.0722 * rgb[..., 2]
+
+
+def local_std(lum, k=24):
+    return [lum[y:y + k, x:x + k].std() for y in range(0, lum.shape[0] - k + 1, k) for x in range(0, lum.shape[1] - k + 1, k)]
+
+
+def load(root, shot):
+    return np.asarray(Image.open(f"{root}/{shot}.png").convert("RGB")).astype(np.float64)
+
+
+def region(root, shot, box):
+    im = load(root, shot)
+    h, w, _ = im.shape
+    x0, y0, x1, y1 = box
+    r = im[int(y0 * h):int(y1 * h), int(x0 * w):int(x1 * w)]
+    m = r.reshape(-1, 3).mean(0)
+    hue, sat, _ = colorsys.rgb_to_hsv(*(m / 255))
+    return f"RGB {tuple(int(round(v)) for v in m)} hue {hue * 360:.0f} sat {sat:.2f} std {np.median(local_std(luminance(r))):.1f}"
+
+
+def river_edge(root):
+    lum = luminance(load(root, "e/bench-e-river"))
+    h, w = lum.shape
+    y0 = int(h * 0.89)
+    return {x: round(float(lum[y0:, x].mean()), 1) for x in (0, 2, 8, w - 9, w - 3, w - 1)}
+
+
+def horizon(root, shot):
+    lum = luminance(load(root, shot))
+    h = lum.shape[0]
+    k = 24
+    for y in range(0, h - k + 1, k):
+        band = lum[y:y + k]
+        if np.median([band[:, x:x + k].std() for x in range(0, band.shape[1] - k + 1, k)]) > 2.0:
+            return y / h
+    return 1.0
+
+
+def clipped(root, shot):
+    im = load(root, shot)
+    return float((im.max(axis=2) >= 250).mean())
+
+
+for name, shot, box in REGIONS:
