+#!/usr/bin/env python3
+"""Review sheets of the polish1 stage: BEFORE (the canonical scenes captures of G2 at the start of the stage) against
+AFTER (the same shots captured on the polish1 build), one sheet per critic issue (full size, for the scratchpad), and two
+small review JPEGs for reports/captures/polish1 (the committed G2 budget is already used up: they are kept tiny).
+
+Usage: review-sheets-polish1.py BEFORE_DIR AFTER_DIR SHEETS_DIR REVIEW_DIR
+  BEFORE_DIR, AFTER_DIR: outputs of scripts/capture-scenes.sh (same folder and file names).
+Every legend says: llvmpipe, not Victus evidence. Placeholder graphics: these are prototype frames, not production art.
+"""
+import os
+import sys
+from PIL import Image, ImageDraw
+
+BEFORE, AFTER, SHEETS, REVIEW = sys.argv[1:5]
+LLVM = "llvmpipe, not Victus evidence; prototype graphics"
+
+
+def path(root, folder, name):
+    return os.path.join(root, folder, name + ".png")
+
+
+def load(p, size, crop=None):
+    if p is None or not os.path.exists(p):
+        im = Image.new("RGB", size, (40, 40, 40))
+        ImageDraw.Draw(im).text((8, 24), "missing: " + (os.path.basename(p) if p else "-"), fill=(220, 220, 220))
+        return im
+    im = Image.open(p).convert("RGB")
+    if crop:
+        w, h = im.size
+        x0, y0, x1, y1 = crop
+        im = im.crop((int(x0 * w), int(y0 * h), int(x1 * w), int(y1 * h)))
+    return im.resize(size, Image.LANCZOS)
+
+
+def label(draw, xy, text, w):
+    x, y = xy
+    draw.rectangle([x, y, x + min(w, len(text) * 6 + 6), y + 13], fill=(0, 0, 0))
+    draw.text((x + 3, y + 1), text, fill=(235, 235, 235))
+
+
+def sheet(title, rows, out, cell=(800, 450), quality=86):
+    """rows: list of (folder, shot, crop or None, caption)."""
+    w, h = cell
+    head = 34
+    img = Image.new("RGB", (2 * w + 6, head + len(rows) * (h + 4)), (16, 16, 16))
+    d = ImageDraw.Draw(img)
+    d.text((6, 4), title, fill=(255, 255, 255))
+    d.text((6, 18), "BEFORE (left: G2 at the start of polish1) vs AFTER (right: polish1); " + LLVM, fill=(200, 200, 200))
+    for i, (folder, shot, crop, cap) in enumerate(rows):
+        y = head + i * (h + 4)
+        img.paste(load(path(BEFORE, folder, shot), cell, crop), (0, y))
+        img.paste(load(path(AFTER, folder, shot), cell, crop), (w + 6, y))
+        label(d, (0, y), f"before: {shot}{' (crop)' if crop else ''}", w)
+        label(d, (w + 6, y), f"after: {cap}", w)
+    img.save(out, quality=quality, optimize=True)
+    print(out)
+
+
+FACE = (0.25, 0.0, 0.75, 0.62)
+issues = [
+    ("01-meadow", "Rank 1: meadow terrain (tones, dry patches, meso relief, cover fade, golden-hour sheen and haze)", [
+        ("c", "bench-c-vista-golden", None, "vista golden"), ("b", "bench-b-wide-noon", None, "wide noon"),
+        ("e", "bench-e-vista-noon", None, "vista noon"), ("c", "bench-c-clash-golden", None, "clash golden")]),
+    ("02-acne", "Rank 2: cascade shadow acne (receiver-plane depth bias)", [
+        ("c", "bench-c-rout", None, "rout"), ("c", "bench-c-vista-golden", (0.0, 0.35, 0.5, 0.75), "vista golden"),
+        ("d-shown", "bench-d-shown-00-field", None, "field")]),
+    ("03-crowds", "Rank 3: crowd variation (idle pose variants, gaze levelled, hoplite guard variants)", [
+        ("b", "bench-b-front", None, "front"), ("a", "bench-a-line", None, "line"), ("b", "bench-b-between", None, "between")]),
+    ("04-faces", "Rank 4: faces (skin wrap clamp, sky fill desaturated on skin, catchlights, sclera, backlit hair)", [
+        ("a", "bench-a-commander-grim", FACE, "commander grim"), ("a", "bench-a-commander-battlecry", FACE, "commander battlecry"),
+        ("d-shown", "bench-d-shown-03-officer-face", None, "officer"), ("a", "bench-a-soldier-face", FACE, "soldier face")]),
+    ("05-hero-beats", "Rank 5: hero beats (sight-line crowd hiding, victory shield lowered, fallen laid out)", [
+        ("d-shown", "bench-d-shown-02-surrender", None, "surrender"), ("d-shown", "bench-d-shown-03-officer-face", None, "officer"),
+        ("d-shown", "bench-d-shown-04-commander-face", None, "commander"), ("d-shown", "bench-d-shown-06-fallen", None, "fallen")]),
+    ("06-light", "Rank 6: fill light (warm ground bounce, subject metering, neutral shoulder, kit EV, backlit hair)", [
+        ("e", "bench-e-fortification", None, "fortification"), ("c", "bench-c-melee-low", None, "melee low"),
+        ("a", "bench-a-two-shot-golden", None, "two-shot golden"), ("a", "bench-a-kit", None, "kit")]),
+    ("07-far-land", "Rank 7: land beyond the map (hills, fields, woods and clearings; noon valley fog thinned)", [
+        ("c", "bench-c-vista-noon", None, "vista noon"), ("e", "bench-e-vista-high", None, "vista high"),
+        ("d-shown", "bench-d-shown-05-standards", None, "standards"), ("e", "bench-e-fortification", None, "fortification")]),
+    ("08-banners", "Rank 8: standards (vertex-stage cloth flutter with normal ripple)", [
+        ("a", "bench-a-line", (0.0, 0.1, 0.4, 0.6), "line"), ("b", "bench-b-standard", None, "standard"),
+        ("d-shown", "bench-d-shown-05-standards", None, "standards"), ("d-shown", "bench-d-shown-04-commander-face", None, "commander")]),
+    ("09-smoke", "Rank 9: aftermath smoke and the cut-away framing", [
+        ("d-shown", "bench-d-shown-00-field", None, "field"), ("d-shown", "bench-d-shown-01-prisoners", None, "prisoners"),
+        ("d-cutaway", "bench-d-cutaway-06-cutaway", None, "cut-away (reframed)")]),
+    ("10-settlements", "Rank 10: settlements, fortification and river (wall-base grime, hut variety, water screen edge)", [
+        ("e", "bench-e-fortification", (0.1, 0.35, 0.9, 0.8), "fortification"), ("e", "bench-e-settlement", None, "settlement"),
+        ("e", "bench-e-river", None, "river")]),
+    ("11-rain", "Rank 11: rain (longer, brighter streaks; wet grass sheen; smaller flower cards)", [
+        ("b-rain", "bench-b-front", None, "front, rain"), ("b-rain", "bench-b-wide-noon", None, "wide noon, rain"),
+        ("e-rain", "bench-e-settlement", None, "settlement, rain")]),
+]
+os.makedirs(SHEETS, exist_ok=True)
+os.makedirs(REVIEW, exist_ok=True)
+for key, title, rows in issues:
+    sheet(title, rows, os.path.join(SHEETS, f"polish1-{key}.jpg"))
+
+
+def small(rows, cell, title, out, quality):
+    """rows: list of (folder, shot, crop, caption); two columns: before | after."""
+    cw, ch = cell
+    img = Image.new("RGB", (2 * (cw + 2), 26 + len(rows) * (ch + 2)), (16, 16, 16))
+    d = ImageDraw.Draw(img)
+    d.text((4, 2), title, fill=(255, 255, 255))
+    d.text((4, 13), "before (left) vs after (right); " + LLVM, fill=(200, 200, 200))
+    for i, (folder, shot, crop, cap) in enumerate(rows):
+        y = 26 + i * (ch + 2)
+        for j, root in enumerate([BEFORE, AFTER]):
+            x = j * (cw + 2)
+            img.paste(load(path(root, folder, shot), cell, crop), (x, y))
+            lab = ("before " if j == 0 else "after ") + cap
+            d.rectangle([x, y, x + len(lab) * 6 + 4, y + 11], fill=(0, 0, 0))
+            d.text((x + 2, y), lab, fill=(235, 235, 235))
+    img.save(out, quality=quality, optimize=True)
+    print(out, os.path.getsize(out))
+
+
+small([("c", "bench-c-vista-golden", None, "C vista golden"), ("b", "bench-b-wide-noon", None, "B wide noon"),
+       ("c", "bench-c-vista-noon", None, "C vista noon"), ("e", "bench-e-fortification", None, "E fortification"),
+       ("d-cutaway", "bench-d-cutaway-06-cutaway", None, "D cut-away")],
+      (288, 162), "polish1: land, light and framing", os.path.join(REVIEW, "polish1-01-before-after.jpg"), 50)
+small([("a", "bench-a-commander-grim", FACE, "A commander"), ("d-shown", "bench-d-shown-03-officer-face", None, "D officer"),
+       ("d-shown", "bench-d-shown-02-surrender", None, "D surrender"), ("a", "bench-a-two-shot-golden", None, "A two-shot golden")],
+      (288, 162), "polish1: faces and hero beats", os.path.join(REVIEW, "polish1-02-faces-hero.jpg"), 50)
