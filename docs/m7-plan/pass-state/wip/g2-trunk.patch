+    /// <summary>The close beats' sight line: a soldier between the camera and the subject, or within the radius of the
+    /// line (spear reach), is in the way; one behind the camera, at or past the subject, or beyond the radius is not.</summary>
+    [Fact]
+    public void SightLineHidesOnlySoldiersBetweenTheCameraAndTheSubject()
+    {
+        var sl = (Eye: new Vector3(0, 1.6f, 0), Subject: new Vector3(0, 1.1f, 10f), Radius: 1.5f);
+        bool In(float x, float z) => Gfx.Demo.Scenes.Bench.TraceCrowd.InSightLine(sl, new Vector3(x, 0, z));
+        Assert.True(In(0f, 5f));        // on the line
+        Assert.True(In(1.2f, 3f));      // beside it, within spear reach
+        Assert.False(In(2.0f, 5f));     // beyond the radius
+        Assert.False(In(0f, -1f));      // behind the camera
+        Assert.False(In(0f, 9.6f));     // at the subject (the pair, the officer's guards)
+        Assert.False(In(0f, 14f));      // past the subject
+    }
