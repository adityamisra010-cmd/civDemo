@@ -0,0 +1,154 @@
+using Gfx.Chars.Animation;
+using Gfx.Chars.Format;
+using Microsoft.Xna.Framework;
+
+namespace Gfx.Chars.Crowd;
+
+/// <summary>
+/// One pose variant of a crowd idle (polish1, critic rank 3; PRESENTATION ONLY): constant world-space offsets laid over
+/// every frame of the clip, so the clip's own motion (breathing, weight shifts) is kept. Angles in degrees.
+/// <list type="bullet">
+/// <item><c>HeadPitch</c>: the head's mean gaze elevation over the clip after the offset (the CMU retargets bow the head
+/// by a fixed amount: every soldier stared at the ground).</item>
+/// <item><c>HeadYaw</c>: a turn of neck and head about the vertical.</item>
+/// <item><c>SpineTwist</c>, <c>SpineLean</c>: the trunk turned about the vertical and leaned forward (+) at spine_02.</item>
+/// <item><c>ArmYaw</c>, <c>ArmPitch</c>: the weapon (right) arm swung about the vertical and raised (+) at the shoulder:
+/// the held spear or sword changes its angle with it.</item>
+/// <item><c>ShieldYaw</c>: the shield (left) arm swung about the vertical.</item>
+/// </list>
+/// </summary>
+public readonly record struct PoseVariant(float HeadPitch, float HeadYaw, float SpineTwist, float SpineLean, float ArmYaw, float ArmPitch, float ShieldYaw);
+
+/// <summary>
+/// The crowd's idle pose variants and their derivation from a clip (polish1; PRESENTATION ONLY). Each variant is a new
+/// clip of the same length baked into <see cref="CrowdAnimationBank"/>: per frame, forward kinematics of the source
+/// frame, then world-space rotations at spine_02, neck_01 and head (half each), upperarm_r and upperarm_l, each folded
+/// back into the bone's local rotation (<c>local' = g_parent⁻¹ · R · g_parent · local</c>), so every child follows.
+/// Deterministic: a pure function of the skeleton, the clip and the variant.
+/// </summary>
+public static class CrowdPoseVariants
+{
+    /// <summary>Variant 0 only levels the gaze; 1-3 add a head turn, trunk twist and lean, and weapon/shield arm swings.</summary>
+    public static readonly PoseVariant[] Idle =
+    {
+        new(-2f, 0f, 0f, 0f, 0f, 0f, 0f),
+        new(1f, 11f, 3.5f, -1.5f, 9f, -11f, 4f),
+        new(-5f, -9f, -3f, 2f, -8f, 13f, -5f),
+        new(0f, 5f, 2f, 3f, 12f, 6f, 2.5f),
+    };
+
+    public static readonly string[] BaseClips = { "idle", "idle_proud" };
+
+    /// <summary>Clip names: "idle@0" … "idle@3", "idle_proud@0" … "idle_proud@3".</summary>
+    public static readonly string[] Names = BaseClips.SelectMany(b => Enumerable.Range(0, Idle.Length).Select(k => b + "@" + k)).ToArray();
+
+    /// <summary>The base clip and the variant of a variant clip name.</summary>
+    public static (string baseClip, PoseVariant variant) Parse(string name)
+    {
+        int at = name.LastIndexOf('@');
+        if (at <= 0) throw new ArgumentException($"not a variant clip name: {name}");
+        int k = int.Parse(name.AsSpan(at + 1), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture);
+        return (name[..at], Idle[k]);
+    }
+
+    /// <summary>The face's forward direction in bind space: horizontal, from the head joint to the eyes (+Z without eyes).</summary>
+    public static Vector3 FaceForward(Skeleton s)
+    {
+        if (s.TryIndex("eye_l", out int el) && s.TryIndex("eye_r", out int er) && s.TryIndex("head", out int h))
+        {
+            var d = 0.5f * (s.Head[el] + s.Head[er]) - s.Head[h];
+            d.Y = 0;
+            if (d.LengthSquared() > 1e-8f) return Vector3.Normalize(d);
+        }
+        return Vector3.UnitZ;
+    }
+
+    /// <summary>Mean elevation (degrees) of the face's forward direction over the clip's frames.</summary>
+    public static float MeanHeadPitch(Skeleton s, ClipDef clip)
+    {
+        var pose = new Pose(s.Count); var g = new Quaternion[s.Count]; var hd = new Vector3[s.Count];
+        int head = s["head"], pelvis = s.TryIndex("pelvis", out int pv) ? pv : -1;
+        var face = FaceForward(s);
+        double sum = 0;
+        for (int f = 0; f < clip.Frames; f++)
+        {
+            Load(s, clip, f, pose);
+            Fk.Solve(s, pose, g, hd, pelvis);
+            var fw = Q.Rotate(g[head], face);
+            sum += MathHelper.ToDegrees(MathF.Asin(Math.Clamp(fw.Y, -1f, 1f)));
+        }
+        return (float)(sum / Math.Max(1, clip.Frames));
+    }
+
+    static void Load(Skeleton s, ClipDef clip, int f, Pose pose)
+    {
+        pose.Reset();
+        int nb = Math.Min(clip.Bones, s.Count);
+        for (int b = 0; b < nb; b++) pose.Local[b] = clip.Rotations[f * clip.Bones + b];
+        pose.Pelvis = clip.Pelvis[f];
+    }
+
+    /// <summary>Rotates bone <paramref name="b"/> (and so its subtree) by the world rotation <paramref name="r"/> about its joint.</summary>
+    static void Turn(Skeleton s, Pose pose, Quaternion[] g, int b, Quaternion r)
+    {
+        int par = s.Parent[b];
+        var gp = par >= 0 ? g[par] : Quaternion.Identity;
+        pose.Local[b] = Quaternion.Normalize(Q.Mul(Q.Mul(Q.Inverse(gp), Q.Mul(r, gp)), pose.Local[b]));
+    }
+
+    static Quaternion About(Vector3 axis, float degrees) => Quaternion.CreateFromAxisAngle(Vector3.Normalize(axis), MathHelper.ToRadians(degrees));
+
+    /// <summary>The variant of <paramref name="clip"/> (same length, frame rate, loop flag and pelvis track).</summary>
+    public static ClipDef Derive(Skeleton s, ClipDef clip, string name, PoseVariant v)
+    {
+        int n = s.Count;
+        var pose = new Pose(n); var g = new Quaternion[n]; var hd = new Vector3[n];
+        int pelvis = s.TryIndex("pelvis", out int pv) ? pv : -1;
+        int spine = s["spine_02"], neck = s["neck_01"], head = s["head"], armR = s["upperarm_r"], armL = s["upperarm_l"];
+        var face = FaceForward(s);
+        var trunk = Q.Mul(About(Vector3.UnitY, v.SpineTwist), About(Vector3.UnitX, v.SpineLean));
+        bool turnTrunk = v.SpineTwist != 0 || v.SpineLean != 0;
+        // the gaze correction is measured after the trunk offset (a forward lean lowers the head with it)
+        double pitchSum = 0;
+        for (int f = 0; f < clip.Frames; f++)
+        {
+            Load(s, clip, f, pose);
+            Fk.Solve(s, pose, g, hd, pelvis);
+            if (turnTrunk) { Turn(s, pose, g, spine, trunk); Fk.Solve(s, pose, g, hd, pelvis); }
+            pitchSum += MathHelper.ToDegrees(MathF.Asin(Math.Clamp(Q.Rotate(g[head], face).Y, -1f, 1f)));
+        }
+        float pitchFix = v.HeadPitch - (float)(pitchSum / Math.Max(1, clip.Frames));
+        var rot = new Quaternion[clip.Frames * n];
+        for (int f = 0; f < clip.Frames; f++)
+        {
+            Load(s, clip, f, pose);
+            Fk.Solve(s, pose, g, hd, pelvis);
+            // trunk: twist about the vertical, lean about the body's lateral axis (the character faces +Z)
+            if (turnTrunk)
+            {
+                Turn(s, pose, g, spine, trunk);
+                Fk.Solve(s, pose, g, hd, pelvis);
+            }
+            // gaze: pitch about the face's own lateral axis this frame, yaw about the vertical; half at the neck, half at the head
+            var fw = Q.Rotate(g[head], face);
+            var fh = new Vector3(fw.X, 0, fw.Z);
+            fh = fh.LengthSquared() > 1e-8f ? Vector3.Normalize(fh) : Vector3.UnitZ;
+            var gaze = Q.Mul(About(Vector3.UnitY, v.HeadYaw), About(Vector3.Cross(fh, Vector3.UnitY), pitchFix));
+            var halfGaze = Q.Scale(gaze, 0.5f);
+            Turn(s, pose, g, neck, halfGaze);
+            Fk.Solve(s, pose, g, hd, pelvis);
+            Turn(s, pose, g, head, halfGaze);
+            Fk.Solve(s, pose, g, hd, pelvis);
+            // the weapon arm and the shield arm
+            if (v.ArmYaw != 0 || v.ArmPitch != 0) Turn(s, pose, g, armR, Q.Mul(About(Vector3.UnitY, v.ArmYaw), About(Vector3.UnitX, -v.ArmPitch)));
+            if (v.ShieldYaw != 0) Turn(s, pose, g, armL, About(Vector3.UnitY, v.ShieldYaw));
+            Array.Copy(pose.Local, 0, rot, f * n, n);
+        }
+        return new ClipDef
+        {
+            Name = name, Loop = clip.Loop, Fps = clip.Fps, Frames = clip.Frames, Bones = n, Speed = clip.Speed,
+            Rotations = rot, Pelvis = (Vector3[])clip.Pelvis.Clone(), Contacts = (byte[])clip.Contacts.Clone(),
+            Source = clip.Source + " (polish1 pose variant)",
+        };
+    }
+}
