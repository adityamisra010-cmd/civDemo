@@ -0,0 +1,486 @@
+using System.Globalization;
+using System.Text.Json;
+using Gfx.Chars.Crowd;
+using Gfx.Chars.Rendering;
+using Gfx.Engine.Rendering;
+using Gfx.Units;
+using Microsoft.Xna.Framework;
+
+namespace Gfx.Demo.Scenes.Bench;
+
+/// <summary>Where a trace-driven soldier stands in its battle (presentation reading of the trace state).</summary>
+public enum TraceSoldierState { Active, Routing, Surrendered, Dead, Escaped }
+
+/// <summary>
+/// The battle trace of benchmark scenes C and D (stage scenes): the exported TacticalResolver run
+/// ($G2_ASSETS/baked/trace/battle-2100.g2bt, scripts/export-battle-trace.sh) with its header (battle-grid frame, result).
+/// READ ONLY: nothing here writes the trace; <see cref="BattleTrace.Hash"/> proves it.
+/// </summary>
+public sealed class BenchBattle
+{
+    public const string FileName = "battle-2100.g2bt";
+    public BattleTrace Trace { get; }
+    /// <summary>The battle-grid origin in the presentation's world (world x = (x_mm − Origin.X) / 1000, z likewise).</summary>
+    public Vector2 OriginMm { get; }
+    public string Reason { get; }
+    /// <summary>The side left holding the field (−1 none) and the eliminated side (−1 none), from the resolver's result.</summary>
+    public int HoldsField { get; }
+    public int EliminatedSide { get; }
+    public long EndMs { get; }
+    public float Duration => (Trace.StepTimeMs(Trace.StepCount - 1) - Trace.StepTimeMs(0)) / 1000f;
+
+    BenchBattle(BattleTrace t)
+    {
+        Trace = t;
+        if (t.FrameJson.Length == 0 || t.ResultJson.Length == 0) throw new InvalidDataException("the trace has no frame/result header (not a stage-scenes export)");
+        using (var f = JsonDocument.Parse(t.FrameJson))
+        {
+            var o = f.RootElement.GetProperty("originMm");
+            OriginMm = new Vector2(o[0].GetInt64(), o[1].GetInt64());
+        }
+        using var r = JsonDocument.Parse(t.ResultJson);
+        Reason = r.RootElement.GetProperty("reason").GetString() ?? "";
+        HoldsField = r.RootElement.GetProperty("holdsField").GetInt32();
+        EliminatedSide = r.RootElement.GetProperty("side").GetInt32();
+        EndMs = r.RootElement.GetProperty("endMs").GetInt64();
+    }
+
+    public static string DefaultPath => Gfx.Engine.Assets.AssetRoot.Baked("trace/" + FileName);
+
+    public static BenchBattle Load(string? path = null)
+    {
+        path ??= DefaultPath;
+        if (!File.Exists(path)) throw new FileNotFoundException($"battle trace missing: {path} (run scripts/export-battle-trace.sh)");
+        return new BenchBattle(BattleTrace.Load(path));
+    }
+
+    public Vector3 World(long xMm, long yMm) => new((xMm - OriginMm.X) / 1000f, 0, (yMm - OriginMm.Y) / 1000f);
+
+    /// <summary>Entity <paramref name="e"/>'s position at the last snapshot on the ground plane (y = 0).</summary>
+    public Vector3 FinalPosition(int e) { var (x, y) = Trace.PosMm(Trace.StepCount - 1, e); return World(x, y); }
+
+    /// <summary>Loads a trace from a file (tests and tools).</summary>
+    public static BenchBattle FromTrace(BattleTrace t) => new(t);
+
+    public static TraceSoldierState Map(TraceState s) => s switch
+    {
+        TraceState.Active => TraceSoldierState.Active, TraceState.Routing => TraceSoldierState.Routing,
+        TraceState.Surrendered => TraceSoldierState.Surrendered, TraceState.Dead => TraceSoldierState.Dead,
+        _ => TraceSoldierState.Escaped,
+    };
+
+    /// <summary>Counts per side and state at a step (for reports and tests).</summary>
+    public int[,] Counts(int step)
+    {
+        var c = new int[2, 5];
+        for (int e = 0; e < Trace.Entities.Count; e++) c[Trace.Entities[e].Side, (int)Map(Trace.State(step, e))]++;
+        return c;
+    }
+}
+
+/// <summary>
+/// Trace-driven crowd (stage scenes; PRESENTATION ONLY, DR42): every entity of the battle trace is one instanced
+/// stage-chars soldier. What the trace decides, the soldier shows: its position (linear between the 2 s snapshots; never
+/// moved by anything else), its state (Escaped soldiers are gone, the Dead lie where they fell, the Surrendered kneel,
+/// Routing soldiers run) and its blows (a melee Fire event plays a thrust or a cut towards its target within that step;
+/// a Damage event plays a stumble). What the trace does not decide is cosmetic and labelled so: the facing between
+/// events (from the move, else held), which idle or guard the others play, the kit of each formation (four kits per
+/// force mapped from the formation's index) and every look (from the entity id). Nothing here writes the trace.
+/// </summary>
+public sealed class TraceCrowd : IDisposable
+{
+    public BenchBattle Battle { get; }
+    public CrowdRenderer Crowd { get; }
+    readonly CharStage _loader;
+    readonly Func<float, float, float> _height;
+    readonly CrowdAgent[] _agents;
+    readonly int[] _variant;          // per entity
+    readonly bool[] _sword;           // per entity: a sword kit (cuts) rather than a spear (thrusts)
+    readonly CrowdLook[] _look;
+    readonly float[][] _yaw;          // [step][entity]
+    readonly long[] _deathMs, _surrenderMs;
+    /// <summary>Polish1 (critic rank 5f): each fallen soldier's facing and fall (back or forward), laid out once so the
+    /// bodies do not cross (NaN: the soldier does not die).</summary>
+    readonly float[] _deadYaw;
+    readonly bool[] _deadBack;
+    readonly int[][] _events;         // per entity: indices of Fire events it made and Damage events it took (time order)
+    readonly float[] _phase;
+    readonly int _idle, _idle2, _walk, _jog, _run, _thrust, _swingOver, _swingSide, _block, _kneel, _cower, _death, _death2, _stumble;
+    // polish1: the idles' pose variants (heads up; head, trunk and arm offsets), picked per entity
+    readonly int[] _idleV, _idle2V;
+    /// <summary>Death content (presentation setting): when false, the dead are not drawn at all.</summary>
+    public bool ShowDead { get; set; } = true;
+    /// <summary>Entities drawn by a hero character instead of the crowd (their crowd agent is hidden).</summary>
+    public HashSet<int> HeroEntities { get; } = new();
+
+    /// <summary>
+    /// Polish1 (critic rank 5d; PRESENTATION ONLY): a close shot's sight line, camera to subject. Crowd soldiers whose body
+    /// stands within <c>Radius</c> of it (spear reach included), between the camera and the subject, are not drawn: the
+    /// camera solver counts bodies, so spears and shields of the soldiers beside the line still crossed the hero frame.
+    /// Null: every soldier is drawn.
+    /// </summary>
+    public (Vector3 Eye, Vector3 Subject, float Radius)? SightLine { get; set; }
+
+    /// <summary>Whether a soldier standing at <paramref name="p"/> (feet) is in the sight line's way.</summary>
+    public static bool InSightLine((Vector3 Eye, Vector3 Subject, float Radius) sl, Vector3 p)
+    {
+        var c = p + new Vector3(0f, 1.1f, 0f);
+        var d = sl.Subject - sl.Eye;
+        float len2 = d.LengthSquared();
+        if (len2 < 1e-4f) return false;
+        float s = Vector3.Dot(c - sl.Eye, d) / len2;
+        if (s <= 0f || s >= 0.92f) return false;
+        return Vector3.DistanceSquared(c, sl.Eye + d * s) < sl.Radius * sl.Radius;
+    }
+    public int Count => _agents.Length;
+    /// <summary>Counts of the last <see cref="Update"/> per presentation state (diagnostics, tests).</summary>
+    public int[] LastStates { get; } = new int[5];
+
+    public const float HitSeconds = 0.6f, RunSpeed = 2.2f, JogSpeed = 1.2f, WalkSpeed = 0.15f;
+
+    public TraceCrowd(Microsoft.Xna.Framework.Graphics.GraphicsDevice gd, BenchBattle battle, Func<float, float, float> height)
+    {
+        Battle = battle; _height = height;
+        _loader = new CharStage(gd);
+        Crowd = new CrowdRenderer(gd, _loader, Gfx.Demo.Scenes.CrowdCast.Variants);
+        var tr = battle.Trace;
+        int n = tr.Entities.Count, steps = tr.StepCount;
+        _agents = new CrowdAgent[n];
+        _variant = new int[n]; _sword = new bool[n]; _look = new CrowdLook[n]; _phase = new float[n];
+        _deathMs = new long[n]; _surrenderMs = new long[n];
+        // kit per formation: the formation's index within its side; every third formation carries swords (surcoats)
+        var formIndex = new Dictionary<long, int>();
+        var perSide = new int[2];
+        foreach (var f in tr.Formations) formIndex[f.Id] = perSide[f.Side]++;
+        int[][] spears = { new[] { 0, 1, 3, 0, 3 }, new[] { 4, 5, 7, 4, 7 } };
+        int[][] swords = { new[] { 2, 2, 1 }, new[] { 6, 6, 5 } };
+        for (int e = 0; e < n; e++)
+        {
+            var ent = tr.Entities[e];
+            uint key = CrowdLook.Hash((uint)ent.Id * 2654435761u + 0x51EDu);
+            bool sw = formIndex[ent.Formation] % 3 == 2;
+            var kits = sw ? swords[ent.Side] : spears[ent.Side];
+            _variant[e] = kits[(int)(CrowdLook.Hash(key ^ 0x1234567u) % (uint)kits.Length)];
+            _sword[e] = sw;
+            _look[e] = CrowdLook.FromKey(key);
+            _phase[e] = (CrowdLook.Hash(key ^ 0x2545F491u) >> 8) * (1f / 16777216f);
+            _deathMs[e] = long.MinValue; _surrenderMs[e] = long.MinValue;
+        }
+        // facing per step (see FacingPerStep); the first step of death and of surrender
+        _yaw = FacingPerStep(tr);
+        for (int s = 0; s < steps; s++)
+            for (int e = 0; e < n; e++)
+            {
+                var st = tr.State(s, e);
+                if (st == TraceState.Dead && _deathMs[e] == long.MinValue) _deathMs[e] = tr.StepTimeMs(s);
+                if (st == TraceState.Surrendered && _surrenderMs[e] == long.MinValue) _surrenderMs[e] = tr.StepTimeMs(s) - tr.StepMs / 2;
+            }
+        // events per entity (Fire as source, Damage as target); a death is timed by the last blow that landed before it
+        var lists = new List<int>[n];
+        for (int i = 0; i < n; i++) lists[i] = new List<int>();
+        for (int k = 0; k < tr.Events.Count; k++)
+        {
+            var ev = tr.Events[k];
+            int who = tr.IndexOf(ev.Kind == TraceEventKind.Fire ? ev.Source : ev.Target);
+            if (who >= 0) lists[who].Add(k);
+        }
+        _events = lists.Select(l => l.ToArray()).ToArray();
+        for (int e = 0; e < n; e++)
+        {
+            if (_deathMs[e] == long.MinValue) continue;
+            long last = long.MinValue;
+            foreach (int k in _events[e])
+            {
+                var ev = tr.Events[k];
+                if (ev.Kind == TraceEventKind.Damage && ev.TimeMs <= _deathMs[e]) last = ev.TimeMs;
+            }
+            if (last != long.MinValue) _deathMs[e] = last;
+        }
+        (_deadYaw, _deadBack) = LayOutFallen(tr, _deathMs, _yaw);
+        _idle = CrowdRenderer.Clip("idle"); _idle2 = CrowdRenderer.Clip("idle_proud"); _walk = CrowdRenderer.Clip("walk");
+        _jog = CrowdRenderer.Clip("jog"); _run = CrowdRenderer.Clip("run"); _thrust = CrowdRenderer.Clip("thrust");
+        _swingOver = CrowdRenderer.Clip("swing_over"); _swingSide = CrowdRenderer.Clip("swing_side"); _block = CrowdRenderer.Clip("block");
+        _kneel = CrowdRenderer.Clip("kneel"); _cower = CrowdRenderer.Clip("cower"); _death = CrowdRenderer.Clip("death_fwd");
+        _death2 = CrowdRenderer.Clip("death_back"); _stumble = CrowdRenderer.Clip("stumble");
+        _idleV = Enumerable.Range(0, 4).Select(k => CrowdRenderer.Clip("idle@" + k)).ToArray();
+        _idle2V = Enumerable.Range(0, 4).Select(k => CrowdRenderer.Clip("idle_proud@" + k)).ToArray();
+    }
+
+    /// <summary>Scene time (s, 0 = the first snapshot) of the trace's milliseconds.</summary>
+    public float SceneTime(long ms) => (ms - Battle.Trace.StepTimeMs(0)) / 1000f;
+
+    /// <summary>
+    /// Each soldier's facing (yaw, radians) per trace step: from the displacement when the soldier moved more than 40 mm
+    /// since the previous step, else held; at the start towards the other side's centroid. A pure function of the trace.
+    /// </summary>
+    public static float[][] FacingPerStep(Gfx.Units.BattleTrace tr)
+    {
+        int n = tr.Entities.Count, steps = tr.StepCount;
+        var c0 = new Vector2[2]; var nc = new int[2];
+        for (int e = 0; e < n; e++) { var (x, y) = tr.PosMm(0, e); c0[tr.Entities[e].Side] += new Vector2(x, y); nc[tr.Entities[e].Side]++; }
+        for (int s = 0; s < 2; s++) c0[s] /= Math.Max(1, nc[s]);
+        var yaw = new float[steps][];
+        for (int s = 0; s < steps; s++)
+        {
+            yaw[s] = new float[n];
+            for (int e = 0; e < n; e++)
+            {
+                int side = tr.Entities[e].Side;
+                float prev;
+                if (s == 0) { var d = c0[1 - side] - c0[side]; prev = MathF.Atan2(d.X, d.Y); }
+                else
+                {
+                    prev = yaw[s - 1][e];
+                    var (x0, y0) = tr.PosMm(s - 1, e); var (x1, y1) = tr.PosMm(s, e);
+                    long dx = x1 - x0, dy = y1 - y0;
+                    if (dx * dx + dy * dy > 40L * 40L) prev = MathF.Atan2(dx, dy);
+                }
+                yaw[s][e] = prev;
+            }
+        }
+        return yaw;
+    }
+
+    /// <summary>Length (m) of a fallen body along its fall, from where the soldier stood.</summary>
+    public const float FallenLength = 1.7f;
+    /// <summary>Closest a fallen body may lie to another (m, between their centre lines) before the layout turns it.</summary>
+    public const float FallenClearance = 0.45f;
+
+    /// <summary>
+    /// Polish1 (critic rank 5f; PRESENTATION ONLY): the fallen pile interpenetrated (each death clip fell along the
+    /// soldier's last facing, a hash picking forward or back). In the order of death (time, then entity), each fallen
+    /// soldier takes the first of: the hashed fall at his facing, the other fall, then both falls turned 30, 60 and
+    /// 90 degrees either way, whose body (a segment <see cref="FallenLength"/> long from where he stood) keeps
+    /// <see cref="FallenClearance"/> from every body already down; with none clear, the one farthest from them. A pure
+    /// function of the trace: the same layout in every still, replay and benchmark frame.
+    /// </summary>
+    public static (float[] yaw, bool[] back) LayOutFallen(Gfx.Units.BattleTrace tr, long[] deathMs, float[][] yawPerStep)
+    {
+        int n = tr.Entities.Count, last = tr.StepCount - 1;
+        var yaw = new float[n]; var back = new bool[n];
+        Array.Fill(yaw, float.NaN);
+        var order = Enumerable.Range(0, n).Where(e => deathMs[e] != long.MinValue).OrderBy(e => deathMs[e]).ThenBy(e => e).ToArray();
+        var placedA = new List<Vector2>(order.Length); var placedB = new List<Vector2>(order.Length);
+        float[] turns = { 0f, 30f, -30f, 60f, -60f, 90f, -90f };
+        foreach (int e in order)
+        {
+            var (x, y) = tr.PosMm(last, e);
+            var p = new Vector2(x / 1000f, y / 1000f);
+            // the facing at death: the step of the death (the last facing he had)
+            int sd = last;
+            for (int s = 0; s <= last; s++) if (BenchBattle.Map(tr.State(s, e)) == TraceSoldierState.Dead) { sd = s; break; }
+            float y0 = yawPerStep[sd][e];
+            bool b0 = (CrowdLook.Hash((uint)e ^ 0xDEADu) & 1u) != 0;
+            float bestYaw = y0; bool bestBack = b0; float bestClear = -1f;
+            foreach (float turn in turns)
+            {
+                foreach (bool bk in new[] { b0, !b0 })
+                {
+                    float cy = y0 + MathHelper.ToRadians(turn);
+                    var dir = new Vector2(MathF.Sin(cy), MathF.Cos(cy)) * (bk ? -1f : 1f);
+                    var a0 = p; var a1 = p + dir * FallenLength;
+                    float clear = float.MaxValue;
+                    for (int k = 0; k < placedA.Count; k++)
+                    {
+                        // cheap reject: bodies whose start is farther than two lengths cannot touch
+                        if (Vector2.DistanceSquared(placedA[k], p) > 4f * FallenLength * FallenLength) continue;
+                        clear = MathF.Min(clear, SegmentDistance(a0, a1, placedA[k], placedB[k]));
+                    }
+                    if (clear >= FallenClearance) { bestYaw = cy; bestBack = bk; bestClear = clear; goto chosen; }
+                    if (clear > bestClear) { bestClear = clear; bestYaw = cy; bestBack = bk; }
+                }
+            }
+        chosen:
+            yaw[e] = bestYaw; back[e] = bestBack;
+            var d = new Vector2(MathF.Sin(bestYaw), MathF.Cos(bestYaw)) * (bestBack ? -1f : 1f);
+            placedA.Add(p); placedB.Add(p + d * FallenLength);
+        }
+        return (yaw, back);
+    }
+
+    /// <summary>Closest distance between segments [a0, a1] and [b0, b1] in the plane.</summary>
+    public static float SegmentDistance(Vector2 a0, Vector2 a1, Vector2 b0, Vector2 b1)
+    {
+        static float Cross(Vector2 u, Vector2 v) => u.X * v.Y - u.Y * v.X;
+        var r = a1 - a0; var s = b1 - b0; float den = Cross(r, s);
+        if (MathF.Abs(den) > 1e-9f)
+        {
+            float t = Cross(b0 - a0, s) / den, u = Cross(b0 - a0, r) / den;
+            if (t >= 0f && t <= 1f && u >= 0f && u <= 1f) return 0f;   // they cross
+        }
+        static float PointSeg(Vector2 p, Vector2 q0, Vector2 q1)
+        {
+            var d = q1 - q0; float l2 = d.LengthSquared();
+            float t = l2 > 1e-12f ? Math.Clamp(Vector2.Dot(p - q0, d) / l2, 0f, 1f) : 0f;
+            return Vector2.Distance(p, q0 + d * t);
+        }
+        return MathF.Min(MathF.Min(PointSeg(a0, b0, b1), PointSeg(a1, b0, b1)), MathF.Min(PointSeg(b0, a0, a1), PointSeg(b1, a0, a1)));
+    }
+
+    static float LerpAngle(float a, float b, float t)
+    {
+        float d = b - a;
+        while (d > MathF.PI) d -= MathF.Tau;
+        while (d < -MathF.PI) d += MathF.Tau;
+        return a + d * t;
+    }
+
+    int StepAt(long tMs)
+    {
+        var tr = Battle.Trace;
+        int lo = 0, hi = tr.StepCount - 1;
+        if (tMs <= tr.StepTimeMs(0)) return 0;
+        if (tMs >= tr.StepTimeMs(hi)) return hi;
+        while (hi - lo > 1) { int m = (lo + hi) >> 1; if (tr.StepTimeMs(m) <= tMs) lo = m; else hi = m; }
+        return lo;
+    }
+
+    /// <summary>The presentation state of entity <paramref name="e"/> at scene time <paramref name="t"/> (the snapshot at or before it).</summary>
+    public TraceSoldierState StateAt(int e, float t) => BenchBattle.Map(Battle.Trace.State(StepAt(Battle.Trace.StepTimeMs(0) + (long)MathF.Floor(t * 1000f)), e));
+
+    /// <summary>World position (on the ground) and facing of entity <paramref name="e"/> at scene time <paramref name="t"/>.</summary>
+    public (Vector3 pos, float yaw) Place(int e, float t)
+    {
+        var tr = Battle.Trace;
+        long t0 = tr.StepTimeMs(0), tMs = t0 + (long)MathF.Floor(t * 1000f);
+        int s = StepAt(tMs), s1 = Math.Min(s + 1, tr.StepCount - 1);
+        long ts = tr.StepTimeMs(s), te = tr.StepTimeMs(s1);
+        float u = te > ts ? Math.Clamp((t * 1000f + t0 - ts) / (te - ts), 0f, 1f) : 0f;
+        var (ax, ay) = tr.PosMm(s, e); var (bx, by) = tr.PosMm(s1, e);
+        var p = Vector3.Lerp(Battle.World(ax, ay), Battle.World(bx, by), u);
+        p.Y = _height(p.X, p.Z);
+        return (p, LerpAngle(_yaw[s][e], _yaw[s1][e], Math.Clamp(u * 4f, 0f, 1f)));
+    }
+
+    /// <summary>Recomputes every soldier for scene time <paramref name="t"/> (s from the first snapshot) and hands them to the renderer.</summary>
+    public void Update(float t)
+    {
+        var tr = Battle.Trace;
+        long t0 = tr.StepTimeMs(0), tMs = t0 + (long)MathF.Floor(t * 1000f);
+        int s = StepAt(tMs), s1 = Math.Min(s + 1, tr.StepCount - 1);
+        long ts = tr.StepTimeMs(s), te = tr.StepTimeMs(s1);
+        float u = te > ts ? Math.Clamp((t * 1000f + t0 - ts) / (te - ts), 0f, 1f) : 0f;
+        float segSec = te > ts ? (te - ts) / 1000f : 1f;
+        float now = t + t0 / 1000f;
+        Array.Clear(LastStates);
+        var bank = Crowd.Bank;
+        for (int e = 0; e < _agents.Length; e++)
+        {
+            ref var a = ref _agents[e];
+            a = default;
+            a.Variant = _variant[e]; a.Look = _look[e];
+            var (ax, ay) = tr.PosMm(s, e); var (bx, by) = tr.PosMm(s1, e);
+            var pa = Battle.World(ax, ay); var pb = Battle.World(bx, by);
+            var p = Vector3.Lerp(pa, pb, u);
+            p.Y = _height(p.X, p.Z);
+            a.Position = p;
+            a.Yaw = LerpAngle(_yaw[s][e], _yaw[s1][e], Math.Clamp(u * 4f, 0f, 1f));
+            float speed = Vector3.Distance(pa, pb) / segSec;
+            var state = BenchBattle.Map(tr.State(s, e));
+            LastStates[(int)state]++;
+            float off = _phase[e];
+            if (state == TraceSoldierState.Escaped || HeroEntities.Contains(e)) { a.Hidden = true; continue; }
+            if (SightLine is { } sl && InSightLine(sl, p)) { a.Hidden = true; continue; }
+            switch (state)
+            {
+                case TraceSoldierState.Dead:
+                {
+                    if (!ShowDead) { a.Hidden = true; continue; }
+                    bool back = _deadBack[e];
+                    if (!float.IsNaN(_deadYaw[e])) a.Yaw = _deadYaw[e];
+                    a.ClipA = back ? _death2 : _death; a.TimeA = MathF.Max(0f, now - _deathMs[e] / 1000f);
+                    a.ClipB = a.ClipA; a.TimeB = a.TimeA; a.Blend = 0;
+                    continue;
+                }
+                case TraceSoldierState.Surrendered:
+                {
+                    // kneels from the instant of surrender and stays down, head bowed (cower blended in)
+                    float since = MathF.Max(0f, now - _surrenderMs[e] / 1000f);
+                    a.ClipA = _kneel; a.TimeA = since;
+                    a.ClipB = _cower; a.TimeB = since + off;
+                    a.Blend = 0.25f + 0.2f * off;
+                    continue;
+                }
+                case TraceSoldierState.Routing:
+                {
+                    var clip = speed > RunSpeed * 0.8f ? _run : _jog;
+                    float cs = MathF.Max(0.5f, bank.Clip(Crowd.Variants[a.Variant].BankIdentity, clip).Speed);
+                    a.ClipA = clip; a.TimeA = now * (MathF.Max(speed, 1.0f) / cs) + off * 3f;
+                    a.ClipB = clip; a.TimeB = a.TimeA; a.Blend = 0;
+                    continue;
+                }
+            }
+            // Active: the latest live event of this soldier decides a blow or a stagger; otherwise the move does
+            var evs = _events[e];
+            int hiIdx = UpperBound(evs, (long)MathF.Floor(now * 1000f));
+            int evClip = -1; float fireAge = 0, hitAge = 0; long target = -1; bool hit = false;
+            for (int k = hiIdx - 1; k >= 0; k--)
+            {
+                var ev = tr.Events[evs[k]];
+                float age = now - ev.TimeMs / 1000f;
+                if (age > tr.StepMs / 1000f + HitSeconds) break;
+                if (ev.Kind == TraceEventKind.Damage && tr.Entities[e].Id == ev.Target)
+                {
+                    if (age < HitSeconds && !hit) { hit = true; hitAge = age; }
+                    continue;
+                }
+                if (ev.Kind == TraceEventKind.Fire && tr.Entities[e].Id == ev.Source && evClip < 0 && age < tr.StepMs / 1000f)
+                {
+                    evClip = _sword[e] ? ((CrowdLook.Hash((uint)evs[k]) & 1u) == 0 ? _swingOver : _swingSide) : _thrust;
+                    target = ev.Target; fireAge = age;
+                }
+            }
+            if (evClip >= 0)
+            {
+                // the blow, towards its target (facing is cosmetic; the target is the trace's), staggered by a blow taken
+                a.ClipA = evClip; a.TimeA = fireAge;
+                int ti = tr.IndexOf(target);
+                if (ti >= 0)
+                {
+                    var (tx, ty) = tr.PosMm(s, ti); var tp = Battle.World(tx, ty) - p;
+                    if (tp.X * tp.X + tp.Z * tp.Z > 0.01f) a.Yaw = MathF.Atan2(tp.X, tp.Z);
+                }
+                a.ClipB = hit ? _stumble : _block; a.TimeB = hit ? hitAge : fireAge + off;
+                a.Blend = hit ? 0.6f : 0f;
+                continue;
+            }
+            if (hit) { a.ClipA = _stumble; a.TimeA = hitAge; a.ClipB = _block; a.TimeB = hitAge + off; a.Blend = 0.25f; continue; }
+            if (speed > WalkSpeed)
+            {
+                var clip = speed > RunSpeed ? _run : speed > JogSpeed ? _jog : _walk;
+                float cs = MathF.Max(0.3f, bank.Clip(Crowd.Variants[a.Variant].BankIdentity, clip).Speed);
+                a.ClipA = clip; a.TimeA = now * (speed / cs) + off * 2.3f;
+                a.ClipB = _idleV[CrowdLook.Hash((uint)e ^ 0x3C6EF372u) & 3u]; a.TimeB = now + off * 7f; a.Blend = speed < 0.4f ? 0.5f : 0f;
+                continue;
+            }
+            // standing: idle, or a guard when enemies are close (the soldier has fought in the last steps)
+            bool engaged = hiIdx > 0 && now - tr.Events[evs[hiIdx - 1]].TimeMs / 1000f < 8f;
+            uint pk = CrowdLook.Hash((uint)e ^ 0x3C6EF372u);
+            if (engaged) { a.ClipA = _block; a.TimeA = 0.35f + off * 0.3f; a.ClipB = _idle2V[(pk >> 2) & 3u]; a.TimeB = now + off * 3f; a.Blend = 0.3f; }
+            else { a.ClipA = _idleV[pk & 3u]; a.TimeA = now + off * 7.8f; a.ClipB = _idle2V[(pk >> 2) & 3u]; a.TimeB = now + off * 3.1f + 1.7f; a.Blend = (CrowdLook.Hash((uint)e ^ 0x6C8E9CF5u) >> 8) * (1f / 16777216f); }
+        }
+        Crowd.SetAgents(_agents);
+    }
+
+    int UpperBound(int[] evs, long tMs)
+    {
+        var tr = Battle.Trace;
+        int lo = 0, hi = evs.Length;
+        while (lo < hi) { int m = (lo + hi) >> 1; if (tr.Events[evs[m]].TimeMs <= tMs) lo = m + 1; else hi = m; }
+        return lo;
+    }
+
+    public void ApplySwitches(RenderFeatures f)
+    {
+        if (Crowd.Lod.Bias != f.CrowdLodBias) Crowd.Lod = Crowd.Lod with { Bias = f.CrowdLodBias };
+        Crowd.ForceLevel = f.CrowdLevel; Crowd.LodFade = f.CrowdLodFade; Crowd.FrustumCulling = f.FrustumCulling;
+        Crowd.Looks = f.CrowdLooks; Crowd.ClipBlend = f.CrowdClipBlend;
+    }
+
+    public string Report() => string.Format(CultureInfo.InvariantCulture,
+        "[trace-crowd] entities={0} active={1} routing={2} surrendered={3} dead={4}{5} escaped={6} heroes={7} drawn={8} lod1={9} lod2={10} lod3={11} tris={12} shadow-instances={13}",
+        Count, LastStates[0], LastStates[1], LastStates[2], LastStates[3], ShowDead ? "" : " (not drawn: death content cut away)", LastStates[4], HeroEntities.Count,
+        Crowd.Stats.Soldiers, Crowd.Stats.PerLevel[0], Crowd.Stats.PerLevel[1], Crowd.Stats.PerLevel[2], Crowd.Stats.Triangles, Crowd.Stats.ShadowInstances);
+
+    public void Dispose() { Crowd.Dispose(); _loader.Dispose(); }
+}
