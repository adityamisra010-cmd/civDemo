+    /// <summary>
+    /// Rank 7 against rank 11: a high sun thins the clear air's height fog (the noon haze that hid the land beyond the
+    /// map), not the weather's: with the rain or mist look the factor stays 1, so their distance stays misty. A clear
+    /// frame gets exactly the clear-air factor, and a low sun thins nothing.
+    /// </summary>
+    [Fact]
+    public void HighSunThinsTheClearAirsFogNotTheWeathers()
+    {
+        float noon = MathHelper.ToRadians(62f), low = MathHelper.ToRadians(10f);
+        Assert.Equal(1f, ForwardRenderer.HighSunFog(0.15f, low, 0f, 0f));
+        Assert.Equal(0.15f, ForwardRenderer.HighSunFog(0.15f, noon, 0f, 0f), 5);
