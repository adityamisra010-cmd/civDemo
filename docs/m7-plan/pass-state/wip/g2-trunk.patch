+    static CameraPose Lerp(CameraPose a, CameraPose b, float u) => a with
+    {
+        Position = Vector3.Lerp(a.Position, b.Position, u), Target = Vector3.Lerp(a.Target, b.Target, u),
+        FovYRadians = MathHelper.Lerp(a.FovYRadians, b.FovYRadians, u),
+    };
+
+    public float CinematicSeconds => _beats.Sum(b => b.Seconds);
+
+    /// <summary>The harness's camera path (slot D): the beats in order, each beat's move over its share of the run.</summary>
+    public (CameraPose camera, float sceneTime, float hour) PathAt(float u)
+    {
+        float total = CinematicSeconds, t = Math.Clamp(u, 0f, 0.99999f) * total, acc = 0;
+        foreach (var b in _beats)
+        {
+            if (t < acc + b.Seconds) return (Lerp(b.From, b.To, (t - acc) / b.Seconds), _tEnd + t, b.Hour);
+            acc += b.Seconds;
+        }
+        var lb = _beats[^1];
+        return (lb.To, _tEnd + total, lb.Hour);
+    }
+
+    public string PathDescription => string.Create(CultureInfo.InvariantCulture,
+        $"aftermath beats ({string.Join(", ", _beats.Select(b => b.Name))}), {CinematicSeconds:F1} s played over the measured frames, death content {Content}");
+
+    public override Vector3 Focus => _cPos;
+
+    /// <summary>Polish1 (critic rank 5d): the sight line of the beat playing at <paramref name="tau"/> when its subject is
+    /// a hero (the pair, a face, the standards); null for the field, prisoners and fallen beats, whose subject is the crowd.</summary>
+    public (Vector3 Eye, Vector3 Subject, float Radius)? SightLineAt(float tau)
+    {
+        float acc = 0;
+        for (int i = 0; i < _beats.Count; i++)
+        {
+            var b = _beats[i];
+            if (tau < acc + b.Seconds || i == _beats.Count - 1)
+            {
+                if (b.Name is not ("surrender" or "officer-face" or "commander-face" or "standards")) return null;
+                var cam = Lerp(b.From, b.To, Math.Clamp((tau - acc) / b.Seconds, 0f, 1f));
+                return (cam.Position, cam.Target, 1.5f);
+            }
+            acc += b.Seconds;
+        }
+        return null;
+    }
+
+    protected override void Animate(float t)
+    {
+        float tau = MathF.Max(0f, t - _tEnd);
+        if (Troops != null) Troops.SightLine = SightLineAt(tau);
+        Troops?.Update(MathF.Max(t, _tEnd));
+        if (_commander != null)
+        {
+            _commander.Update(tau);
+            var ex = _commander.Body.Expression; ex.Clear();
+            float vic = BeatStart("surrender") + 1.2f;
+            if (tau >= vic && tau < vic + 4.5f) ex["battlecry"] = 1f; else ex["grim"] = 0.8f;
+        }
+        if (_officer != null)
+        {
+            _officer.Update(tau);
+            var ex = _officer.Body.Expression; ex.Clear();
+            ex["pain"] = 0.55f; ex["grim"] = 0.35f;
+        }
+        _victorBanner?.Pose(tau + 3f, 0.7f);
+        _defeatedBanner?.Pose(0f, 0f);
+    }
+
+    protected override void DrawExtraShadows(RenderContext rc)
+    {
+        Troops.ApplySwitches(rc.Features);
+        if (rc.Features.Crowd) Troops.Crowd.DrawShadows(rc);
+    }
+
+    protected override void DrawExtraOpaque(RenderContext rc)
+    {
+        Troops.ApplySwitches(rc.Features);
+        Troops.Crowd.Occlusion = null;
+        if (rc.Features.Crowd) Troops.Crowd.DrawOpaque(rc);
+    }
+
+    protected override void DrawExtraTransparent(RenderContext rc) => _smoke.Draw(rc);
+
+    public override string FrameReport() => Troops.Report() + string.Format(CultureInfo.InvariantCulture,
+        " aftermath: victor={0} defeated={1} surrender-beat={2} commander-entity={3} officer-entity={4} standing={5} prisoners={6} victor-side-surrendered={7} fallen={8} escaped={9} death-content={10} smoke-puffs={11}",
+        Outcome.Victor, Outcome.Defeated, Outcome.Surrender, Outcome.CommanderEntity, Outcome.OfficerEntity, Outcome.VictorsStanding, Outcome.Prisoners, Outcome.VictorPrisoners,
+        Outcome.Fallen, Outcome.Escaped, Content, _smoke.LastPuffs);
+
+    public override void Dispose() { Troops?.Dispose(); _smoke?.Dispose(); base.Dispose(); }
+}
