+    /// <summary>
+    /// The trace-driven crowd shows what the trace records and never writes it: at three snapshot times every 7th
+    /// soldier stands exactly at its recorded position (flat ground), in its recorded state, the counts per state of an
+    /// update are the trace's counts at that step, and the trace hashes the same afterwards.
+    /// </summary>
+    [BenchCrowdFact]
+    public void TraceCrowdShowsWhatTheTraceRecordsAndNeverWritesIt()
+    {
+        TestGfx.Host.Invoke(gd =>
+        {
+            var b = BenchBattle.Load(); var tr = b.Trace; string h0 = tr.Hash();
+            using var crowd = new TraceCrowd(gd, b, (x, z) => 0f);
+            foreach (int s in new[] { 0, tr.StepCount / 3, tr.StepCount - 1 })
+            {
+                float t = crowd.SceneTime(tr.StepTimeMs(s));
+                crowd.Update(t);
+                for (int e = 0; e < tr.Entities.Count; e += 7)
+                {
+                    var (x, y) = tr.PosMm(s, e);
+                    var want = b.World(x, y);
+                    var (p, _) = crowd.Place(e, t);
+                    Assert.Equal((want.X, 0f, want.Z), (p.X, p.Y, p.Z));
+                    Assert.Equal(BenchBattle.Map(tr.State(s, e)), crowd.StateAt(e, t));
+                }
+                var c = b.Counts(s);
+                for (int k = 0; k < 5; k++) Assert.Equal(c[0, k] + c[1, k], crowd.LastStates[k]);
+            }
+            Assert.Equal(h0, tr.Hash());
+        });
+    }
