+    /// <summary>
+    /// The fallen of the bench battle are laid out once, in the order of death, from each soldier's facing: the layout
+    /// leaves fewer body pairs closer than the clearance than the hashed falls did, keeps the first soldier to fall
+    /// (nobody down yet) on his own facing and hashed fall, gives a soldier who does not die no layout, and is the same on
+    /// every call (a pure function of the trace).
+    /// </summary>
+    [BenchCrowdFact]
+    public void FallenAreLaidOutApartInTheOrderOfDeath()
+    {
+        var tr = Gfx.Demo.Scenes.Bench.BenchBattle.Load().Trace;
+        int n = tr.Entities.Count, steps = tr.StepCount;
+        var death = new long[n]; Array.Fill(death, long.MinValue);
+        for (int s = 0; s < steps; s++)
+            for (int e = 0; e < n; e++)
+                if (death[e] == long.MinValue && Gfx.Demo.Scenes.Bench.BenchBattle.Map(tr.State(s, e)) == Gfx.Demo.Scenes.Bench.TraceSoldierState.Dead) death[e] = tr.StepTimeMs(s);
+        var yaw = Gfx.Demo.Scenes.Bench.TraceCrowd.FacingPerStep(tr);
+        var (y1, b1) = Gfx.Demo.Scenes.Bench.TraceCrowd.LayOutFallen(tr, death, yaw);
+        var (y2, b2) = Gfx.Demo.Scenes.Bench.TraceCrowd.LayOutFallen(tr, death, yaw);
+        Assert.Equal(y1, y2); Assert.Equal(b1, b2);
+        var dead = Enumerable.Range(0, n).Where(e => death[e] != long.MinValue).ToArray();
+        Assert.True(dead.Length > 100, $"only {dead.Length} fallen");
+        for (int e = 0; e < n; e++) Assert.Equal(death[e] == long.MinValue, float.IsNaN(y1[e]));
+        (Vector2 a, Vector2 b) Body(int e, float yw, bool back)
+        {
+            var (x, y) = tr.PosMm(steps - 1, e);
+            var p = new Vector2(x / 1000f, y / 1000f);
+            return (p, p + new Vector2(MathF.Sin(yw), MathF.Cos(yw)) * (back ? -1f : 1f) * Gfx.Demo.Scenes.Bench.TraceCrowd.FallenLength);
+        }
+        int Close(Func<int, (Vector2 a, Vector2 b)> body)
+        {
+            var bodies = dead.Select(body).ToArray();
+            int c = 0;
+            for (int i = 0; i < bodies.Length; i++)
+                for (int j = i + 1; j < bodies.Length; j++)
+                    if (Gfx.Demo.Scenes.Bench.TraceCrowd.SegmentDistance(bodies[i].a, bodies[i].b, bodies[j].a, bodies[j].b) < Gfx.Demo.Scenes.Bench.TraceCrowd.FallenClearance) c++;
+            return c;
+        }
+        int StepOfDeath(int e) { for (int s = 0; s < steps; s++) if (Gfx.Demo.Scenes.Bench.BenchBattle.Map(tr.State(s, e)) == Gfx.Demo.Scenes.Bench.TraceSoldierState.Dead) return s; return steps - 1; }
+        int naive = Close(e => Body(e, yaw[StepOfDeath(e)][e], (CrowdLook.Hash((uint)e ^ 0xDEADu) & 1u) != 0));
+        int laid = Close(e => Body(e, y1[e], b1[e]));
+        // the density of the fallen: how many lie within a body's width (0.45 m) of another's feet
+        int packed = 0;
+        for (int i = 0; i < dead.Length; i++)
+        {
+            var (xi, yi) = tr.PosMm(steps - 1, dead[i]);
+            for (int j = 0; j < dead.Length; j++)
+            {
+                if (i == j) continue;
+                var (xj, yj) = tr.PosMm(steps - 1, dead[j]);
+                long dx = xi - xj, dy = yi - yj;
+                if (dx * dx + dy * dy < 450L * 450L) { packed++; break; }
+            }
+        }
+        _out.WriteLine($"fallen {dead.Length}; within 0.45 m of another {packed}; close body pairs: hashed falls {naive}, laid out {laid}");
+        Assert.True(naive > 0, "the test needs overlapping falls");
+        Assert.True(laid < naive, $"laid out {laid} close pairs, hashed falls {naive}");
+        // the first to fall has nobody to avoid: his own facing at death and his hashed fall
+        var first = dead.OrderBy(e => death[e]).ThenBy(e => e).First();
+        Assert.Equal(yaw[StepOfDeath(first)][first], y1[first]);
+        Assert.Equal((CrowdLook.Hash((uint)first ^ 0xDEADu) & 1u) != 0, b1[first]);
+    }
