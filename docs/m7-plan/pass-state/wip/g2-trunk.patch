+    /// <summary>
+    /// The exported battle of scenes C and D is the file its manifest names (sha256 and trace hash), 2,100 soldiers of two
+    /// sides of 1,050, with the resolver's result in its header, and its compact form round-trips exactly.
+    /// </summary>
+    [BenchTraceFact]
+    public void BenchBattleBakeMatchesItsManifest()
+    {
+        var path = BenchBattle.DefaultPath;
+        var row = File.ReadAllLines(Path.Combine(Path.GetDirectoryName(path)!, "MANIFEST.tsv"))
+            .Single(l => l.StartsWith(BenchBattle.FileName + "\t", StringComparison.Ordinal)).Split('\t');
+        Assert.Equal(row[1], Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path))).ToLowerInvariant());
+        var b = BenchBattle.Load();
