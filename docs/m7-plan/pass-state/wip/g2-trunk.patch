+        Assert.InRange(b.HoldsField, -1, 1);
+        Assert.False(string.IsNullOrEmpty(b.Reason));
+        var c = b.Counts(b.Trace.StepCount - 1);
+        int total = 0; foreach (var v in c) total += v;
+        Assert.Equal(2100, total);
+        AssertSameTrace(b.Trace, BattleTrace.ParseBinary(Bin(b.Trace)));
+    }
