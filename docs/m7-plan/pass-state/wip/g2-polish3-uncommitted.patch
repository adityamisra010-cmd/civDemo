+    /// <summary>
+    /// Rank 3: the fallen beat is framed by what it shows. Given a view score, the beat takes the best of its 48 views
+    /// round the densest fallen (16 directions, 8, 11 and 14 m off, 1.5 m up, looking at it): with a score that rewards
+    /// one direction and distance, the beat's camera stands there; with a score that is the same everywhere, the first
+    /// view (straight +z, 8 m off) wins the tie; without a score the beat keeps its fixed view. The other six beats do not
+    /// change with the score.
+    /// </summary>
+    [Fact]
+    public void FallenBeatTakesTheBestScoredView()
+    {
+        static Vector3 Flat(Vector3 p, float up) => new(p.X, up, p.Z);
+        var plan = new Gfx.Demo.Scenes.Bench.AftermathPlan(0, 1, true, 0, 1, Gfx.Demo.Scenes.Bench.DeathContent.Shown, 10, 5, 0, 7, 3);
+        var occ = new List<Vector3> { new(1.5f, 0f, 3f), new(-4f, 0f, 1f) };
+        var fallen = new Vector3(12, 0, 9);
+        List<Gfx.Demo.Scenes.Bench.AftermathShot> Beats(Func<Vector3, Vector3, float>? score) =>
+            Gfx.Demo.Scenes.Bench.BenchAftermathScene.PlanBeats(plan, Vector3.Zero, new Vector3(3, 0, 0), 0f, fallen,
+                new Vector3(30, 0, 30), new Vector3(5, 0, 2), occ, Flat, 1, score);
+        var none = Beats(null);
+        // the eye of the wanted view: direction 5 of 16 (112.5 degrees from +z), the middle distance (11 m)
+        float a = 5 * MathF.Tau / 16f;
+        var want = fallen + new Vector3(MathF.Sin(a), 0f, MathF.Cos(a)) * 11f + new Vector3(0, 1.5f, 0);
+        var picked = Beats((eye, target) => -Vector3.Distance(eye, want));
+        var flat = Beats((eye, target) => 0f);
+        Assert.Equal(none.Take(6), picked.Take(6));
+        // the still is taken at StillAt of the beat's slow move: that is where the chosen view stands
+        static (Vector3 eye, Vector3 target) Still(Gfx.Demo.Scenes.Bench.AftermathShot b) =>
+            (Vector3.Lerp(b.From.Position, b.To.Position, Gfx.Demo.Scenes.Bench.BenchAftermathScene.StillAt),
+             Vector3.Lerp(b.From.Target, b.To.Target, Gfx.Demo.Scenes.Bench.BenchAftermathScene.StillAt));
+        var f = picked[6];
+        Assert.Equal("fallen", f.Name);
+        var (eye, target) = Still(f);
+        Assert.True(Vector3.Distance(eye, want) < 1e-3f, $"the still stands at {eye}, the best view is at {want}");
+        Assert.True(Vector3.Distance(target, new Vector3(fallen.X, 0.3f, fallen.Z)) < 1e-3f, $"the still looks at {target}");
+        var first = fallen + new Vector3(0f, 1.5f, 8f);
+        Assert.True(Vector3.Distance(Still(flat[6]).eye, first) < 1e-3f, $"a tie goes to the first view: {Still(flat[6]).eye}");
+        Assert.True(Vector3.Distance(Still(none[6]).eye, eye) > 1f, "without a score the beat keeps its fixed view");
+    }
