+    /// <summary>
+    /// Polish3 (critic rank 3): how well a view from <paramref name="eye"/> towards <paramref name="target"/> frames the
+    /// fallen beat: a few bodies near the camera and the prisoners beyond, not a carpet of the dead nor the living in front.
+    /// Every soldier as he lies or kneels at rest (the fallen settled and relaxed, the prisoners placed) inside the frame's
+    /// half-width (0.7 of the distance ahead) is counted near (1 to 6 m ahead) or beyond (6 to 20 m); the score is the near
+    /// bodies up to six, less 0.7 for each near body past six, 2 for each near prisoner and 3 for each near standing man,
+    /// plus 0.15 for each prisoner beyond (at most 40). Reads the trace only.
+    /// </summary>
+    float FallenViewScore(Vector3 eye, Vector3 target)
+    {
+        var tr = Battle.Trace; int last = tr.StepCount - 1;
+        var f = new Vector2(target.X - eye.X, target.Z - eye.Z);
+        if (f.LengthSquared() < 1e-6f) return float.NegativeInfinity;
+        f = Vector2.Normalize(f);
+        int bodiesNear = 0, prisonersNear = 0, standingNear = 0, prisonersBeyond = 0;
+        for (int e = 0; e < tr.Entities.Count; e++)
+        {
+            var st = BenchBattle.Map(tr.State(last, e));
+            if (st is not (TraceSoldierState.Dead or TraceSoldierState.Surrendered or TraceSoldierState.Active)) continue;
+            var (p, _) = Troops.Place(e, _tEnd);
+            var q = new Vector2(p.X, p.Z) + (st == TraceSoldierState.Dead ? Troops.SettleOffset(e) : st == TraceSoldierState.Surrendered ? Troops.PrisonerOffset(e) : Vector2.Zero);
+            var v = q - new Vector2(eye.X, eye.Z);
+            float along = Vector2.Dot(v, f), across = MathF.Abs(v.X * f.Y - v.Y * f.X);
+            if (along < 1f || along > 20f || across > along * 0.7f) continue;
+            bool near = along <= 6f;
+            if (st == TraceSoldierState.Dead) { if (near) bodiesNear++; }
+            else if (st == TraceSoldierState.Surrendered) { if (near) prisonersNear++; else prisonersBeyond++; }
+            else if (near) standingNear++;
+        }
+        return Math.Min(bodiesNear, 6) - 0.7f * Math.Max(0, bodiesNear - 6) - 2f * prisonersNear - 3f * standingNear + 0.15f * Math.Min(prisonersBeyond, 40);
+    }
