+    // ------------------------------------------------------------------ weather on the device (PillarScene)
+
+    const int W = 320, H = 180;
+    static readonly SunState Sun = SunModel.At(11f);
+
+    static ForwardRenderer NewRenderer(GraphicsDevice gd, string switches)
+    {
+        var r = new ForwardRenderer(gd, TestGfx.Host.Effects);
+        r.Settings.FogParams = new Vector4(0f, 0.02f, 0f, 0f);
+        r.Settings.ShadowCasterBounds = new BoundingBox(new Vector3(-80, -1, -80), new Vector3(80, 10, 80));
+        r.Settings.Features.SetMany("autoexposure=0,bloom=0,grade=0,aa=none,farfield=0,ssao=0,contact=0");
+        if (switches.Length > 0) r.Settings.Features.SetMany(switches);
+        return r;
+    }
+
+    static Color[] Frame(ForwardRenderer r, IRenderContent c, CameraPose cam, RenderTarget2D rt, float t = 0f)
+    {
+        r.Render(c, cam, Sun, rt, t);
+        return Capture.ReadPixels(rt);
+    }
+
+    static float Luma(Color c) => 0.2126f * c.R + 0.7152f * c.G + 0.0722f * c.B;
+
+    static float LumaAt(Color[] px, CameraPose cam, Vector3 world)
+    {
+        var c = Vector4.Transform(new Vector4(world, 1), cam.View * cam.Projection(W / (float)H));
+        int x = (int)((c.X / c.W * 0.5f + 0.5f) * W), y = (int)((0.5f - c.Y / c.W * 0.5f) * H);
+        float s = 0;
+        for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) s += Luma(px[Math.Clamp(y + j, 0, H - 1) * W + Math.Clamp(x + i, 0, W - 1)]);
+        return s / 9f;
+    }
+
+    /// <summary>The camera beside the pillar, square to the sun (no glint towards it): ground on the pillar's sunlit and
+    /// shadowed sides, near ground and far ground across the slab.</summary>
+    static (CameraPose cam, Vector3 lit, Vector3 shade, Vector3 near, Vector3 far) SunBehind()
+    {
+        var l = Sun.DirectionToLight;
+        var s = Vector3.Normalize(new Vector3(l.X, 0, l.Z)); var p = new Vector3(-s.Z, 0, s.X);
+        var cam = new CameraPose(p * 6f + new Vector3(0, 2.6f, 0), new Vector3(0, 0.25f, 0), 0.8f, 0.1f, 400f);
+        return (cam, s * 0.9f, -s * 0.9f, p * 3.2f + s * 1.5f, -p * 40f + s * 3f);
+    }
+
+    /// <summary>Content that draws the pillar and, in the transparent pass, an optional rain layer or smoke layer.</summary>
+    sealed class WeatherBox(PillarScene scene, RainLayer? rain, SmokeLayer? smoke) : IRenderContent, ITransparentContent
+    {
+        public void DrawShadowCasters(RenderContext rc) => scene.DrawShadowCasters(rc);
+        public void DrawOpaque(RenderContext rc) => scene.DrawOpaque(rc);
+        public bool NeedsSceneColor(RenderContext rc) => false;
+        public void DrawTransparent(RenderContext rc) { rain?.Draw(rc); smoke?.Draw(rc); }
+    }
+
+    /// <summary>
+    /// All weather terms at 0 give the default frame pixel for pixel; wetness darkens the lit, porous ground (water in the
+    /// pores) by a clear margin on both the sunlit and the shadowed side.
+    /// </summary>
+    [GfxFact]
+    public void WetGroundDarkensAndZeroWeatherIsTheDefaultFrame()
+    {
+        TestGfx.Host.Invoke(gd =>
+        {
+            using var scene = new PillarScene(gd);
+            using var rt = new RenderTarget2D(gd, W, H, false, SurfaceFormat.Color, DepthFormat.None);
+            var (cam, lit, shade, _, _) = SunBehind();
+            using var dflt = NewRenderer(gd, "");
+            using var zero = NewRenderer(gd, "cloud=0,wet=0,rain=0,mist=0");
+            using var wet = NewRenderer(gd, "wet=1");
+            var a = Frame(dflt, scene, cam, rt); var z = Frame(zero, scene, cam, rt); var b = Frame(wet, scene, cam, rt);
+            Assert.Equal(0, Capture.CountChanged(a, z, 0));
+            float litRel = (LumaAt(a, cam, lit) - LumaAt(b, cam, lit)) / MathF.Max(1, LumaAt(a, cam, lit));
+            float shadeRel = (LumaAt(a, cam, shade) - LumaAt(b, cam, shade)) / MathF.Max(1, LumaAt(a, cam, shade));
+            Assert.True(litRel > 0.2f, $"sunlit wet ground darkened by {litRel:P1}");
+            Assert.True(shadeRel > 0.1f, $"shaded wet ground darkened by {shadeRel:P1}");
+        });
+    }
+
+    /// <summary>Cloud cover dims the direct sun: the ratio of sunlit to shadowed ground falls (softer, flatter light).</summary>
+    [GfxFact]
+    public void CloudSoftensTheSunAndShadeContrast()
+    {
+        TestGfx.Host.Invoke(gd =>
+        {
+            using var scene = new PillarScene(gd);
+            using var rt = new RenderTarget2D(gd, W, H, false, SurfaceFormat.Color, DepthFormat.None);
+            var (cam, lit, shade, _, _) = SunBehind();
+            using var clear = NewRenderer(gd, "");
+            using var cloud = NewRenderer(gd, "cloud=1");
+            var a = Frame(clear, scene, cam, rt); var b = Frame(cloud, scene, cam, rt);
+            float ra = LumaAt(a, cam, lit) / MathF.Max(1, LumaAt(a, cam, shade));
+            float rb = LumaAt(b, cam, lit) / MathF.Max(1, LumaAt(b, cam, shade));
+            Assert.True(ra > 1.3f, $"clear sky: sunlit/shade {ra:F2}");
+            Assert.True(rb < ra * 0.8f, $"overcast sunlit/shade {rb:F2} vs clear {ra:F2}");
+        });
+    }
+
+    /// <summary>Ground mist changes the far ground much more than the near ground (it lies in the distance and the low air).</summary>
