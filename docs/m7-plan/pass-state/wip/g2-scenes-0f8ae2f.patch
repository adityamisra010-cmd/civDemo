+        sb.Append("\"entities\":[").Append(string.Join(",", men.Select((m, i) => $"[{I(100 + i)},{I(m.side + 1)},{I(m.side)}]"))).Append("],");
+        string Pos() => string.Join(",", men.Select(m => I((long)MathF.Round(m.x * 1000f)) + "," + I((long)MathF.Round(m.z * 1000f))));
+        sb.Append("\"steps\":[{\"t\":0,\"pos\":[").Append(Pos()).Append("],\"state\":[").Append(string.Join(",", men.Select(_ => "0"))).Append("]},");
+        sb.Append("{\"t\":2000,\"pos\":[").Append(Pos()).Append("],\"state\":[").Append(string.Join(",", men.Select(m => I((int)m.state)))).Append("]}],");
+        sb.Append("\"events\":[],\"frame\":{\"originMm\":[0,0]},\"result\":{\"reason\":\"test\",\"holdsField\":").Append(I(holdsField)).Append(",\"side\":-1,\"endMs\":2000}}");
+        return BenchBattle.FromTrace(BattleTrace.Parse(Encoding.UTF8.GetBytes(sb.ToString())));
