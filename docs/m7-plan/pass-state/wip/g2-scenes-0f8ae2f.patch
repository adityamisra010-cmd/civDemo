@@ -190,9 +190,21 @@ vec3 iblSpecular(vec3 r, float rough) {
 }
 vec2 envBrdf(float nov, float rough) { return texture2D(BrdfLut, vec2(nov, rough)).rg; }
 
+// Stage scenes: wet surfaces (Weather.x = wetness 0..1). Water fills the pores of rough dielectrics (they darken) and a
+// film makes every surface glossier, upward faces more than vertical ones (after Lagarde 2013). Off (0): no change at all.
+void wetSurface(inout vec3 albedo, inout float rough, float metal, vec3 up) {
+    if (Weather.x <= 0.0) return;
+    float u = clamp(up.y * 0.5 + 0.5, 0.0, 1.0);
