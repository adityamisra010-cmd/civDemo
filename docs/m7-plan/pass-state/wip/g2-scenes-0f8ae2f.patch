+++ b/prototypes/m7-gfx2/Gfx.Engine/Rendering/RainLayer.cs
@@ -0,0 +1,134 @@
+using System.Runtime.InteropServices;
+using Gfx.Engine.Effects;
+using Gfx.Engine.Mgfx;
+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Graphics;
+
+namespace Gfx.Engine.Rendering;
+
+/// <summary>
+/// Rain streaks (stage scenes; PRESENTATION ONLY): a fixed lattice of thin quads in a box that repeats around the camera,
+/// falling at <see cref="FallSpeed"/> with the wind and drawn additively in the transparent pass. Every streak's position
+/// is a pure function of its seed and the scene time (no particle state, no randomness at draw time), so stills, the
+/// benchmark path and replays all show the same rain. The streak length stands in for the motion blur of a 1/50 s
+/// exposure; the width never falls below about 0.7 px so distant streaks stay visible as a fine veil. Their light is the
+/// sky's (the ambient sky term) plus a little sun: a falling drop refracts the sky behind the viewer.
+/// The density follows <see cref="RenderFeatures.Rain"/> (each streak has a threshold; 0 draws nothing).
+/// </summary>
+public sealed class RainLayer : IDisposable
+{
+    public const int Streaks = 24_000;
+    /// <summary>Edge of the repeating box (m) around the camera; height is 0.6 × this.</summary>
+    public float Box { get; set; } = 36f;
+    public float FallSpeed { get; set; } = 7.5f;
+    /// <summary>Streak length (m): the fall during a 1/50 s exposure is 0.15 m; longer reads as heavier rain at film rates.</summary>
+    public float Length { get; set; } = 0.42f;
+    public Vector3 Wind { get; set; } = new(1.2f, 0f, 0.6f);
+    /// <summary>Brightness of a streak relative to the ambient sky radiance.</summary>
+    public float Brightness { get; set; } = 1.0f;
+
+    readonly VertexBuffer _vb;
+    readonly IndexBuffer _ib;
+
+    [StructLayout(LayoutKind.Sequential, Pack = 1)]
+    struct RainVertex : IVertexType
+    {
+        public Vector4 Seed;
+        public static readonly VertexDeclaration Decl = new(new VertexElement(0, VertexElementFormat.Vector4, VertexElementUsage.Position, 0));
+        readonly VertexDeclaration IVertexType.VertexDeclaration => Decl;
+    }
+
+    public RainLayer(GraphicsDevice gd)
+    {
+        var v = new RainVertex[Streaks * 4];
+        var ix = new int[Streaks * 6];
+        for (int i = 0; i < Streaks; i++)
+        {
+            // integer hash per streak (no RNG state): position in the box and the density threshold
+            uint h0 = Hash((uint)i * 2654435761u + 0x9E3779B9u), h1 = Hash(h0 ^ 0x85EBCA6Bu), h2 = Hash(h1 ^ 0xC2B2AE35u);
+            var s = new Vector3((h0 >> 8) / 16777216f, (h1 >> 8) / 16777216f, (h2 >> 8) / 16777216f);
+            for (int c = 0; c < 4; c++) v[i * 4 + c].Seed = new Vector4(s, c);
+            int b = i * 4, o = i * 6;
+            ix[o] = b; ix[o + 1] = b + 1; ix[o + 2] = b + 2; ix[o + 3] = b + 1; ix[o + 4] = b + 3; ix[o + 5] = b + 2;
+        }
+        _vb = new VertexBuffer(gd, RainVertex.Decl, v.Length, BufferUsage.WriteOnly);
+        _vb.SetData(v);
+        _ib = new IndexBuffer(gd, IndexElementSize.ThirtyTwoBits, ix.Length, BufferUsage.WriteOnly);
+        _ib.SetData(ix);
+    }
+
+    static uint Hash(uint x) { x ^= x >> 16; x *= 0x85EBCA6Bu; x ^= x >> 13; x *= 0xC2B2AE35u; x ^= x >> 16; return x; }
+
+    /// <summary>Draws the streaks into the HDR target of the transparent pass (depth tested, not written). No-op without rain.</summary>
+    public void Draw(RenderContext rc)
+    {
+        float rain = rc.Features.Rain;
+        if (rain <= 0f || rc.IsShadowPass || rc.IsReflectionPass) return;
+        var gd = rc.Device;
+        var e = rc.Effects.Get(WeatherEffectNames.Rain);
+        float pixelAngle = 2f * MathF.Tan(rc.Camera.FovYRadians * 0.5f) / MathF.Max(1f, rc.ViewportSize.Y);
+        e.Parameters["RainParams"].SetValue(new Vector4(Box, FallSpeed, Length, rain));
+        e.Parameters["RainWind"].SetValue(new Vector4(Wind, pixelAngle));
+        e.Parameters["RainCam"].SetValue(new Vector4(rc.Camera.Position, rc.TimeSeconds));
+        // light of a streak: the sky's radiance (G2 ambient sky term) and a trace of the key light
+        var light = rc.Sun.AmbientSky * (1.6f * Brightness) + rc.Sun.LightColor * 0.012f;
+        e.Parameters["RainLight"].SetValue(new Vector4(light, 0));
+        gd.SetVertexBuffer(_vb); gd.Indices = _ib;
+        gd.BlendState = BlendState.Additive; gd.DepthStencilState = DepthStencilState.DepthRead; gd.RasterizerState = RasterizerState.CullNone;
+        rc.Apply(e);
+        gd.DrawIndexedPrimitives(PrimitiveType.TriangleList, 0, 0, Streaks * 2);
+        rc.Stats.RecordDraw(1, Streaks * 2);
+        gd.BlendState = BlendState.Opaque; gd.DepthStencilState = DepthStencilState.Default;
+    }
+
+    public void Dispose() { _vb.Dispose(); _ib.Dispose(); }
+}
+
+public static class WeatherEffectNames
+{
+    public const string Rain = "WeatherRain";
+    public const string Smoke = "WeatherSmoke";
+}
+
+/// <summary>Weather effects (stage scenes), discovered like every <see cref="IEffectSource"/>.</summary>
+public sealed class WeatherEffects : IEffectSource
+{
+    public IEnumerable<EffectBuilder> CreateEffects()
+    {
+        yield return new EffectBuilder(WeatherEffectNames.Rain)
+            .Attribute("vec4 a_seed", VertexElementUsage.Position, 0)
+            .Matrix("ViewProj", Stage.Vertex)
+            .Vec4("RainParams", Stage.Vertex).Vec4("RainWind", Stage.Vertex).Vec4("RainCam", Stage.Vertex)
+            .Vec4("RainLight", Stage.Pixel)
+            .BlendedGBuffer()
+            .Varyings("vec2 v_uv; float v_alpha;")
+            .VertexMain(@"
+    float box = RainParams.x;
+    vec3 B = vec3(box, box * 0.6, box);
+    vec3 vel = vec3(RainWind.x, -RainParams.y, RainWind.z);
+    float corner = floor(a_seed.w + 0.01);
+    float cx = (corner == 0.0 || corner == 2.0) ? -1.0 : 1.0;
+    float cy = corner < 1.5 ? 0.0 : 1.0;
+    // the lattice point of this streak nearest the camera, falling with the scene time
+    vec3 p = a_seed.xyz * B + vel * RainCam.w;
+    vec3 rel = p - RainCam.xyz;
+    rel -= B * floor(rel / B + 0.5);
+    vec3 wp = RainCam.xyz + rel;
+    float dist = length(rel);
+    vec3 dir = normalize(vel);
+    vec3 toCam = rel / max(dist, 1e-3);
+    vec3 side = normalize(cross(dir, toCam) + vec3(1e-5, 0.0, 0.0));
+    float width = max(0.0012, dist * RainWind.w * 0.7);
+    vec3 pos = wp + side * (cx * width) + dir * (cy * RainParams.z);
+    // density: streak k is drawn when its threshold is below the rain amount
+    float keep = step(fract(a_seed.x * 17.31 + a_seed.z * 5.77), RainParams.w);
+    v_alpha = keep * smoothstep(0.6, 2.5, dist) * (1.0 - smoothstep(box * 0.3, box * 0.5, dist)) * (0.35 + 0.65 * min(1.0, 0.0012 / width + 0.25));
+    v_uv = vec2(cx, cy);
+    gl_Position = keep > 0.5 ? ViewProj_mul(vec4(pos, 1.0)) : vec4(2.0, 2.0, 2.0, 1.0);")
+            .PixelMain(@"
+    float across = 1.0 - abs(v_uv.x);
+    float along = sin(clamp(v_uv.y, 0.0, 1.0) * 3.14159);
+    float a = v_alpha * across * along * 0.22;
+    gl_FragColor = vec4(RainLight.rgb * a, a);");
+    }
+}
