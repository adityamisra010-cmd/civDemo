+    /// <summary>Smoke puffs are a pure function of scene time: the same time draws the same frame, another time a
+    /// different one, and a layer without sources draws nothing.</summary>
+    [GfxFact]
+    public void SmokeIsAPureFunctionOfSceneTime()
+    {
+        TestGfx.Host.Invoke(gd =>
+        {
+            using var pillar = new PillarScene(gd);
+            using var smoke = new SmokeLayer(gd);
+            using var empty = new SmokeLayer(gd);
+            var (cam, _, _, _, _) = SunBehind();
+            var l = Sun.DirectionToLight; var sd = Vector3.Normalize(new Vector3(l.X, 0, l.Z));
+            smoke.Add(SmokeSource.Plume(new Vector3(sd.Z, 0f, -sd.X) * -3f));
+            var with = new WeatherBox(pillar, null, smoke); var none = new WeatherBox(pillar, null, empty); var bare = new WeatherBox(pillar, null, null);
+            using var rt = new RenderTarget2D(gd, W, H, false, SurfaceFormat.Color, DepthFormat.None);
+            using var r = NewRenderer(gd, "");
+            var a = Frame(r, with, cam, rt, 6f); int puffs = smoke.LastPuffs;
+            var a2 = Frame(r, with, cam, rt, 6f);
+            Assert.Equal(puffs, smoke.LastPuffs);
+            var b = Frame(r, with, cam, rt, 9.5f);
+            Assert.True(puffs > 10, "puffs alive");
+            Assert.Equal(0, Capture.CountChanged(a, a2, 0));
+            Assert.True(Capture.CountChanged(a, b, 2) > 50, "the plume moved");
+            Assert.True(Capture.CountChanged(Frame(r, bare, cam, rt, 6f), a, 2) > 50, "the plume is visible");
+            Assert.Equal(0, Capture.CountChanged(Frame(r, bare, cam, rt, 6f), Frame(r, none, cam, rt, 6f), 0));
+        });
+    }
