+using System.Globalization;
+using Gfx.Chars.Animation;
+using Gfx.Engine.Cameras;
+using Gfx.Engine.Rendering;
+using Gfx.Engine.Scene;
+using Gfx.Gear.Items;
+using Gfx.Gear.Runtime;
+using Gfx.Proc.Environment.Trees;
+using Gfx.Proc.Presentation;
+using Microsoft.Xna.Framework;
+
+namespace Gfx.Demo.Scenes.Bench;
+
+/// <summary>
+/// Death and execution content of cinematics (presentation setting, D-079 DR41: execution and death are depicted only
+/// when the content is enabled). Its DEFAULT IS OPEN (D-079 Q12): this type has no default and every scene that uses it
+/// is built with an explicit value (the members start at 1, so <c>default(DeathContent)</c> is not a value and is rejected).
+/// <see cref="Shown"/>: the fallen lie where the trace says they fell and the aftermath
+/// has a shot of them. <see cref="CutAway"/>: no dead soldier is drawn anywhere and that shot cuts away to the sky.
+/// Neither changes anything else: the trace, the outcome and every other beat are the same.
+/// </summary>
+public enum DeathContent { Shown = 1, CutAway = 2 }
+
+/// <summary>One beat of the aftermath: a camera move (start → end pose over the beat), the hour of its light.</summary>
+public sealed record AftermathShot(string Name, CameraPose From, CameraPose To, float Seconds, float Hour, string Depicts);
+
+/// <summary>
+/// The aftermath plan (pure data) derived from the battle trace's recorded outcome (D-079 DR40, DR41): who holds the
+/// field, whether the defeated side has soldiers who surrendered, which soldiers stand for the two hero characters,
+/// and whether the dead are
+/// shown. The heroes' pair is the clearest surrender stage: a victors' standing soldier and a defeated prisoner
+/// <see cref="PairMin"/>-<see cref="PairMax"/> m apart with the fewest other soldiers on their feet or knees within
+/// <see cref="StageRadius"/> m of them (ties: lower ids); without such a pair, the victors' soldier nearest the prisoners
+/// and the prisoner nearest him. Rules: (1) the victor is the resolver's <c>holdsField</c> side; with none, there is no victory beat and no
+/// raised standard; (2) the surrender beat exists only if the defeated side has Surrendered soldiers at the end, and its
+/// officer IS one of them (his position and state are the trace's); (3) with <see cref="DeathContent.CutAway"/> no shot
+/// depicts the dead. Nothing is invented that the trace contradicts.
+/// </summary>
+public sealed record AftermathPlan(int Victor, int Defeated, bool Surrender, int CommanderEntity, int OfficerEntity, DeathContent Content,
+    int VictorsStanding, int Prisoners, int VictorPrisoners, int Fallen, int Escaped)
+{
+    public bool HasVictor => Victor >= 0;
+    /// <summary>The surrender pair's distance window and the radius of the stage around them (m).</summary>
+    public const float PairMin = 1.8f, PairMax = 4.5f, StageRadius = 4f;
+    /// <summary>Soldiers on their feet or knees within <see cref="StageRadius"/> of the chosen pair (-1: rule (b) chose).</summary>
+    public int StageCrowd { get; init; } = -1;
+
+    /// <summary>The plan from the trace's last snapshot; <paramref name="place"/> gives an entity's world position there
+    /// (the trace crowd's, or <see cref="BenchBattle.FinalPosition"/> on the ground plane).</summary>
+    public static AftermathPlan From(BenchBattle b, Func<int, Vector3> place, DeathContent content)
+    {
+        if (!Enum.IsDefined(content)) throw new ArgumentOutOfRangeException(nameof(content), content, "the death-content setting has no default (D-079 Q12): pass Shown or CutAway");
+        var tr = b.Trace; int last = tr.StepCount - 1;
+        int victor = b.HoldsField, defeated = victor >= 0 ? 1 - victor : -1;
+        int standing = 0, prisoners = 0, vPrisoners = 0, fallen = 0, escaped = 0;
+        var sur = Vector3.Zero; int nSur = 0;
+        for (int e = 0; e < tr.Entities.Count; e++)
+        {
+            var st = BenchBattle.Map(tr.State(last, e)); int side = tr.Entities[e].Side;
+            if (st == TraceSoldierState.Dead) fallen++;
+            else if (st == TraceSoldierState.Escaped) escaped++;
+            else if (st == TraceSoldierState.Surrendered) { if (side == defeated) { prisoners++; sur += place(e); nSur++; } else vPrisoners++; }
+            else if (side == victor && st == TraceSoldierState.Active) standing++;
+        }
+        int commander = -1, officer = -1, stageCrowd = -1;
+        if (victor >= 0)
+        {
+            int n = tr.Entities.Count;
+            var pos = new Vector3[n]; var st = new TraceSoldierState[n];
+            for (int e = 0; e < n; e++) { pos[e] = place(e); st[e] = BenchBattle.Map(tr.State(last, e)); }
+            // (a) the clearest surrender stage: a victors' standing soldier and a defeated prisoner PairMin-PairMax m
+            //     apart with the fewest other soldiers on their feet or knees within StageRadius m of their midpoint;
+            //     ties: the lower commander id, then the lower officer id
+            int bestCrowd = int.MaxValue;
+            if (nSur > 0)
+                for (int v = 0; v < n; v++)
+                {
+                    if (tr.Entities[v].Side != victor || st[v] != TraceSoldierState.Active) continue;
+                    for (int o = 0; o < n; o++)
+                    {
+                        if (tr.Entities[o].Side != defeated || st[o] != TraceSoldierState.Surrendered) continue;
+                        float dx = pos[o].X - pos[v].X, dz = pos[o].Z - pos[v].Z, d2 = dx * dx + dz * dz;
+                        if (d2 < PairMin * PairMin || d2 > PairMax * PairMax) continue;
+                        float mx = (pos[o].X + pos[v].X) * 0.5f, mz = (pos[o].Z + pos[v].Z) * 0.5f;
+                        int crowd = 0;
+                        for (int e = 0; e < n && crowd < bestCrowd; e++)
+                        {
+                            if (e == v || e == o || st[e] is TraceSoldierState.Dead or TraceSoldierState.Escaped) continue;
+                            float ex = pos[e].X - mx, ez = pos[e].Z - mz;
+                            if (ex * ex + ez * ez < StageRadius * StageRadius) crowd++;
+                        }
+                        if (crowd < bestCrowd) { bestCrowd = crowd; commander = v; officer = o; }
+                    }
+                }
+            if (commander < 0)
+            {
+                // (b) without such a pair: the victors' standing soldier nearest the prisoners (or the field's centre
+                //     without prisoners) and the prisoner nearest him
+                var target = nSur > 0 ? sur / nSur : Vector3.Zero;
+                float best = float.MaxValue;
+                for (int e = 0; e < n; e++)
+                {
+                    if (tr.Entities[e].Side != victor || st[e] != TraceSoldierState.Active) continue;
+                    float d = Vector3.DistanceSquared(pos[e], target);
+                    if (d < best) { best = d; commander = e; }
+                }
+                if (nSur > 0 && commander >= 0)
+                {
+                    var c = pos[commander]; best = float.MaxValue;
+                    for (int e = 0; e < n; e++)
+                    {
+                        if (tr.Entities[e].Side != defeated || st[e] != TraceSoldierState.Surrendered) continue;
+                        float d = Vector3.DistanceSquared(pos[e], c);
+                        if (d < best) { best = d; officer = e; }
+                    }
+                }
+            }
+            if (bestCrowd != int.MaxValue) stageCrowd = bestCrowd;
+        }
+        return new AftermathPlan(victor, defeated, officer >= 0, commander, officer, content, standing, prisoners, vPrisoners, fallen, escaped) { StageCrowd = stageCrowd };
+    }
+}
+
+/// <summary>
+/// Benchmark scene D, the cinematic aftermath (stage scenes, D-078 QM8 D, D-079 DR40/DR41/DR45): the end of the scene-C
+/// battle as the trace records it, with the two hero characters of the surrender beat played by the trace's own soldiers
+/// (<see cref="AftermathPlan"/>): the victors' commander raises his sword over a defeated officer who kneels with his
+/// weapons on the ground, the prisoners kneel where they surrendered, the victor's standard is raised and the defeated
+/// standard lies on the ground, smoke rises from the field and dust drifts. Camera moves per beat (crane, dolly, push-in,
+/// close-ups, low angles); the benchmark harness plays them in order. Scene time = battle end + cinematic time.
+/// Two registered scenes, one per death-content state; neither is a default (D-079 Q12 is open).
+/// PRESENTATION ONLY: the trace and the grid are read, never written.
+/// </summary>
+public abstract class BenchAftermathScene : BenchSceneBase, ICameraPathScene
+{
+    public DeathContent Content { get; }
+    public BenchBattle Battle { get; private set; } = null!;
+    public TraceCrowd Troops { get; private set; } = null!;
+    public AftermathPlan Outcome { get; private set; } = null!;
+    public IReadOnlyList<AftermathShot> Beats => _beats;
+    readonly List<AftermathShot> _beats = new();
+    SmokeLayer _smoke = null!;
+    KitSoldier? _commander, _officer;
+    Banner? _victorBanner, _defeatedBanner;
+    Vector3 _cPos, _oPos, _fallen; float _cYaw, _oYaw;
+    float _tEnd;
+
+    protected BenchAftermathScene(DeathContent content)
+    {
+        if (!Enum.IsDefined(content)) throw new ArgumentOutOfRangeException(nameof(content), content, "the death-content setting has no default (D-079 Q12): pass Shown or CutAway");
+        Content = content;
+    }
+
+    protected override float ShadowDistanceM => 600f;
+
+    protected override IReadOnlyList<Exclusion>? TreeExclusions(TerrainMeshData mesh)
+    {
+        Battle ??= BenchBattle.Load();
+        return BenchBattlefieldScene.BattleGround(Battle, 8f, 7f);
+    }
+
+    protected override void Build()
+    {
+        Battle ??= BenchBattle.Load();
+        var m = Env.Terrain.Mesh;
+        Troops = new TraceCrowd(Device, Battle, m.HeightAt) { ShowDead = Content == DeathContent.Shown };
+        _tEnd = Battle.Duration;
+        Outcome = AftermathPlan.From(Battle, e => Troops.Place(e, _tEnd).pos, Content);
+        _smoke = new SmokeLayer(Device);
+        if (Outcome.CommanderEntity >= 0)
+        {
+            Troops.HeroEntities.Add(Outcome.CommanderEntity);
+            (_cPos, _) = Troops.Place(Outcome.CommanderEntity, _tEnd);
+        }
+        if (Outcome.OfficerEntity >= 0)
+        {
+            Troops.HeroEntities.Add(Outcome.OfficerEntity);
+            (_oPos, _) = Troops.Place(Outcome.OfficerEntity, _tEnd);
+            _cYaw = YawTo(new Vector2(_cPos.X, _cPos.Z), new Vector2(_oPos.X, _oPos.Z));
+            _oYaw = _cYaw + MathF.PI;
+        }
+        else if (Outcome.CommanderEntity >= 0) (_, _cYaw) = Troops.Place(Outcome.CommanderEntity, _tEnd);
+        BuildHeroes();
+        _fallen = FallenCentre();
+        BuildSmoke();
+        Animate(_tEnd);
+    }
+
+    void BuildHeroes()
+    {
+        if (Outcome.CommanderEntity < 0) return;
+        var cast = EnsureCast();
+        Vector3 G(Vector3 p) => new(p.X, Env.Terrain.HeightAt(p.X, p.Z), p.Z);
+        // the commander: the victors' kit (stage-chars mail and surcoat), bare-headed, heater shield and arming sword
+        var cBody = cast.Stage.Spawn("commander_a", "kit_a");
+        KitAssets.StripBakedKit(cBody);
+        Gfx.Gear.Anim.CombatClips.Install(cBody.Asset);
+        var cKit = new Loadout
+        {
+            Right = Weapons.Build(new WeaponSpec { Kind = "arming", Seed = 811, MapSize = 512 }), RightFrame = "grip",
+            Left = Shields.Build(new ShieldSpec { Kind = "heater", Seed = 812, Field = "#2B4373", Charge = "#C29A45", Device = "chevron", Wear = 0.6 }),
+            Mode = Gfx.Gear.Rig.LeftHold.Strap, SleeveThickness = 0.028f,
+        };
+        cKit.Carried.Add((Weapons.Build(new WeaponSpec { Kind = "scabbard", Seed = 813, MapSize = 512 }), "hang", "hip_l"));
+        _commander = new KitSoldier(cast.Kit, cBody, cKit, "bench-d:commander") { Ground = p => Env.Terrain.HeightAt(p.X, p.Z) };
+        float victoryAt = BeatStart("surrender") + 1.2f;
+        var cAt = _cPos; float cYaw = _cYaw;
+        _commander.Drive(t => new AnimInput
+        {
+            Speed = 0, Action = t >= victoryAt ? "kit.sword.victory" : "kit.sword.guard", ActionStart = t >= victoryAt ? victoryAt : 0f,
+            HoldLastFrame = true, FootLock = false,
+            LookAt = Outcome.Surrender ? new Vector3(_oPos.X, _oPos.Y + 0.9f, _oPos.Z) : null,
+        }, t => Matrix.CreateRotationY(cYaw) * Matrix.CreateTranslation(G(cAt)));
+        // the victor's standard, planted two metres behind the commander's shield side (StandardPlaces)
+        var (vStd, dStd) = StandardPlaces(cAt, cYaw, _oPos, _oYaw);
+        _victorBanner = Banner.Create(cast.Kit, Banner.Build(new BannerSpec { Seed = 821, MapSize = 512, Field = "#2B4373", Charge = "#C29A45", Device = "chevron", Fringe = "#C29A45" }),
+            Matrix.CreateRotationY(cYaw - MathHelper.PiOver2) * Matrix.CreateTranslation(G(vStd)));
+        if (!Outcome.Surrender) return;
+        // the officer: one of the defeated soldiers who surrendered, kneeling with his hands raised, his sword and shield
+        // on the ground beside him (the surrender clip held at its last frame; he surrendered before the scene begins)
+        var oBody = cast.Stage.Spawn("b3", "kit_b");
+        KitAssets.StripBakedKit(oBody);
+        Gfx.Gear.Anim.CombatClips.Install(oBody.Asset);
+        var oKit = new Loadout
+        {
+            Right = Weapons.Build(new WeaponSpec { Kind = "arming", Seed = 831, MapSize = 512 }), RightFrame = "grip",
+            Left = Shields.Build(new ShieldSpec { Kind = "kite", Seed = 832, Field = "#93301F", Charge = "#DAD3C1", Device = "saltire", Wear = 0.75 }),
+            Mode = Gfx.Gear.Rig.LeftHold.Strap, SleeveThickness = 0.028f,
+        };
+        _officer = new KitSoldier(cast.Kit, oBody, oKit, "bench-d:officer") { Ground = p => Env.Terrain.HeightAt(p.X, p.Z) };
+        var oAt = _oPos; float oYaw = _oYaw;
+        _officer.Drive(t => new AnimInput { Speed = 0, Action = "kit.sword.surrender", ActionStart = -12f, HoldLastFrame = true, FootLock = false,
+            LookAt = new Vector3(_cPos.X, _cPos.Y + 1.6f, _cPos.Z) }, t => Matrix.CreateRotationY(oYaw) * Matrix.CreateTranslation(G(oAt)));
+        _officer.ReleaseRight = -12f + 0.30f; _officer.ReleaseLeft = -12f + 0.40f;
+        // the defeated standard lies on the ground beside the officer, its cloth slack (StandardPlaces)
+        var foot = G(dStd);
+        _defeatedBanner = Banner.Create(cast.Kit, Banner.Build(new BannerSpec { Seed = 841, MapSize = 512, Field = "#93301F", Charge = "#DAD3C1", Device = "saltire", Fringe = "#DAD3C1" }),
+            Matrix.CreateRotationZ(-MathHelper.PiOver2 + 0.05f) * Matrix.CreateRotationY(oYaw + 0.4f) * Matrix.CreateTranslation(foot + new Vector3(0, 0.06f, 0)));
+    }
+
+    /// <summary>Smoke from the three 24 m cells with the most dead (fires among the wreckage) and dust from the five
+    /// densest cells of those still on their feet or knees, none within 25-30 m of the heroes and no fire within 40 m of
+    /// the fallen the last beat looks at (the close shots look through clear air).</summary>
+    void BuildSmoke()
+    {
+        var tr = Battle.Trace; int last = tr.StepCount - 1;
+        var dead = new SortedDictionary<(int, int), int>();
+        var stand = new SortedDictionary<(int, int), int>();
+        for (int e = 0; e < tr.Entities.Count; e++)
+        {
+            var st = BenchBattle.Map(tr.State(last, e));
+            var p = Troops.Place(e, _tEnd).pos;
+            var key = ((int)MathF.Floor(p.X / 24f), (int)MathF.Floor(p.Z / 24f));
+            if (st == TraceSoldierState.Dead) dead[key] = dead.GetValueOrDefault(key) + 1;
+            else if (st is TraceSoldierState.Active or TraceSoldierState.Surrendered) stand[key] = stand.GetValueOrDefault(key) + 1;
+        }
+        Vector3 Cell((int, int) k) { float x = (k.Item1 + 0.5f) * 24f, z = (k.Item2 + 0.5f) * 24f; return new Vector3(x, Env.Terrain.HeightAt(x, z), z); }
+        // fires: the densest cells of the fallen (ties: the lower key)
+        int n = 0;
+        foreach (var kv in dead.OrderByDescending(kv => kv.Value).ThenBy(kv => kv.Key))
+        {
+            var at = Cell(kv.Key);
+            if (Outcome.CommanderEntity >= 0 && Vector2.Distance(new Vector2(at.X, at.Z), new Vector2(_cPos.X, _cPos.Z)) < 25f) continue;
+            if (Vector2.Distance(new Vector2(at.X, at.Z), new Vector2(_fallen.X, _fallen.Z)) < 40f) continue;
+            if (n++ >= 3) break;
+            _smoke.Add(SmokeSource.Plume(at, 0.9f + 0.15f * n));
+        }
+        // dust: the densest cells of those still on their feet or knees, but not within 30 m of the heroes (the close
+        // shots look through clear air)
+        n = 0;
+        foreach (var kv in stand.OrderByDescending(kv => kv.Value).ThenBy(kv => kv.Key))
+        {
+            var at = Cell(kv.Key);
+            if (Outcome.CommanderEntity >= 0 && Vector2.Distance(new Vector2(at.X, at.Z), new Vector2(_cPos.X, _cPos.Z)) < 30f) continue;
+            if (n++ >= 5) break;
+            _smoke.Add(SmokeSource.Dust(at));
+        }
+    }
+
+    float BeatStart(string name)
+    {
+        float t = 0;
+        foreach (var b in _beats) { if (b.Name == name) return t; t += b.Seconds; }
+        // the beats are made after the heroes: before that, the standard layout of PlanBeats is used
+        return name switch { "field" => 0f, "prisoners" => 5f, "surrender" => 10f, _ => 16f };
+    }
+
+    Vector3 G(Vector3 p, float up) => new(p.X, Env.Terrain.HeightAt(p.X, p.Z) + up, p.Z);
+
+    protected override void BuildShots()
+    {
+        _beats.Clear();
+        _beats.AddRange(PlanBeats(Outcome, _cPos, _oPos, _cYaw, _fallen, FieldCentre(), PrisonersCentre(), Occluders(), G, ShieldSide()));
+        // the opening crane is high over the field: turned to the clearest view of the trees
+        if (_beats.Count > 0 && _beats[0].Name == "field")
+        {
+            var b = _beats[0];
+            var still = Lerp(b.From, b.To, StillAt);
+            var eye = ClearEye(still.Position, still.Target, still.FovYRadians, 60f);
+            var move = eye - still.Position;
+            _beats[0] = b with { From = b.From with { Position = b.From.Position + move }, To = b.To with { Position = b.To.Position + move } };
+        }
+        var shots = new List<CaptureShot>();
+        float t = 0;
+        for (int i = 0; i < _beats.Count; i++)
+        {
+            var b = _beats[i];
+            shots.Add(new CaptureShot($"{i:00}-{b.Name}", Lerp(b.From, b.To, StillAt), b.Hour, _tEnd + t + StillAt * b.Seconds));
+            t += b.Seconds;
+        }
+        ShotList = shots.ToArray();
+    }
+
+    /// <summary>The side (+1/-1 along the commander-to-officer cross axis s = (-d.z, 0, d.x)) of the commander's shield
+    /// arm, from his posed left shoulder (1 without a commander).</summary>
+    int ShieldSide()
+    {
+        if (_commander == null) return 1;
+        var inst = _commander.Body; inst.SolvePose();
+        var shoulder = Vector3.Transform(inst.Heads[inst.Asset.Skeleton["upperarm_l"]], inst.World);
+        var o = Outcome.Surrender ? _oPos : _cPos + new Vector3(MathF.Sin(_cYaw), 0, MathF.Cos(_cYaw)) * 3f;
+        var d = Vector3.Normalize(new Vector3(o.X - _cPos.X, 0, o.Z - _cPos.Z));
+        return Vector3.Dot(shoulder - _cPos, new Vector3(-d.Z, 0, d.X)) >= 0f ? 1 : -1;
+    }
+
+    /// <summary>Where in each beat the still is taken (fraction of the move): the solved camera pose.</summary>
+    public const float StillAt = 0.62f;
+
+    /// <summary>Soldiers on their feet or knees at the end (not the heroes): what can stand in a close shot's way.</summary>
+    List<Vector3> Occluders()
+    {
+        var tr = Battle.Trace; int last = tr.StepCount - 1; var list = new List<Vector3>();
+        for (int e = 0; e < tr.Entities.Count; e++)
+        {
+            if (e == Outcome.CommanderEntity || e == Outcome.OfficerEntity) continue;
+            if (BenchBattle.Map(tr.State(last, e)) is TraceSoldierState.Dead or TraceSoldierState.Escaped) continue;
+            list.Add(Troops.Place(e, _tEnd).pos);
+        }
+        return list;
+    }
+
+    /// <summary>The centre of everyone left on the field at the end (standing, kneeling or fallen; not the escaped).</summary>
+    Vector3 FieldCentre()
+    {
+        var tr = Battle.Trace; int last = tr.StepCount - 1; var c = Vector3.Zero; int n = 0;
+        for (int e = 0; e < tr.Entities.Count; e++)
+        {
+            if (BenchBattle.Map(tr.State(last, e)) == TraceSoldierState.Escaped) continue;
+            c += Troops.Place(e, _tEnd).pos; n++;
+        }
+        return n > 0 ? c / n : _cPos;
+    }
+
+    /// <summary>The centre of the defeated prisoners within 20 m of the officer (the officer's place without them).</summary>
+    Vector3 PrisonersCentre()
+    {
+        var tr = Battle.Trace; int last = tr.StepCount - 1; var c = Vector3.Zero; int n = 0;
+        for (int e = 0; e < tr.Entities.Count; e++)
+        {
+            if (tr.Entities[e].Side != Outcome.Defeated || BenchBattle.Map(tr.State(last, e)) != TraceSoldierState.Surrendered) continue;
+            var p = Troops.Place(e, _tEnd).pos;
+            if (Vector3.Distance(p, _oPos) > 20f) continue;
+            c += p; n++;
+        }
+        return n > 0 ? c / n : _oPos;
+    }
+
+    /// <summary>Where the two standards stand (victor's, raised behind the commander) and lie (defeated's, beside the
+    /// officer), from the heroes' places and facings.</summary>
+    public static (Vector3 victor, Vector3 defeated) StandardPlaces(Vector3 c, float cYaw, Vector3 o, float oYaw)
+    {
+        var fwd = new Vector3(MathF.Sin(cYaw), 0, MathF.Cos(cYaw)); var left = new Vector3(fwd.Z, 0, -fwd.X);
+        var ob = new Vector3(MathF.Sin(oYaw), 0, MathF.Cos(oYaw)); var ol = new Vector3(ob.Z, 0, -ob.X);
+        return (c - fwd * 2.2f + left * 1.6f, o + ol * 1.8f - ob * 0.6f);
+    }
+
+    /// <summary>How many soldiers (vertical capsules 0.45 m in radius and 1.8 m tall) stand across the sight line from
+    /// the eye to the target, the last 0.8 m before the target excepted (the subject's own place).</summary>
+    public static int Blockers(Vector3 eye, Vector3 target, IReadOnlyList<Vector3> occ)
+    {
+        var a = new Vector2(eye.X, eye.Z); var ab = new Vector2(target.X, target.Z) - a; float len2 = ab.LengthSquared();
+        if (len2 < 1e-4f) return 0;
+        float len = MathF.Sqrt(len2); int n = 0;
+        foreach (var p in occ)
+        {
+            var q = new Vector2(p.X, p.Z);
+            float u = Vector2.Dot(q - a, ab) / len2;
+            if (u <= 0f || u * len > len - 0.8f) continue;
+            if (Vector2.DistanceSquared(a + ab * u, q) > 0.45f * 0.45f) continue;
+            if (MathHelper.Lerp(eye.Y, target.Y, u) < p.Y + 1.8f) n++;
+        }
+        return n;
+    }
+
+    /// <summary>The blockers of a close shot: the line to the target (twice), to points a quarter of the distance either
+    /// side of it (at least 0.6 m) and to the point half a metre below it.</summary>
+    public static int ViewBlockers(Vector3 eye, Vector3 target, IReadOnlyList<Vector3> occ)
+    {
+        var f = target - eye; f.Y = 0;
+        var side = f.LengthSquared() < 1e-6f ? Vector3.UnitX : Vector3.Normalize(new Vector3(-f.Z, 0, f.X));
+        float w = MathF.Max(0.6f, (target - eye).Length() * 0.25f);
+        return 2 * Blockers(eye, target, occ) + Blockers(eye, target + side * w, occ) + Blockers(eye, target - side * w, occ)
+             + Blockers(eye, target - Vector3.UnitY * 0.5f, occ);
+    }
+
+    /// <summary>The eye turned about the target's vertical axis in <paramref name="stepDeg"/> steps up to
+    /// <paramref name="maxTurnDeg"/> either way (keeping its distance and its height above the ground) with the fewest
+    /// <see cref="ViewBlockers"/>; ties: the smaller turn, then the positive one.</summary>
+    public static Vector3 Solve(Vector3 eye, Vector3 target, IReadOnlyList<Vector3> occ, Func<Vector3, float, Vector3> G, float maxTurnDeg, float stepDeg = 15f)
+    {
+        float up = eye.Y - G(eye, 0f).Y;
+        var rel = new Vector2(eye.X - target.X, eye.Z - target.Z);
+        Vector3 best = eye; int bestCost = int.MaxValue;
+        for (int k = 0; k * stepDeg <= maxTurnDeg + 1e-3f; k++)
+            for (int sgn = 1; sgn >= -1; sgn -= 2)
+            {
+                if (k == 0 && sgn < 0) continue;
+                float ang = MathHelper.ToRadians(stepDeg * k * sgn), cs = MathF.Cos(ang), sn = MathF.Sin(ang);
+                var cand = G(new Vector3(target.X + rel.X * cs - rel.Y * sn, 0, target.Z + rel.X * sn + rel.Y * cs), up);
+                int cost = ViewBlockers(cand, target, occ);
+                if (cost < bestCost) { bestCost = cost; best = cand; }
+            }
+        return best;
+    }
+
+    /// <summary>The first of the candidate eyes with the fewest <see cref="ViewBlockers"/> (the list order breaks ties).</summary>
+    public static Vector3 FirstClearest(IReadOnlyList<Vector3> eyes, Vector3 target, IReadOnlyList<Vector3> occ)
+    {
+        Vector3 best = eyes[0]; int bestCost = int.MaxValue;
+        foreach (var e in eyes)
+        {
+            int c = ViewBlockers(e, target, occ);
+            if (c < bestCost) { bestCost = c; best = e; }
+        }
+        return best;
+    }
+
+    /// <summary>A beat whose still (at <see cref="StillAt"/> of the move) is exactly the given pose: the camera moves by
+    /// <paramref name="eyeMove"/> and its aim by <paramref name="aimMove"/> over the beat.</summary>
+    static AftermathShot Beat(string name, Vector3 eye, Vector3 target, float fov, float near, Vector3 eyeMove, Vector3 aimMove, float seconds, float hour, string depicts) =>
+        new(name, new CameraPose(eye - eyeMove * StillAt, target - aimMove * StillAt, fov, near, 40000f),
+            new CameraPose(eye + eyeMove * (1 - StillAt), target + aimMove * (1 - StillAt), fov, near, 40000f), seconds, hour, depicts);
+
+    /// <summary>
+    /// The aftermath beats of a plan (pure: the death-content rule is tested on it). Inputs: the two heroes' places, the
+    /// commander's facing (used when there is no surrender), the centre of the densest cluster of the fallen, the centre
+    /// of the field (everyone left on it), the centre of the prisoners near the officer, the soldiers that can stand in a
+    /// close shot's way, the ground function (position, height above the ground) and the side of the commander's
+    /// shield arm. Each close shot's camera is turned to the view with the fewest soldiers across it (<see cref="Solve"/>,
+    /// <see cref="FirstClearest"/>). Beats 1-6 are the same in both content states; the 7th is "fallen"
+    /// (<see cref="DeathContent.Shown"/>) or "cutaway".
+    /// </summary>
+    public static List<AftermathShot> PlanBeats(AftermathPlan plan, Vector3 commander, Vector3 officer, float commanderYaw,
+        Vector3 fallen, Vector3 field, Vector3 prisoners, IReadOnlyList<Vector3> occ, Func<Vector3, float, Vector3> G, int shieldSide = 1)
+    {
+        var beats = new List<AftermathShot>();
+        float h = BenchHours.Golden;
+        if (plan.CommanderEntity < 0)
+        {
+            // no victor: a single sombre crane over the field, no victory beat, no standard
+            beats.Add(new AftermathShot("field", new CameraPose(G(field, 70f) + new Vector3(-60, 0, -60), G(field, 0f)), new CameraPose(G(field, 40f) + new Vector3(-40, 0, -40), G(field, 0f)), 6f, BenchHours.Dusk, "the field, no victor"));
+            return beats;
+        }
+        var c = commander;
+        var o = plan.Surrender ? officer : c + new Vector3(MathF.Sin(commanderYaw), 0, MathF.Cos(commanderYaw)) * 3f;
+        var d = Vector3.Normalize(new Vector3(o.X - c.X, 0, o.Z - c.Z));            // commander -> officer
+        var s = new Vector3(-d.Z, 0, d.X);                                            // across
+        var mid = (c + o) * 0.5f;
+        float sep = Vector3.Distance(new Vector3(c.X, 0, c.Z), new Vector3(o.X, 0, o.Z));
+        float cYaw = plan.Surrender ? MathF.Atan2(d.X, d.Z) : commanderYaw, oYaw = cYaw + MathF.PI;
+        var (vStd, dStd) = StandardPlaces(c, cYaw, o, oYaw);
+        int Side(Func<float, Vector3> eyeFor, Vector3 target) => ViewBlockers(eyeFor(1f), target, occ) <= ViewBlockers(eyeFor(-1f), target, occ) ? 1 : -1;
+        // 1 crane over the field (the centre of everyone still on it: standing, kneeling or fallen) from the victors'
+        //   side, down towards it
+        beats.Add(new AftermathShot("field", new CameraPose(G(field - d * 75f + s * 45f, 42f), G(field + d * 10f, 0f), 0.8f, 0.3f, 40000f),
+            new CameraPose(G(field - d * 50f + s * 30f, 24f), G(field, 0f), 0.8f, 0.3f, 40000f), 5f, h, "the field after the battle: victors, prisoners, smoke"));
+        // 2 dolly along the kneeling prisoners, from the victors' side
+        var pT = G(prisoners, 0.8f);
+        var pEye = Solve(G(prisoners - d * 6.5f - s * 2f, 1.7f), pT, occ, G, 90f);
+        var pSide = Vector3.Normalize(Vector3.Cross(Vector3.Normalize(pT - pEye), Vector3.Up));
+        beats.Add(Beat("prisoners", pEye, pT, 0.70f, 0.1f, pSide * 5f, pSide * 5f, 5f, h, plan.Surrender ? "the defeated who surrendered kneel" : "the victors hold the field"));
+        // 3 the surrender: two-shot from across the pair, slow push-in (the clearer side, then turned to the clearest view)
+        var mT = G(mid, 1.05f);
+        float two = MathF.Max(4.2f, sep * 1.25f);
+        int sg = Side(k => G(mid + s * (two * k), 1.5f), mT);
+        var mEye = Solve(G(mid + s * (two * sg), 1.5f), mT, occ, G, 45f);
+        beats.Add(Beat("surrender", mEye, mT, 0.62f, 0.1f, (mT - mEye) * 0.12f, Vector3.Zero, 6f, h, plan.Surrender ? "the commander takes the surrender" : "the commander"));
+        // 4 the officer's face, over the commander's shoulder (the clearer shoulder)
+        var oT = G(o, 1.05f);
+        sg = Side(k => G(c + d * 0.9f + s * (0.55f * k), 1.55f), oT);
+        var oEye = G(c + d * 0.9f + s * (0.55f * sg), 1.55f);
+        beats.Add(Beat("officer-face", oEye, oT, 0.40f, 0.05f, d * 0.2f, Vector3.Zero, 3.5f, h, "the defeated officer"));
+        // 5 the commander from low and in front, turned 15-75 degrees towards his sword arm (his shield is on the other
+        //   side: shieldSide is the side of s it is on), against the sky; the kneeling officer counts as an occluder;
+        //   the candidates are tried in the order 30, 45, 15, 60, 75 degrees and the first with the fewest blockers wins
+        var cT = G(c, 1.64f);
+        var occ5 = new List<Vector3>(occ) { o };
+        var sword = s * -shieldSide;
+        var cands = new[] { 30f, 45f, 15f, 60f, 75f }.Select(a =>
+        {
+            float r = MathHelper.ToRadians(a);
+            return G(c + (d * MathF.Cos(r) + sword * MathF.Sin(r)) * 2.6f, 1.1f);
+        }).ToList();
+        var cEye = FirstClearest(cands, cT, occ5);
+        beats.Add(Beat("commander-face", cEye, cT, 0.44f, 0.05f, (cT - cEye) * 0.06f, Vector3.UnitY * 0.04f, 3.5f, h, "the victorious commander"));
+        // 6 standards: low behind the defeated standard on the ground, the victor's raised beyond the commander
+        var sT = G(vStd, 2.3f);
+        var back = new Vector3(dStd.X - vStd.X, 0, dStd.Z - vStd.Z);
+        back = back.LengthSquared() < 1e-4f ? -d : Vector3.Normalize(back);
+        var sEye = Solve(G(dStd + back * 1.8f, 1.0f), sT, occ, G, 45f);
+        beats.Add(Beat("standards", sEye, sT, 0.62f, 0.05f, Vector3.UnitY * 0.12f, Vector3.UnitY * 0.2f, 4f, h, "standards: the victor's raised, the defeated's on the ground"));
+        // 7 the fallen, or the cut-away (death content setting)
+        if (plan.Content == DeathContent.Shown)
+        {
+            var fT = G(fallen, 0.3f);
+            var fEye = Solve(G(fallen - d * 9f - s * 5f, 5.5f), fT, occ, G, 90f);
+            var fSide = Vector3.Normalize(Vector3.Cross(Vector3.Normalize(fT - fEye), Vector3.Up));
+            beats.Add(Beat("fallen", fEye, fT, 0.75f, 0.1f, fSide * 4f, fSide * 4f, 5f, h, "the fallen where they fell"));
+        }
+        else
+            beats.Add(new AftermathShot("cutaway", new CameraPose(G(mid - d * 12f, 1.8f), G(mid + d * 30f, 6f), 0.8f, 0.1f, 40000f),
+                new CameraPose(G(mid - d * 12f, 2.4f), G(mid + d * 60f, 40f), 0.8f, 0.1f, 40000f), 5f, BenchHours.Dusk, "cut away to the smoke and the sky (death content cut away)"));
+        return beats;
+    }
+
+    /// <summary>The centre of the densest cluster of the fallen on the field: the dead soldier with the most dead within
+    /// 6 m (ties: the lower entity), and the centroid of those (the commander's place without any dead).</summary>
+    Vector3 FallenCentre()
+    {
+        var tr = Battle.Trace; int last = tr.StepCount - 1;
+        var dead = new List<Vector3>();
+        for (int e = 0; e < tr.Entities.Count; e++)
+        {
+            if (BenchBattle.Map(tr.State(last, e)) != TraceSoldierState.Dead) continue;
+            dead.Add(Troops.Place(e, _tEnd).pos);
+        }
+        int best = -1, bestN = 0;
+        for (int i = 0; i < dead.Count; i++)
+        {
+            int n = 0;
+            foreach (var q in dead) if (Vector3.DistanceSquared(q, dead[i]) <= 36f) n++;
+            if (n > bestN) { bestN = n; best = i; }
+        }
+        if (best < 0) return _cPos;
+        var c = Vector3.Zero; int k = 0;
+        foreach (var q in dead) if (Vector3.DistanceSquared(q, dead[best]) <= 36f) { c += q; k++; }
+        return c / k;
+    }
+
+    static CameraPose Lerp(CameraPose a, CameraPose b, float u) => a with
+    {
+        Position = Vector3.Lerp(a.Position, b.Position, u), Target = Vector3.Lerp(a.Target, b.Target, u),
+        FovYRadians = MathHelper.Lerp(a.FovYRadians, b.FovYRadians, u),
+    };
+
+    public float CinematicSeconds => _beats.Sum(b => b.Seconds);
+
+    /// <summary>The harness's camera path (slot D): the beats in order, each beat's move over its share of the run.</summary>
+    public (CameraPose camera, float sceneTime, float hour) PathAt(float u)
+    {
+        float total = CinematicSeconds, t = Math.Clamp(u, 0f, 0.99999f) * total, acc = 0;
+        foreach (var b in _beats)
+        {
+            if (t < acc + b.Seconds) return (Lerp(b.From, b.To, (t - acc) / b.Seconds), _tEnd + t, b.Hour);
+            acc += b.Seconds;
+        }
+        var lb = _beats[^1];
+        return (lb.To, _tEnd + total, lb.Hour);
+    }
+
+    public string PathDescription => string.Create(CultureInfo.InvariantCulture,
+        $"aftermath beats ({string.Join(", ", _beats.Select(b => b.Name))}), {CinematicSeconds:F1} s played over the measured frames, death content {Content}");
+
+    public override Vector3 Focus => _cPos;
+
+    protected override void Animate(float t)
+    {
+        Troops?.Update(MathF.Max(t, _tEnd));
+        float tau = MathF.Max(0f, t - _tEnd);
+        if (_commander != null)
+        {
+            _commander.Update(tau);
+            var ex = _commander.Body.Expression; ex.Clear();
+            float vic = BeatStart("surrender") + 1.2f;
+            if (tau >= vic && tau < vic + 4.5f) ex["battlecry"] = 1f; else ex["grim"] = 0.8f;
+        }
+        if (_officer != null)
+        {
+            _officer.Update(tau);
+            var ex = _officer.Body.Expression; ex.Clear();
+            ex["pain"] = 0.55f; ex["grim"] = 0.35f;
+        }
+        _victorBanner?.Pose(tau + 3f, 0.7f);
+        _defeatedBanner?.Pose(0f, 0f);
+    }
+
+    protected override void DrawExtraShadows(RenderContext rc)
