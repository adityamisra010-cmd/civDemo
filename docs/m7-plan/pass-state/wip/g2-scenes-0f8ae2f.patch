+    }
+
+    protected override void DrawExtraTransparent(RenderContext rc) => _smoke.Draw(rc);
+
+    public override string FrameReport() => Troops.Report() + string.Format(CultureInfo.InvariantCulture,
+        " aftermath: victor={0} defeated={1} surrender-beat={2} commander-entity={3} officer-entity={4} standing={5} prisoners={6} victor-side-surrendered={7} fallen={8} escaped={9} death-content={10} smoke-puffs={11}",
