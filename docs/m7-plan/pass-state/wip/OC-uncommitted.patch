+using Proto.M7.Events;
+using Proto.M7.Fixed;
+using Proto.M7.War;
+using Proto.M7.War.Outcomes;
+using Proto.M7.War.Siege;
+using Proto.M7.Tests.Siege;
+using Xunit;
+using static Proto.M7.Tests.Outcomes.OutcomeRig;
+using static Proto.M7.Tests.TestSupport;
+
+namespace Proto.M7.Tests.LaneOC;
+
+/// <summary>
+/// [OC, completion after fix round 1, 2026-11-13] Item 7, THE PLAYER'S CAPTURE CHOICE: D-089 DH2 ("When the player's own immediate
+/// assault takes a city, the player is asked 'Occupy, sack or raze?' at the moment of capture"; it answers lane U's U-Q11) and DH2-R1
+/// (an AI taker still disposes by its doctrine at the moment of capture, unchanged). Lane S's immediate assault (an order issued at a
+/// siege pulse start acts at once, WA1) takes the city inside the order; lane W's world now raises a DECISION INSTANT at that instant
+/// after the order's consequences (EventRules R4's exception: an OrderConsequence event, one consequence window, the choice accepted
+/// there in class ConsequenceOrder), so the choice is offered and does not lapse (lane U's U-F4, U2-5). Lane W's refusals are
+/// unchanged. The rig is lane W's (OutcomeRig.BuildBound: lane S's walled city, polity 0's only city, besieged by polity 1).
+/// </summary>
+public sealed class CaptureChoiceTests
+{
+    private static readonly long Start = SiegeRig.At(1500, 100);
+    private const long SackD = (long)Disposition.Sack, RazeD = (long)Disposition.Raze, OccupyD = (long)Disposition.Occupy;
+
+    private sealed class Storms : IAssaultResolver
+    {
+        public AssaultResult Resolve(in AssaultInputs input, SiegeCoefficients k) => new(true, Q32.One, Q32.One, Q32.Zero, Q32.Zero);
+    }
+
+    private static (int, long, long) Assault => (SiegeKinds.OrderAssault, Pack(1, 0), 1_000L);
+    private static (int, long, long) Dispose(long d) => (OutcomeKinds.OrderDispose, Pack(1, 0), d);
+
+    /// <summary>The player's assault at Start; the stops the runner makes at Start are returned in order (every window at Start).</summary>
+    private static BoundBuilt Assaulted(int[]? ai = null, SubTurnOrderLog? replay = null, long[]? extraProbes = null)
+        => BuildBound(Start, foodDays: 120, stops: replay is null, probes: new[] { Start }.Concat(extraProbes ?? Array.Empty<long>()).ToArray(),
+                      resolver: new Storms(), replay: replay, ai: ai);
+
+    /// <summary>
+    /// TURN-EXACT PIN, the PLAYER'S PATH (D-089 DH2). Polity 1, a human player, orders the immediate assault at the siege pulse start
+    /// Start; it takes the city inside the order. The runner then stops AGAIN AT Start — a consequence window (AfterOrders) whose one hit
+    /// is DispositionDue for the city (class OrderConsequence, source the city) — and the player's "Sack" issued there is logged as a
+    /// consequence order, accepted (reason 0) and applied AT Start: the settlement outcome row is a Sack at Start, the loot reaches the
+    /// taker's treasury at Start, and nothing waits for a later instant (no window at Start + 1 ms, none at the next turn start for
+    /// it). Choosing Occupy there records Occupy; the choices differ in the ledger exactly by the sack's loot.
+    /// </summary>
+    [Theory]
+    [InlineData(SackD)]
+    [InlineData(OccupyD)]
+    public void DH2_ThePlayersOwnImmediateAssault_IsAskedAtTheMomentOfCapture_AndTheChoiceAppliesThere(long choice)
+    {
+        var b = Assaulted();
+        var r1 = b.R.RunUntil(Start + Day);
+        Assert.Equal((RunStatus.Interrupted, Start), (r1.Status, r1.AtMs));
+        Assert.False(b.R.Windows[^1].AfterOrders);                                    // the world window at Start (the probe)
+        b.R.IssueOrder(Assault.Item1, Assault.Item2, Assault.Item3);
+        long treasury0 = b.W.Ledger.Balance(b.W.TreasuryOf(1));
+        var r2 = b.R.RunUntil(Start + Day);
+        Assert.Equal((RunStatus.Interrupted, Start), (r2.Status, r2.AtMs));             // asked AT the moment of capture
+        var c = Assert.Single(b.Siege.Captures);
+        Assert.Equal((Start, 1), (c.AtMs, c.To));
+        var w = b.R.Windows[^1];
+        Assert.True(w.AfterOrders);
+        Assert.Equal(Start, w.InstantMs);
+        var hit = Assert.Single(w.Hits);
+        Assert.Equal(((byte)EventClass.OrderConsequence, OutcomeKinds.DispositionDue, 0L), (hit.Class, hit.Kind, hit.SourceId));
+        var o = b.R.IssueOrder(OutcomeKinds.OrderDispose, Pack(1, 0), choice);
+        Assert.True(o.AfterConsequence);
+        Assert.Equal(Start, o.InstantMs);
+        Assert.Equal(RunStatus.ReachedLimit, b.R.RunUntil(Start + Day).Status);         // no further stop
+        var res = b.W.OrderResults.Single(x => x.Kind == OutcomeKinds.OrderDispose);
+        Assert.Equal((Start, 0), (res.AtMs, res.Reason));
+        var row = Assert.Single(b.W.SettlementOutcomes);
+        Assert.Equal(((byte)choice, Start, 1), (row.Disposition, row.AtMs, row.To));
+        long loot = b.W.Ledger.Balance(b.W.TreasuryOf(1)) - treasury0;
+        Assert.Equal(choice == SackD, loot > 0);
+        Assert.Equal(choice == SackD ? 500_000 - b.W.Ledger.Balance(b.W.MoneyAccount(0)) : 0, loot);   // the city's money, taken at T
+        Assert.DoesNotContain(b.R.Windows, x => x.InstantMs > Start && x.InstantMs <= Start + Day);   // nothing deferred
+    }
+
+    /// <summary>The choice is OFFERED at the moment of capture; a player who resumes without choosing keeps Occupy (lane W's default), and
+    /// a Sack issued at a later stop (Start + 1 day) is refused WindowClosed — the choice exists only at the capture instant, as lane W
+    /// rules for every capture. At the consequence window the only order accepted is the offered disposition: a second assault, a
+    /// prisoner order or a disposition of another settlement are refused NotOffered and change nothing (no action multiplication); a
+    /// Raze is refused LastCity (the city is the taker's only one: lane W's refusal, unchanged).</summary>
+    [Fact]
+    public void DH2_TheChoiceIsOfferedOnce_OnlyTheOfferedChoiceIsAccepted_LaneWsRefusalsStand()
+    {
+        var b = Assaulted(extraProbes: new[] { Start + Day });
+        b.R.RunUntil(Start + 2 * Day);
+        b.R.IssueOrder(Assault.Item1, Assault.Item2, Assault.Item3);
+        b.R.RunUntil(Start + 2 * Day);                                                 // the consequence window at Start
+        Assert.True(b.R.Windows[^1].AfterOrders);
+        var before = b.W.Ledger.Snapshot();
+        b.R.IssueOrder(Assault.Item1, Assault.Item2, Assault.Item3);                    // not the offered choice
+        b.R.IssueOrder(OutcomeKinds.OrderPrisoners, Pack(1, 0), Value((long)PrisonerAction.Release, 1));
+        b.R.IssueOrder(OutcomeKinds.OrderDispose, Pack(1, 0), RazeD);                   // the taker's only city
+        var r = b.R.RunUntil(Start + 2 * Day);
+        Assert.Equal((RunStatus.Interrupted, Start + Day), (r.Status, r.AtMs));          // the probe's later stop
+        var results = b.W.OrderResults.Where(x => x.AtMs == Start).ToArray();
+        Assert.Equal(new[] { OutcomeRefusal.NotOffered, OutcomeRefusal.NotOffered, OutcomeRefusal.LastCity },
+                     results.Select(x => x.Reason).ToArray());
+        Assert.Single(b.Siege.Captures);
+        Assert.Equal(before, b.W.Ledger.Snapshot());                                    // refusals change nothing
+        Assert.Equal((byte)Disposition.Occupy, b.W.SettlementOutcomes.Single().Disposition);
+        b.R.IssueOrder(OutcomeKinds.OrderDispose, Pack(1, 0), SackD);                   // a day later: the moment has passed
+        b.R.RunUntil(Start + 2 * Day);
+        Assert.Equal(OutcomeRefusal.WindowClosed, b.W.OrderResults[^1].Reason);
+        Assert.Equal((byte)Disposition.Occupy, b.W.SettlementOutcomes.Single().Disposition);
+    }
+
+    /// <summary>TURN-EXACT PIN, the AI'S PATH (DH2-R1, unchanged): polity 1 is an AI with a Sack doctrine; its immediate assault at Start
+    /// takes the city and its doctrine disposes of it AT Start (a Sack row at Start, the loot at Start) — no decision instant is raised
+    /// (no consequence window anywhere).</summary>
+    [Fact]
+    public void DH2R1_AnAITaker_DisposesByItsDoctrine_AtTheMomentOfCapture_NoDecisionInstant()
+    {
+        var b = Assaulted(ai: new[] { -1, (int)Disposition.Sack, -1 });
+        b.R.RunUntil(Start + Day);
+        b.R.IssueOrder(Assault.Item1, Assault.Item2, Assault.Item3);
+        Assert.Equal(RunStatus.ReachedLimit, b.R.RunUntil(Start + Day).Status);
+        Assert.DoesNotContain(b.R.Windows, w => w.AfterOrders);
+        var row = Assert.Single(b.W.SettlementOutcomes);
+        Assert.Equal(((byte)Disposition.Sack, Start), (row.Disposition, row.AtMs));
+    }
+
+    /// <summary>The disposition issued in the SAME window as the assault (after it in log order — lane U's measured path) applies at Start
+    /// and the decision instant, no longer needed, is cancelled: no consequence window opens. And the CONTROL: a capture made by a WORLD
+    /// EVENT (the city starves into capitulation) offers the choice at its SettlementTaken window, as before, with no consequence
+    /// window.</summary>
+    [Fact]
+    public void ASameWindowChoice_Applies_AndNoDecisionInstantOpens_AWorldEventCaptureIsUnchanged()
+    {
+        var b = Assaulted();
+        b.R.RunUntil(Start + Day);
+        b.R.IssueOrder(Assault.Item1, Assault.Item2, Assault.Item3);
+        b.R.IssueOrder(OutcomeKinds.OrderDispose, Pack(1, 0), SackD);
+        Assert.Equal(RunStatus.ReachedLimit, b.R.RunUntil(Start + Day).Status);
+        Assert.DoesNotContain(b.R.Windows, w => w.AfterOrders);
+        Assert.Equal(((byte)Disposition.Sack, Start), (b.W.SettlementOutcomes.Single().Disposition, b.W.SettlementOutcomes.Single().AtMs));
+        Assert.Equal(1, b.S.CancelledCount);
+
+        var starve = BuildBound(Start, foodDays: 5, stops: true);
+        long taken = -1;
+        while (true)
+        {
+            var r = starve.R.RunUntil(Start + 200 * Day);
+            if (r.Status == RunStatus.ReachedLimit) break;
+            if (starve.Siege.Captures.Count > 0 && starve.Siege.Captures[0].AtMs == r.AtMs && taken < 0)
+            {
+                taken = r.AtMs;
+                Assert.False(starve.R.Windows[^1].AfterOrders);
+                Assert.Contains(starve.R.Windows[^1].Hits, h => h.Kind == OutcomeKinds.SettlementTaken);
+                starve.R.IssueOrder(OutcomeKinds.OrderDispose, Pack(1, 0), SackD);
+            }
+        }
+        Assert.True(taken > 0);
+        Assert.DoesNotContain(starve.R.Windows, w => w.AfterOrders);
+        Assert.Equal(((byte)Disposition.Sack, taken), (starve.W.SettlementOutcomes.Single().Disposition, starve.W.SettlementOutcomes.Single().AtMs));
+    }
+
+    /// <summary>LIVE VERSUS REPLAY: the live run (stops; the assault; the consequence stop; the Sack) and the replay of its order log
+    /// (stops off; the consequence order delivered in its own phase) give the same world (state hash), the same windows (the
+    /// consequence window included) and the same order results; the log records the consequence order as such.</summary>
+    [Fact]
+    public void LiveVersusReplay_TheDecisionInstantAndItsChoice()
+    {
+        var live = Assaulted();
+        live.R.RunUntil(Start + Day);
+        live.R.IssueOrder(Assault.Item1, Assault.Item2, Assault.Item3);
+        live.R.RunUntil(Start + Day);
+        live.R.IssueOrder(OutcomeKinds.OrderDispose, Pack(1, 0), SackD);
+        live.R.RunUntil(Start + Day);
+        Assert.Equal(new[] { false, true }, live.R.Orders.Orders.Select(o => o.AfterConsequence).ToArray());
+        var replay = Assaulted(replay: live.R.Orders);
+        replay.R.RunUntil(Start + Day);
+        Assert.Equal(live.W.StateHashHex(), replay.W.StateHashHex());
+        Assert.Equal(live.R.WindowsHashHex(), replay.R.WindowsHashHex());
+        Assert.Equal(live.W.OrderResults.ToArray(), replay.W.OrderResults.ToArray());
+        Assert.Equal(live.R.Orders.HashHex(), replay.R.Orders.HashHex());
+        Assert.Contains(replay.R.Windows, w => w.AfterOrders && w.InstantMs == Start);
+        // the log's consequence flag has teeth: the same order logged as a window order is refused at the gate, and the city stays occupied
+        var wrong = new SubTurnOrderLog();
+        foreach (var o in live.R.Orders.Orders) wrong.Append(o.InstantMs, o.Kind, o.A, o.B);
+        var mis = Assaulted(replay: wrong);
+        mis.R.RunUntil(Start + Day);
+        Assert.Equal((byte)Disposition.Occupy, mis.W.SettlementOutcomes.Single().Disposition);
+        Assert.NotEqual(live.W.StateHashHex(), mis.W.StateHashHex());
+    }
+
+    /// <summary>The event core's guards (EventRules R4's exception): a consequence can be raised only from a WINDOW ORDER at its own
+    /// instant — not from a world event, and not from an order issued at a consequence window (no chain).</summary>
+    [Fact]
+    public void ADecisionInstantIsRaisedOnlyByAWindowOrder_NeverByAWorldEventOrAConsequenceOrder()
+    {
+        var s = new EventScheduler(0);
+        var world = new Probe(s);
+        s.Schedule(10, EventClass.System, 0, 0, 1);
+        s.ExecuteNext(world, out _);                                                    // a world event: refused
+        Assert.IsType<InvalidOperationException>(world.Error);
+        s.ScheduleOrder(10, 0, 2, 0, 0);
+        world.Error = null;
+        s.ExecuteNext(world, out _);                                                    // a window order: allowed
+        Assert.Null(world.Error);
+        s.ExecuteNext(world, out var consequence);
+        Assert.Equal((byte)EventClass.OrderConsequence, consequence.Key.Class);
+        s.ScheduleOrder(10, 1, 2, 0, 0, afterConsequence: true);
+        s.ExecuteNext(world, out _);                                                    // an order at the consequence window: refused
+        Assert.IsType<InvalidOperationException>(world.Error);
+    }
+
+    private sealed class Probe : IEventWorld
+    {
+        public Probe(EventScheduler s) { }
+        public Exception? Error;
+        public bool IsLive(EntityRef e) => true;
+        public void Execute(in ScheduledEvent ev, EventScheduler s)
+        {
+            if (ev.Key.Class == (byte)EventClass.OrderConsequence) return;
+            try { s.ScheduleConsequence(ev.Key.TimeMs, 0, 0, 3); }
+            catch (Exception e) { Error = e; }
+        }
+    }
+}
