+
+    [Fact]
+    public void Probe_Ambush()
+    {
+        var co = AutoCoefficients.Sprint1;
+        for (ulong seed = 1; seed <= 4; seed++)
+            foreach (bool m in new[] { false, true })
+            {
+                var to = new TacticalBattle(OldAmbush(seed, m), new KnowledgeAi(), new KnowledgeAi()).Run();
+                var tn = new TacticalBattle(ParityScenarios.Build(ParityScenarioId.Ambush, seed, m), new KnowledgeAi(), new KnowledgeAi()).Run();
+                var ao = new AutoBattle(OldAmbush(seed, m), co).Run();
+                var an = new AutoBattle(ParityScenarios.Build(ParityScenarioId.Ambush, seed, m), co).Run();
+                _o.WriteLine($"seed {seed} mir {m}\n OLD T {Sum(to)}\n NEW T {Sum(tn)}\n OLD A {Sum(ao)}\n NEW A {Sum(an)}");
