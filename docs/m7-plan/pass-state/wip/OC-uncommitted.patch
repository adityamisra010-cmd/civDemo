@@ -0,0 +1,155 @@
+namespace Proto.M7.Tactical;
+
+/// <summary>[OC, 2026-11-13] The role a side holds in a battle (D-087 DF8, D-088 DG8). Stable codes.</summary>
+public enum BattleRole : byte
+{
+    /// <summary>No role: a battle no engagement opened (a meeting engagement built by hand; BattleSetup.Defender = -1).</summary>
+    None = 0,
+    /// <summary>The side that initiated combat (D-087 DF8: "the army that initiates combat is the attacker").</summary>
+    Attacker = 1,
+    /// <summary>The side that was attacked (D-087 DF8: "the side that was attacked, is the defender").</summary>
+    Defender = 2,
+}
+
+/// <summary>[OC, 2026-11-13] Why a battle's roles are refused (<see cref="BattleRoles.Check"/>). Stable codes; None = accepted.
+/// Appended only, never renumbered.</summary>
+public enum RolesRefusal : byte
+{
+    None = 0,
+    /// <summary>BattleSetup.Defender is not -1, 0 or 1.</summary>
+    BadDefender = 1,
+    /// <summary>BattleSetup.Ambusher is not -1, 0 or 1.</summary>
+    BadAmbusher = 2,
+    /// <summary>The ambushing side is not the attacker: READING OC-R1 (a) (applied) — the ambushing side initiates combat, so it is
+    /// the attacker, and the other side is the defender (one role per side, D-088 DG8).</summary>
+    AmbusherIsNotTheAttacker = 3,
+    /// <summary>One empire is on both sides (as a side's own empire or as an ally): a side holds one empire's armies, or an empire's
+    /// and its allies' (D-088 DG8), so an empire belongs to one side.</summary>
+    EmpireOnBothSides = 4,
+    /// <summary>A formation's empire is neither its side's own empire nor one of its side's allies.</summary>
+    NotOnItsSide = 5,
+    /// <summary>A side lists allies but no empire of its own (a side is an empire's, with its allies).</summary>
+    AlliesWithoutEmpire = 6,
+    /// <summary>The empire whose army initiated combat is on no side of the battle (it cannot give a side the attacker's role).</summary>
+    InitiatorNotInBattle = 7,
+    /// <summary>The engagement's two empires are on the same side.</summary>
+    EngagementWithinOneSide = 8,
+}
+
+/// <summary>
+/// [OC, completion after fix round 1, 2026-11-13] D-087 DF8 and D-088 DG8 — ONE ROLE PER SIDE. "A side is the attacker or the
+/// defender, and an army is part of a side. A side holds one empire's armies, or an empire's and its allies' armies. Every army on a
+/// side shares the side's role" (DG8; it replaces D-087 DF8-R2 (a), each army its own role). "The army that initiates combat is the
+/// attacker. Declaring war, or exerting a zone of control or a siege without combat, does not make an army the attacker" (DF8).
+///
+/// REPRESENTATION. A battle carries its roles once, per side: <see cref="BattleSetup.Defender"/> (the attacked side; the attacker is
+/// the other side; -1 = no roles). A formation has no role of its own: its role is its side's (<see cref="RoleOf"/>), whatever its
+/// army or its empire (<see cref="FormationSpec.Empire"/>). Each side may state its own empire and its allies
+/// (<see cref="SideSpec.Empire"/>, <see cref="SideSpec.Allies"/>); <see cref="Check"/> refuses a setup whose rosters or roles break
+/// DG8 (an empire on both sides, a formation of an empire foreign to its side, an ambusher that is not the attacker).
+/// THE ROLES COME FROM THE ENGAGEMENT THAT OPENED THE BATTLE, never from a war declaration: <see cref="FromEngagement"/> gives the
+/// attacker's role to the side holding the empire whose army initiated combat (the war-pulse hand-off
+/// War.EngagementBattle.Build, the War Sandbox's initiator, the map ambush of item 6), so which empire declared the war, or whose
+/// army first stood in the other's zone of control or laid a siege, never enters.
+/// The roles never change a battle (D-087 DF8, DF11: equal sides are a tie whatever the roles; the resolvers read Defender and
+/// Ambusher only in EqualSides.Decide, which no longer picks a winner by them), so a role is a fact of the record, checked at the
+/// battle's creation (the hand-offs call <see cref="Check"/>); the resolvers do not re-check it.
+/// </summary>
+public static class BattleRoles
+{
+    /// <summary>The role of side <paramref name="side"/> (0 or 1) in a battle: Defender for BattleSetup.Defender, Attacker for the other
+    /// side, None when the battle has no roles (Defender -1).</summary>
+    public static BattleRole RoleOfSide(BattleSetup setup, int side)
+    {
+        if (side != 0 && side != 1) throw new ArgumentOutOfRangeException(nameof(side));
+        if (setup.Defender < 0) return BattleRole.None;
+        return side == setup.Defender ? BattleRole.Defender : BattleRole.Attacker;
+    }
+
+    /// <summary>The role of one formation: its side's role (one role per side, D-088 DG8) — never its own army's or empire's.</summary>
+    public static BattleRole RoleOf(BattleSetup setup, long formationId)
+    {
+        foreach (var f in setup.Formations) if (f.Id == formationId) return RoleOfSide(setup, f.Side);
+        throw new ArgumentException($"no formation {formationId}", nameof(formationId));
+    }
+
+    /// <summary>The attacking side (the side that initiated combat), or -1 when the battle has no roles.</summary>
+    public static int AttackerSide(BattleSetup setup) => setup.Defender < 0 ? -1 : 1 - setup.Defender;
+
+    /// <summary>The side whose roster holds <paramref name="empire"/> (its own empire or an ally), or -1 when no side states it.</summary>
+    public static int SideOfEmpire(BattleSetup setup, int empire)
+    {
+        if (empire < 0) return -1;
+        for (int s = 0; s < setup.Sides.Length; s++)
+        {
+            var side = setup.Sides[s];
+            if (side.Empire == empire) return s;
+            foreach (int a in side.Allies) if (a == empire) return s;
+        }
+        return -1;
+    }
+
+    /// <summary>
+    /// Checks a battle's roles and rosters against D-088 DG8 and READING OC-R1 (a). In order (the first failure is returned):
+    /// Defender and Ambusher in {-1, 0, 1}; an ambusher is the attacker (Defender = 1 - Ambusher); a side that lists allies states its
+    /// own empire; no empire on both sides (own or allied); every formation that states its empire belongs to its side's roster when
+    /// the side states one. A side without a roster (Empire -1, no allies) accepts any formation: hand-built battles and the shipped
+    /// scenarios name no empires.
+    /// </summary>
+    public static RolesRefusal Check(BattleSetup setup)
+    {
+        if (setup.Defender < -1 || setup.Defender > 1) return RolesRefusal.BadDefender;
+        if (setup.Ambusher < -1 || setup.Ambusher > 1) return RolesRefusal.BadAmbusher;
+        if (setup.Ambusher >= 0 && setup.Defender != 1 - setup.Ambusher) return RolesRefusal.AmbusherIsNotTheAttacker;
+        if (setup.Sides.Length != 2) throw new ArgumentException("exactly two sides", nameof(setup));
+        for (int s = 0; s < 2; s++)
+            if (setup.Sides[s].Empire < 0 && setup.Sides[s].Allies.Length > 0) return RolesRefusal.AlliesWithoutEmpire;
+        // an empire belongs to one side: compare the two rosters as sorted integer sets (no hashing)
+        var r0 = Roster(setup.Sides[0]);
+        var r1 = Roster(setup.Sides[1]);
+        foreach (int e in r0) if (Array.BinarySearch(r1, e) >= 0) return RolesRefusal.EmpireOnBothSides;
+        var forms = (FormationSpec[])setup.Formations.Clone();
+        Array.Sort(forms, static (a, b) => a.Id.CompareTo(b.Id));
+        foreach (var f in forms)
+        {
+            if (f.Empire < 0 || f.Side < 0 || f.Side > 1) continue;
+            var roster = f.Side == 0 ? r0 : r1;
+            if (roster.Length > 0 && Array.BinarySearch(roster, f.Empire) < 0) return RolesRefusal.NotOnItsSide;
+        }
+        return RolesRefusal.None;
+    }
+
+    /// <summary>A side's roster (its own empire and its allies) as a sorted array of distinct ids.</summary>
+    private static int[] Roster(SideSpec side)
+    {
+        var list = new List<int>(side.Allies.Length + 1);
+        if (side.Empire >= 0) list.Add(side.Empire);
+        foreach (int a in side.Allies) if (a >= 0) list.Add(a);
+        var arr = list.ToArray();
+        Array.Sort(arr);
+        int n = 0;
+        for (int i = 0; i < arr.Length; i++) if (n == 0 || arr[n - 1] != arr[i]) arr[n++] = arr[i];
+        Array.Resize(ref arr, n);
+        return arr;
+    }
+
+    /// <summary>
+    /// The roles of a battle opened by an ENGAGEMENT (D-087 DF8): the side whose roster holds <paramref name="initiatorEmpire"/> — the
+    /// empire whose army initiated combat — is the attacker, the other side the defender; every army on a side shares its role
+    /// (D-088 DG8). The engagement's other empire (<paramref name="targetEmpire"/>, -1 when not known) must stand on the other side.
+    /// Nothing else is read: in particular no war declaration, zone of control or siege. Returns the setup with Defender set (and the
+    /// roles checked), or the refusal.
+    /// </summary>
+    public static RolesRefusal FromEngagement(BattleSetup field, int initiatorEmpire, int targetEmpire, out BattleSetup? battle)
+    {
+        battle = null;
+        int attacker = SideOfEmpire(field, initiatorEmpire);
+        if (attacker < 0) return RolesRefusal.InitiatorNotInBattle;
+        if (targetEmpire >= 0 && SideOfEmpire(field, targetEmpire) == attacker) return RolesRefusal.EngagementWithinOneSide;
+        var b = field with { Defender = 1 - attacker };
+        var r = Check(b);
+        if (r != RolesRefusal.None) return r;
+        battle = b;
+        return RolesRefusal.None;
+    }
+}
