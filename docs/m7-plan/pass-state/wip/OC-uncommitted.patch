+// SCRATCH PROBE (lane OC completion stage) — never committed; removed by exact name before every commit.
+using System.Text;
+using Proto.M7.Fixed;
+using Proto.M7.Spatial;
+using Proto.M7.Tactical;
+using Xunit;
+using Xunit.Abstractions;
+
+namespace Proto.M7.Tests.LaneOC;
+
+public sealed class ZzProbeOC
+{
+    private readonly ITestOutputHelper _o;
+    public ZzProbeOC(ITestOutputHelper o) { _o = o; }
+
+    private static Vec2L A(long cx, long cy) => MultiDomainScenarios.A(cx, cy);
+
+    public static BattleSetup OldAmphibious(ulong seed)
+    {
+        var g = new TerrainGrid(64, 40, MultiDomainScenarios.AmphibCell, TerrainClass.Open);
+        for (int y = 0; y < 40; y++)
+            for (int x = 0; x < 64; x++)
+            {
+                if (x <= 27) g.Set(x, y, TerrainClass.Water);
+                else if (x <= 33 && y >= 3 && y <= 9) g.Set(x, y, TerrainClass.Hills, 20_000);
+                else if (x >= 32 && x <= 37 && y >= 12 && y <= 31) g.Set(x, y, TerrainClass.Forest);
+            }
+        var forms = new[]
+        {
+            MultiDomainScenarios.Fleet(10, 0, DomainProfiles.TurretWarship, 2, A(12, 14)),
+            MultiDomainScenarios.Fleet(11, 0, DomainProfiles.SteamTransport with { Capacity = 30 }, 2, A(6, 22)),
+            new FormationSpec(12, 0, MultiDomainScenarios.Rifles50m, 50, A(6, 22)) { EmbarkedOn = 11 },
+            MultiDomainScenarios.Flight(13, 0, DomainProfiles.StrikeAircraft, 1),
+            MultiDomainScenarios.Flight(14, 0, DomainProfiles.Fighter, 1),
+            new FormationSpec(20, 1, MultiDomainScenarios.Rifles50m, 50, A(34, 20)),
+            new FormationSpec(21, 1, DomainProfiles.GunCrew, 5, A(31, 6)) { Weapons = new[] { DomainProfiles.CoastalGun } },
+            new FormationSpec(22, 1, DomainProfiles.GunCrew, 5, A(40, 18)) { Weapons = new[] { DomainProfiles.AaGun } },
+            new FormationSpec(23, 1, DomainProfiles.Sniper with { RangeCells = 14, SightCells = 16 }, 2, A(33, 26)),
+            MultiDomainScenarios.Flight(24, 1, DomainProfiles.Fighter, 1),
+        };
+        return new BattleSetup(g, TerrainCostTable.PlaceholderTestTable(), ConcealmentTable.PlaceholderTestTable(),
+            MultiDomainScenarios.Sides(new[] { A(35, 20) }, new[] { A(34, 20) }), forms, seed)
+        { MultiDomain = new MultiDomainSetup { Rules = new DomainRules() }, Rules = new TacticalRules { SlotSpacingMm = 5_000 }, Defender = 1 };
+    }
+
+    public static ScriptedController OldPlan() => new ScriptedController()
+        .Add(0, new OrderRequest(10, OrderKind.Attack, 0, 21))
+        .Add(0, new OrderRequest(13, OrderKind.Attack, 0, 21))
+        .Add(0, new OrderRequest(14, OrderKind.Escort, 0, 13))
+        .Add(1, new OrderRequest(11, OrderKind.MoveTo, 0, -1, A(27, 20)))
+        .Add(2, new OrderRequest(10, OrderKind.Bombard, 0, -1, A(33, 18)))
+        .Add(3, new OrderRequest(12, OrderKind.Disembark, 0, -1, A(31, 20)))
+        .Add(6, new OrderRequest(12, OrderKind.Attack, 0, 20))
+        .Add(8, new OrderRequest(12, OrderKind.Attack, 0, 23));
+
+    public static BattleSetup OldAmbush(ulong seed, bool mirrored)
+    {
+        var grid = TacticalScenarios.OpenField();
+        long X(long col) => mirrored ? TacticalScenarios.MirrorColumn(col) : col;
+        Vec2L C(long col, long row) => TacticalScenarios.Cell(X(col), row);
+        for (long r = 0; r <= TacticalScenarios.FieldH - 1; r++) for (long c = 23; c <= 29; c++) grid.Set(X(c), r, TerrainClass.Jungle);
+        var HI = UnitProfiles.HeavyInfantry;
+        var forms = new[] { new FormationSpec(1, 0, HI, 50, C(14, 16)), new FormationSpec(2, 1, HI, 50, C(27, 16)) { Posture = Posture.Ambush } };
+        var sides = new[]
+        {
+            new SideSpec(mirrored ? ExitEdge.East : ExitEdge.West) { Objectives = new[] { C(40, 16) } },
+            new SideSpec(mirrored ? ExitEdge.West : ExitEdge.East) { Objectives = Array.Empty<Vec2L>() },
+        };
+        return new BattleSetup(grid, TerrainCostTable.PlaceholderTestTable(), ConcealmentTable.PlaceholderTestTable(), sides, forms, seed)
+        { Rules = new TacticalRules(), Defender = 1 };
+    }
+
+    private static string Sum(BattleResult r)
+    {
+        var sb = new StringBuilder();
+        sb.Append($"{r.Resolver} {r.Reason} side {r.Side} holds {r.HoldsField} win {r.Winner}/{r.WinBasis} pulses {r.Pulses} end {r.EndMs} fight {r.FirstFightMs?.ToString() ?? "null"} trace {r.TraceHash[..8]} state {r.StateHash[..8]}");
+        foreach (var f in r.Formations.OrderBy(f => f.FormationId))
+            sb.Append($"\n   F{f.FormationId} s{f.Side} {f.Domain} start {f.Start} surv {f.Survivors} kil {f.Killed} sur {f.Surrendered} act {f.ActiveAtEnd} esc {f.Escaped} rout {f.RoutedEscaped} rej {f.RejoinedAtTie} mor {f.MoraleEnd} dmgD {f.DamageDealt} dmgT {f.DamageTaken} att {f.AttacksMade} emb {f.EmbarkedAtEnd} ent {f.EnteredAtMs?.ToString() ?? "-"}");
+        return sb.ToString();
+    }
+
+    [Fact]
+    public void Probe_Amphibious()
+    {
+        foreach (ulong seed in new ulong[] { 42, 7, 3, 1 })
+        {
+            var o = Proto.M7.Tests.MultiDomain.DT.RunChecked(new TacticalBattle(OldAmphibious(seed), OldPlan(), MultiDomainScenarios.AmphibiousDefence()));
+            var n = Proto.M7.Tests.MultiDomain.DT.RunChecked(new TacticalBattle(MultiDomainScenarios.Amphibious(seed), MultiDomainScenarios.AmphibiousPlan(), MultiDomainScenarios.AmphibiousDefence()));
+            _o.WriteLine($"seed {seed} OLD {Sum(o)}\n   pers {o.Personnel!.Hash[..8]}");
