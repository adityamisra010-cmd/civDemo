+    [CharsBakeFact]
+    public void CrowdIdleVariantsLiftTheBowedHeadAndMoveTheWeaponArm()
+    {
+        var notes = new List<string>();
+        foreach (var id in new[] { "a1", "b3" })
+        {
+            var (sk, clips) = Identity(id);
+            foreach (var name in CrowdPoseVariants.BaseClips)
+            {
+                var src = clips.Clip(name)!;
+                float before = CrowdPoseVariants.MeanHeadPitch(sk, src);
+                for (int k = 0; k < CrowdPoseVariants.Idle.Length; k++)
+                {
+                    var v = CrowdPoseVariants.Derive(sk, src, name + "@" + k, CrowdPoseVariants.Idle[k]);
+                    Assert.Equal(src.Frames, v.Frames);
+                    float after = CrowdPoseVariants.MeanHeadPitch(sk, v);
+                    Assert.InRange(after, CrowdPoseVariants.Idle[k].HeadPitch - 1.5f, CrowdPoseVariants.Idle[k].HeadPitch + 1.5f);
+                    if (k == 0) notes.Add($"{id} {name}: mean gaze {before:0.0} -> {after:0.0} deg");
+                }
+            }
+            var bank = CrowdAnimationBank.BuildCpu(new[] { (sk, clips) });
+            int hand = sk["hand_r"];
+            var h0 = Joint(bank, sk, 0, hand, CrowdAnimationBank.ClipIndex("idle@0"), 1.0f, 0, 0, 0);
+            for (int k = 1; k < CrowdPoseVariants.Idle.Length; k++)
+            {
+                var hk = Joint(bank, sk, 0, hand, CrowdAnimationBank.ClipIndex("idle@" + k), 1.0f, 0, 0, 0);
