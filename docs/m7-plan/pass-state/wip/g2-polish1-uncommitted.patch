+    /// <summary>Character-space position of a bone's joint for one crowd instance's two-clip sample (the shader's CPU twin).</summary>
+    static Vector3 Joint(CrowdAnimationBank bank, Skeleton sk, int identity, int bone, int clipA, float timeA, int clipB, float timeB, float blend)
+    {
+        var (a0, a1, fa) = bank.Sample(identity, clipA, timeA);
+        var (b0, b1, fb) = bank.Sample(identity, clipB, timeB);
+        var aA = new Vector4(a0, a1, fa, blend); var aB = new Vector4(b0, b1, fb, 0);
+        return bank.SkinCpu(sk.Head[bone], new[] { bone, 0, 0, 0 }, new[] { 1f, 0, 0, 0 }, aA, aB);
+    }
+
+    /// <summary>
+    /// Rank 3: the idle variants raise the retargeted clips' bowed heads to the variant's gaze (within 1.5 degrees of it,
+    /// mean over the clip), and the variants move the weapon hand: at one time the right hand of variants 1-3 stands
+    /// more than 5 cm from variant 0's.
