+/// <summary>
+/// Stage polish2 (the visual critic's second pass): helmets over hair (rank 1). Presentation only: every property here
+/// is about what is drawn; nothing reads or writes a simulation.
+/// </summary>
+[Collection(EnvSerialCollection.Name)]
+public sealed class Polish2Tests
+{
+    // review aid: POLISH2_HAIR_SIZE renders the hair frames larger (the test's pixel bounds assume the default)
+    static readonly int W = int.TryParse(Environment.GetEnvironmentVariable("POLISH2_HAIR_SIZE"), out int sz) ? sz : 160, H = W;
+
+    sealed class Probe(CharStage stage) : IRenderContent
+    {
+        /// <summary>Back-face culling for the frame (the envelope mask), or null for the renderer's own state.</summary>
+        public RasterizerState? Raster;
+        public void DrawShadowCasters(RenderContext rc) { }
+        public void DrawOpaque(RenderContext rc)
+        {
+            var prev = rc.Device.RasterizerState;
+            if (Raster != null) rc.Device.RasterizerState = Raster;
+            stage.DrawOpaque(rc);
+            rc.Device.RasterizerState = prev;
+        }
+    }
+
+    /// <summary>
+    /// The culling that keeps a mesh's outward faces: XNA culls by screen winding, and a triangle whose geometric normal
+    /// (b - a) x (c - a) faces the camera winds counter-clockwise on screen. Decided by the majority of the mesh's
+    /// triangles against their vertex normals (which <c>Shapes.OrientOutward</c> turned outward).
+    /// </summary>
+    static RasterizerState OutwardCulling(Gfx.Gear.Geometry.KitMesh m)
+    {
+        int agree = 0;
+        for (int t = 0; t + 2 < m.Indices.Count; t += 3)
+        {
+            var a = m.Positions[m.Indices[t]]; var b = m.Positions[m.Indices[t + 1]]; var c = m.Positions[m.Indices[t + 2]];
+            agree += Vector3.Dot(Vector3.Cross(b - a, c - a), m.Normals[m.Indices[t]]) > 0 ? 1 : -1;
+        }
+        return agree > 0 ? RasterizerState.CullClockwise : RasterizerState.CullCounterClockwise;
+    }
