+#!/usr/bin/env python3
+"""The measured figures of reports/polish2.md §1: region statistics of the canonical captures, before and after.
+
+Usage: measure-polish2.py BEFORE_DIR AFTER_DIR
+  BEFORE_DIR, AFTER_DIR: outputs of scripts/capture-scenes.sh (1920x1080; same folder and file names).
+Per region: mean RGB, HSV hue (degrees) and saturation of the mean colour, the median luminance standard deviation in
+24 px windows (local contrast), the share of near-white pixels (every channel 225 or more) and, over the brightest tenth
+of the region's pixels, the mean HSV saturation and the share above 0.75 (the golden-hour "neon" measure).
+Every frame measured here was rendered by llvmpipe (not Victus evidence); these are prototype frames, not production art.
+"""
+import colorsys
+import sys
+
+import numpy as np
+from PIL import Image
+
+BEFORE, AFTER = sys.argv[1:3]
+REGIONS = [  # name, shot, box (x0, y0, x1, y1 as fractions of the frame)
+    ("B wide noon, sky", "b/bench-b-wide-noon", (0.0, 0.0, 1.0, 0.18)),
+    ("C vista noon, sky", "c/bench-c-vista-noon", (0.0, 0.0, 1.0, 0.12)),
+    ("E vista golden, sky", "e/bench-e-vista-golden", (0.0, 0.0, 1.0, 0.18)),
+    ("C clash golden, foreground cover", "c/bench-c-clash-golden", (0.0, 0.80, 0.4, 0.98)),
+    ("C vista golden, foreground cover", "c/bench-c-vista-golden", (0.05, 0.80, 0.55, 0.97)),
+    ("A two-shot golden, ground", "a/bench-a-two-shot-golden", (0.0, 0.85, 1.0, 1.0)),
+    ("E river, far bank", "e/bench-e-river", (0.20, 0.42, 0.90, 0.80)),
+    ("C melee low, crowd", "c/bench-c-melee-low", (0.0, 0.38, 1.0, 0.85)),
+    ("B front, close soldiers", "b/bench-b-front", (0.0, 0.40, 0.75, 0.95)),
+    ("D field, the fallen cluster's ground", "d-shown/bench-d-shown-00-field", (0.25, 0.55, 0.55, 0.90)),
+    ("D fallen, ground around the bodies", "d-shown/bench-d-shown-06-fallen", (0.0, 0.0, 1.0, 1.0)),
+]
+
+
+def luminance(rgb):
+    return 0.2126 * rgb[..., 0] + 0.7152 * rgb[..., 1] + 0.0722 * rgb[..., 2]
+
+
+def local_std(lum, k=24):
+    return [lum[y:y + k, x:x + k].std() for y in range(0, lum.shape[0] - k + 1, k) for x in range(0, lum.shape[1] - k + 1, k)]
+
+
+def region(root, shot, box):
+    im = np.asarray(Image.open(f"{root}/{shot}.png").convert("RGB")).astype(np.float64)
+    h, w, _ = im.shape
+    x0, y0, x1, y1 = box
+    return im[int(y0 * h):int(y1 * h), int(x0 * w):int(x1 * w)]
+
+
+def stats(px):
+    mean = px.reshape(-1, 3).mean(0)
+    hh, ss, _ = colorsys.rgb_to_hsv(*(mean / 255.0))
+    lum = luminance(px)
+    contrast = float(np.median(local_std(lum))) if min(lum.shape) >= 24 else float(lum.std())
+    flat = px.reshape(-1, 3)
+    white = float((flat.min(1) >= 225).mean())
+    mx, mn = flat.max(1), flat.min(1)
+    sat = np.where(mx > 0, (mx - mn) / np.maximum(mx, 1e-6), 0.0)
+    l = luminance(flat)
+    top = l >= np.quantile(l, 0.9)
+    return mean, hh * 360.0, ss, contrast, white, float(sat[top].mean()), float((sat[top] > 0.75).mean())
+
+
+def fmt(s):
+    mean, hue, sat, con, white, tsat, tneon = s
+    return (f"RGB {mean[0]:.0f},{mean[1]:.0f},{mean[2]:.0f} hue {hue:.0f} sat {sat:.2f} contrast {con:.1f} "
+            f"white {100 * white:.2f} % brightest-tenth sat {tsat:.2f} (>0.75: {100 * tneon:.0f} %)")
+
+
+print("llvmpipe, not Victus evidence; prototype frames")
+for name, shot, box in REGIONS:
+    try:
+        b = stats(region(BEFORE, shot, box)); a = stats(region(AFTER, shot, box))
+        print(f"{name}:\n  before {fmt(b)}\n  after  {fmt(a)}")
+    except FileNotFoundError as e:
+        print(f"{name}: missing {e.filename}")
