+    /// </summary>
+    internal static HairCount CountHair(GraphicsDevice gd, string identity, string helmet, Func<KitItem, Vector3, HairKind, HairPlace>? covers)
+    {
+        using var stage = new CharStage(gd);
+        using var kit = new KitWorld(gd, stage);
+        using var rt = new RenderTarget2D(gd, W, H, false, SurfaceFormat.Color, DepthFormat.None);
+        using var r = NewRenderer(gd);
+        var body = new CharInstance(stage.Asset(identity));
+        stage.Instances.Add(body);
+        var sockets = KitSockets.For(body.Asset);
+        var m = KitSockets.Measure(body.Asset);
+        var helm = Helmets.Build(new HelmetSpec { Kind = helmet, Seed = 3, MapSize = 64, Lod = 0, Crest = null }, m);
+        var envMesh = Helmets.Envelope(helm);
+        var envItem = new KitItem { Id = "test.envelope." + helmet, Kind = "test.envelope" };
+        envItem.Parts.Add(new KitPart { Name = "envelope", Mesh = envMesh, Maps = "env" });
+        var maps = new MapSet("env", 16, 16);
+        maps.PaintMesh(envMesh, 1, _ => Texel.Of(new Vector3(0.9f, 0.1f, 0.6f), 0.6f, 0f));
+        envItem.Maps["env"] = maps.Finish(1);
+        envItem.Frames["head"] = Matrix.Identity;
+        kit.Wear(body, "polish2-test", new[] { (helm, "head", sockets["head"]), (envItem, "head", sockets["head"]) },
+            covers == null ? null : (it, p, k) => it == helm ? covers(it, p, k) : HairPlace.Free);
+        stage.Invalidate();
+        body.SolvePose();
+
+        var parts = body.AllParts().Select(p => (p.Name, p.Material)).Distinct().ToArray();
+        string envPart = envItem.Id + ":envelope";
+        bool IsScalp(string n) => KitAssets.IsHair(n) && !n.StartsWith("beard", StringComparison.Ordinal);
+        bool IsBeard(string n) => n.StartsWith("beard", StringComparison.Ordinal);
+        bool IsLod(string n) => n.EndsWith("_lod", StringComparison.Ordinal);
+        void Show(Func<string, string, bool> visible)
+        {
+            body.HiddenParts.Clear();
+            foreach (var (n, mat) in parts) if (!visible(n, mat) || IsLod(n)) body.HiddenParts.Add(n);
+        }
+        bool Base(string n, string mat) => n != envPart && !IsScalp(n) && !IsBeard(n) && mat is not ("brow" or "lash");
+
+        var centre = sockets["head"].Bind.Translation + new Vector3(0, -0.015f, 0);
+        var res = new HairCount(identity, helmet, new int[8], new int[8], new int[8], new int[8], new int[8]);
+        var probe = new Probe(stage);
+        var envCull = OutwardCulling(envMesh);
+        Color[] Frame(CameraPose cam)
+        {
+            r.Render(probe, cam, SunModel.At(11f), rt, 0f);
+            return Capture.ReadPixels(rt);
+        }
+        static bool Differs(Color a, Color b) => Math.Abs(a.R - b.R) + Math.Abs(a.G - b.G) + Math.Abs(a.B - b.B) > 6;
+        for (int k = 0; k < Azimuths.Length; k++)
+        {
+            float az = MathHelper.ToRadians(Azimuths[k]);
+            var eye = centre + new Vector3(MathF.Sin(az) * 0.62f, 0.05f, MathF.Cos(az) * 0.62f);
+            var cam = new CameraPose(eye, centre, 0.55f, 0.05f, 50f);
+            Show((n, mat) => false); var sky = Frame(cam);
+            Show((n, mat) => n == envPart); probe.Raster = envCull; var env = Frame(cam); probe.Raster = null;
+            Show(Base); var bare = Frame(cam);
+            var bare2 = Frame(cam);
+            Assert.Equal(0, Capture.CountChanged(bare, bare2));
+            Show((n, mat) => Base(n, mat) || IsScalp(n)); var scalp = Frame(cam);
+            Show((n, mat) => Base(n, mat) || IsBeard(n)); var beard = Frame(cam);
+            var marked = DumpDir != null ? (Color[])scalp.Clone() : null;
+            // the envelope mask eroded by one pixel: the envelope's clipped edge and the solid helmet's rolled edge
+            // rasterise up to a pixel apart along the lower edge
+            var raw = new bool[W * H];
+            for (int i = 0; i < W * H; i++) raw[i] = Differs(env[i], sky[i]);
+            bool In(int x, int y) => x >= 0 && y >= 0 && x < W && y < H && raw[y * W + x];
+            for (int i = 0; i < W * H; i++)
+            {
+                int x = i % W, y = i / W;
+                bool mask = raw[i] && In(x - 1, y) && In(x + 1, y) && In(x, y - 1) && In(x, y + 1);
+                if (raw[i]) res.MaskTotal[k]++;
+                bool sh = Differs(scalp[i], bare[i]), bh = Differs(beard[i], bare[i]);
+                if (sh) { res.ScalpTotal[k]++; if (mask) res.ScalpInMask[k]++; }
+                if (bh) { res.BeardTotal[k]++; if (mask) res.BeardInMask[k]++; }
+                if (marked != null && mask && (sh || bh)) marked[i] = sh ? Color.Red : Color.Cyan;
+            }
+            if (marked != null)
+            {
+                Directory.CreateDirectory(DumpDir!);
+                var tag = $"{identity}-{helmet}-{(covers == null ? "untrimmed" : "trimmed")}-{Azimuths[k]:000}";
+                using var img = new Texture2D(gd, W, H); img.SetData(marked);
+                using (var fs = File.Create(Path.Combine(DumpDir!, tag + ".png"))) img.SaveAsPng(fs, W, H);
+                img.SetData(env);
+                using (var fs = File.Create(Path.Combine(DumpDir!, tag + "-env.png"))) img.SaveAsPng(fs, W, H);
+            }
+        }
+        return res;
+    }
+
+    /// <summary>Review aid: with POLISH2_HAIR_DUMP set, every counted frame is written there (hair inside the mask marked red, beard cyan).</summary>
+    static readonly string? DumpDir = Environment.GetEnvironmentVariable("POLISH2_HAIR_DUMP");
+
+    static string Describe(HairCount c) => $"{c.Identity} in a {c.Helmet}: scalp hair in the mask by azimuth [{string.Join(",", c.ScalpInMask)}], " +
+        $"beard in the mask [{string.Join(",", c.BeardInMask)}], scalp total [{string.Join(",", c.ScalpTotal)}], mask [{string.Join(",", c.MaskTotal)}]";
+
+    /// <summary>
+    /// Critic rank 1 (polish2): a closed helmet shows none of its wearer's scalp hair. For three identities (a4: medium
+    /// grey hair, long cards and 14 mm shells, and a 4 cm full beard, the case scene A showed; the avatar: tied back with a
+    /// queue and a full beard; a2: short hair and a moustache) under the two face-plate helmets (Corinthian, great helm),
+    /// seen from eight azimuths: no scalp-hair pixel lies inside the helmet's envelope mask (over the bronze or iron, or in
+    /// its eye openings and slots), and from the sides and behind (90° to 270°) no beard pixel does either (no beard shell
+    /// reaches out through the cheek guards). Controls in the test: with the hair left untrimmed the same frames show
+    /// scalp hair inside the mask, so the count can see the fault; the masks are not empty.
+    /// </summary>
+    [CharsGfxFact]
+    public void ClosedHelmetsShowNoHairThroughTheMetalFromAnySide() => TestGfx.Host.Invoke(gd =>
+    {
+        int controlHits = 0;
+        foreach (var id in new[] { "a4", "avatar", "a2" })
+            foreach (var helmet in new[] { "corinthian", "greathelm" })
+            {
+                var c = CountHair(gd, id, helmet, Helmets.PlaceHair);
+                for (int k = 0; k < Azimuths.Length; k++)
+                {
+                    Assert.True(c.MaskTotal[k] > 2000, $"{Describe(c)}: the envelope mask at {Azimuths[k]}° has only {c.MaskTotal[k]} pixels");
+                    Assert.True(c.ScalpInMask[k] == 0, $"{Describe(c)}: scalp hair inside the helmet at {Azimuths[k]}°");
+                    if (Azimuths[k] >= 90 && Azimuths[k] <= 270)
+                        Assert.True(c.BeardInMask[k] == 0, $"{Describe(c)}: beard through the metal at {Azimuths[k]}°");
+                }
+                if (id == "a4")
+                {
+                    var none = CountHair(gd, id, helmet, null);
+                    controlHits += none.ScalpInMask.Sum();
+                    Assert.True(none.ScalpInMask.Sum() > 500, $"control (untrimmed hair) {Describe(none)}: the count does not see hair inside the helmet");
+                }
+            }
+        Assert.True(controlHits > 0);
+    });
+
+    /// <summary>
+    /// The trimming does not over-reach (polish2): hair below an open helmet's lower edge still shows. a4's long grey hair
+    /// under a kettle hat and under a Montefortino is still drawn from every azimuth, and none of it inside the helmet's
+    /// envelope mask.
+    /// </summary>
+    [CharsGfxFact]
+    public void OpenHelmetsLeaveTheHairBelowTheirEdge() => TestGfx.Host.Invoke(gd =>
+    {
+        foreach (var helmet in new[] { "kettle", "montefortino" })
+        {
+            var c = CountHair(gd, "a4", helmet, Helmets.PlaceHair);
+            for (int k = 0; k < Azimuths.Length; k++)
+            {
+                Assert.True(c.ScalpInMask[k] == 0, $"{Describe(c)}: scalp hair inside the helmet at {Azimuths[k]}°");
+                Assert.True(c.ScalpTotal[k] > 150, $"{Describe(c)}: only {c.ScalpTotal[k]} hair pixels below the edge at {Azimuths[k]}°");
+            }
+        }
+    });
+
+    /// <summary>
+    /// The shell layout the root test relies on (polish2): every fur and scalp-shell mesh of the bake is recognised as
+    /// layered blocks of the same vertices (a mesh from another bake would fall back to centroid tests), and card meshes
+    /// are not.
+    /// </summary>
+    [CharsBakeFact]
+    public void ShellMeshesAreRecognisedAsLayers()
+    {
+        var f = Gfx.Chars.Format.CharacterFile.Load(Path.Combine(Gfx.Engine.Assets.AssetRoot.Baked("chars"), "a4.g2ch"));
+        var hair = f.Mesh("hair")!; var beard = f.Mesh("beard")!; var cards = f.Mesh("hair_long")!;
+        Assert.Equal("hairshell", hair.Material);
+        Assert.Equal(12, KitAssets.ShellLayers(hair));
+        Assert.Equal(12, KitAssets.ShellLayers(beard));
+        Assert.Equal(0, KitAssets.ShellLayers(cards));
+        Assert.Equal(HairKind.Beard, KitAssets.KindOf(beard));
+        Assert.Equal(HairKind.Scalp, KitAssets.KindOf(cards));
+    }
+}
