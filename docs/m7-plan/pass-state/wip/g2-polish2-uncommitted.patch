+    /// <summary>Polish2: the bank name of the surrender pose (<see cref="DeriveSurrender"/>).</summary>
+    public const string Surrender = "kneel@surrender";
+
+    /// <summary>Upper-arm and forearm directions of the surrender pose in character space (the character faces +Z,
+    /// its left is +X): both arms raised in an open V a little forward of the head, forearms almost upright.</summary>
+    public static readonly Vector3 SurrenderUpperArmL = Vector3.Normalize(new Vector3(0.36f, 0.86f, 0.30f)),
+        SurrenderForearmL = Vector3.Normalize(new Vector3(0.14f, 0.97f, 0.16f));
+
+    /// <summary>
+    /// Polish2 (critic rank 3; PRESENTATION ONLY): the surrender pose, laid over every frame of the kneel clip: both upper
+    /// arms and forearms turned (in world space at their joints) onto the raised directions above, so the open hands stand
+    /// above the head, and the gaze bowed to a mean of 30° below level (half at the neck, half at the head). The kneel
+    /// itself, the pelvis track and the clip's length are kept. A pure function of the skeleton and the clip.
+    /// </summary>
+    public static ClipDef DeriveSurrender(Skeleton s, ClipDef kneel)
+    {
+        int n = s.Count;
+        var pose = new Pose(n); var g = new Quaternion[n]; var hd = new Vector3[n];
+        int pelvis = s.TryIndex("pelvis", out int pv) ? pv : -1;
+        int neck = s["neck_01"], head = s["head"];
+        var arms = new[] { (s["upperarm_l"], s["lowerarm_l"], s["hand_l"], 1f), (s["upperarm_r"], s["lowerarm_r"], s["hand_r"], -1f) };
+        var face = FaceForward(s);
+        var rot = new Quaternion[kneel.Frames * n];
+        for (int f = 0; f < kneel.Frames; f++)
+        {
+            Load(s, kneel, f, pose);
+            Fk.Solve(s, pose, g, hd, pelvis);
+            foreach (var (upper, lower, hand, side) in arms)
+            {
+                var upT = new Vector3(SurrenderUpperArmL.X * side, SurrenderUpperArmL.Y, SurrenderUpperArmL.Z);
+                var foT = new Vector3(SurrenderForearmL.X * side, SurrenderForearmL.Y, SurrenderForearmL.Z);
+                Turn(s, pose, g, upper, Q.Between(hd[lower] - hd[upper], upT));
+                Fk.Solve(s, pose, g, hd, pelvis);
+                Turn(s, pose, g, lower, Q.Between(hd[hand] - hd[lower], foT));
+                Fk.Solve(s, pose, g, hd, pelvis);
+            }
+            // the head bowed: pitch about the face's lateral axis to 30 degrees below level
+            var fw = Q.Rotate(g[head], face);
+            float pitch = MathHelper.ToDegrees(MathF.Asin(Math.Clamp(fw.Y, -1f, 1f)));
+            var fh = new Vector3(fw.X, 0, fw.Z);
+            fh = fh.LengthSquared() > 1e-8f ? Vector3.Normalize(fh) : Vector3.UnitZ;
+            var bow = Q.Scale(About(Vector3.Cross(fh, Vector3.UnitY), -30f - pitch), 0.5f);
+            Turn(s, pose, g, neck, bow);
+            Fk.Solve(s, pose, g, hd, pelvis);
+            Turn(s, pose, g, head, bow);
+            Fk.Solve(s, pose, g, hd, pelvis);
+            Array.Copy(pose.Local, 0, rot, f * n, n);
+        }
+        return new ClipDef
+        {
+            Name = Surrender, Loop = kneel.Loop, Fps = kneel.Fps, Frames = kneel.Frames, Bones = n, Speed = kneel.Speed,
+            Rotations = rot, Pelvis = (Vector3[])kneel.Pelvis.Clone(), Contacts = (byte[])kneel.Contacts.Clone(),
+            Source = kneel.Source + " (polish2 surrender pose)",
+        };
+    }
