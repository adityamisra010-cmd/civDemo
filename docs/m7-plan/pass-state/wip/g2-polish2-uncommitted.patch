+#!/usr/bin/env python3
+"""Review sheets of the polish2 stage: BEFORE (polish1's canonical captures) against AFTER (the same shots captured on
+the polish2 build), one sheet per critic issue (full size, for the scratchpad), and two small review JPEGs for
+reports/captures/polish2 (the committed G2 budget is already used up: they are kept tiny).
+
+Usage: review-sheets-polish2.py BEFORE_DIR AFTER_DIR SHEETS_DIR REVIEW_DIR
+  BEFORE_DIR, AFTER_DIR: outputs of scripts/capture-scenes.sh (same folder and file names).
+Every legend says: llvmpipe, not Victus evidence. Placeholder graphics: these are prototype frames, not production art.
+"""
+import os
+import sys
+from PIL import Image, ImageDraw
+
+BEFORE, AFTER, SHEETS, REVIEW = sys.argv[1:5]
+LLVM = "llvmpipe, not Victus evidence; prototype graphics"
+
+
+def path(root, folder, name):
+    return os.path.join(root, folder, name + ".png")
+
+
+def load(p, size, crop=None):
+    if p is None or not os.path.exists(p):
+        im = Image.new("RGB", size, (40, 40, 40))
+        ImageDraw.Draw(im).text((8, 24), "missing: " + (os.path.basename(p) if p else "-"), fill=(220, 220, 220))
+        return im
+    im = Image.open(p).convert("RGB")
+    if crop:
+        w, h = im.size
+        x0, y0, x1, y1 = crop
+        im = im.crop((int(x0 * w), int(y0 * h), int(x1 * w), int(y1 * h)))
+    return im.resize(size, Image.LANCZOS)
+
+
+def label(draw, xy, text, w):
+    x, y = xy
+    draw.rectangle([x, y, x + min(w, len(text) * 6 + 6), y + 13], fill=(0, 0, 0))
+    draw.text((x + 3, y + 1), text, fill=(235, 235, 235))
+
+
+def sheet(title, rows, out, cell=(800, 450), quality=86):
+    """rows: list of (folder, shot, crop or None, caption)."""
+    w, h = cell
+    head = 34
+    img = Image.new("RGB", (2 * w + 6, head + len(rows) * (h + 4)), (16, 16, 16))
+    d = ImageDraw.Draw(img)
+    d.text((6, 4), title, fill=(255, 255, 255))
+    d.text((6, 18), "BEFORE (left: polish1) vs AFTER (right: polish2); " + LLVM, fill=(200, 200, 200))
+    for i, (folder, shot, crop, cap) in enumerate(rows):
+        y = head + i * (h + 4)
+        img.paste(load(path(BEFORE, folder, shot), cell, crop), (0, y))
+        img.paste(load(path(AFTER, folder, shot), cell, crop), (w + 6, y))
+        label(d, (0, y), f"before: {shot}{' (crop)' if crop else ''}", w)
+        label(d, (w + 6, y), f"after: {cap}", w)
+    img.save(out, quality=quality, optimize=True)
+    print(out)
+
+
+FACE = (0.25, 0.0, 0.75, 0.62)
+issues = [
+    ("01-helmet-hair", "Rank 1: no hair through a closed helmet (hair placed free, under or over the metal)", [
+        ("a", "bench-a-commander-battlecry", FACE, "commander battlecry"), ("a", "bench-a-two-shot", None, "two-shot"),
+        ("a", "bench-a-two-shot-golden", None, "two-shot golden"), ("a", "bench-a-line", None, "line")]),
+    ("02-clouds", "Rank 2: a deterministic cloud layer (heaps high sun, streaks low sun) and its shadows on the land", [
+        ("b", "bench-b-wide-noon", None, "wide noon"), ("c", "bench-c-vista-noon", None, "vista noon"),
+        ("e", "bench-e-vista-golden", None, "vista golden"), ("c", "bench-c-vista-dusk", None, "vista dusk")]),
+    ("03-aftermath", "Rank 3: the aftermath (disarmed prisoners and fallen, kit on the ground, settled bodies, fires)", [
+        ("d-shown", "bench-d-shown-00-field", None, "field"), ("d-shown", "bench-d-shown-01-prisoners", None, "prisoners"),
+        ("d-shown", "bench-d-shown-06-fallen", None, "fallen"), ("d-cutaway", "bench-d-cutaway-06-cutaway", None, "cut-away")]),
+    ("04-river", "Rank 4: the river's banks (turf and earth, damp ragged wet band, darker rock, soft water edge)", [
+        ("e", "bench-e-river", None, "river"), ("e", "bench-e-settlement", None, "settlement"),
+        ("e-rain", "bench-e-river", None, "river, rain")]),
+    ("05-golden", "Rank 5: golden-hour ground cover (gamut compression, capped transmission chroma, per-tuft hue)", [
+        ("c", "bench-c-clash-golden", None, "clash golden"), ("c", "bench-c-vista-golden", None, "vista golden"),
+        ("a", "bench-a-two-shot-golden", None, "two-shot golden"), ("b", "bench-b-wide-golden", None, "wide golden")]),
+    ("06-crowd", "Rank 6: the close crowd (duller iron, muted dyes, weathered paint; LOD meshes unchanged)", [
+        ("c", "bench-c-melee-low", None, "melee low"), ("b", "bench-b-front", None, "front"),
+        ("b", "bench-b-between", None, "between")]),
+    ("07-marks", "Rank 7: the battle's marks (trodden turf, no grass through bodies, kit dropped in flight, dust)", [
+        ("d-shown", "bench-d-shown-00-field", None, "field"), ("d-shown", "bench-d-shown-06-fallen", None, "fallen"),
+        ("c", "bench-c-clash-noon", None, "clash noon"), ("c", "bench-c-rout", None, "rout")]),
+    ("09-faces-mid", "Rank 9: mid-distance faces (crowd eye whites and teeth, warm beards, hero catchlights fade)", [
+        ("b", "bench-b-front", (0.0, 0.40, 0.33, 0.62), "front (crop)"), ("d-shown", "bench-d-shown-01-prisoners", None, "prisoners"),
+        ("d-shown", "bench-d-shown-02-surrender", None, "surrender")]),
+    ("12-avatar", "Rank 12: the player's avatar plays scene D's victorious commander", [
+        ("d-shown", "bench-d-shown-04-commander-face", None, "commander"), ("d-shown", "bench-d-shown-02-surrender", None, "surrender"),
+        ("d-shown", "bench-d-shown-05-standards", None, "standards")]),
+]
+os.makedirs(SHEETS, exist_ok=True)
+os.makedirs(REVIEW, exist_ok=True)
+for key, title, rows in issues:
+    sheet(title, rows, os.path.join(SHEETS, f"polish2-{key}.jpg"))
+
+
+def small(rows, cell, title, out, quality):
+    """rows: list of (folder, shot, crop, caption); two columns: before | after."""
+    cw, ch = cell
+    img = Image.new("RGB", (2 * (cw + 2), 26 + len(rows) * (ch + 2)), (16, 16, 16))
+    d = ImageDraw.Draw(img)
+    d.text((4, 2), title, fill=(255, 255, 255))
+    d.text((4, 13), "before (left) vs after (right); " + LLVM, fill=(200, 200, 200))
+    for i, (folder, shot, crop, cap) in enumerate(rows):
+        y = 26 + i * (ch + 2)
+        for j, root in enumerate([BEFORE, AFTER]):
+            x = j * (cw + 2)
+            img.paste(load(path(root, folder, shot), cell, crop), (x, y))
+            lab = ("before " if j == 0 else "after ") + cap
+            d.rectangle([x, y, x + len(lab) * 6 + 4, y + 11], fill=(0, 0, 0))
+            d.text((x + 2, y), lab, fill=(235, 235, 235))
+    img.save(out, quality=quality, optimize=True)
+    print(out, os.path.getsize(out))
+
+
+small([("b", "bench-b-wide-noon", None, "B wide noon"), ("c", "bench-c-clash-golden", None, "C clash golden"),
+       ("e", "bench-e-river", None, "E river"), ("d-shown", "bench-d-shown-00-field", None, "D field")],
+      (256, 144), "polish2: clouds, golden ground, river, battlefield marks", os.path.join(REVIEW, "polish2-01-before-after.jpg"), 48)
+small([("a", "bench-a-commander-battlecry", FACE, "A battlecry"), ("d-shown", "bench-d-shown-06-fallen", None, "D fallen"),
+       ("d-shown", "bench-d-shown-01-prisoners", None, "D prisoners"), ("c", "bench-c-melee-low", None, "C melee")],
+      (256, 144), "polish2: helmet hair, aftermath, crowd", os.path.join(REVIEW, "polish2-02-hair-aftermath-crowd.jpg"), 48)
