+        for (int y = 0; y < g.Height; y++)
+            for (int x = 0; x < g.Width; x++)
+            {
+                int i = y * g.Width + x;
+                float sw = surf[i];
+                if (float.IsNaN(sw) || g.WaterDepthMm[i] > 0) continue;
+                var p = m.SamplePosition(x, y);
+                float fb = p.Y - sw;
+                if (fb > 20f || fb < -0.5f) continue;
+                float slope = 1 - m.NormalAt(p.X, p.Z).Y;
+                float bank = SplatModel.SmoothStep(20f, 10f, fb);
+                float noise = PNoise.Fbm(p.X / 7f, p.Z / 7f, seed ^ 0xBA4Bu, 3);
+                int o = i * n;
+                float keepRock = SplatModel.SmoothStep(0.40f, 0.55f, slope) * SplatModel.SmoothStep(0.5f, 0.72f, noise);
+                float fromRock = splats[o + rock] * (1f - keepRock) * bank, fromSand = splats[o + sand] * 0.85f * bank;
