new file mode 100644
index 0000000..71800c4
--- /dev/null
+++ b/Sim.Core/State/PrerequisiteExpression.cs
@@ -0,0 +1,244 @@
+using Sim.Core.Systems.ClassMobility;
+using Sim.Core.Systems.Research;
+
+namespace Sim.Core.State;
+
+/// <summary>The operator of a <see cref="PrereqExpr"/> node: a single prerequisite (an atom), ALL of its parts, or ONE OF them.</summary>
+public enum PrereqOp { Atom = 0, All = 1, Any = 2 }
+
+/// <summary>
+/// D-084 (research-tree audit §4); D-089 DH4 — THE ROLE ONE PREREQUISITE PLAYS IN ITS EXPRESSION, decided from the expression
+/// itself so that no label is ever false. <see cref="Required"/>: it holds on every satisfying route
+/// (<see cref="Predicate.MustHoldAtoms"/>). <see cref="OneOf"/>: it is not required, the required ones alone do not satisfy the
+/// expression, and the required ones with it do — it completes the choice on its own. <see cref="Grouped"/>: otherwise — it
+/// counts only together with others (a part of a grouped alternative, as plough_ard in seed_drill OR (plough_ard AND
+/// horse_collar)), or it is redundant. Without a Grouped prerequisite the plain reading — every "required" AND at least one
+/// "one of" (if any) — is exactly the expression (DERIVED for monotone expressions: research-tree-fixes-2026-11.md §3.1).
+/// </summary>
+public enum PrereqKind { Required = 1, OneOf = 2, Grouped = 3 }
+
+/// <summary>
+/// D-084 (research-tree audit §4); D-089 DH4 (lane RT2: moved here from the research screens so that the screens and the
+/// inspector, <see cref="InfoQuery"/>, keep ONE model) — A PREREQUISITE EXPRESSION AS THE PLAYER IS SHOWN IT: the content's parsed
+/// <see cref="Predicate"/> folded (<see cref="Predicate.Fold{T}"/>) into an n-ary tree whose atoms are the predicate's atom ids
+/// (content node indices for a node's prerequisite; node or institution ids for an entity's requirement). A chain of one
+/// operator becomes one group ("a AND b AND c" is all-of[a, b, c]); a change of operator is a nested group, so
+/// "seed_drill OR (plough_ard AND horse_collar)" stays one-of[seed_drill, all-of[plough_ard, horse_collar]] and is never read
+/// as three alternatives. The tree models atoms, AND, OR and parentheses — every shipped prerequisite and requirement is made of
+/// those alone — and then holds exactly the expression's truth table (pinned for every node and entity by Sim.Tests and
+/// Sim.Ui.Tests). An expression with anything else has no tree here (<see cref="Of(Predicate?)"/> returns null). Pure; no
+/// hashing, no dictionaries; a read-only display query (never consulted by a system).
+/// </summary>
+public sealed class PrereqExpr
+{
+    public PrereqOp Op { get; }
+    /// <summary>The prerequisite's atom id (<see cref="PrereqOp.Atom"/>), else -1.</summary>
+    public int Atom { get; }
+    /// <summary>The parts of a group, in source order (at least two); empty for an atom.</summary>
+    public IReadOnlyList<PrereqExpr> Parts { get; }
+
+    private PrereqExpr(PrereqOp op, int atom, PrereqExpr[] parts) { Op = op; Atom = atom; Parts = parts; }
+
+    public static PrereqExpr Leaf(int atom) => new(PrereqOp.Atom, atom, []);
+
+    /// <summary>A group of <paramref name="op"/> over <paramref name="parts"/>: a part of the same operator is spliced in (the
+    /// operator is associative), a repeated atom is kept once (it is idempotent) and a group of one part is that part.</summary>
+    public static PrereqExpr Group(PrereqOp op, IReadOnlyList<PrereqExpr> parts)
+    {
+        if (op == PrereqOp.Atom) throw new ArgumentException("a group is ALL or ANY", nameof(op));
+        var flat = new List<PrereqExpr>();
+        foreach (PrereqExpr p in parts)
+        {
+            if (p.Op == op) { foreach (PrereqExpr q in p.Parts) AddPart(flat, q); }
+            else AddPart(flat, p);
+        }
+        if (flat.Count == 0) throw new ArgumentException("a group needs a part", nameof(parts));
+        return flat.Count == 1 ? flat[0] : new PrereqExpr(op, -1, [.. flat]);
+    }
+
+    private static void AddPart(List<PrereqExpr> parts, PrereqExpr p)
+    {
+        if (p.Op == PrereqOp.Atom)
+            foreach (PrereqExpr q in parts) if (q.Op == PrereqOp.Atom && q.Atom == p.Atom) return;
+        parts.Add(p);
+    }
+
+    /// <summary>The expression of <paramref name="node"/>; null for a root (see <see cref="Of(Predicate?)"/>).</summary>
+    public static PrereqExpr? Of(ResearchNode node) => Of(node.Prerequisite);
+
+    /// <summary>The tree of <paramref name="p"/>; null for no expression, and null for an expression this tree does not model —
+    /// one holding a comparison or a NOT, which <see cref="Predicate.Fold{T}"/> folds to one placeholder whose truth is not known
+    /// here. The research loader refuses a NOT and a comparison that reads a variable or a quantity in a prerequisite, but it
+    /// admits a comparison of literals such as "1 &gt; 0" (always true or always false), so such content can load (D-084
+    /// verification round 1, RT-R1-02; no shipped prerequisite has one). The surfaces then show what makes no false claim: each
+    /// prerequisite's kind (<see cref="Kinds(Predicate?, IReadOnlyList{int})"/>, decided from the Predicate itself), the flat
+    /// list and the content's own expression text — never a guessed tree, and never an exception.</summary>
+    public static PrereqExpr? Of(Predicate? p)
+    {
+        if (p is null) return null;
+        PrereqExpr e = p.Fold<PrereqExpr>(Leaf, (l, r) => Group(PrereqOp.All, [l, r]), (l, r) => Group(PrereqOp.Any, [l, r]), Unrepresentable);
+        return e.HasUnrepresentable() ? null : e;
+    }
+
+    /// <summary>The placeholder Fold returns for a comparison or a negation.</summary>
+    private static readonly PrereqExpr Unrepresentable = new(PrereqOp.Atom, -1, []);
+
+    private bool HasUnrepresentable()
+    {
+        if (ReferenceEquals(this, Unrepresentable)) return true;
+        foreach (PrereqExpr p in Parts) if (p.HasUnrepresentable()) return true;
+        return false;
+    }
+
+    /// <summary>Whether the expression holds when <paramref name="done"/> says which prerequisites are complete.</summary>
+    public bool Holds(Func<int, bool> done)
+    {
+        switch (Op)
+        {
+            case PrereqOp.Atom: return done(Atom);
+            case PrereqOp.All:
+                foreach (PrereqExpr p in Parts) if (!p.Holds(done)) return false;
+                return true;
+            default:
+                foreach (PrereqExpr p in Parts) if (p.Holds(done)) return true;
+                return false;
+        }
+    }
+
+    /// <summary>Whether the expression has an alternative anywhere (an ANY group).</summary>
+    public bool HasAlternatives
+    {
+        get
+        {
+            if (Op == PrereqOp.Any) return true;
+            foreach (PrereqExpr p in Parts) if (p.HasAlternatives) return true;
+            return false;
+        }
+    }
+
+    /// <summary>The expression in words with every nested group in parentheses: "Seed drill OR (Ard plough AND Padded horse
+    /// collar)". The detail pane and the inspector pass <see cref="NameInExpression"/>, so a name with parentheses of its own is
+    /// quoted.</summary>
+    public string Text(Func<int, string> name)
+    {
+        if (Op == PrereqOp.Atom) return name(Atom);
+        var parts = new List<string>(Parts.Count);
+        foreach (PrereqExpr p in Parts) parts.Add(p.Op == PrereqOp.Atom ? p.Text(name) : "(" + p.Text(name) + ")");
+        return string.Join(Op == PrereqOp.All ? " AND " : " OR ", parts);
+    }
+
+    /// <summary>D-084 verification round 1 (RT-R1-06 a): a name as an expression line writes it — in double quotes when it holds a
+    /// parenthesis of its own (11 shipped names do, such as "Cuneiform (full writing)"), so that every unquoted parenthesis of the
+    /// line is the expression's grouping: Lunar calendar AND ("Cuneiform (full writing)" OR Egyptian hieroglyphic OR ...).</summary>
+    public static string NameInExpression(string name) => name.IndexOf('(') >= 0 || name.IndexOf(')') >= 0 ? "\"" + name + "\"" : name;
+
+    /// <summary>The kind of each prerequisite of <paramref name="node"/>, aligned with <see cref="ResearchNode.PrerequisiteNodes"/>.</summary>
+    public static PrereqKind[] Kinds(ResearchNode node) => Kinds(node.Prerequisite, node.PrerequisiteNodes);
+
+    /// <summary>The kind (<see cref="PrereqKind"/>) of each atom in <paramref name="atoms"/> within <paramref name="p"/>; all
+    /// <see cref="PrereqKind.Required"/>'s default for no expression. Decided from the Predicate itself, so it holds for an
+    /// expression the tree does not model too.</summary>
+    public static PrereqKind[] Kinds(Predicate? p, IReadOnlyList<int> atoms)
+    {
+        var kinds = new PrereqKind[atoms.Count];
+        if (p is null) { Array.Fill(kinds, PrereqKind.Required); return kinds; }
+        IReadOnlyList<int> must = p.MustHoldAtoms();
+        bool mustAlone = p.Evaluate(null, a => Contains(must, a), null);
+        for (int k = 0; k < atoms.Count; k++)
+        {
+            int a = atoms[k];
+            if (Contains(must, a)) kinds[k] = PrereqKind.Required;
+            else if (!mustAlone && p.Evaluate(null, x => x == a || Contains(must, x), null)) kinds[k] = PrereqKind.OneOf;
+            else kinds[k] = PrereqKind.Grouped;
+        }
+        return kinds;
+    }
+
+    internal static bool Contains(IReadOnlyList<int> list, int v)
+    {
+        for (int i = 0; i < list.Count; i++) if (list[i] == v) return true;
+        return false;
+    }
+}
+
+/// <summary>One row of a requirement's outline (<see cref="PrereqOutline.Rows"/>): a prerequisite (<see cref="Atom"/> ≥ 0) with its
+/// <see cref="Kind"/>, or the HEAD of a nested group (<see cref="Atom"/> = -1) whose <see cref="Group"/> is the group itself:
+/// <see cref="Prefix"/> ("either ", "or " or ""), its operator and its <see cref="Arity"/> (how many items follow it at
+/// <see cref="Depth"/> + 1). <see cref="Depth"/> is the nesting level (0 = an item of the root).</summary>
+public sealed record PrereqRow(int Depth, int Atom, PrereqKind Kind, string Prefix, PrereqExpr? Group)
+{
+    public bool IsHead => Atom < 0;
+    /// <summary>A head's item count (its group's parts); 0 for a prerequisite.</summary>
+    public int Arity => Group is { } g ? g.Parts.Count : 0;
+    /// <summary>A head's operator: all of / one of.</summary>
+    public PrereqOp Op => Group?.Op ?? PrereqOp.Atom;
+}
+
+/// <summary>
+/// D-084; D-089 DH4 — A REQUIREMENT AS A LIST THAT KEEPS ITS GROUPING, shared by the research screen's REQUIRES rows and the
+/// inspector's ENABLED BY, WHY LOCKED and "a prerequisite of" lines. A requirement whose every prerequisite is
+/// <see cref="PrereqKind.Required"/> or <see cref="PrereqKind.OneOf"/> (no <see cref="PrereqKind.Grouped"/> one) keeps the flat list
+/// it always had: one row per prerequisite, in the order given, with its kind — "every required AND at least one one-of" is then
+/// exactly the expression. A requirement with a grouped prerequisite gets the expression's own outline, in pre-order: the root's
+/// prerequisites with their kinds, and every nested group as a head row (its prefix, operator and item count) followed by its
+/// items one level deeper — so the grouping is never lost and no row claims a kind it does not have. The root itself has no
+/// head: its operator is the kind of its prerequisites ("required" under ALL, "one of" under ANY) or, when it has none, its
+/// heads' prefixes ("either"/"or" under ANY, none under ALL).
+/// </summary>
+public static class PrereqOutline
+{
+    /// <summary>The rows of <paramref name="p"/> over <paramref name="atoms"/> (the requirement's distinct atoms, the order a flat
+    /// list uses). Empty for no requirement.</summary>
+    public static List<PrereqRow> Rows(Predicate? p, IReadOnlyList<int> atoms)
+    {
+        var rows = new List<PrereqRow>();
+        if (p is null || atoms.Count == 0) return rows;
+        return Rows(PrereqExpr.Of(p), atoms, PrereqExpr.Kinds(p, atoms));
+    }
+
+    /// <summary>The rows of the tree <paramref name="expr"/> (null when the expression is not modelled) over
+    /// <paramref name="atoms"/>, whose kinds (<see cref="PrereqExpr.Kinds(Predicate?, IReadOnlyList{int})"/>) are
+    /// <paramref name="kinds"/>, aligned. The research screen's view holds both already.</summary>
+    public static List<PrereqRow> Rows(PrereqExpr? expr, IReadOnlyList<int> atoms, IReadOnlyList<PrereqKind> kinds)
+    {
+        var rows = new List<PrereqRow>();
+        if (atoms.Count == 0) return rows;
+        bool grouped = false;
+        foreach (PrereqKind k in kinds) grouped |= k == PrereqKind.Grouped;
+        if (!grouped || expr is null)
+        {
+            for (int k = 0; k < atoms.Count; k++) rows.Add(new PrereqRow(0, atoms[k], kinds[k], "", null));
+            return rows;
+        }
