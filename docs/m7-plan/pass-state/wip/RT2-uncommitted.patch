+    /// round 1, RT-R1-06 c: an outline never begins "or all of"). Under an ALL parent, nothing.</summary>
+    public static string HeadPrefix(bool parentAny, int index, bool root) => !parentAny ? "" : index > 0 ? "or " : root ? "either " : "";
+}
