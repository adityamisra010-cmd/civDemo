+/// <summary>A Fact that SKIPS (not fails) when the exported battle trace of scenes C and D is missing.</summary>
+public sealed class BenchTraceFactAttribute : FactAttribute
+{
+    public BenchTraceFactAttribute() { if (!File.Exists(BenchBattle.DefaultPath)) Skip = "no battle-trace bake: run scripts/export-battle-trace.sh"; }
+}
+
+/// <summary>A device test that needs the stage-chars bake and the exported battle trace: SKIPS without any of them.</summary>
+public sealed class BenchCrowdFactAttribute : FactAttribute
+{
+    public BenchCrowdFactAttribute()
+    {
+        if (!TestGfx.Available) Skip = "no graphics device: " + TestGfx.Reason;
+        else if (!Gfx.Chars.Rendering.CharStage.BakeExists()) Skip = "no character bake: run scripts/bake-chars.sh";
+        else if (!File.Exists(BenchBattle.DefaultPath)) Skip = "no battle-trace bake: run scripts/export-battle-trace.sh";
+    }
+}
+
+/// <summary>Stage scenes: the compact battle trace, the weather switches and layers, the aftermath plan and its beats.</summary>
+public sealed class ScenesTests
+{
+    // ------------------------------------------------------------------ compact binary trace (G2BT)
+
+    static BattleTrace Fixture() => BattleTrace.Load(BattleTrace.FindFixture(BattleTrace.DefaultFixture));
+
+    static byte[] Bin(BattleTrace t) { using var ms = new MemoryStream(); t.WriteBinary(ms); return ms.ToArray(); }
+
+    static byte[] Inflate(byte[] gz)
+    {
+        using var z = new GZipStream(new MemoryStream(gz), CompressionMode.Decompress);
+        using var o = new MemoryStream(); z.CopyTo(o); return o.ToArray();
+    }
+
+    static byte[] Deflate(byte[] raw)
+    {
+        using var o = new MemoryStream();
+        using (var z = new GZipStream(o, CompressionLevel.Fastest, leaveOpen: true)) z.Write(raw);
+        return o.ToArray();
+    }
+
+    static int VarLen(long v) { ulong z = (ulong)((v << 1) ^ (v >> 63)); int n = 1; while (z >= 0x80) { z >>= 7; n++; } return n; }
+    static int StrLen(string s) => 4 + Encoding.UTF8.GetByteCount(s);
+
+    /// <summary>The documented G2BT layout's exact uncompressed length for a trace, computed field by field from its
+    /// public contents (independent of the writer).</summary>
+    static long ExpectedPayloadLength(BattleTrace t)
+    {
+        long n = 4 + 4 + StrLen(t.Label) + 8 + 8 + 1 + StrLen(t.FrameJson) + StrLen(t.ResultJson);
+        n += 4; foreach (var f in t.Formations) n += 8 + 4 + StrLen(f.Kind) + 1 + 4;
+        n += 4 + t.Entities.Count * 20L;
+        n += 4 + t.StepCount * 8L;
+        var prev = new long[2 * t.Entities.Count];
+        for (int s = 0; s < t.StepCount; s++)
+            for (int e = 0; e < t.Entities.Count; e++)
+            {
+                var (x, y) = t.PosMm(s, e);
+                n += VarLen(x - prev[2 * e]) + VarLen(y - prev[2 * e + 1]);
+                prev[2 * e] = x; prev[2 * e + 1] = y;
+            }
+        n += (long)t.StepCount * t.Entities.Count;
+        n += 4; long pt = 0;
+        foreach (var ev in t.Events) { n += VarLen(ev.TimeMs - pt) + 1 + VarLen(ev.Source) + VarLen(ev.Target) + VarLen(ev.A); pt = ev.TimeMs; }
+        return n;
+    }
+
+    static void AssertSameTrace(BattleTrace a, BattleTrace b)
+    {
+        Assert.Equal(a.Label, b.Label); Assert.Equal(a.Seed, b.Seed); Assert.Equal(a.StepMs, b.StepMs); Assert.Equal(a.Over, b.Over);
+        Assert.Equal(a.FrameJson, b.FrameJson); Assert.Equal(a.ResultJson, b.ResultJson);
+        Assert.Equal(a.Formations, b.Formations); Assert.Equal(a.Entities, b.Entities); Assert.Equal(a.Events, b.Events);
+        Assert.Equal(a.StepCount, b.StepCount);
+        for (int s = 0; s < a.StepCount; s++)
+        {
+            Assert.Equal(a.StepTimeMs(s), b.StepTimeMs(s));
+            for (int e = 0; e < a.Entities.Count; e++) { Assert.Equal(a.PosMm(s, e), b.PosMm(s, e)); Assert.Equal(a.State(s, e), b.State(s, e)); }
+        }
+        Assert.Equal(a.Hash(), b.Hash());
+    }
+
+    /// <summary>
+    /// The populated G1 fixture (formations, entities, steps and events all present) written in the compact form reads
+    /// back field for field, hashes the same, writes back to the same bytes, and its payload has exactly the length the
+    /// documented layout gives.
+    /// </summary>
+    [Fact]
+    public void BinaryTraceRoundTripsThePopulatedFixtureExactly()
+    {
+        var t = Fixture();
+        Assert.True(t.Formations.Count > 0 && t.Entities.Count > 0 && t.StepCount > 1 && t.Events.Count > 0, "a populated trace");
+        var bytes = Bin(t);
+        Assert.True(bytes.Length > 2 && bytes[0] == 0x1F && bytes[1] == 0x8B, "gzip");
+        var back = BattleTrace.ParseBinary(bytes);
+        AssertSameTrace(t, back);
+        Assert.Equal(bytes, Bin(back));
+        Assert.Equal(ExpectedPayloadLength(t), Inflate(bytes).LongLength);
+        // Load dispatches on the gzip magic
+        string tmp = Path.Combine(Path.GetTempPath(), "g2bt-" + Environment.ProcessId.ToString(CultureInfo.InvariantCulture) + ".g2bt");
+        try { File.WriteAllBytes(tmp, bytes); AssertSameTrace(t, BattleTrace.Load(tmp)); }
+        finally { File.Delete(tmp); }
+    }
+
+    /// <summary>A damaged compact trace is refused, never read as a different battle: wrong magic, an unknown version, an
+    /// unknown event kind, time running backwards, trailing bytes, a truncated payload.</summary>
+    [Fact]
+    public void BinaryTraceRefusesDamagedInput()
+    {
+        var raw = Inflate(Bin(Fixture()));
+        byte[] Copy() => (byte[])raw.Clone();
+        var bad = Copy(); bad[0] = (byte)'X';
+        Assert.Throws<InvalidDataException>(() => BattleTrace.ParseBinary(Deflate(bad)));
+        bad = Copy(); BinaryPrimitives.WriteInt32LittleEndian(bad.AsSpan(4), 2);
+        Assert.Throws<InvalidDataException>(() => BattleTrace.ParseBinary(Deflate(bad)));
+        Assert.Throws<InvalidDataException>(() => BattleTrace.ParseBinary(Deflate(raw.Concat(new byte[] { 0 }).ToArray())));
+        var trunc = raw[..^1];
+        var ex = Record.Exception(() => BattleTrace.ParseBinary(Deflate(trunc)));
+        Assert.True(ex is EndOfStreamException or InvalidDataException, "truncated: " + ex?.GetType().Name);
+        // the event table: the first event's kind byte follows its time varint; make it 7
+        var t = Fixture();
+        long evStart = ExpectedPayloadLength(t) - EventBytes(t);
+        int kindAt = checked((int)(evStart + 4 + VarLen(t.Events[0].TimeMs)));
+        Assert.Equal((byte)t.Events[0].Kind, raw[kindAt]);
+        bad = Copy(); bad[kindAt] = 7;
+        Assert.Throws<InvalidDataException>(() => BattleTrace.ParseBinary(Deflate(bad)));
+        // the second step's time set equal to the first's
+        long timesAt = ExpectedPayloadLength(t) - EventBytes(t) - (long)t.StepCount * t.Entities.Count - PositionBytes(t) - t.StepCount * 8L;
+        bad = Copy(); BinaryPrimitives.WriteInt64LittleEndian(bad.AsSpan(checked((int)timesAt + 8)), t.StepTimeMs(0));
+        Assert.Throws<InvalidDataException>(() => BattleTrace.ParseBinary(Deflate(bad)));
+    }
+
+    static long EventBytes(BattleTrace t)
+    {
+        long n = 4, pt = 0;
+        foreach (var ev in t.Events) { n += VarLen(ev.TimeMs - pt) + 1 + VarLen(ev.Source) + VarLen(ev.Target) + VarLen(ev.A); pt = ev.TimeMs; }
+        return n;
+    }
+
+    static long PositionBytes(BattleTrace t)
+    {
+        long n = 0; var prev = new long[2 * t.Entities.Count];
+        for (int s = 0; s < t.StepCount; s++)
+            for (int e = 0; e < t.Entities.Count; e++)
+            {
+                var (x, y) = t.PosMm(s, e);
+                n += VarLen(x - prev[2 * e]) + VarLen(y - prev[2 * e + 1]);
+                prev[2 * e] = x; prev[2 * e + 1] = y;
+            }
+        return n;
+    }
+
+    /// <summary>
+    /// The exported battle of scenes C and D is the file its manifest names (sha256 and trace hash), 2,100 soldiers of two
+    /// sides of 1,050, with the resolver's result in its header, and its compact form round-trips exactly.
+    /// </summary>
+    [BenchTraceFact]
+    public void BenchBattleBakeMatchesItsManifest()
+    {
+        var path = BenchBattle.DefaultPath;
+        var row = File.ReadAllLines(Path.Combine(Path.GetDirectoryName(path)!, "MANIFEST.tsv"))
+            .Single(l => l.StartsWith(BenchBattle.FileName + "\t", StringComparison.Ordinal)).Split('\t');
+        Assert.Equal(row[1], Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path))).ToLowerInvariant());
+        var b = BenchBattle.Load();
+        Assert.Equal(row[2], b.Trace.Hash());
+        Assert.Equal(2100, b.Trace.Entities.Count);
+        Assert.Equal(1050, b.Trace.Entities.Count(e => e.Side == 0));
+        Assert.InRange(b.HoldsField, -1, 1);
+        Assert.False(string.IsNullOrEmpty(b.Reason));
+        var c = b.Counts(b.Trace.StepCount - 1);
+        int total = 0; foreach (var v in c) total += v;
+        Assert.Equal(2100, total);
+        AssertSameTrace(b.Trace, BattleTrace.ParseBinary(Bin(b.Trace)));
+    }
+
+    /// <summary>
+    /// The trace-driven crowd shows what the trace records and never writes it: at three snapshot times every 7th
+    /// soldier stands exactly at its recorded position (flat ground), in its recorded state, the counts per state of an
+    /// update are the trace's counts at that step, and the trace hashes the same afterwards.
+    /// </summary>
+    [BenchCrowdFact]
+    public void TraceCrowdShowsWhatTheTraceRecordsAndNeverWritesIt()
+    {
+        TestGfx.Host.Invoke(gd =>
+        {
+            var b = BenchBattle.Load(); var tr = b.Trace; string h0 = tr.Hash();
+            using var crowd = new TraceCrowd(gd, b, (x, z) => 0f);
+            foreach (int s in new[] { 0, tr.StepCount / 3, tr.StepCount - 1 })
+            {
+                float t = crowd.SceneTime(tr.StepTimeMs(s));
+                crowd.Update(t);
+                for (int e = 0; e < tr.Entities.Count; e += 7)
+                {
+                    var (x, y) = tr.PosMm(s, e);
+                    var want = b.World(x, y);
+                    var (p, _) = crowd.Place(e, t);
+                    Assert.Equal((want.X, 0f, want.Z), (p.X, p.Y, p.Z));
+                    Assert.Equal(BenchBattle.Map(tr.State(s, e)), crowd.StateAt(e, t));
+                }
+                var c = b.Counts(s);
+                for (int k = 0; k < 5; k++) Assert.Equal(c[0, k] + c[1, k], crowd.LastStates[k]);
+            }
+            Assert.Equal(h0, tr.Hash());
+        });
+    }
+
+    // ------------------------------------------------------------------ weather switches
+
+    /// <summary>Weather presets set all four terms; single terms clamp to 0..1; unknown looks are refused; Describe
+    /// mentions weather only when a term is on (the clear frame's description is unchanged).</summary>
+    [Fact]
+    public void WeatherSwitchesParseClampAndDescribe()
+    {
+        var f = new RenderFeatures();
+        string clear = f.Describe();
+        Assert.False(f.HasWeather);
+        f.SetMany("weather=rain");
+        Assert.Equal((0.93f, 1f, 1f, 0.35f), (f.Cloud, f.Wetness, f.Rain, f.Mist));
+        Assert.Contains("rain=1", f.Describe());
+        f.SetMany("weather=mist");
+        Assert.Equal((WeatherPresets.Mist.Cloud, WeatherPresets.Mist.Wetness, 0f, 1f), (f.Cloud, f.Wetness, f.Rain, f.Mist));
+        f.SetMany("weather=clear");
+        Assert.False(f.HasWeather);
+        Assert.Equal(clear, f.Describe());
+        f.SetMany("cloud=2,wet=-1,rain=0.5,mist=0.25");
+        Assert.Equal((1f, 0f, 0.5f, 0.25f), (f.Cloud, f.Wetness, f.Rain, f.Mist));
+        Assert.Throws<ArgumentException>(() => f.SetMany("weather=snow"));
+        foreach (var w in WeatherPresets.All) Assert.Equal(w, WeatherPresets.Get(w.Name));
+    }
+
+    /// <summary>Mist 0 returns the scene's fog and haze bit for bit; mist thickens the fog and the haze monotonically.</summary>
+    [Fact]
+    public void MistOffLeavesFogAndHazeExactlyAsTheyWere()
+    {
+        var fog = new Vector4(0.0123f, 0.0456f, 7.5f, 0.82f);
+        Assert.Equal(fog, ForwardRenderer.MistFog(fog, 0f));
+        Assert.Equal(fog, ForwardRenderer.MistFog(fog, -0.5f));
+        Assert.Equal(3.25f, ForwardRenderer.MistHaze(3.25f, 0f));
+        Vector4 prev = fog; float prevHaze = 3.25f;
+        foreach (float m in new[] { 0.25f, 0.5f, 1f })
+        {
+            var f = ForwardRenderer.MistFog(fog, m);
+            Assert.True(f.X > prev.X && f.W > prev.W, $"mist {m}: density and cap rise");
+            Assert.Equal(fog.Z, f.Z);
+            float h = ForwardRenderer.MistHaze(3.25f, m);
+            Assert.True(h > prevHaze);
+            prev = f; prevHaze = h;
+        }
+    }
+
+    // ------------------------------------------------------------------ weather on the device (PillarScene)
+
+    const int W = 320, H = 180;
+    static readonly SunState Sun = SunModel.At(11f);
+
+    static ForwardRenderer NewRenderer(GraphicsDevice gd, string switches)
+    {
+        var r = new ForwardRenderer(gd, TestGfx.Host.Effects);
+        r.Settings.FogParams = new Vector4(0f, 0.02f, 0f, 0f);
+        r.Settings.ShadowCasterBounds = new BoundingBox(new Vector3(-80, -1, -80), new Vector3(80, 10, 80));
+        r.Settings.Features.SetMany("autoexposure=0,bloom=0,grade=0,aa=none,farfield=0,ssao=0,contact=0");
+        if (switches.Length > 0) r.Settings.Features.SetMany(switches);
+        return r;
+    }
+
+    static Color[] Frame(ForwardRenderer r, IRenderContent c, CameraPose cam, RenderTarget2D rt, float t = 0f)
+    {
+        r.Render(c, cam, Sun, rt, t);
+        return Capture.ReadPixels(rt);
+    }
+
+    static float Luma(Color c) => 0.2126f * c.R + 0.7152f * c.G + 0.0722f * c.B;
+
+    static float LumaAt(Color[] px, CameraPose cam, Vector3 world)
+    {
+        var c = Vector4.Transform(new Vector4(world, 1), cam.View * cam.Projection(W / (float)H));
+        int x = (int)((c.X / c.W * 0.5f + 0.5f) * W), y = (int)((0.5f - c.Y / c.W * 0.5f) * H);
+        float s = 0;
+        for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) s += Luma(px[Math.Clamp(y + j, 0, H - 1) * W + Math.Clamp(x + i, 0, W - 1)]);
+        return s / 9f;
+    }
+
+    /// <summary>The camera beside the pillar, square to the sun (no glint towards it): ground on the pillar's sunlit and
+    /// shadowed sides, near ground and far ground across the slab.</summary>
+    static (CameraPose cam, Vector3 lit, Vector3 shade, Vector3 near, Vector3 far) SunBehind()
+    {
+        var l = Sun.DirectionToLight;
+        var s = Vector3.Normalize(new Vector3(l.X, 0, l.Z)); var p = new Vector3(-s.Z, 0, s.X);
+        var cam = new CameraPose(p * 6f + new Vector3(0, 2.6f, 0), new Vector3(0, 0.25f, 0), 0.8f, 0.1f, 400f);
+        return (cam, s * 0.9f, -s * 0.9f, p * 3.2f + s * 1.5f, -p * 40f + s * 3f);
+    }
+
+    /// <summary>Content that draws the pillar and, in the transparent pass, an optional rain layer or smoke layer.</summary>
+    sealed class WeatherBox(PillarScene scene, RainLayer? rain, SmokeLayer? smoke) : IRenderContent, ITransparentContent
+    {
+        public void DrawShadowCasters(RenderContext rc) => scene.DrawShadowCasters(rc);
+        public void DrawOpaque(RenderContext rc) => scene.DrawOpaque(rc);
+        public bool NeedsSceneColor(RenderContext rc) => false;
+        public void DrawTransparent(RenderContext rc) { rain?.Draw(rc); smoke?.Draw(rc); }
+    }
+
+    /// <summary>
+    /// All weather terms at 0 give the default frame pixel for pixel; wetness darkens the lit, porous ground (water in the
+    /// pores) by a clear margin on both the sunlit and the shadowed side.
+    /// </summary>
+    [GfxFact]
+    public void WetGroundDarkensAndZeroWeatherIsTheDefaultFrame()
+    {
