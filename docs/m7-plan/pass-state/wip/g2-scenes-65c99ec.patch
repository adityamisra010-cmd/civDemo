+/// <summary>
+/// Stage scenes: a scene that plays its own camera path (a cinematic's beats). The benchmark harness plays it on slot D
+/// instead of an orbit: u in [0, 1) over the measured frames → camera, scene time and hour of day. Presentation only.
+/// </summary>
+public interface ICameraPathScene
+{
