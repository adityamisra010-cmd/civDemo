diff --git a/prototypes/m7-gfx2/Gfx.Engine/Rendering/SmokeLayer.cs b/prototypes/m7-gfx2/Gfx.Engine/Rendering/SmokeLayer.cs
new file mode 100644
index 0000000..143d1fa
--- /dev/null
+++ b/prototypes/m7-gfx2/Gfx.Engine/Rendering/SmokeLayer.cs
@@ -0,0 +1,196 @@
+using System.Runtime.InteropServices;
+using Gfx.Engine.Effects;
+using Gfx.Engine.Mgfx;
+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Graphics;
+
+namespace Gfx.Engine.Rendering;
+
+/// <summary>A smoke or dust source: where it rises from and how it looks.</summary>
+public sealed record SmokeSource(Vector3 Base, float Rate, float Life, float Rise, float StartSize, float EndSize, Vector3 Tint, float Opacity, float Spread)
+{
+    /// <summary>A thin ground layer (dust): seen through its thickness, so it is faint from above and dense edge-on.</summary>
+    public bool Layer { get; init; }
+
+    /// <summary>A plume of grey smoke from a smouldering fire: thin puffs that billow from 3 m to 20 m wide as they rise
+    /// about 20 m and drift downwind, fading as they spread.</summary>
+    public static SmokeSource Plume(Vector3 at, float scale = 1f) => new(at, 6f * scale, 22f, 2.2f * scale, 3f * scale, 20f * scale, new Vector3(0.34f, 0.33f, 0.31f), 0.18f, 2.5f);
+    /// <summary>A low drifting dust haze over trampled ground (barely rises, wide, very faint).</summary>
+    public static SmokeSource Dust(Vector3 at, float scale = 1f) => new(at, 5f * scale, 26f, 0.15f, 6f * scale, 14f * scale, new Vector3(0.62f, 0.55f, 0.44f), 0.035f, 12f * scale) { Layer = true };
+}
+
+/// <summary>
+/// Smoke and dust puffs (stage scenes; PRESENTATION ONLY): camera-facing soft billboards emitted by <see cref="SmokeSource"/>s,
+/// each puff's birth, drift (wind), rise, growth and fade a pure function of its index and the scene time (no particle
+/// state; stills, replays and the benchmark path agree). Lit by the sun with a forward-scattering phase and by the sky
+/// light, sorted back to front on the CPU and drawn with premultiplied alpha in the transparent pass (depth tested, not
+/// written); the soft edge fades where a puff meets the ground (scene depth) so plumes do not cut into the terrain.
+/// </summary>
+public sealed class SmokeLayer : IDisposable
+{
+    readonly GraphicsDevice _gd;
+    readonly List<SmokeSource> _sources = new();
+    readonly List<(float depth, SmokeVertex[] quad)> _sorted = new();
+    SmokeVertex[] _verts = Array.Empty<SmokeVertex>();
+    DynamicVertexBuffer? _vb; IndexBuffer? _ib; int _capacity;
+    public Vector3 Wind { get; set; } = new(1.0f, 0f, 0.3f);
+    public IReadOnlyList<SmokeSource> Sources => _sources;
+    public int LastPuffs { get; private set; }
+
+    [StructLayout(LayoutKind.Sequential, Pack = 1)]
+    struct SmokeVertex : IVertexType
+    {
+        public Vector4 Pos;     // xyz world centre, w corner (0..3)
+        public Vector4 Puff;    // x size (m), y opacity, z seed, w age 0..1
+        public Vector4 Tint;    // rgb, w 1 for a thin ground layer (dust)
+        public static readonly VertexDeclaration Decl = new(
+            new VertexElement(0, VertexElementFormat.Vector4, VertexElementUsage.Position, 0),
+            new VertexElement(16, VertexElementFormat.Vector4, VertexElementUsage.TextureCoordinate, 0),
+            new VertexElement(32, VertexElementFormat.Vector4, VertexElementUsage.TextureCoordinate, 1));
+        readonly VertexDeclaration IVertexType.VertexDeclaration => Decl;
+    }
+
+    public SmokeLayer(GraphicsDevice gd) { _gd = gd; }
+
+    public void Add(SmokeSource s) => _sources.Add(s);
+    public void Clear() => _sources.Clear();
+
+    static float H(uint x) { x ^= x >> 16; x *= 0x85EBCA6Bu; x ^= x >> 13; x *= 0xC2B2AE35u; x ^= x >> 16; return (x >> 8) / 16777216f; }
+
+    /// <summary>Builds the puffs alive at scene time <paramref name="t"/>, sorted back to front for <paramref name="eye"/>.</summary>
+    void Build(float t, Vector3 eye)
+    {
+        _sorted.Clear();
+        for (int si = 0; si < _sources.Count; si++)
+        {
+            var s = _sources[si];
+            int n = Math.Max(1, (int)MathF.Ceiling(s.Rate * s.Life));
+            float period = n / s.Rate;
+            for (int i = 0; i < n; i++)
+            {
+                uint key = (uint)(si * 7919 + i * 104729 + 17);
+                // puff i is born at times (i + j·n)/rate; its current age in this cycle
+                float born = (i + H(key) * 0.6f) / s.Rate;
+                float age = ((t - born) % period + period) % period;
+                if (age > s.Life) continue;
+                float a = age / s.Life;
+                var dir = new Vector3(H(key ^ 0xA1u) * 2 - 1, 0, H(key ^ 0xB2u) * 2 - 1);
+                // drift downwind, rise and spread, plus a slow meander (each puff its own phase) so plumes billow
+                float ph = H(key ^ 0xE5u) * MathF.Tau;
+                var meander = new Vector3(MathF.Sin(age * 0.45f + ph), 0, MathF.Cos(age * 0.37f + ph * 1.7f)) * (s.Spread * 1.2f * a);
+                var p = s.Base + dir * (s.Spread * (0.3f + a)) + Wind * age * (0.6f + 0.4f * a) + meander
+                      + new Vector3(0, s.Rise * MathF.Pow(age, 0.75f) + 0.3f * s.StartSize, 0);
+                float size = MathHelper.Lerp(s.StartSize, s.EndSize, MathF.Sqrt(a)) * (0.8f + 0.4f * H(key ^ 0xC3u));
+                float op = s.Opacity * MathF.Min(1f, a * 8f) * (1f - a) * (1f - a);
+                var quad = new SmokeVertex[4];
+                for (int c = 0; c < 4; c++)
+                    quad[c] = new SmokeVertex { Pos = new Vector4(p, c), Puff = new Vector4(size, op, H(key ^ 0xD4u), a), Tint = new Vector4(s.Tint, s.Layer ? 1f : 0f) };
+                _sorted.Add((Vector3.DistanceSquared(p, eye), quad));
+            }
+        }
+        _sorted.Sort((x, y) => y.depth.CompareTo(x.depth));
+        LastPuffs = _sorted.Count;
+    }
+
+    public void Draw(RenderContext rc)
+    {
+        if (_sources.Count == 0 || rc.IsShadowPass || rc.IsReflectionPass) return;
+        Build(rc.TimeSeconds, rc.Camera.Position);
+        int n = _sorted.Count;
+        if (n == 0) return;
+        if (_capacity < n)
+        {
+            _vb?.Dispose(); _ib?.Dispose();
+            _capacity = Math.Max(n, 256);
+            _vb = new DynamicVertexBuffer(_gd, SmokeVertex.Decl, _capacity * 4, BufferUsage.WriteOnly);
+            var ix = new int[_capacity * 6];
+            for (int i = 0; i < _capacity; i++) { int b = i * 4, o = i * 6; ix[o] = b; ix[o + 1] = b + 1; ix[o + 2] = b + 2; ix[o + 3] = b + 1; ix[o + 4] = b + 3; ix[o + 5] = b + 2; }
+            _ib = new IndexBuffer(_gd, IndexElementSize.ThirtyTwoBits, ix.Length, BufferUsage.WriteOnly);
+            _ib.SetData(ix);
+            _verts = new SmokeVertex[_capacity * 4];
+        }
+        for (int i = 0; i < n; i++) Array.Copy(_sorted[i].quad, 0, _verts, i * 4, 4);
+        _vb!.SetData(_verts, 0, n * 4, SetDataOptions.Discard);
+        var e = rc.Effects.Get(WeatherEffectNames.Smoke);
+        var cam = rc.Camera;
+        var fwd = Vector3.Normalize(cam.Target - cam.Position);
+        var right = Vector3.Normalize(Vector3.Cross(fwd, Vector3.Up)); var up = Vector3.Cross(right, fwd);
+        e.Parameters["SmokeRight"].SetValue(new Vector4(right, 0));
+        e.Parameters["SmokeUp"].SetValue(new Vector4(up, 0));
+        e.Parameters["SmokeSun"].SetValue(new Vector4(rc.Sun.LightColor, 0));
+        e.Parameters["SmokeAmb"].SetValue(new Vector4(rc.Sun.AmbientSky * MathF.PI, 0));
+        e.Parameters["SmokeDir"].SetValue(new Vector4(rc.Sun.DirectionToLight, 0));
+        _gd.SetVertexBuffer(_vb); _gd.Indices = _ib;
+        _gd.BlendState = BlendState.AlphaBlend; _gd.DepthStencilState = DepthStencilState.DepthRead; _gd.RasterizerState = RasterizerState.CullNone;
+        rc.Apply(e);
+        _gd.DrawIndexedPrimitives(PrimitiveType.TriangleList, 0, 0, n * 2);
+        rc.Stats.RecordDraw(1, n * 2);
+        _gd.BlendState = BlendState.Opaque; _gd.DepthStencilState = DepthStencilState.Default;
+    }
+
+    public void Dispose() { _vb?.Dispose(); _ib?.Dispose(); }
+}
+
+/// <summary>The smoke effect (stage scenes), registered with the weather effects.</summary>
+public sealed class SmokeEffects : IEffectSource
+{
+    public IEnumerable<EffectBuilder> CreateEffects()
+    {
+        yield return new EffectBuilder(WeatherEffectNames.Smoke)
+            .Attribute("vec4 a_pos", VertexElementUsage.Position, 0)
+            .Attribute("vec4 a_puff", VertexElementUsage.TextureCoordinate, 0)
+            .Attribute("vec4 a_tint", VertexElementUsage.TextureCoordinate, 1)
+            .Matrix("ViewProj", Stage.Vertex)
+            .Vec4("SmokeRight", Stage.Vertex).Vec4("SmokeUp", Stage.Vertex)
+            .Vec4("SmokeSun", Stage.Pixel).Vec4("SmokeAmb", Stage.Pixel).Vec4("SmokeDir", Stage.Pixel)
+            .Vec4("CameraPos", Stage.Pixel).Vec4("FogParams", Stage.Pixel).Vec4("FogColor", Stage.Pixel)
+            .BlendedGBuffer()
+            .Varyings("vec2 v_uv; vec4 v_puff; vec4 v_tint; vec3 v_wpos; vec3 v_centre;")
+            .VertexMain(@"
+    float c = floor(a_pos.w + 0.01);
+    vec2 corner = vec2((c == 0.0 || c == 2.0) ? -1.0 : 1.0, c < 1.5 ? -1.0 : 1.0);
+    // a slow per-puff turn of the quad so the noise pattern does not repeat
+    float ang = a_puff.z * 6.2831 + a_puff.w * (a_puff.z - 0.5) * 2.0;
+    vec2 rc = vec2(corner.x * cos(ang) - corner.y * sin(ang), corner.x * sin(ang) + corner.y * cos(ang));
+    vec3 wp = a_pos.xyz + (SmokeRight.xyz * rc.x + SmokeUp.xyz * rc.y) * (a_puff.x * 0.5);
+    v_uv = corner; v_puff = a_puff; v_tint = a_tint; v_wpos = wp; v_centre = a_pos.xyz;
+    gl_Position = ViewProj_mul(vec4(wp, 1.0));")
+            .PixelMain(@"
+    float r = length(v_uv);
+    // soft round puff with a procedural billow (value-noise octaves in the puff's frame)
+    vec2 q = v_uv * 2.3 + vec2(v_puff.z * 17.0, v_puff.z * 31.0);
+    float n = 0.0, amp = 0.55;
+    for (int k = 0; k < 3; k++) {
+        vec2 i = floor(q), f = fract(q); f = f * f * (3.0 - 2.0 * f);
+        float h00 = fract(sin(dot(i, vec2(127.1, 311.7))) * 43758.5);
+        float h10 = fract(sin(dot(i + vec2(1.0, 0.0), vec2(127.1, 311.7))) * 43758.5);
+        float h01 = fract(sin(dot(i + vec2(0.0, 1.0), vec2(127.1, 311.7))) * 43758.5);
+        float h11 = fract(sin(dot(i + vec2(1.0, 1.0), vec2(127.1, 311.7))) * 43758.5);
+        n += amp * mix(mix(h00, h10, f.x), mix(h01, h11, f.x), f.y);
+        q *= 2.1; amp *= 0.5;
+    }
+    float shape = smoothstep(1.0, 0.25, r + (n - 0.45) * 0.8);
+    vec3 V = normalize(v_wpos - CameraPos.xyz);
+    float d = length(v_wpos - CameraPos.xyz);
+    // a thin ground layer (dust) is seen through its thickness: its optical depth grows as 1/sin(elevation) of the
+    // view, so from above it is faint and edge-on it is dense; a puff at the camera fades out (a puff filling the
+    // view reads as a blur, not as smoke)
+    float layer = v_tint.w > 0.5 ? clamp(0.12 / max(abs(V.y), 0.02), 0.08, 1.0) : 1.0;
+    float nearFade = smoothstep(0.25, 0.8, d / max(v_puff.x, 1.0));
+    float a = clamp(shape * v_puff.y * layer * nearFade, 0.0, 1.0);
+    // light: sky light plus the sun with a forward-scattering lobe (puffs glow against a low sun), each puff shaded as
+    // a soft sphere (its sun side lighter, its far side and underside darker) so a plume reads as a volume
+    float cosT = dot(V, SmokeDir.xyz);
+    float g = 0.35; float phase = 0.0796 * (1.0 - g * g) / pow(1.0 + g * g - 2.0 * g * cosT, 1.5) * 2.5;
+    vec3 ip = (v_wpos - v_centre) / max(0.5 * v_puff.x, 0.01);
+    vec3 N = normalize(ip - V * sqrt(max(0.0, 1.0 - min(dot(ip, ip), 1.0))));
+    float sunSide = mix(0.3, 1.0, clamp(dot(N, SmokeDir.xyz) * 0.5 + 0.5, 0.0, 1.0));
+    float skySide = mix(0.6, 1.0, clamp(N.y * 0.5 + 0.5, 0.0, 1.0));
+    float self = mix(0.45, 1.0, n);
+    vec3 col = v_tint.rgb * (SmokeAmb.rgb * 0.32 * self * skySide + SmokeSun.rgb * (0.10 + 0.16 * phase) * self * sunSide);
+    // distance fog like the scene's
+    float fog = 1.0 - exp(-FogParams.x * 0.35 * d);
+    col = mix(col, FogColor.rgb, clamp(fog, 0.0, 0.9));
+    gl_FragColor = vec4(col * a, a);");
+    }
+}
