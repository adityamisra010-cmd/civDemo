+using System.Globalization;
+using Gfx.Chars.Rendering;
+using Gfx.Engine.Rendering;
+using Gfx.Engine.Scene;
+using Gfx.Gear.Runtime;
+using Gfx.Proc.Authoritative;
+using Gfx.Proc.Environment;
+using Gfx.Proc.Environment.Structures;
+using Gfx.Proc.Presentation;
+using Gfx.Proc.Scenes;
+using Microsoft.Xna.Framework;
+using Microsoft.Xna.Framework.Graphics;
+
+namespace Gfx.Demo.Scenes.Bench;
+
+/// <summary>
+/// Times of day of the benchmark scenes (stage scenes; presentation only). The sun model sits at 40° N with a +12°
+/// declination: noon has the sun 61° up, golden hour about 9° (long warm light), dusk about 1° (sunset: a low orange sun,
+/// shadows across the whole field, the sky turning).
+/// </summary>
+public static class BenchHours
+{
+    public const float Noon = 12.5f, Golden = 17.9f, Dusk = 18.62f;
+    public static readonly (string name, float hour)[] All = { ("noon", Noon), ("golden", Golden), ("dusk", Dusk) };
+}
+
+/// <summary>
+/// The hero characters of a benchmark scene: a stage-chars character stage and the era kit in it (stage kit), with
+/// the kit garment outfits it loads. PRESENTATION ONLY: the characters read nothing from any simulation (DR39, DR42);
+/// where a scene maps a hero to a battle-trace entity, it takes that entity's position and state and nothing else.
+/// </summary>
+public sealed class BenchCast : IDisposable
+{
+    readonly GraphicsDevice _gd;
+    readonly List<CharAsset> _outfits = new();
+    public CharStage Stage { get; }
+    public KitWorld Kit { get; }
+
+    public BenchCast(GraphicsDevice gd)
+    {
+        _gd = gd;
+        Stage = new CharStage(gd);
+        Kit = new KitWorld(gd, Stage);
+    }
+
+    /// <summary>An identity wearing a stage-kit garment outfit ($G2_ASSETS/baked/kit/outfits, scripts/bake-kit-outfits.sh).</summary>
+    public CharInstance SpawnKitOutfit(string identity, string outfit)
+    {
+        string path = Gfx.Engine.Assets.AssetRoot.Baked($"kit/outfits/{identity}__{outfit}.g2ch");
+        if (!File.Exists(path)) throw new FileNotFoundException($"kit outfit bake missing: {path} (run scripts/bake-kit-outfits.sh)");
+        var inst = new CharInstance(Stage.Asset(identity));
+        var asset = CharAsset.Load(_gd, path, Stage.Textures.Get);
+        _outfits.Add(asset);
+        inst.Wear(_gd, asset);
+        Stage.Instances.Add(inst);
+        Stage.Invalidate();
+        return inst;
+    }
+
+    public void Dispose()
+    {
+        Kit.Dispose();
+        foreach (var a in _outfits) a.Dispose();
+        _outfits.Clear();
+        Stage.Dispose();
+    }
+}
+
+/// <summary>
+/// Base of the five benchmark scenes (stage scenes, D-078 QM8, D-079 DR48): the env stage's temperate battlefield (the
+/// generated grid, forest, river, ground cover, the Iron Age village) with optional hero characters, a crowd and rain.
+/// Weather and its looks come from the render switches (<c>weather=clear|overcast|mist|rain</c>, or <c>cloud</c>,
+/// <c>wet</c>, <c>rain</c>, <c>mist</c>), so the same scene and cameras serve every look and the harness measures
+/// whatever the switches select. PRESENTATION ONLY: the grid and every trace are read, never written.
+/// </summary>
+public abstract class BenchSceneBase : EnvSceneBase, IFrameReport
+{
+    public override BattleTerrainInputs Inputs => TerrainTemperateScene.FixtureInputs;
+    protected uint SettlementSeed => (uint)(Grid.Seed ^ (Grid.Seed >> 32));
+    protected override Func<TerrainMeshData, WaterField, StructureKit?, SettlementPlan>? Settlement =>
+        (m, w, kit) => Settlements.IronAgeVillage(m, w, SettlementSeed, kit);
+
+    protected RainLayer Rain { get; private set; } = null!;
+    public BenchCast? Cast { get; private set; }
+    protected BenchCast EnsureCast() => Cast ??= new BenchCast(Device);
+    bool _built;
+
+    protected override void OnLoad()
+    {
+        base.OnLoad();
+        Rain = new RainLayer(Device);
+        Build();
+        BuildShots();
+        _built = true;
+        Update(0);
+    }
+
+    /// <summary>The shots need the scene's content: they are made after <see cref="Build"/>.</summary>
+    protected override void MakeShots() { }
+    protected abstract void Build();
+    protected abstract void BuildShots();
+    protected virtual void Animate(float t) { }
+
+    public override void Update(float t)
+    {
+        base.Update(t);
+        if (!_built) return;
+        Animate(t);
+        Cast?.Stage.Invalidate();
+    }
+
+    /// <summary>Shadow distance of the scene's cascades (m).</summary>
+    protected virtual float ShadowDistanceM => 600f;
+    public override void Configure(RenderSettings settings)
+    {
+        base.Configure(settings);
+        settings.Features.ShadowDistance = ShadowDistanceM;
+    }
+
+    protected virtual void DrawExtraShadows(RenderContext rc) { }
+    protected virtual void DrawExtraOpaque(RenderContext rc) { }
+    protected virtual void DrawExtraTransparent(RenderContext rc) { }
+
+    public override void DrawShadowCasters(RenderContext rc)
+    {
+        base.DrawShadowCasters(rc);
+        DrawExtraShadows(rc);
+        Cast?.Stage.DrawShadows(rc);
+    }
+
+    public override void DrawOpaque(RenderContext rc)
+    {
+        base.DrawOpaque(rc);
+        DrawExtraOpaque(rc);
+        Cast?.Stage.DrawOpaque(rc);
+    }
+
+    public override void DrawTransparent(RenderContext rc)
+    {
+        base.DrawTransparent(rc);
+        DrawExtraTransparent(rc);
+        Rain.Draw(rc);
+    }
+
+    public virtual string FrameReport() => "";
+
+    /// <summary>A world point on the ground at (x, z) plus <paramref name="up"/>.</summary>
+    protected Vector3 OnGround(Vector2 p, float up = 0f) => new(p.X, Env.Terrain.HeightAt(p.X, p.Y) + up, p.Y);
+
+    /// <summary>
+    /// The occlusion cost of a sight line (stage scenes; presentation only): the tree crowns it passes through (each
+    /// non-shrub tree of the env layout as a vertical capsule from a third of its height to its top, of the layout's
+    /// crown radius) plus 4 for each of 23 samples of the line under the terrain. Trees behind the eye or beyond the
+    /// target do not count.
+    /// </summary>
+    public int SightCost(Vector3 eye, Vector3 target)
+    {
+        var m = Env.Terrain.Mesh; int cost = 0;
+        for (int i = 1; i < 24; i++)
+        {
+            var p = Vector3.Lerp(eye, target, i / 24f);
+            if (p.Y < m.HeightAt(p.X, p.Z) + 0.2f) cost += 4;
+        }
+        var a = new Vector2(eye.X, eye.Z); var ab = new Vector2(target.X, target.Z) - a;
+        float len2 = ab.LengthSquared();
+        if (len2 < 1e-4f) return cost;
+        foreach (var t in Env.Forest.Trees)
+        {
+            if (t.Species.IsShrub) continue;
+            float vh = t.Species.VariantHeight(t.Variant), h = vh * t.Scale;
+            float crown = (t.Species == Gfx.Proc.Environment.Trees.TreeSpecies.Pine || t.Species == Gfx.Proc.Environment.Trees.TreeSpecies.AridPine ? 3.8f : 5.2f) * t.Scale * (vh / 20f);
+            var p = new Vector2(t.Position.X, t.Position.Z);
+            float u = Vector2.Dot(p - a, ab) / len2;
+            if (u < 0f || u > 1f) continue;
+            if (Vector2.DistanceSquared(a + ab * u, p) > crown * crown) continue;
+            float y = MathHelper.Lerp(eye.Y, target.Y, u);
+            if (y > t.Position.Y + h * 0.33f && y < t.Position.Y + h) cost++;
+        }
+        return cost;
+    }
+
+    /// <summary>
+    /// How many tree crowns hold the eye itself (presentation only): non-shrub trees of the env layout within their crown
+    /// radius plus 1.5 m of it horizontally, with the eye below their top plus 1.5 m. A camera inside foliage sees leaves,
+    /// not the shot, and the sight-line cost alone does not rule it out.
+    /// </summary>
+    public int EyeInCrowns(Vector3 eye)
+    {
+        int n = 0;
+        foreach (var t in Env.Forest.Trees)
+        {
+            if (t.Species.IsShrub) continue;
+            float vh = t.Species.VariantHeight(t.Variant), h = vh * t.Scale;
+            float crown = (t.Species == Gfx.Proc.Environment.Trees.TreeSpecies.Pine || t.Species == Gfx.Proc.Environment.Trees.TreeSpecies.AridPine ? 3.8f : 5.2f) * t.Scale * (vh / 20f) + 1.5f;
+            float dx = eye.X - t.Position.X, dz = eye.Z - t.Position.Z;
+            if (dx * dx + dz * dz < crown * crown && eye.Y < t.Position.Y + h + 1.5f) n++;
+        }
+        return n;
+    }
+
+    /// <summary>
+    /// The occlusion cost of a shot: <see cref="SightCost"/> over five sight lines, the target counted twice, points 35 %
+    /// of the frame's width either side of it at its height above the ground, and the ground a third and two thirds of
+    /// the way to it.
+    /// </summary>
+    public int ShotCost(Vector3 eye, Vector3 target, float fovY)
+    {
+        var f = target - eye; float dist = f.Length();
+        if (dist < 0.01f) return 0;
+        var fwd = f / dist;
+        var side = Vector3.Cross(fwd, Vector3.Up);
+        side = side.LengthSquared() < 1e-6f ? Vector3.UnitX : Vector3.Normalize(side);
+        float halfW = dist * MathF.Tan(fovY * 0.5f) * (16f / 9f);
+        float up = target.Y - Env.Terrain.HeightAt(target.X, target.Z);
+        Vector3 Lift(Vector3 p, float u) => OnGround(new Vector2(p.X, p.Z), u);
+        return 2 * SightCost(eye, target)
+             + SightCost(eye, Lift(target + side * halfW * 0.7f, up)) + SightCost(eye, Lift(target - side * halfW * 0.7f, up))
+             + SightCost(eye, Lift(Vector3.Lerp(eye, target, 1f / 3f), 0.5f)) + SightCost(eye, Lift(Vector3.Lerp(eye, target, 2f / 3f), 0.5f));
+    }
+
+    /// <summary>
+    /// The clearest eye for a shot (presentation only): <paramref name="eye"/> turned about the target's vertical axis in
+    /// 10-degree steps up to <paramref name="maxTurnDeg"/> either way, keeping its distance and its height above the
+    /// ground and staying 30 m inside the map; the least <see cref="ShotCost"/> plus 60 for each crown holding the eye
+    /// (<see cref="EyeInCrowns"/>) wins, then the smaller turn, then the positive turn (deterministic: the candidates are
+    /// tried in that order and only a strictly lower cost replaces).
+    /// </summary>
+    public Vector3 ClearEye(Vector3 eye, Vector3 target, float fovY, float maxTurnDeg = 60f)
+    {
+        var m = Env.Terrain.Mesh;
+        float up = eye.Y - m.HeightAt(eye.X, eye.Z);
+        var rel = new Vector2(eye.X - target.X, eye.Z - target.Z);
+        Vector3 best = eye; int bestCost = int.MaxValue;
+        int steps = (int)MathF.Floor(maxTurnDeg / 10f);
+        for (int k = 0; k <= steps; k++)
+            for (int sgn = 1; sgn >= -1; sgn -= 2)
+            {
+                if (k == 0 && sgn < 0) continue;
+                float ang = MathHelper.ToRadians(10f * k * sgn);
+                float c = MathF.Cos(ang), s = MathF.Sin(ang);
+                var e2 = new Vector2(target.X + rel.X * c - rel.Y * s, target.Z + rel.X * s + rel.Y * c);
+                if (MathF.Abs(e2.X) > m.HalfExtentX - 30f || MathF.Abs(e2.Y) > m.HalfExtentZ - 30f) continue;
+                var cand = OnGround(e2, up);
+                int cost = ShotCost(cand, target, fovY) + 60 * EyeInCrowns(cand);
+                if (cost < bestCost) { bestCost = cost; best = cand; }
+            }
+        LastClearCost = bestCost == int.MaxValue ? -1 : bestCost;
+        return best;
+    }
+
+    /// <summary>The cost of the last <see cref="ClearEye"/> result (-1: no candidate was on the map).</summary>
+    public int LastClearCost { get; private set; }
+
+    /// <summary>Yaw (0 faces +Z) of the direction from <paramref name="from"/> to <paramref name="to"/> on the ground plane.</summary>
+    protected static float YawTo(Vector2 from, Vector2 to) => MathF.Atan2(to.X - from.X, to.Y - from.Y);
+
+    public override void Dispose()
+    {
+        Cast?.Dispose();
+        Rain?.Dispose();
+        base.Dispose();
+    }
+
+    protected static string F(float v) => v.ToString("0.##", CultureInfo.InvariantCulture);
+}
