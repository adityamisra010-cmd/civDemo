@@ -0,0 +1,165 @@
+using System.Globalization;
+using Gfx.Chars.Animation;
+using Gfx.Chars.Rendering;
+using Gfx.Engine.Cameras;
+using Gfx.Engine.Scene;
+using Gfx.Gear.Items;
+using Gfx.Gear.Runtime;
+using Gfx.Proc.Environment.Trees;
+using Gfx.Proc.Presentation;
+using Microsoft.Xna.Framework;
+
+namespace Gfx.Demo.Scenes.Bench;
+
+/// <summary>
+/// Benchmark scene A, the soldier close-up (stage scenes, D-078 QM8 A): a hero hoplite (linen corselet, Corinthian
+/// helmet with a horsehair crest, a painted aspis, a spear held overhand) and his commander, bare-headed in a bronze
+/// cuirass with the stage-kit hero asset (the bronze-faced aspis, DR49 item 2) on his arm, on the meadow by the Iron Age
+/// village with three more hoplites and the force's standard behind them. The commander's face moves from grim to a
+/// battle cry and to calm over the scene's first seconds (MakeHuman face pose units), the soldier's stays set; eyes look
+/// at the camera's side. Close-ups of faces, eyes, skin and kit. PRESENTATION ONLY: nothing here reads a simulation.
+/// </summary>
+[DemoScene("bench-a", "Benchmark A: soldier close-up, a hero hoplite and his commander (hero aspis), faces, eyes, skin, kit, an expression")]
+public sealed class BenchCloseupScene : BenchSceneBase
+{
+    public KitSoldier Commander { get; private set; } = null!;
+    public KitSoldier Soldier { get; private set; } = null!;
+    readonly List<KitSoldier> _line = new();
+    Banner _banner = null!;
+    Vector2 _site; float _facing;
+    Vector3 _cEyes, _sEyes;
+    public const float Hour = 10.2f;
+    protected override float ShadowDistanceM => 260f;
+
+    protected override IReadOnlyList<Exclusion>? TreeExclusions(TerrainMeshData mesh)
+    {
+        Site(mesh);
+        return new[] { new Exclusion(_site, 22f) };
+    }
+
+    /// <summary>Open, dry, level meadow 70–110 m from the village palisade, the village behind the cast.</summary>
+    void Site(TerrainMeshData m)
+    {
+        if (_site != Vector2.Zero) return;
+        var v = Gfx.Proc.Environment.Structures.Settlements.IronAgeVillage(m, new Gfx.Proc.Environment.WaterField(m), SettlementSeed, null);
+        float best = float.MaxValue;
+        for (int a = 0; a < 48; a++)
+            for (float d = 70; d <= 110; d += 8)
+            {
+                float ang = a * MathF.Tau / 48;
+                var c = v.Centre + new Vector2(MathF.Cos(ang), MathF.Sin(ang)) * (v.Radius + d);
+                if (MathF.Abs(c.X) > m.HalfExtentX - 60 || MathF.Abs(c.Y) > m.HalfExtentZ - 60) continue;
+                float sc = 0, lo = float.MaxValue, hi = float.MinValue;
+                for (float x = -14; x <= 14; x += 3.5f)
+                    for (float z = -14; z <= 14; z += 3.5f)
+                    {
+                        if (m.IsWet(c.X + x, c.Y + z)) sc += 500;
+                        if (m.ClassAt(c.X + x, c.Y + z) != Gfx.Proc.Authoritative.TerrainClass.Open) sc += 40;
+                        float h = m.HeightAt(c.X + x, c.Y + z); lo = MathF.Min(lo, h); hi = MathF.Max(hi, h);
+                    }
+                sc += (hi - lo) * 60f;
+                if (sc < best) { best = sc; _site = c; }
+            }
+        // the cast faces about 35 degrees off the morning sun's azimuth (three-quarter key light on the faces), the
+        // village behind them as the camera sees them
+        var sun = SunModel.At(Hour).DirectionToLight;
+        _facing = MathF.Atan2(sun.X, sun.Z) + MathHelper.ToRadians(35f);
+    }
+
+    /// <summary>A point in the stage frame (x right, z towards the audience) on the ground plus up.</summary>
+    Vector3 At(float x, float z, float up = 0f)
+    {
+        var p = new Vector3(_site.X, 0, _site.Y) + Vector3.Transform(new Vector3(x, 0, z), Matrix.CreateRotationY(_facing));
+        return new Vector3(p.X, Env.Terrain.HeightAt(p.X, p.Z) + up, p.Z);
+    }
+
+    Matrix Place(float x, float z, float yaw = 0f) => Matrix.CreateRotationY(_facing + yaw) * Matrix.CreateTranslation(At(x, z));
+
+    protected override void Build()
+    {
+        Site(Env.Terrain.Mesh);
+        var cast = EnsureCast();
+        string glb = Gfx.Engine.Assets.AssetRoot.Baked("kit/hero/" + Gfx.Gear.Bake.HeroBake.FileName);
+        var hero = File.Exists(glb) ? Gfx.Gear.Bake.HeroBake.Load(glb) : Aspis.Build(Gfx.Gear.Bake.HeroBake.Spec);
+        // the commander: bare-headed (his face in view) in the authored hoplite guard, a bronze-headed spear overhand and
+        // the hero aspis on his arm (the strapped aspis rides in front of the body in the guard; at rest the idle's
+        // shield arm put the board through his chest and his upper arm through the board)
+        Commander = Hoplite(cast, "commander_a", null, hero, 0, new Vector2(-0.55f, 0.15f), -0.25f, 0.2f, "bronze");
+        // the hero soldier: Corinthian helmet with a dark crest, a painted aspis (blue field, sun device)
+        Soldier = Hoplite(cast, "a2", "#1E1A17", Aspis.Build(new AspisSpec { Seed = 12, MapSize = 1024, BronzeFace = false, Field = "#2B4373", Device = "sun", Wear = 0.5 }),
+            1, new Vector2(0.75f, -0.35f), 0.30f, 0.9f, "iron");
+        // three more of the line behind them
+        _line.Add(Hoplite(cast, "a1", "#7E2A20", Aspis.Build(new AspisSpec { Seed = 11, MapSize = 512, Device = "crescent", Wear = 0.6 }), 2, new Vector2(-1.9f, -2.6f), 0.1f, 1.4f, "iron"));
+        _line.Add(Hoplite(cast, "a3", "#D8D0BC", Aspis.Build(new AspisSpec { Seed = 13, MapSize = 512, Device = "wheel", Paint = "#2A2622", Wear = 0.45 }), 3, new Vector2(0.2f, -3.1f), 0.05f, 2.1f, "bronze"));
+        _line.Add(Hoplite(cast, "a4", "#7E2A20", Aspis.Build(new AspisSpec { Seed = 14, MapSize = 512, BronzeFace = false, Field = "#273350", Device = "crescent", Wear = 0.7 }), 4, new Vector2(2.3f, -2.7f), -0.1f, 2.7f, "iron"));
+        _banner = Banner.Create(cast.Kit, Banner.Build(new BannerSpec { Seed = 61, MapSize = 1024, Field = "#2B4373", Charge = "#C29A45", Device = "sun", Fringe = "#C29A45" }),
+            Matrix.CreateRotationY(_facing + 0.3f) * Matrix.CreateTranslation(At(-3.3f, -1.4f)));
+        Animate(2f);
+        _cEyes = Eyes(Commander.Body); _sEyes = Eyes(Soldier.Body);
+    }
+
+    KitSoldier Hoplite(BenchCast cast, string id, string? crest, KitItem shield, int i, Vector2 at, float yaw, float phase, string metal)
+    {
+        var body = cast.SpawnKitOutfit(id, "anc_a");
+        var m = Gfx.Gear.Rig.KitSockets.Measure(body.Asset);
+        var kit = new Loadout
+        {
+            Helmet = crest == null ? null : Helmets.Build(new HelmetSpec { Kind = "corinthian", Seed = (uint)(100 + i), Crest = crest, Wear = 0.4 + 0.1 * i }, m),
+            Right = Weapons.Build(new WeaponSpec { Kind = "spear", Seed = (uint)(200 + i), MapSize = 512, Metal = metal }), RightFrame = "grip_over",
+            Left = shield, Mode = Gfx.Gear.Rig.LeftHold.Strap,
+            // the commander's broad shoulders (his identity's v-shaped torso) and the cuirass's shoulder strap reach through
+            // the board in the guard; a 40 mm standoff off the forearm keeps them behind it (the strap fit accounts for it)
+            SleeveThickness = id == "commander_a" ? 0.04f : 0f,
+        };
+        Gfx.Gear.Anim.CombatClips.Install(body.Asset);
+        var s = new KitSoldier(cast.Kit, body, kit, "bench-a:" + id) { Ground = p => Env.Terrain.HeightAt(p.X, p.Z) };
+        var camSide = At(0.6f, 6f, 1.6f);
+        s.Drive(t => new AnimInput { Speed = 0, Action = "kit.hoplite.guard", ActionStart = -phase, HoldLastFrame = true, LookAt = camSide, FootLock = false },
+            t => Place(at.X, at.Y, yaw), phase);
+        return s;
+    }
+
+    static Vector3 Eyes(CharInstance inst)
+    {
+        inst.SolvePose();
+        var s = inst.Asset.Skeleton;
+        return Vector3.Transform(0.5f * (inst.Heads[s["eye_l"]] + inst.Heads[s["eye_r"]]), inst.World);
+    }
+
+    /// <summary>The commander's expression by scene time: grim (0–2 s), a battle cry (2–4 s), calm after; the soldier stays grim.</summary>
+    public static (string name, float weight) CommanderExpression(float t) => t < 2f ? ("grim", 0.9f) : t < 4f ? ("battlecry", 1f) : ("calm", 0.8f);
+
+    protected override void Animate(float t)
+    {
+        if (Commander == null) return;
+        float at = 2f + t;
+        Commander.Update(at); Soldier.Update(at);
+        foreach (var s in _line) s.Update(at);
+        _banner.Pose(at, 0.55f);
+        var ce = Commander.Body.Expression; ce.Clear();
+        var (n, w) = CommanderExpression(t); ce[n] = w;
+        var se = Soldier.Body.Expression; se.Clear(); se["grim"] = 0.6f;
+    }
+
+    protected override void BuildShots()
+    {
+        var fwd = Vector3.Normalize(At(0, 1) - At(0, 0)); var right = Vector3.Normalize(At(1, 0) - At(0, 0));
+        var mid = (_cEyes + _sEyes) * 0.5f;
+        var shots = new List<CaptureShot>
+        {
+            new("two-shot", new CameraPose(mid + fwd * 2.6f + right * 0.35f + new Vector3(0, -0.12f, 0), mid + new Vector3(0, -0.28f, 0), 0.62f, 0.05f, 4000f), Hour, 2.6f),
+            new("commander-battlecry", new CameraPose(_cEyes + fwd * 0.78f - right * 0.28f + new Vector3(0, -0.03f, 0), _cEyes + new Vector3(0, -0.07f, 0), 0.50f, 0.05f, 4000f), Hour, 2.6f),
+            new("commander-grim", new CameraPose(_cEyes + fwd * 0.70f + right * 0.32f + new Vector3(0, 0.01f, 0), _cEyes + new Vector3(0, -0.06f, 0), 0.46f, 0.05f, 4000f), Hour, 1.0f),
+            new("soldier-face", new CameraPose(_sEyes + fwd * 0.62f + right * 0.42f + new Vector3(0, 0.10f, 0), _sEyes + new Vector3(0, -0.06f, 0), 0.50f, 0.05f, 4000f), Hour, 1.0f),
+            new("kit", new CameraPose(_cEyes + fwd * 1.25f + right * 0.85f + new Vector3(0, -0.45f, 0), _cEyes + new Vector3(0.0f, -0.55f, 0) + right * 0.30f, 0.62f, 0.05f, 4000f), Hour, 1.0f),
+            new("line", new CameraPose(At(0.8f, 6.6f, 1.55f), At(0f, -1.0f, 1.05f), 0.62f, 0.1f, 4000f), Hour, 1.0f),
+            new("two-shot-golden", new CameraPose(mid + fwd * 2.6f + right * 0.35f + new Vector3(0, -0.12f, 0), mid + new Vector3(0, -0.28f, 0), 0.62f, 0.05f, 4000f), BenchHours.Golden, 2.6f),
+        };
+        ShotList = shots.ToArray();
+    }
+
+    public override Vector3 Focus => At(0, 0);
+
+    public override string FrameReport() => string.Format(CultureInfo.InvariantCulture, "[bench-a] cast={0} commander expression {1}",
+        2 + _line.Count, string.Join(",", Commander.Body.Expression.Select(kv => kv.Key + "=" + kv.Value.ToString("0.##", CultureInfo.InvariantCulture))));
+}
diff --git a/prototypes/m7-gfx2/Gfx.Demo/Scenes/Bench/SceneB.cs b/prototypes/m7-gfx2/Gfx.Demo/Scenes/Bench/SceneB.cs
new file mode 100644
index 0000000..67eacde
--- /dev/null
+++ b/prototypes/m7-gfx2/Gfx.Demo/Scenes/Bench/SceneB.cs
@@ -0,0 +1,207 @@
+using System.Globalization;
+using Gfx.Chars.Animation;
+using Gfx.Engine.Cameras;
+using Gfx.Engine.Rendering;
+using Gfx.Engine.Scene;
+using Gfx.Gear.Items;
+using Gfx.Gear.Runtime;
+using Gfx.Proc.Environment.Trees;
+using Gfx.Proc.Presentation;
+using Microsoft.Xna.Framework;
+
+namespace Gfx.Demo.Scenes.Bench;
+
+/// <summary>
+/// Benchmark scene B, the formation (stage scenes, D-078 QM8 B): two forces drawn up facing each other on the env
+/// temperate battlefield's meadow beside the Iron Age village, 320 instanced stage-chars soldiers in four blocks of 80
+/// (10 files × 8 ranks; spear and sword kits of both forces), a standard planted before each block with an officer
+/// beside it (full-detail kitted characters), ground cover under their feet. Scripted presentation, not a simulation:
+/// the soldiers idle and shift (two idle clips blended per soldier), nothing advances. The harness's crowd sweep sets
+/// the soldier count (<see cref="ICrowdSizedScene"/>): further blocks stand in lines behind.
+/// </summary>
+[DemoScene("bench-b", "Benchmark B: formation, 320 soldiers of both forces drawn up with standards and officers on the meadow by the village")]
+public sealed class BenchFormationScene : BenchSceneBase, ICrowdSizedScene
+{
+    public int? CrowdCount { get; set; }
+    public const int DefaultCount = 320, Files = 10, Ranks = 8;
+    public CrowdCast Troops { get; private set; } = null!;
+    readonly List<(KitSoldier officer, Banner banner)> _standards = new();
+    Vector2 _centre, _fwd;     // the gap between the armies; force A faces +_fwd
+    float _yawA;
+    protected override float ShadowDistanceM => 700f;
+
+    int Count => Math.Max(1, CrowdCount ?? DefaultCount);
+    int Blocks => (Count + Files * Ranks - 1) / (Files * Ranks);
+    /// <summary>Blocks abreast per force in each line: 2 at the default size, more for the crowd sweep's large armies.</summary>
+    int PerLine => Math.Max(2, (int)MathF.Ceiling(MathF.Sqrt(Blocks / 2f) * 1.4f));
+    int Lines => (Blocks + 2 * PerLine - 1) / (2 * PerLine);
+    /// <summary>Camera distance scale of the wide shots: 1 at the default size, growing with the army.</summary>
+    float Scale => MathF.Max(1f, PerLine / 2f);
+
+    protected override IReadOnlyList<Exclusion>? TreeExclusions(TerrainMeshData mesh)
+    {
+        Site(mesh);
+        var ex = new List<Exclusion>();
+        var side = new Vector2(_fwd.Y, -_fwd.X);
+        float halfW = PerLine * (Files + 6f) * 0.5f + 12f;
+        for (float a = -halfW; a <= halfW; a += 10)
+            for (float d = -22f - 14f * Lines; d <= 22f + 14f * Lines; d += 10)
+                ex.Add(new Exclusion(_centre + side * a + _fwd * d, 9f));
+        return ex;
+    }
+
+    /// <summary>The meadow: open, dry and level ground 90–140 m from the village, the village behind force B.</summary>
+    void Site(TerrainMeshData m)
+    {
+        if (_fwd != Vector2.Zero) return;
+        var v = Gfx.Proc.Environment.Structures.Settlements.IronAgeVillage(m, new Gfx.Proc.Environment.WaterField(m), SettlementSeed, null);
+        float best = float.MaxValue;
+        for (int a = 0; a < 32; a++)
+            for (float d = 95; d <= 150; d += 11)
+            {
+                float ang = a * MathF.Tau / 32;
+                var dir = new Vector2(MathF.Cos(ang), MathF.Sin(ang));
+                var c = v.Centre + dir * (v.Radius + d);
+                if (MathF.Abs(c.X) > m.HalfExtentX - 90 || MathF.Abs(c.Y) > m.HalfExtentZ - 90) continue;
+                float sc = 0, lo = float.MaxValue, hi = float.MinValue;
+                var side = new Vector2(dir.Y, -dir.X);
+                for (float x = -45; x <= 45; x += 7.5f)
+                    for (float z = -40; z <= 40; z += 8)
+                    {
+                        var p = c + side * x + dir * z;
+                        if (m.IsWet(p.X, p.Y)) sc += 500;
+                        sc += m.ClassAt(p.X, p.Y) switch
+                        {
+                            Gfx.Proc.Authoritative.TerrainClass.Open or Gfx.Proc.Authoritative.TerrainClass.Road => 0,
+                            Gfx.Proc.Authoritative.TerrainClass.Hills => 8, Gfx.Proc.Authoritative.TerrainClass.Forest => 60, _ => 300,
+                        };
+                        float h = m.HeightAt(p.X, p.Y); lo = MathF.Min(lo, h); hi = MathF.Max(hi, h);
+                    }
+                sc += (hi - lo) * 25f;
+                if (sc < best) { best = sc; _centre = c; _fwd = -dir; }
+            }
+        // force A stands on the far side from the village and faces it; force B has the village at its back
+        _yawA = MathF.Atan2(_fwd.X, _fwd.Y);
+    }
+
+    protected override void Build()
+    {
+        Site(Env.Terrain.Mesh);
+        var m = Env.Terrain.Mesh;
+        Troops = new CrowdCast(Device, m.HeightAt);
+        var side = new Vector2(_fwd.Y, -_fwd.X);
+        // blocks: force A on -_fwd, force B on +_fwd, PerLine blocks abreast per line with a 6 m gap, lines 14 m apart
+        // (the default 320: two blocks per force); blocks alternate between the forces
+        int blocks = Blocks, left = Count, per = PerLine;
+        for (int i = 0; i < blocks; i++)
+        {
+            int force = i % 2, k = i / 2, line = k / per, slot = k % per;
+            float across = (slot - (per - 1) * 0.5f) * (Files + 6f);
+            var f = force == 0 ? _fwd : -_fwd;
+            var c = _centre - f * (18f + line * 14f) + side * across;
+            float yaw = MathF.Atan2(f.X, f.Y);
+            int n = Math.Min(left, Files * Ranks);
+            int ranks = (n + Files - 1) / Files;
+            Troops.Formations.Add(new FormationSpec(c, yaw, Files, ranks, force, FormationAct.Idle, (uint)(4000 + i * 37), Swords: slot % 2 == 1));
+            left -= n;
+        }
+        BuildStandards();
+    }
+
+    void BuildStandards()
+    {
+        var cast = EnsureCast();
+        var side = new Vector2(_fwd.Y, -_fwd.X);
+        var specs = new (string id, string outfit, string field, string charge, string device, string shield, int force)[]
+        {
+            ("commander_a", "kit_a", "#2B4373", "#C29A45", "chevron", "heater", 0), ("a2", "kit_a", "#2B4373", "#C29A45", "cross", "kite", 0),
+            ("b2", "kit_b", "#93301F", "#DAD3C1", "saltire", "kite", 1), ("b3", "kit_b", "#93301F", "#DAD3C1", "pale", "heater", 1),
+        };
+        for (int k = 0; k < 4; k++)
+        {
+            var (id, outfit, field, charge, device, shield, force) = specs[k];
+            var f = force == 0 ? _fwd : -_fwd;
+            float across = (k % 2 == 0 ? -1 : 1) * (Files * 0.5f + 3f);
+            var blockFront = _centre - f * 18f + side * across;
+            float yaw = MathF.Atan2(f.X, f.Y);
+            // the standard 2.4 m in front of the block's centre, the officer a step to its right
+            var bAt = blockFront + f * 2.4f;
+            var banner = Banner.Create(cast.Kit, Banner.Build(new BannerSpec { Seed = (uint)(900 + k), MapSize = 512, Field = field, Charge = charge, Device = device, Fringe = charge }),
+                Matrix.CreateRotationY(yaw + MathHelper.PiOver2) * Matrix.CreateTranslation(OnGround(bAt)));
+            var body = cast.Stage.Spawn(id, outfit);
+            KitAssets.StripBakedKit(body);
+            Gfx.Gear.Anim.CombatClips.Install(body.Asset);
+            var meas = Gfx.Gear.Rig.KitSockets.Measure(body.Asset);
+            var kit = new Loadout
+            {
+                Helmet = Helmets.Build(new HelmetSpec { Kind = k % 2 == 0 ? "nasal" : "kettle", Seed = (uint)(910 + k), Wear = 0.5 }, meas),
+                Right = Weapons.Build(new WeaponSpec { Kind = "arming", Seed = (uint)(920 + k), MapSize = 512 }), RightFrame = "grip",
+                Left = Shields.Build(new ShieldSpec { Kind = shield, Seed = (uint)(930 + k), Field = field, Charge = charge, Device = device, Wear = 0.5 }),
+                Mode = Gfx.Gear.Rig.LeftHold.Strap, SleeveThickness = 0.028f,
+            };
+            var officer = new KitSoldier(cast.Kit, body, kit, "bench-b:" + id) { Ground = p => Env.Terrain.HeightAt(p.X, p.Z) };
+            var oAt = bAt + side * (k % 2 == 0 ? 1.3f : -1.3f) - f * 0.3f;
+            float phase = 0.37f * k;
+            officer.Drive(t => new AnimInput { Speed = 0, Action = "kit.sword.guard", ActionStart = -phase, HoldLastFrame = true, FootLock = false },
+                t => Matrix.CreateRotationY(yaw) * Matrix.CreateTranslation(OnGround(oAt)), phase);
+            _standards.Add((officer, banner));
+        }
+    }
+
+    Vector3 G(Vector2 p, float up) => OnGround(p, up);
+
+    protected override void BuildShots()
+    {
+        var side = new Vector2(_fwd.Y, -_fwd.X);
+        var shots = new List<CaptureShot>();
+        float k = Scale;
+        // the whole field, three-quarters from behind force A's left: its blocks and standards in front, force B
+        // facing them across the gap with the village beyond (the crowd sweep's camera); turned to the clearest view
+        var wTarget = G(_centre + _fwd * 8f, 0.5f);
+        var wEye = ClearEye(G(_centre - _fwd * (38f * k) - side * (30f * k), 11f * k), wTarget, 0.70f, 40f);
+        foreach (var (name, hour) in BenchHours.All)
+            shots.Add(new CaptureShot("wide-" + name, new CameraPose(wEye, wTarget, 0.70f, 0.3f, 40000f), hour, 2f));
+        // in front of force A's left block and outside it, at eye height: the front ranks of both blocks along the line
+        var aFront = _centre - _fwd * 18f;
+        shots.Add(new CaptureShot("front", new CameraPose(G(aFront + _fwd * 7f - side * 15f, 1.7f), G(aFront + side * 3f, 1.35f), 0.55f, 0.1f, 40000f), BenchHours.Noon, 2f));
+        // between the armies, looking at force B with the village behind it
+        shots.Add(new CaptureShot("between", new CameraPose(G(_centre - _fwd * 6f + side * 4f, 2.0f), G(_centre + _fwd * 24f, 1.6f), 0.62f, 0.1f, 40000f), BenchHours.Noon, 2f));
+        // a standard and its officer, close
+        var bA = aFront + _fwd * 2.4f - side * (Files * 0.5f + 3f);
+        shots.Add(new CaptureShot("standard", new CameraPose(G(bA + _fwd * 3.6f + side * 2.4f, 2.0f), G(bA, 1.7f), 0.62f, 0.1f, 40000f), BenchHours.Golden, 2f));
+        // from behind force A over the blocks
+        var rTarget = G(_centre + _fwd * 10f, 0f);
+        shots.Add(new CaptureShot("rear-high", new CameraPose(ClearEye(G(_centre - _fwd * 70f + side * 10f, 22f), rTarget, 0.75f, 30f), rTarget, 0.75f, 0.3f, 40000f), BenchHours.Noon, 2f));
+        ShotList = shots.ToArray();
+    }
+
+    public override Vector3 Focus => G(_centre, 0f);
+
+    protected override void Animate(float t)
+    {
+        Troops?.Update(t);
+        for (int i = 0; i < _standards.Count; i++)
+        {
+            _standards[i].officer.Update(t);
+            _standards[i].banner.Pose(t + 0.8f * i, 0.65f);
+        }
+    }
+
+    protected override void DrawExtraShadows(RenderContext rc)
+    {
+        Troops.ApplySwitches(rc.Features);
+        if (rc.Features.Crowd) Troops.Crowd.DrawShadows(rc);
+    }
+
+    protected override void DrawExtraOpaque(RenderContext rc)
+    {
+        Troops.ApplySwitches(rc.Features);
+        Troops.Crowd.Occlusion = null;
+        if (rc.Features.Crowd) Troops.Crowd.DrawOpaque(rc);
+    }
+
+    public override string FrameReport() => Troops.Report(null, false) + string.Format(CultureInfo.InvariantCulture,
+        " formations={0} soldiers={1} officers+standards={2}", Troops.Formations.Count, Troops.Soldiers, _standards.Count);
+
+    public override void Dispose() { Troops?.Dispose(); base.Dispose(); }
+}
diff --git a/prototypes/m7-gfx2/Gfx.Demo/Scenes/Bench/SceneC.cs b/prototypes/m7-gfx2/Gfx.Demo/Scenes/Bench/SceneC.cs
new file mode 100644
index 0000000..1448b41
--- /dev/null
+++ b/prototypes/m7-gfx2/Gfx.Demo/Scenes/Bench/SceneC.cs
@@ -0,0 +1,208 @@
+using System.Globalization;
+using Gfx.Engine.Cameras;
+using Gfx.Engine.Rendering;
+using Gfx.Engine.Scene;
+using Gfx.Proc.Environment.Trees;
+using Gfx.Proc.Presentation;
+using Microsoft.Xna.Framework;
+
+namespace Gfx.Demo.Scenes.Bench;
+
+/// <summary>
+/// Benchmark scene C, the large battlefield (stage scenes, D-078 QM8 C, D-079 DR49 item 5): the 2,100 soldiers of the
+/// exported TacticalResolver battle (scripts/export-battle-trace.sh), each one instanced stage-chars soldier driven by
+/// the trace (<see cref="TraceCrowd"/>), on the env temperate battlefield whose authoritative grid the battle ran on
+/// (downscaled to the battle's 20 m cells). Scene time = battle time from deployment (s). Trees and boulders are kept off
+/// the ground the armies stand on (ground cover stays); CPU occlusion culling as in render2. PRESENTATION ONLY: the trace
+/// and the grid are read, never written (tests hash both).
+/// </summary>
+[DemoScene("bench-c", "Benchmark C: large battlefield, 2,100 soldiers driven by the TacticalResolver battle trace on the terrain grid")]
+public sealed class BenchBattlefieldScene : BenchSceneBase
+{
+    public BenchBattle Battle { get; private set; } = null!;
+    public TraceCrowd Troops { get; private set; } = null!;
+    BattleOccluders _occ = null!;
+    readonly Gfx.Engine.Scene.OcclusionBuffer _ob = new(256, 144);
+    bool _occOn;
+
+    protected override float ShadowDistanceM => 900f;
+
+    protected override IReadOnlyList<Exclusion>? TreeExclusions(TerrainMeshData mesh)
+    {
+        // where the armies stand and fight (every 10th snapshot, Active, Surrendered and Dead soldiers, 8 m cells)
+        Battle ??= BenchBattle.Load();
+        return BattleGround(Battle, 8f, 7f);
+    }
+
+    /// <summary>Discs over the 8 m cells where soldiers of the battle stand, fight, surrender or fall (not the routers' flight).</summary>
+    public static List<Exclusion> BattleGround(BenchBattle b, float cell, float radius)
+    {
+        var tr = b.Trace;
+        var cells = new SortedSet<(int, int)>();
+        for (int s = 0; s < tr.StepCount; s += 10)
+            for (int e = 0; e < tr.Entities.Count; e++)
+            {
+                var st = tr.State(s, e);
+                if (st is Gfx.Units.TraceState.Routing or Gfx.Units.TraceState.Escaped) continue;
+                var (x, y) = tr.PosMm(s, e);
+                var w = b.World(x, y);
+                cells.Add(((int)MathF.Floor(w.X / cell), (int)MathF.Floor(w.Z / cell)));
+            }
+        return cells.Select(c => new Exclusion(new Vector2((c.Item1 + 0.5f) * cell, (c.Item2 + 0.5f) * cell), radius)).ToList();
+    }
+
+    protected override void Build()
+    {
+        Battle ??= BenchBattle.Load();
+        var m = Env.Terrain.Mesh;
+        Troops = new TraceCrowd(Device, Battle, m.HeightAt);
+        _occ = new BattleOccluders(m);
+        if (Env.Settlement is { } s) _occ.AddWallRing(s.Outline, 3.4f, m.HeightAt);
+    }
+
+    /// <summary>Centroid of a side's soldiers in a state at scene time t (falls back to all of the side).</summary>
+    public Vector3 Centroid(int side, float t, params TraceSoldierState[] states)
+    {
+        var c = Vector3.Zero; int n = 0;
+        for (int e = 0; e < Troops.Count; e++)
+        {
+            if (Battle.Trace.Entities[e].Side != side) continue;
+            if (states.Length > 0 && Array.IndexOf(states, Troops.StateAt(e, t)) < 0) continue;
+            c += Troops.Place(e, t).pos; n++;
+        }
+        if (n == 0) return states.Length > 0 ? Centroid(side, t) : Vector3.Zero;
+        c /= n; c.Y = Env.Terrain.HeightAt(c.X, c.Z);
+        return c;
+    }
+
+    Vector3 G(Vector3 p, float up) => new(p.X, Env.Terrain.HeightAt(p.X, p.Z) + up, p.Z);
+
+    /// <summary>Scene times of the battle's phases (from the trace): deployment, advance, first clash, melee, rout.</summary>
+    public static readonly (string name, float t)[] Phases = { ("deploy", 4f), ("advance", 38f), ("clash", 96f), ("melee", 170f), ("rout", 330f) };
+
+    protected override void BuildShots()
+    {
+        var shots = new List<CaptureShot>();
+        float tClash = 96f, tMelee = 110f, tRout = 330f;
+        var a0 = Centroid(0, 4f); var b0 = Centroid(1, 4f);
+        var axis = Vector3.Normalize(new Vector3(b0.X - a0.X, 0, b0.Z - a0.Z));      // side 0 -> side 1
+        var side = Vector3.Normalize(Vector3.Cross(axis, Vector3.Up));                 // along the fronts
+        var mid0 = (a0 + b0) * 0.5f;
+        var cA = Centroid(0, tClash, TraceSoldierState.Active); var cB = Centroid(1, tClash, TraceSoldierState.Active);
+        var contact = (cA + cB) * 0.5f;
+        var cM = (Centroid(0, tMelee, TraceSoldierState.Active) + Centroid(1, tMelee, TraceSoldierState.Active)) * 0.5f;
+        // vista: from the flank at a 25 % elevation (low enough that the frame's top holds the horizon and the sky, not
+        // the flat far field beyond the 1 km map), far enough that the middle 95 % of the soldiers on the field (along
+        // the line between the armies) fill three quarters of the frame's width; turned to the clearest view
+        const float vFov = 0.70f;
+        float ext = Extent(tClash, axis, contact, 0.95f);
+        float hfov = MathF.Atan(MathF.Tan(vFov * 0.5f) * 16f / 9f);
+        float vDist = Math.Clamp(ext / (MathF.Tan(hfov) * 0.75f), 120f, 420f);
+        var vTarget = G(contact, 0f);
+        var vEye = ClearEye(G(contact - side * vDist - axis * (vDist * 0.25f), vDist * 0.25f), vTarget, vFov, 50f);
+        foreach (var (name, hour) in BenchHours.All)
+            shots.Add(new CaptureShot("vista-" + name, new CameraPose(vEye, vTarget, vFov, 0.5f, 40000f), hour, tClash));
+        // the advance: low, behind the left of side 0's line, looking over the shields at the other army coming on
+        shots.Add(new CaptureShot("advance", new CameraPose(G(a0 - axis * 32f - side * 60f, 6.5f), G(b0 + side * 20f, 1.5f), 0.70f, 0.3f, 40000f), BenchHours.Noon, 38f));
+        // the clash: where the blows fall thickest (FightCentre), from 34 m along the fronts and a little on side 0's
+        // side, 13 m up (over any rise between), aimed 4.5 m above the fighting so it sits a little below the frame's
+        // centre with the rest of the line beyond and the horizon and sky at the top, not the flat far field beyond the
+        // 1 km map (the clearest of +-30 deg)
+        var fight = FightCentre(tClash, 6f) ?? contact; ClashAt = fight;
+        var cTarget = G(fight + side * 3f, 4.5f);
+        var cEye = ClearEye(G(fight - side * 34f - axis * 12f, 13f), cTarget, 0.62f, 30f); ClashEye = cEye;
+        foreach (var (name, hour) in BenchHours.All)
+            shots.Add(new CaptureShot("clash-" + name, new CameraPose(cEye, cTarget, 0.62f, 0.3f, 40000f), hour, tClash));
+        // the melee over the shoulders of side 0's rear ranks, at the densest fighting a little later (2.6 m up, 8 m back)
+        var melee = FightCentre(tMelee, 4f) ?? cM; MeleeAt = melee;
+        shots.Add(new CaptureShot("melee-low", new CameraPose(G(melee - axis * 8f - side * 5f, 2.6f), G(melee + axis * 2f, 1.2f), 0.80f, 0.1f, 40000f), BenchHours.Golden, tMelee));
+        // the rout: wide over the field, routers running for the edges, the surrendered and the fallen
+        var cR = Centroid(1, tRout, TraceSoldierState.Active, TraceSoldierState.Surrendered, TraceSoldierState.Dead);
+        shots.Add(new CaptureShot("rout", new CameraPose(ClearEye(G(cR + side * 110f - axis * 60f, 45f), G(cR, 0f), 0.85f, 40f), G(cR, 0f), 0.85f, 0.4f, 40000f), BenchHours.Golden, tRout));
+        ShotList = shots.ToArray();
+    }
+
+    /// <summary>Where the fighting is densest about scene time <paramref name="t"/> (see <see cref="DensestFighting"/>),
+    /// on the ground.</summary>
+    public Vector3? FightCentre(float t, float window)
+    {
+        var at = DensestFighting(Battle.Trace, (e, et) => Troops.Place(e, et).pos, Troops.SceneTime, t, window);
+        return at is { } a ? new Vector3(a.X, Env.Terrain.HeightAt(a.X, a.Z), a.Z) : null;
+    }
+
+    /// <summary>
+    /// Where the fighting is densest about scene time <paramref name="t"/> (presentation only, a pure reading of the
+    /// trace): the 10 m cell holding the most melee blows (Fire events within +-<paramref name="window"/> s, each placed
+    /// where its source stood at the event's time by <paramref name="place"/>), ties to the lower cell (x, then z: the
+    /// cells are visited in that order and only a strictly larger count replaces), and the centroid of those blows'
+    /// sources and targets. Null when no blow falls in the window.
+    /// </summary>
+    public static Vector3? DensestFighting(Gfx.Units.BattleTrace tr, Func<int, float, Vector3> place, Func<long, float> sceneTime, float t, float window)
+    {
+        var cells = new SortedDictionary<(int, int), (int n, Vector3 sum, int m)>();
+        foreach (var ev in tr.Events)
+        {
+            if (ev.Kind != Gfx.Units.TraceEventKind.Fire) continue;
+            float et = sceneTime(ev.TimeMs);
+            if (MathF.Abs(et - t) > window) continue;
+            int si = tr.IndexOf(ev.Source), ti = tr.IndexOf(ev.Target);
+            if (si < 0) continue;
+            var ps = place(si, et);
+            var key = ((int)MathF.Floor(ps.X / 10f), (int)MathF.Floor(ps.Z / 10f));
+            var sum = ps; int m = 1;
+            if (ti >= 0) { sum += place(ti, et); m++; }
+            var c = cells.GetValueOrDefault(key);
+            cells[key] = (c.n + 1, c.sum + sum, c.m + m);
+        }
+        (int n, Vector3 sum, int m) best = default;
+        foreach (var kv in cells) if (kv.Value.n > best.n) best = kv.Value;
+        return best.n == 0 ? null : best.sum / best.m;
+    }
+
+    /// <summary>The half-extent along <paramref name="dir"/> about <paramref name="about"/> holding the given fraction of
+    /// the soldiers on the field (not escaped) at scene time t (a sorted list of distances: deterministic).</summary>
+    public float Extent(float t, Vector3 dir, Vector3 about, float fraction)
+    {
+        var d = new List<float>();
+        for (int e = 0; e < Troops.Count; e++)
+        {
+            if (Troops.StateAt(e, t) == TraceSoldierState.Escaped) continue;
+            var p = Troops.Place(e, t).pos;
+            d.Add(MathF.Abs(Vector3.Dot(p - about, dir)));
+        }
+        if (d.Count == 0) return 50f;
+        d.Sort();
+        return d[Math.Min(d.Count - 1, (int)(fraction * d.Count))];
+    }
+
+    /// <summary>Where the clash and melee shots look (the densest fighting at their times) and the clash shot's eye (for the report).</summary>
+    public Vector3 ClashAt { get; private set; }
+    public Vector3 MeleeAt { get; private set; }
+    public Vector3 ClashEye { get; private set; }
+
+    public override Vector3 Focus => Battle == null ? Vector3.Zero : Centroid(0, 96f);
+
+    protected override void Animate(float t) => Troops?.Update(t);
+
+    protected override void DrawExtraShadows(RenderContext rc)
+    {
+        Troops.ApplySwitches(rc.Features);
+        if (rc.Features.Crowd) Troops.Crowd.DrawShadows(rc);
+    }
+
+    protected override void DrawExtraOpaque(RenderContext rc)
+    {
+        Troops.ApplySwitches(rc.Features);
+        _occOn = rc.Features.OcclusionCulling && !rc.IsReflectionPass;
+        if (_occOn) { _occ.Build(_ob, rc); Troops.Crowd.Occlusion = _ob; }
+        else Troops.Crowd.Occlusion = null;
+        if (rc.Features.Crowd) Troops.Crowd.DrawOpaque(rc);
+    }
+
+    public override string FrameReport() => Troops.Report() + string.Format(CultureInfo.InvariantCulture,
+        " battle={0} holds-field={1} duration={2:F0}s clash-at=({4:F0},{5:F0}) clash-eye=({6:F0},{7:F1},{8:F0}) melee-at=({9:F0},{10:F0}){3}", Battle.Reason, Battle.HoldsField, Battle.Duration,
+        _occOn ? string.Format(CultureInfo.InvariantCulture, " occlusion=on occluder-tris={0} hidden={1}", _ob.TrianglesRasterized, _ob.Occluded) : " occlusion=off",
+        ClashAt.X, ClashAt.Z, ClashEye.X, ClashEye.Y, ClashEye.Z, MeleeAt.X, MeleeAt.Z);
+
+    public override void Dispose() { Troops?.Dispose(); base.Dispose(); }
+}
