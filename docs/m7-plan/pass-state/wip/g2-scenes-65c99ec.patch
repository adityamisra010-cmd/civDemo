+        Assert.Equal(new Vector3(25.5f, 0, 5f), Densest(d, 30f, 6f));
+        // the same trace seen at 40 s (window 2 s): only the two later blows in (-1, 0)
+        Assert.Equal(new Vector3(-4.5f, 0, 5f), Densest(d, 40f, 2f));
+        // no blow in the window
+        Assert.Null(Densest(d, 50f, 2f));
+        Assert.Null(Densest(Blows(men), 30f, 6f));
+    }
+}
