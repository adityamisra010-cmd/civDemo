+#!/usr/bin/env bash
+# Canonical captures of stage scenes: the five benchmark scenes at 1920x1080 as accumulated stills (every shot at its
+# own hour: B, C and E at noon, golden hour and dusk), both death-content states of scene D, and rain and mist looks of
+# B, C and E.
+#
+# Usage: scripts/capture-scenes.sh OUT_DIR [GROUPS] [SAMPLES]
+#   GROUPS: any of a,b,c,d,e,weather (default: all); SAMPLES: accumulation samples per still (default 8)
+# Needs a Release build of M7Gfx2.slnx, the render1, env, chars, kit-outfit and crowd bakes, and the battle trace
+# (scripts/export-battle-trace.sh). Frames rendered without a GPU are llvmpipe frames (not Victus evidence). The crowd
+# soldiers of B, C and D are posed by CMU motion capture: PROTOTYPE-ONLY; scene A's cast and the heroes of B and D by the
+# authored kit clips.
+set -euo pipefail
+here="$(cd "$(dirname "$0")" && pwd)"
+out="${1:?usage: capture-scenes.sh OUT_DIR [GROUPS] [SAMPLES]}"
+groups="${2:-a,b,c,d,e,weather}"
+samples="${3:-8}"
+# G2_DEMO_DLL: another copy of the Release build to run (e.g. a copy of its bin folder, so the tree can be rebuilt while
+# a long capture runs)
+demo="${G2_DEMO_DLL:-$here/../Gfx.Demo/bin/Release/net10.0/Gfx.Demo.dll}"
+[ -f "$demo" ] || { echo "capture-scenes: build Release first ($demo)" >&2; exit 2; }
+export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-offscreen}" LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"
+mkdir -p "$out"
+cap() { # name scene switches [args...]
+  local name=$1 scene=$2 sw=$3; shift 3
+  echo "== $name: $scene samples=$samples${sw:+,$sw} $*"
+  local t0; t0=$(date +%s)
+  nice -n 10 dotnet "$demo" --capture "$scene" --out "$out/$name" --size 1920x1080 --set "samples=$samples${sw:+,$sw}" "$@" \
+    > "$out/$name.log" 2>&1
+  echo "   $(( $(date +%s) - t0 )) s"
+}
+has() { case ",$groups," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }
+# every shot of every scene (each scene's shots carry their own hours)
+has a && cap a bench-a ""
+has b && cap b bench-b ""
+has c && cap c bench-c ""
+if has d; then
+  cap d-shown bench-d-shown ""
+  # the cut-away state differs in two ways only: no dead soldier is drawn, and the last beat cuts away
+  cap d-cutaway bench-d-cutaway "" --shots 00-field,06-cutaway
+fi
+has e && cap e bench-e ""
+if has weather; then
+  cap b-rain bench-b weather=rain --shots wide-noon,front
+  cap b-mist bench-b weather=mist --shots wide-golden
+  cap c-rain bench-c weather=rain --shots clash-noon
+  cap c-mist bench-c weather=mist --shots vista-golden
+  cap e-rain bench-e weather=rain --shots settlement,river
+  cap e-mist bench-e weather=mist --shots vista-golden
+fi
+echo "capture-scenes: done ($out)"
