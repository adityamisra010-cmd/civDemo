+#!/usr/bin/env bash
+# Export the battle trace of benchmark scenes C and D (stage scenes) into $G2_ASSETS/baked/trace, or check an
+# existing export.
+#
+# Usage: scripts/export-battle-trace.sh [--check]
+#
+# Builds and runs tools/traceexport (a tool outside M7Gfx2.slnx; never shipped). It runs the battle prototype's
+# TacticalResolver (prototypes/m7-sprint1/Proto.M7, referenced read-only, never modified) with 21 heavy-infantry
+# formations of 50 per side (2,100 entities, the proposed heavy-infantry cap) on a 20 m battle grid downscaled from the
+# G2 temperate fixture grid, and writes battle-2100.g2bt (the compact binary trace, gzip) and MANIFEST.tsv (file
+# sha256, the trace's content hash, the m7-sprint1 tree it ran). The run is integer-only and deterministic: --check
+# re-exports into a temporary file and compares the trace content hash with the manifest (exit 1 on a difference).
+# Outputs are never committed. About 90 s on 4 CPUs here.
+set -euo pipefail
+here="$(cd "$(dirname "$0")" && pwd)"
+g2="$(cd "$here/.." && pwd)"
+repo="$(cd "$g2/../.." && pwd)"
+root="${G2_ASSETS:-/home/user/g2w/assets}"
+out="$root/baked/trace"
+name="battle-2100.g2bt"
+check=0
+[ "${1:-}" = "--check" ] && check=1
+export DOTNET_CLI_USE_MSBUILD_SERVER=0
+proj="$g2/tools/traceexport/TraceExport.csproj"
+nice -n 19 dotnet build "$proj" -c Release -m:1 -nodeReuse:false -v:q -nologo >/dev/null
+dll="$g2/tools/traceexport/bin/Release/net10.0/TraceExport.dll"
+sprint="$(git -C "$repo" rev-parse HEAD:prototypes/m7-sprint1 2>/dev/null || echo unknown)"
+mkdir -p "$out"
+tmp="$(mktemp -d)"
+trap 'rm -f "$tmp/$name" "$tmp/export.log"; rmdir "$tmp" 2>/dev/null || true' EXIT
+dotnet "$dll" --out "$tmp/$name" --formations 21 --seed 7 --commit "tree $sprint" | tee "$tmp/export.log"
+hash="$(sed -n 's/^\[trace\] trace hash \([0-9A-F]*\) .*/\1/p' "$tmp/export.log")"
+[ -n "$hash" ] || { echo "export-battle-trace: no trace hash in the exporter output" >&2; exit 1; }
+if [ "$check" = 1 ]; then
+  [ -f "$out/MANIFEST.tsv" ] || { echo "export-battle-trace: no manifest in $out (run without --check first)" >&2; exit 3; }
+  want="$(awk -F'\t' -v n="$name" '$1==n {print $3}' "$out/MANIFEST.tsv")"
+  if [ "$want" = "$hash" ]; then echo "export-battle-trace: OK, content hash $hash equals the manifest"; exit 0; fi
+  echo "export-battle-trace: content hash $hash differs from the manifest's $want" >&2; exit 1
+fi
+mv -f "$tmp/$name" "$out/$name"
+sha="$(sha256sum "$out/$name" | cut -d' ' -f1)"
+bytes="$(stat -c %s "$out/$name")"
+{
+  printf '# file\tsha256\ttrace_hash\tbytes\tsource\n'
+  printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$sha" "$hash" "$bytes" "tools/traceexport --formations 21 --seed 7; prototypes/m7-sprint1 tree $sprint"
+} > "$out/MANIFEST.tsv"
+echo "export-battle-trace: wrote $out/$name ($bytes bytes, sha256 $sha, trace hash $hash)"
