+using PClass = Proto.M7.Spatial.TerrainClass;
+
+namespace TraceExport;
+
+/// <summary>
+/// G2 stage scenes: exports a battle trace (format m7gfx-battle-trace/1) for benchmark scene C.
+/// <para>WHAT RUNS: the battle prototype's TacticalResolver (<c>new TacticalBattle(setup, KnowledgeAi, KnowledgeAi)</c>, the
+/// engine behind <c>TacticalResolver.Resolve</c>) from prototypes/m7-sprint1/Proto.M7, referenced read-only and never modified.
+/// This tool only builds the setup, steps the battle through its public surface and records what it publishes.</para>
+/// <para>ON THE TERRAIN GRID (DR49 item 5): the battle grid is derived from the G2 authoritative battlefield grid (the env
+/// temperate fixture, 256 x 256 cells of 4 m) by a fixed integer downscale to the tactical slice's 20 m cells (5 x 5 fine
+/// cells per battle cell, 51 x 51 cells, 1,020 m square): class by the rules in <see cref="Downscale"/>, height = the floor
+/// of the mean. The env stage's Iron Age village (a presentation plan on the same grid) enters as Building cells so no
+/// soldier walks through its huts. This mapping is a PROTOTYPE ADAPTER of this tool, not a ruled design.</para>
+/// <para>OUTPUT: entity positions (mm in the battle grid's frame) and states at every 2 s step from deployment to the end of
+/// the battle, and every executed Fire (A = 1 melee, 2 ranged) and Damage (A = hit points) event, plus the battle result
+/// and the input hashes in the header. Everything is integer and deterministic: the same inputs give the same bytes.</para>
+/// </summary>
+public static class Program
+{
+    public const int Factor = 5;              // fine cells per battle cell along each axis (4 m -> 20 m)
+    public const int CellMm = 20_000;         // TacticalScenarios.CellMm
+    public const int Files = 10;              // TacticalRules.FormationColumns default
+    public const int PerFormation = 50;       // the proposed heavy-infantry cap (ProposedCaps.Proposed)
+
+    public static int Main(string[] args)
+    {
+        CultureInfo.DefaultThreadCurrentCulture = CultureInfo.InvariantCulture;
+        CultureInfo.CurrentCulture = CultureInfo.InvariantCulture;
+        string? Opt(string n, string? d) { int i = Array.IndexOf(args, n); return i >= 0 && i + 1 < args.Length ? args[i + 1] : d; }
+        string outPath = Opt("--out", null) ?? throw new ArgumentException("--out FILE (.g2bt: compact binary; .json: the JSON fixture format)");
+        ulong seed = ulong.Parse(Opt("--seed", "7")!, CultureInfo.InvariantCulture);
+        int perSide = int.Parse(Opt("--formations", "21")!, CultureInfo.InvariantCulture);
+        string commit = Opt("--commit", "")!;
+        var sw = System.Diagnostics.Stopwatch.StartNew();
+        MapOnly = Array.IndexOf(args, "--map-only") >= 0;
+        var json = Export(seed, perSide, commit, out var report);
+        if (MapOnly) { Console.WriteLine(report); return 0; }
+        Console.WriteLine(report);
+        if (Array.IndexOf(args, "--map") >= 0) Console.WriteLine(MapText);
+        // the presentation's own reader parses the JSON, then writes the compact binary form (same trace hash)
+        var parsed = Gfx.Units.BattleTrace.Parse(json);
+        byte[] file;
+        if (outPath.EndsWith(".json", StringComparison.Ordinal)) file = json;
+        else { using var ms = new MemoryStream(); parsed.WriteBinary(ms); file = ms.ToArray(); }
+        File.WriteAllBytes(outPath, file);
+        var back = Gfx.Units.BattleTrace.Load(outPath);
+        if (back.Hash() != parsed.Hash()) throw new InvalidOperationException("the written trace does not read back to the same trace");
+        Console.WriteLine($"[trace] trace hash {parsed.Hash()} ({parsed.Entities.Count} entities, {parsed.StepCount} steps, {parsed.Events.Count} events); JSON {json.Length:N0} bytes");
+        Console.WriteLine($"[trace] wrote {outPath}: {file.Length:N0} bytes, sha256 {Convert.ToHexStringLower(SHA256.HashData(file))}, {sw.Elapsed.TotalSeconds:F1} s");
+        return 0;
+    }
+
+    /// <summary>The G2 grid -> the coarse battle grid (see the class summary). Returns the grid and the village cells.</summary>
+    public static (TerrainGrid grid, bool[] village) Downscale(BattleTerrainGrid g, SettlementPlan? village)
+    {
+        int w = g.Width / Factor, h = g.Height / Factor;
+        var grid = new TerrainGrid(w, h, CellMm, PClass.Open);
+        var vil = new bool[w * h];
+        var counts = new int[16];
+        for (int cy = 0; cy < h; cy++)
+            for (int cx = 0; cx < w; cx++)
+            {
+                Array.Clear(counts);
+                long hsum = 0; int wet = 0, deep = 0;
+                for (int dy = 0; dy < Factor; dy++)
+                    for (int dx = 0; dx < Factor; dx++)
+                    {
+                        int i = g.Index(cx * Factor + dx, cy * Factor + dy);
+                        hsum += g.HeightMm[i];
+                        int d = g.WaterDepthMm[i];
+                        if (d > 0) { wet++; if (d >= 1000) deep++; }
+                        counts[(int)g.Class[i]]++;
+                    }
+                long hm = FloorDiv(hsum, Factor * Factor);
+                PClass c;
+                if (deep >= 8) c = PClass.Water;          // a channel of deep water across the cell
+                else if (wet >= 5) c = PClass.Ford;       // shallow water or the river's edge: passable, slow
+                else
+                {
+                    // majority land class (Beach and Desert count as Open: the battle slice has no such classes); ties -> lower code
+                    counts[(int)GClass.Open] += counts[(int)GClass.Beach] + counts[(int)GClass.Desert];
+                    counts[(int)GClass.Beach] = counts[(int)GClass.Desert] = counts[(int)GClass.Water] = counts[(int)GClass.Wall] = 0;
+                    int best = (int)GClass.Open;
+                    for (int k = 0; k < 8; k++) if (counts[k] > counts[best] || (counts[k] == counts[best] && k < best)) best = k;
+                    c = (GClass)best switch
+                    {
+                        GClass.Road => PClass.Road, GClass.Forest => PClass.Forest, GClass.Jungle => PClass.Jungle,
+                        GClass.Hills => PClass.Hills, GClass.Mountain => PClass.Mountain, _ => PClass.Open,
+                    };
+                }
+                if (village != null)
+                {
+                    // battle-cell centre in the presentation's world frame (x, z in metres; the grid is centred on the origin)
+                    float wx = (cx * CellMm + CellMm / 2) / 1000f - g.Width * g.CellMm / 2000f;
+                    float wz = (cy * CellMm + CellMm / 2) / 1000f - g.Height * g.CellMm / 2000f;
+                    float dxv = wx - village.Centre.X, dzv = wz - village.Centre.Y;
+                    if (dxv * dxv + dzv * dzv <= (village.Radius + 12f) * (village.Radius + 12f)) { c = PClass.Building; vil[cy * w + cx] = true; }
+                }
+                grid.Set(cx, cy, c, hm);
+            }
+        return (grid, vil);
+    }
+
+    static long FloorDiv(long a, long b) => a >= 0 ? a / b : -((-a + b - 1) / b);
+
+    /// <summary>
+    /// Deployment site: the rectangle (±<paramref name="halfAxis"/> cells along the battle axis, ±<paramref name="halfFront"/>
+    /// across it) whose cells are most open, dry and level, for both axes (x: the sides exit West and East; y: North and
+    /// South), scanned over every centre: integer score (ties -> the x axis, then lower cy, then lower cx). Forest costs
+    /// enough that an open field wins where one exists (the benchmark wants the armies in view); cells next to the village
+    /// cost extra so the lines keep clear of its palisade.
+    /// </summary>
+    public static (bool alongX, int cx, int cy, long score) FindSite(TerrainGrid grid, bool[] village, int halfAxis, int halfFront)
+    {
+        long best = long.MaxValue; int bx = 0, by = 0; bool bAlong = true;
+        bool NearVillage(int x, int y)
+        {
+            for (int dy = -2; dy <= 2; dy++) for (int dx = -2; dx <= 2; dx++)
+            {
+                int qx = x + dx, qy = y + dy;
+                if (qx >= 0 && qy >= 0 && qx < grid.Width && qy < grid.Height && village[qy * grid.Width + qx]) return true;
+            }
+            return false;
+        }
+        foreach (bool alongX in new[] { true, false })
+        {
+            int hx = alongX ? halfAxis : halfFront, hy = alongX ? halfFront : halfAxis;
+            for (int cy = hy + 1; cy < grid.Height - hy - 1; cy++)
+                for (int cx = hx + 1; cx < grid.Width - hx - 1; cx++)
+                {
+                    long s = 0, lo = long.MaxValue, hi = long.MinValue;
+                    for (int y = cy - hy; y <= cy + hy && s < best; y++)
+                        for (int x = cx - hx; x <= cx + hx; x++)
+                        {
+                            var c = grid.ClassAt(x, y);
+                            s += c switch
+                            {
+                                PClass.Open or PClass.Road => 0, PClass.Hills => 30, PClass.Forest or PClass.Jungle => 400, PClass.Ford => 600,
+                                _ => 5000,
+                            };
+                            if (c != PClass.Building && NearVillage(x, y)) s += 300;
+                            long hgt = grid.HeightAt(x, y); lo = Math.Min(lo, hgt); hi = Math.Max(hi, hgt);
+                        }
+                    if (s >= best) continue;
+                    s += (hi - lo) / 100;          // one point per 10 cm of relief across the site
+                    if (s < best) { best = s; bx = cx; by = cy; bAlong = alongX; }
+                }
+        }
+        return (bAlong, bx, by, best);
+    }
+
+    /// <summary>The battle grid as text after the last export (north up: y descending; ',' marks open cells of the site).</summary>
+    public static string MapText { get; private set; } = "";
+    /// <summary>--map-only: print the battle grid and the site, run no battle.</summary>
+    public static bool MapOnly { get; set; }
+
+    public static byte[] Export(ulong seed, int perSide, string commit, out string report)
+    {
+        var inputs = TerrainTemperateScene.FixtureInputs;
+        var g = BattleTerrainGenerator.Generate(inputs);
+        var mesh = TerrainMeshData.Build(g);
+        var village = Settlements.IronAgeVillage(mesh, new WaterField(mesh), (uint)(g.Seed ^ (g.Seed >> 32)), null);
+        var (grid, vil) = Downscale(g, village);
+        const int PerLine = 11;
+        int lines = (perSide + PerLine - 1) / PerLine;
+        const int HalfAxis = 8, HalfFront = 6;
+        var (alongX, cx, cy, score) = FindSite(grid, vil, HalfAxis, HalfFront);
+        int halfCols = alongX ? HalfAxis : HalfFront, halfRows = alongX ? HalfFront : HalfAxis;
+        var map = new StringBuilder();
+        for (int y = grid.Height - 1; y >= 0; y--)
+        {
+            for (int x = 0; x < grid.Width; x++)
+            {
+                bool site = Math.Abs(x - cx) <= halfCols && Math.Abs(y - cy) <= halfRows;
+                char ch = grid.ClassAt(x, y) switch
+                {
+                    PClass.Road => '=', PClass.Open => '.', PClass.Forest => 'T', PClass.Hills => 'h', PClass.Mountain => 'M',
+                    PClass.Water => '~', PClass.Ford => 'f', PClass.Building => '#', _ => '?',
+                };
+                map.Append(site && ch == '.' ? ',' : ch);
+            }
+            map.Append('\n');
+        }
+        MapText = map.ToString();
+        if (MapOnly) { report = MapText + $"site ({cx},{cy}) along {(alongX ? "x" : "y")} score {score}; village centre {village.Centre} radius {village.Radius}"; return Array.Empty<byte>(); }
+
+        // anchors: lines of up to 11 blocks per side, 15 m frontage each with 4.5 m gaps, lines 30 m apart; the armies'
+        // front lines start 170 m apart along the battle axis, inside the 12-cell (240 m) sight of the heavy-infantry
+        // profile, so both sides advance to contact from the first pulse
+        var forms = new List<FormationSpec>();
+        long centreX = cx * (long)CellMm + CellMm / 2, centreY = cy * (long)CellMm + CellMm / 2;
+        const long Gap = 85_000, LineStep = 30_000, Pitch = 19_500;
+        // battle axis a (side 0 at -a, side 1 at +a) and frontage f, in grid axes
+        var (ax0, ay0) = alongX ? (1L, 0L) : (0L, 1L);
+        var (fx0, fy0) = alongX ? (0L, 1L) : (1L, 0L);
+        Vec2L At(long along, long across) => new(centreX + along * ax0 + across * fx0, centreY + along * ay0 + across * fy0);
+        long id = 1;
+        for (int side = 0; side < 2; side++)
+        {
+            int placed = 0;
+            for (int line = 0; line < lines && placed < perSide; line++)
+            {
+                int inLine = Math.Min(PerLine, perSide - placed);
+                for (int k = 0; k < inLine; k++)
+                {
+                    long dir = side == 0 ? -1 : 1;
+                    long across = (k - (inLine - 1) / 2) * Pitch - ((inLine - 1) % 2 == 0 ? 0 : Pitch / 2);
+                    forms.Add(new FormationSpec(id++, side, UnitProfiles.HeavyInfantry, PerFormation, At(dir * (Gap + line * LineStep), across)));
+                    placed++;
+                }
+            }
+        }
+        // each side's objective: the other army's front-line centre (the knowledge-only AIs advance, detect and attack);
+        // side 0 exits behind it (West, or North = low y), side 1 the opposite edge
+        var obj0 = At(Gap, 0); var obj1 = At(-Gap, 0);
+        var setup = new BattleSetup(grid, TerrainCostTable.PlaceholderTestTable(), ConcealmentTable.PlaceholderTestTable(),
+            new[] { new SideSpec(alongX ? ExitEdge.West : ExitEdge.North) { Objectives = new[] { obj0 } },
+                    new SideSpec(alongX ? ExitEdge.East : ExitEdge.South) { Objectives = new[] { obj1 } } },
+            forms.ToArray(), seed);
+        var battle = new TacticalBattle(setup, new KnowledgeAi(), new KnowledgeAi());
+        long stepMs = setup.Rules.StepMs;
+
+        // step through the battle, snapshotting after every event of each 2 s instant has executed
+        var times = new List<long>(); var pos = new List<long[]>(); var states = new List<byte[]>();
+        void Snap(long t)
+        {
+            var ents = battle.Entities();
+            var p = new long[2 * ents.Count]; var s = new byte[ents.Count];
+            for (int i = 0; i < ents.Count; i++) { p[2 * i] = ents[i].Pos.X; p[2 * i + 1] = ents[i].Pos.Y; s[i] = (byte)ents[i].State; }
+            times.Add(t); pos.Add(p); states.Add(s);
+        }
+        battle.Start();
+        long next = setup.StartMs;
+        var sched = battle.Scheduler;
+        while (true)
+        {
+            bool have = sched.TryPeekKey(out var key);
+            if (!have || battle.IsOver || key.TimeMs > next)
+            {
+                Snap(next);
+                if (battle.IsOver || !have) break;
+                next += stepMs;
+                continue;
+            }
+            battle.Advance();
+        }
+        var result = battle.Result ?? throw new InvalidOperationException("battle did not end");
+        var ents0 = battle.Entities();
+
+        // executed Fire / Damage events, in execution order (the scheduler's own trace)
+        var ev = new StringBuilder();
+        int nFire = 0, nDamage = 0;
+        foreach (var e in sched.Trace.Entries)
+        {
+            if (e.Outcome != TraceOutcome.Executed) continue;
+            string? k = e.Kind == TacticalKinds.Fire ? "Fire" : e.Kind == TacticalKinds.Damage ? "Damage" : null;
+            if (k == null) continue;
+            if (k == "Fire") nFire++; else nDamage++;
+            if (ev.Length > 0) ev.Append(",\n");
+            ev.Append(CultureInfo.InvariantCulture, $"{{\"t\":{e.Key.TimeMs},\"k\":\"{k}\",\"src\":{e.Source.Id},\"tgt\":{e.Target.Id},\"a\":{e.A}}}");
+        }
+
+        var sb = new StringBuilder();
+        string label = string.Create(CultureInfo.InvariantCulture,
+            $"G2 scene C trace: TacticalResolver (prototypes/m7-sprint1/Proto.M7{(commit.Length > 0 ? " @ " + commit : "")}, unmodified) run by tools/traceexport; " +
+            $"{forms.Count} heavy-infantry formations of {PerFormation} ({forms.Count * PerFormation} entities), KnowledgeAi both sides, seed {seed}; " +
+            $"battle grid {grid.Width}x{grid.Height} cells of {CellMm / 1000} m downscaled from the G2 temperate fixture grid (BTG1 sha256 {g.HashHex()}), " +
+            $"village cells as Building; site centre cell ({cx},{cy}), axis {(alongX ? "x (exits West/East)" : "y (exits North/South)")}, score {score}; result {result.Reason}, side {result.Side}, holds field {result.HoldsField}, " +
+            $"{result.Pulses} pulses, end {result.EndMs} ms; {times.Count} snapshots");
+        sb.Append("{\n\"format\":\"m7gfx-battle-trace/1\",\n");
+        sb.Append("\"label\":\"").Append(label).Append("\",\n");
+        sb.Append(CultureInfo.InvariantCulture, $"\"seed\":{seed},\"stepMs\":{stepMs},\"over\":true,\n");
+        // the battle-grid frame -> the presentation frame: world x = x_mm/1000 - 512, world z = y_mm/1000 - 512 (metres)
+        sb.Append(CultureInfo.InvariantCulture, $"\"frame\":{{\"originMm\":[{g.Width * g.CellMm / 2},{g.Height * g.CellMm / 2}],\"gridCellMm\":{CellMm},\"gridW\":{grid.Width},\"gridH\":{grid.Height}}},\n");
+        sb.Append(CultureInfo.InvariantCulture, $"\"result\":{{\"reason\":\"{result.Reason}\",\"side\":{result.Side},\"holdsField\":{result.HoldsField},\"pulses\":{result.Pulses},\"endMs\":{result.EndMs},\"resultHash\":\"{result.ResultHash()}\",\"traceHash\":\"{result.TraceHash}\",\"formations\":[");
+        for (int i = 0; i < result.Formations.Length; i++)
+        {
+            var f = result.Formations[i];
+            if (i > 0) sb.Append(',');
+            sb.Append(CultureInfo.InvariantCulture, $"{{\"id\":{f.FormationId},\"side\":{f.Side},\"start\":{f.Start},\"survivors\":{f.Survivors},\"killed\":{f.Killed},\"surrendered\":{f.Surrendered},\"activeAtEnd\":{f.ActiveAtEnd},\"escaped\":{f.Escaped},\"routedEscaped\":{f.RoutedEscaped},\"moraleEnd\":{f.MoraleEnd}}}");
+        }
+        sb.Append("]},\n\"formations\":[");
+        for (int i = 0; i < forms.Count; i++)
+        {
+            var f = forms[i];
+            if (i > 0) sb.Append(',');
+            sb.Append(CultureInfo.InvariantCulture, $"{{\"id\":{f.Id},\"side\":{f.Side},\"kind\":\"{f.Profile.Name}\",\"ranged\":{(f.Profile.RangeCells > 0 ? "true" : "false")},\"count\":{f.Count}}}");
+        }
+        sb.Append("],\n\"entities\":[");
+        for (int i = 0; i < ents0.Count; i++)
+        {
+            if (i > 0) sb.Append(',');
+            sb.Append(CultureInfo.InvariantCulture, $"[{ents0[i].Id},{ents0[i].FormationId},{ents0[i].Side}]");
+        }
+        sb.Append("],\n\"steps\":[\n");
+        for (int s = 0; s < times.Count; s++)
+        {
+            if (s > 0) sb.Append(",\n");
+            sb.Append(CultureInfo.InvariantCulture, $"{{\"t\":{times[s]},\"pos\":[").AppendJoin(',', pos[s]).Append("],\"state\":[").AppendJoin(',', states[s]).Append("]}");
+        }
+        sb.Append("\n],\n\"events\":[\n").Append(ev).Append("\n]\n}\n");
+
+        var killed = new long[2]; var surr = new long[2]; var esc = new long[2]; var start = new long[2]; var act = new long[2];
+        foreach (var f in result.Formations) { killed[f.Side] += f.Killed; surr[f.Side] += f.Surrendered; esc[f.Side] += f.Escaped; start[f.Side] += f.Start; act[f.Side] += f.ActiveAtEnd; }
+        int vilCells = vil.Count(x => x);
+        report = string.Create(CultureInfo.InvariantCulture,
+            $"[trace] grid {grid.Width}x{grid.Height} x {CellMm / 1000} m from BTG1 {g.HashHex()}; village cells {vilCells}; site ({cx},{cy}) along {(alongX ? "x" : "y")} score {score}\n" +
+            $"[trace] {forms.Count} formations, {ents0.Count} entities; {times.Count} snapshots of {stepMs} ms; events fire {nFire}, damage {nDamage}\n" +
+            $"[trace] result {result.Reason}, eliminated side {result.Side}, holds field {result.HoldsField}, pulses {result.Pulses}, end {result.EndMs} ms\n" +
+            $"[trace] side 0: start {start[0]} active {act[0]} killed {killed[0]} surrendered {surr[0]} escaped {esc[0]}\n" +
+            $"[trace] side 1: start {start[1]} active {act[1]} killed {killed[1]} surrendered {surr[1]} escaped {esc[1]}\n" +
+            $"[trace] result hash {result.ResultHash()}");
+        return Encoding.UTF8.GetBytes(sb.ToString());
+    }
+}
diff --git a/prototypes/m7-gfx2/tools/traceexport/TraceExport.csproj b/prototypes/m7-gfx2/tools/traceexport/TraceExport.csproj
