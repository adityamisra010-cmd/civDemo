+    /// <summary>
+    /// The close-shot solver returns the candidate with the fewest blockers, trying the turns in a fixed order (0, +15,
+    /// -15, +30, ...) and keeping the first of equal cost. Tie-dense: occluders placed symmetrically make each +/- pair
+    /// cost the same, and the positive turn is taken; with nothing in the way, the preferred eye is kept.
+    /// </summary>
+    [Fact]
+    public void CloseShotSolverPicksTheClearestViewWithStableTies()
+    {
+        var target = new Vector3(0, 1.0f, 0); var eye = new Vector3(0, 1.6f, -5f);
+        Assert.Equal(eye, BenchAftermathScene.Solve(eye, target, new List<Vector3>(), Flat, 90f));
+        // a soldier on the line and two mirrored pairs: k = 0 is blocked, +-15 and +-30 tie by symmetry
+        var occ = new List<Vector3> { new(0, 0, -2.5f) };
+        foreach (float ang in new[] { 15f, 30f })
+        {
+            float r = MathHelper.ToRadians(ang);
+            occ.Add(new Vector3(MathF.Sin(r) * 2.5f, 0, -MathF.Cos(r) * 2.5f));
+            occ.Add(new Vector3(-MathF.Sin(r) * 2.5f, 0, -MathF.Cos(r) * 2.5f));
+        }
+        var got = BenchAftermathScene.Solve(eye, target, occ, Flat, 90f);
+        // the expected answer by brute force over the documented candidate order
+        Vector3 best = eye; int bestCost = int.MaxValue; var costs = new List<int>();
+        for (int k = 0; k * 15 <= 90; k++)
+            foreach (int sg in new[] { 1, -1 })
+            {
+                if (k == 0 && sg < 0) continue;
+                float a = MathHelper.ToRadians(15f * k * sg);
+                // the eye (0, -5) relative to the target, turned by a about the vertical axis
+                var c = new Vector3(5f * MathF.Sin(a), 1.6f, -5f * MathF.Cos(a));
+                int cost = BenchAftermathScene.ViewBlockers(c, target, occ); costs.Add(cost);
+                if (cost < bestCost) { bestCost = cost; best = c; }
+            }
+        Assert.True(costs[0] > costs.Min(), "the straight view is blocked");
+        Assert.True(costs.Count(c => c == costs.Min()) >= 2, "a tie exists at the minimum");
+        Assert.Equal(best.X, got.X, 4); Assert.Equal(best.Z, got.Z, 4);
+        Assert.True(got.X > 0f, "the positive turn wins the tie");
+        // FirstClearest keeps the list order among equal costs: the blocked straight view loses, the first clear one wins
+        var listed = new List<Vector3> { eye, new(5f, 1.6f, 0f), new(-5f, 1.6f, 0f) };
+        Assert.Equal(listed[1], BenchAftermathScene.FirstClearest(listed, target, occ));
+        listed.Reverse();
+        Assert.Equal(new Vector3(-5f, 1.6f, 0f), BenchAftermathScene.FirstClearest(listed, target, occ));
+    }
