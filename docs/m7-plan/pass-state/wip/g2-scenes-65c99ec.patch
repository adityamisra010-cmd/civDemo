+            (0, 5f, -15f), (1, 6f, -15f),    // cell (0, -2)
+        };
+        // two blows in each cell at t = 30 s, in two event orders: the lowest cell (-1, 0) wins both times
+        var a = Blows(men, (30000, "Fire", 0, 1), (30000, "Fire", 0, 1), (30000, "Fire", 2, 3), (30000, "Fire", 2, 3),
+            (30000, "Fire", 4, 5), (30000, "Fire", 4, 5), (30000, "Fire", 6, 7), (30000, "Fire", 6, 7));
+        var b = Blows(men, (30000, "Fire", 6, 7), (30000, "Fire", 4, 5), (30000, "Fire", 2, 3), (30000, "Fire", 0, 1),
+            (30000, "Fire", 6, 7), (30000, "Fire", 4, 5), (30000, "Fire", 2, 3), (30000, "Fire", 0, 1));
+        Assert.Equal(new Vector3(-4.5f, 0, 5f), Densest(a, 30f, 6f));
+        Assert.Equal(new Vector3(-4.5f, 0, 5f), Densest(b, 30f, 6f));
+        // without cell (-1, 0): the tie between (0, 3) and (0, -2) goes to the lower z, (0, -2)
+        var c = Blows(men, (30000, "Fire", 4, 5), (30000, "Fire", 4, 5), (30000, "Fire", 6, 7), (30000, "Fire", 6, 7));
+        Assert.Equal(new Vector3(5.5f, 0, -15f), Densest(c, 30f, 6f));
+        // one more blow in (2, 0) moves it there; a blow outside the window and a Damage event do not count
+        var d = Blows(men, (30000, "Fire", 0, 1), (30000, "Fire", 0, 1), (31000, "Fire", 0, 1), (30000, "Fire", 2, 3), (30000, "Fire", 2, 3),
