+#!/usr/bin/env python3
+"""Review sheets of stage scenes: G1-vs-G2 side-by-side sheets per scene (full size, for the scratchpad) and two small
+review JPEGs for reports/captures/scenes (the committed budget is small).
+
+Usage: review-sheets-scenes.py G2_DIR G1_DIR SHEETS_DIR REVIEW_DIR
+  G2_DIR: the output of scripts/capture-scenes.sh; G1_DIR: G1's own captures (one folder per G1 scene).
+Every legend says: llvmpipe, not Victus evidence; scenes A-D also: CMU motion PROTOTYPE-ONLY in frame.
+"""
+import os
+import sys
+from PIL import Image, ImageDraw
+
+G2, G1, SHEETS, REVIEW = sys.argv[1:5]
+LLVM = "llvmpipe, not Victus evidence"
+CMU = "CMU motion (PROTOTYPE-ONLY) in frame"
+
+
+def g1(scene, shot):
+    return os.path.join(G1, scene, f"{scene}-{shot}.png")
+
+
+def g2(folder, scene, shot):
+    return os.path.join(G2, folder, f"{scene}-{shot}.png")
+
+
+def load(path, size):
+    if path is None or not os.path.exists(path):
+        im = Image.new("RGB", size, (40, 40, 40))
+        ImageDraw.Draw(im).text((8, 8), "(no capture)" if path is None else "missing: " + os.path.basename(path), fill=(220, 220, 220))
+        return im
+    return Image.open(path).convert("RGB").resize(size, Image.LANCZOS)
+
+
+def label(draw, xy, text, w):
+    x, y = xy
+    draw.rectangle([x, y, x + w, y + 13], fill=(0, 0, 0))
+    draw.text((x + 3, y + 1), text, fill=(235, 235, 235))
+
+
+def sheet(title, legend, rows, out, cell=(800, 450), quality=88):
+    """rows: list of (left_label, left_path, right_label, right_path)."""
+    w, h = cell
+    head = 34
+    img = Image.new("RGB", (2 * w + 6, head + len(rows) * (h + 4)), (16, 16, 16))
+    d = ImageDraw.Draw(img)
+    d.text((6, 4), title, fill=(255, 255, 255))
+    d.text((6, 18), legend, fill=(200, 200, 200))
+    for i, (ll, lp, rl, rp) in enumerate(rows):
+        y = head + i * (h + 4)
+        img.paste(load(lp, cell), (0, y))
+        img.paste(load(rp, cell), (w + 6, y))
+        label(d, (0, y), ll, w)
+        label(d, (w + 6, y), rl, w)
+    img.save(out, quality=quality, optimize=True)
+    return out
+
+
+os.makedirs(SHEETS, exist_ok=True)
+os.makedirs(REVIEW, exist_ok=True)
+
+per_scene = {
+    "A": ("Scene A, soldier close-up: G1 (left) vs G2 bench-a (right)", f"{LLVM}; {CMU}; 1920x1080 sources, G2 8-sample stills", [
+        ("G1 avatar-turntable face-34", g1("avatar-turntable", "face-34"), "G2 bench-a commander-battlecry", g2("a", "bench-a", "commander-battlecry")),
+        ("G1 units-closeup kits-clips", g1("units-closeup", "kits-clips"), "G2 bench-a two-shot", g2("a", "bench-a", "two-shot")),
+        ("G1 avatar-turntable face-front", g1("avatar-turntable", "face-front"), "G2 bench-a soldier-face", g2("a", "bench-a", "soldier-face")),
+        ("G1 units-closeup variation", g1("units-closeup", "variation"), "G2 bench-a kit (hero aspis)", g2("a", "bench-a", "kit")),
+    ]),
+    "B": ("Scene B, formation: G1 (left) vs G2 bench-b (right)", f"{LLVM}; {CMU}; 1920x1080 sources, G2 8-sample stills", [
+        ("G1 units-wide5k frontline", g1("units-wide5k", "frontline"), "G2 bench-b front (noon)", g2("b", "bench-b", "front")),
+        ("G1 units-wide5k wide", g1("units-wide5k", "wide"), "G2 bench-b wide (golden hour)", g2("b", "bench-b", "wide-golden")),
+        ("G1 units-closeup variation", g1("units-closeup", "variation"), "G2 bench-b standard (golden hour)", g2("b", "bench-b", "standard")),
+    ]),
+    "C": ("Scene C, large battlefield: G1 (left) vs G2 bench-c, 2,100 trace-driven soldiers (right)", f"{LLVM}; {CMU}; 1920x1080 sources, G2 8-sample stills", [
+        ("G1 battlefield wide", g1("battlefield", "wide"), "G2 bench-c vista (golden hour)", g2("c", "bench-c", "vista-golden")),
+        ("G1 battlefield mid", g1("battlefield", "mid"), "G2 bench-c clash (golden hour)", g2("c", "bench-c", "clash-golden")),
+        ("G1 units-clash melee", g1("units-clash", "melee"), "G2 bench-c melee, eye level", g2("c", "bench-c", "melee-low")),
+    ]),
+    "D": ("Scene D, cinematic aftermath: G1 (left) vs G2 bench-d-shown (right)", f"{LLVM}; {CMU}; the death-content default is open (D-079 Q12): both states captured", [
+        ("G1 battlefield-cine aftermath", g1("battlefield-cine", "00-aftermath-62"), "G2 bench-d-shown 00 field", g2("d-shown", "bench-d-shown", "00-field")),
+        ("G1 battlefield-cine outcome beat", g1("battlefield-cine", "04-outcomebeat-62"), "G2 bench-d-shown 02 surrender", g2("d-shown", "bench-d-shown", "02-surrender")),
+        ("G1 cine-surrender outcome beat", g1("cine-surrender", "04-outcomebeat-92"), "G2 bench-d-shown 04 commander", g2("d-shown", "bench-d-shown", "04-commander-face")),
+        ("G1 battlefield-cine banner", g1("battlefield-cine", "05-banner-62"), "G2 bench-d-shown 05 standards", g2("d-shown", "bench-d-shown", "05-standards")),
+    ]),
+    "D-states": ("Scene D, the two death-content states (no default chosen): SHOWN (left) vs CUT AWAY (right)", f"{LLVM}; {CMU}", [
+        ("bench-d-shown 00 field (the fallen drawn)", g2("d-shown", "bench-d-shown", "00-field"), "bench-d-cutaway 00 field (no dead drawn)", g2("d-cutaway", "bench-d-cutaway", "00-field")),
+        ("bench-d-shown 06 fallen", g2("d-shown", "bench-d-shown", "06-fallen"), "bench-d-cutaway 06 cut-away", g2("d-cutaway", "bench-d-cutaway", "06-cutaway")),
+        ("bench-d-shown 01 prisoners", g2("d-shown", "bench-d-shown", "01-prisoners"), "bench-d-shown 03 officer", g2("d-shown", "bench-d-shown", "03-officer-face")),
+    ]),
+    "E": ("Scene E, campaign environment: G1 (left) vs G2 bench-e (right)", f"{LLVM}; no characters; 1920x1080 sources, G2 8-sample stills", [
+        ("G1 terrain-temperate day", g1("terrain-temperate", "day"), "G2 bench-e vista (noon)", g2("e", "bench-e", "vista-noon")),
+        ("G1 terrain-temperate dusk", g1("terrain-temperate", "dusk"), "G2 bench-e vista (dusk)", g2("e", "bench-e", "vista-dusk")),
+        ("G1 terrain-temperate tactical-low", g1("terrain-temperate", "tactical-low"), "G2 bench-e settlement (golden hour)", g2("e", "bench-e", "settlement")),
+        ("(G1 has no settlement or fortification)", None, "G2 bench-e fortification (noon)", g2("e", "bench-e", "fortification")),
+        ("(G1 has no river view)", None, "G2 bench-e river (golden hour)", g2("e", "bench-e", "river")),
+    ]),
+    "weather": ("Weather (right) against the clear look (left), scenes B, C, E", f"{LLVM}; {CMU} (B, C)", [
+        ("bench-b wide (noon), clear", g2("b", "bench-b", "wide-noon"), "bench-b wide (noon), rain", g2("b-rain", "bench-b", "wide-noon")),
+        ("bench-b front (noon), clear", g2("b", "bench-b", "front"), "bench-b front (noon), rain", g2("b-rain", "bench-b", "front")),
+        ("bench-b wide (golden hour), clear", g2("b", "bench-b", "wide-golden"), "bench-b wide (golden hour), mist", g2("b-mist", "bench-b", "wide-golden")),
+        ("bench-c vista (golden hour), clear", g2("c", "bench-c", "vista-golden"), "bench-c vista (golden hour), mist", g2("c-mist", "bench-c", "vista-golden")),
+        ("bench-c clash (golden hour), clear", g2("c", "bench-c", "clash-golden"), "bench-c clash (noon), rain", g2("c-rain", "bench-c", "clash-noon")),
+        ("bench-e settlement (golden hour), clear", g2("e", "bench-e", "settlement"), "bench-e settlement (golden hour), rain", g2("e-rain", "bench-e", "settlement")),
+        ("bench-e river (golden hour), clear", g2("e", "bench-e", "river"), "bench-e river (golden hour), rain", g2("e-rain", "bench-e", "river")),
+        ("bench-e vista (golden hour), clear", g2("e", "bench-e", "vista-golden"), "bench-e vista (golden hour), mist", g2("e-mist", "bench-e", "vista-golden")),
+    ]),
+}
+for key, (title, legend, rows) in per_scene.items():
+    print(sheet(title, legend, rows, os.path.join(SHEETS, f"scenes-{key}.jpg")))
+
+# hours: noon / golden / dusk of B, C, E (one sheet, three columns)
+hours = [("b", "bench-b", "wide"), ("c", "bench-c", "vista"), ("e", "bench-e", "vista")]
+w, h = 640, 360
+img = Image.new("RGB", (3 * w + 12, 34 + len(hours) * (h + 4)), (16, 16, 16))
+d = ImageDraw.Draw(img)
+d.text((6, 4), "Time of day: noon (12.5 h), golden hour (17.9 h), dusk (18.62 h); scenes B, C, E", fill=(255, 255, 255))
+d.text((6, 18), f"{LLVM}; {CMU} (B, C); 1920x1080 sources, 8-sample stills", fill=(200, 200, 200))
+for i, (folder, scene, shot) in enumerate(hours):
+    for j, hour in enumerate(["noon", "golden", "dusk"]):
+        x, y = j * (w + 6), 34 + i * (h + 4)
+        img.paste(load(g2(folder, scene, f"{shot}-{hour}"), (w, h)), (x, y))
+        label(d, (x, y), f"{scene} {shot} {hour}", w)
+out = os.path.join(SHEETS, "scenes-hours.jpg")
+img.save(out, quality=88, optimize=True)
+print(out)
+
+# committed review JPEGs (small): G1 vs G2 per scene in one sheet; hours and weather in another
+def small(rows, cols, cell, title, legend, out, quality):
+    cw, ch = cell
+    img = Image.new("RGB", (cols * (cw + 2), 26 + len(rows) * (ch + 2)), (16, 16, 16))
+    d = ImageDraw.Draw(img)
+    d.text((4, 2), title, fill=(255, 255, 255))
+    d.text((4, 13), legend, fill=(200, 200, 200))
+    for i, row in enumerate(rows):
+        for j, (lab, path) in enumerate(row):
+            x, y = j * (cw + 2), 26 + i * (ch + 2)
+            img.paste(load(path, cell), (x, y))
+            d.rectangle([x, y, x + len(lab) * 6 + 4, y + 11], fill=(0, 0, 0))
+            d.text((x + 2, y), lab, fill=(235, 235, 235))
+    img.save(out, quality=quality, optimize=True)
+    print(out, os.path.getsize(out))
+
+
