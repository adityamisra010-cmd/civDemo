+#!/usr/bin/env bash
+# llvmpipe costs of stage scenes (NOT Victus evidence): the harness's smoke suite on the benchmark scenes A-E and on the
+# perf stage's G1 stand-ins (the same slots and output layout), then the weather looks on scenes B and C (one load each,
+# the variants rendered in turn on the loaded scene).
+#
+# Usage: scripts/bench-scenes.sh OUT_DIR
+# Needs a Release build of M7Gfx2.slnx, the bakes of scripts/capture-scenes.sh and the battle trace.
+set -euo pipefail
+here="$(cd "$(dirname "$0")" && pwd)"
+out="${1:?usage: bench-scenes.sh OUT_DIR}"
+demo="$here/../Gfx.Demo/bin/Release/net10.0/Gfx.Demo.dll"
+[ -f "$demo" ] || { echo "bench-scenes: build Release first ($demo)" >&2; exit 2; }
+export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-offscreen}" LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"
+mkdir -p "$out"
+run() { # name args...
+  local name=$1; shift
+  echo "== $name: $* (load: $(cut -d' ' -f1-3 /proc/loadavg))"
+  local t0; t0=$(date +%s)
+  nice -n 10 dotnet "$demo" "$@" > "$out/$name.log" 2>&1
+  echo "   $(( $(date +%s) - t0 )) s (load: $(cut -d' ' -f1-3 /proc/loadavg))"
+}
+run smoke-bench --suite smoke --out "$out/smoke-bench"
+run smoke-g1 --suite smoke --bind g1 --out "$out/smoke-g1"
+run weather-b --bench bench-b --shot wide-noon --size 1280x720 --frames 10 --variants "g2;weather=overcast;weather=mist;weather=rain"
+run weather-c --bench bench-c --shot clash-noon --size 1280x720 --frames 10 --variants "g2;weather=overcast;weather=mist;weather=rain"
+echo "bench-scenes: done ($out)"
