<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lane T: procedural terrain. Authoritative/ is INTEGER-ONLY (scanned by scripts/check-gfx-determinism.sh);
       Presentation/ and Scenes/ are float presentation code that only READ the authoritative grid. -->
  <PropertyGroup>
    <RootNamespace>Gfx.Proc</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- G2 stage env: ez-tree presets (MIT, unmodified copies of the pinned files; see Environment/EzTree) -->
    <EmbeddedResource Include="Environment\EzTree\presets\*.json" LogicalName="ez-tree/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gfx.Tests" />
    <ProjectReference Include="..\Gfx.Engine\Gfx.Engine.csproj" />
  </ItemGroup>
</Project>
