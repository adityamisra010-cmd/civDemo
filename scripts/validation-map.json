{
  "_doc": "Change-aware tiered validation (docs/validation-policy.md). CHECKS are the commands; CATEGORIES map changed paths to checks per tier. Test selections are dotnet test filter terms: a bare word is FullyQualifiedName~word (substring of Namespace.Class.Method); 'trait:k=v' is a trait filter. scripts/tiered_validation.py reads this file; scripts/test_tiered_validation.py proves every path, check and test pattern in it resolves. Categories are matched in order; a path takes the FIRST matching category, plus the reference inference for C# and test inputs. Keep it small and transparent: add a category only when a real change kind needs different checks.",
  "referenceInference": {
    "_doc": "For a changed .cs file (or any file whose name is referenced from test sources), the test classes whose source mentions the file stem are added to the targeted run. More than maxClasses referencing classes means a widely shared type: the change escalates to the project's full suite at integration tier.",
    "maxClasses": 40
  },
  "checks": {
    "build": {"desc": "Release build of the solution (incremental; tests then run --no-build)", "cmd": ["dotnet", "build", "Sim.slnx", "-c", "Release", "-nologo", "-v", "q"], "requires": ["Sim.slnx"]},
    "banned-constructs": {"desc": "Determinism banned-constructs grep (CLAUDE.md law 5)", "cmd": ["bash", "scripts/check-banned-constructs.sh"], "requires": ["scripts/check-banned-constructs.sh"]},
    "read-isolation": {"desc": "Grievance/raw-read isolation gate", "cmd": ["bash", "scripts/check-read-isolation.sh"], "requires": ["scripts/check-read-isolation.sh"]},
    "readonly-proof": {"desc": "Read-only view mutation must not compile (T0.2)", "cmd": ["bash", "scripts/check-readonly-proof.sh"], "requires": ["scripts/check-readonly-proof.sh"]},
    "research-audit": {"desc": "Research content audit is current", "cmd": ["python3", "scripts/research-content-audit.py", "--check"], "requires": ["scripts/research-content-audit.py"]},
    "research-calibration-report": {"desc": "Research calibration report is current", "cmd": ["python3", "scripts/research-calibration-report.py", "--check"], "requires": ["scripts/research-calibration-report.py"]},
    "unlock-audit": {"desc": "Research to gameplay unlock audit is current", "cmd": ["python3", "scripts/research-gameplay-unlock-audit.py", "--check"], "requires": ["scripts/research-gameplay-unlock-audit.py"]},
    "tree-closure": {"desc": "Research tree closure check (ids, keys, prerequisites, reachability, cycles, Age order)", "cmd": ["python3", "docs/m6-plan/knowledge-redesign/tools/tree_closure_check.py"], "requires": ["docs/m6-plan/knowledge-redesign/tools/tree_closure_check.py"]},
    "research-tool-tests": {"desc": "Unit tests of the research tooling", "cmd": ["sh", "-c", "python3 -I docs/m6-plan/knowledge-redesign/tools/test_validate.py && python3 -I docs/m6-plan/knowledge-redesign/tools/test_sourcing_queue.py"], "requires": ["docs/m6-plan/knowledge-redesign/tools"]},
    "charters": {"desc": "M7 unit and building charter consistency (ids, register, keys, prerequisite Ages, links)", "cmd": ["python3", "-I", "docs/m7-plan/tools/check_charters.py", "."], "requires": ["docs/m7-plan/tools/check_charters.py"]},
    "doc-links": {"desc": "Relative links and anchors in the changed Markdown files resolve", "cmd": ["python3", "scripts/check-doc-links.py", "{changed_md}"], "requires": ["scripts/check-doc-links.py"]},
    "doc-links-all": {"desc": "Relative links and anchors in every Markdown file under docs/ and the root resolve", "cmd": ["python3", "scripts/check-doc-links.py", "--all"], "requires": ["scripts/check-doc-links.py"]},
    "selector-selftest": {"desc": "Tiered-validation selector unit tests and map consistency", "cmd": ["python3", "-m", "unittest", "scripts/test_tiered_validation.py"], "requires": ["scripts/test_tiered_validation.py"]},
    "simtests-selected": {"desc": "Sim.Tests restricted to the selected filter", "kind": "dotnet-test", "project": "Sim.Tests", "after": ["build"]},
    "uitests-selected": {"desc": "Sim.Ui.Tests restricted to the selected filter", "kind": "dotnet-test", "project": "Sim.Ui.Tests", "after": ["build"]},
    "simtests-full": {"desc": "The whole Sim.Tests suite (about 28-31 min unloaded, 45-55 min under load, as recorded)", "kind": "dotnet-test", "project": "Sim.Tests", "after": ["build"], "full": true},
    "uitests-full": {"desc": "The whole Sim.Ui.Tests suite", "kind": "dotnet-test", "project": "Sim.Ui.Tests", "after": ["build"], "full": true},
    "ci-xproc-determinism": {"desc": "Cross-process determinism and allocation legs", "where": "ci", "note": ".github/workflows/ci.yml jobs determinism-xproc; runs on push/PR"},
    "ci-platform-smoke": {"desc": "Windows / cross-platform UI smoke", "where": "ci", "note": ".github/workflows/ui-artifact.yml and xplat-surveillance.yml"},
    "calibration-nightly": {"desc": "20-seed autoplay sweep and corridor teeth", "where": "ci", "note": ".github/workflows/ci.yml job calibration-nightly (scheduled)"},
    "multi-seed-trial": {"desc": "Four-seed, 1,630-turn research overlay trial", "where": "heavy", "note": "CIVSIM_OVERLAYS=... dotnet test Sim.Tests --filter FullyQualifiedName~OverlayRun_FourSeeds (docs/m6-plan/knowledge-redesign/research-cost-pass/pacing-recalibration.md)"},
    "bench": {"desc": "Hot-path benchmark", "where": "heavy", "note": "dotnet run --project Sim.Cli -c Release -- bench (CLAUDE.md: when hot paths change)"},
    "gui-acceptance": {"desc": "Manual GUI acceptance", "where": "manual", "note": "docs/m5-playability-gate.md checklist"}
  },
  "categories": [
    {"id": "selector", "desc": "the validation selector itself", "paths": ["scripts/tiered_validation.py", "scripts/validation-map.json", "scripts/test_tiered_validation.py", "scripts/validate.sh", "scripts/check-doc-links.py"],
     "targeted": {"checks": ["selector-selftest"]}, "integration": {"checks": ["doc-links-all"]}},
    {"id": "ci-workflows", "desc": "CI workflow definitions (validated by CI itself)", "paths": [".github/**"],
     "targeted": {"checks": ["selector-selftest"]}, "integration": {"checks": ["ci-xproc-determinism", "ci-platform-smoke"]}},
    {"id": "guard-scripts", "desc": "repository guard scripts", "paths": ["scripts/check-*.sh"],
     "targeted": {"checks": ["banned-constructs", "read-isolation"]}, "integration": {"checks": ["readonly-proof"]}},
    {"id": "research-tools", "desc": "research content tooling and reports", "paths": ["scripts/research*.py", "scripts/research_lib.py", "scripts/research-calibration/**", "docs/m6-plan/knowledge-redesign/tools/**"],
     "targeted": {"checks": ["research-tool-tests", "research-audit", "research-calibration-report", "unlock-audit", "tree-closure"]}},
    {"id": "m7-charters", "desc": "M7 unit and building charters and their checker", "paths": ["docs/m7-plan/**"],
     "targeted": {"checks": ["charters", "doc-links"]}},
    {"id": "research-candidate", "desc": "research-economy candidate and trial overlays (read by ResearchCandidateTests)", "paths": ["docs/m6-plan/knowledge-redesign/research-cost-pass/candidate/**", "docs/m6-plan/knowledge-redesign/research-cost-pass/trial/**"],
     "targeted": {"sim": ["ResearchCandidateTests"], "checks": ["doc-links"]}},
    {"id": "doc-fixtures", "desc": "binary order logs and other non-Markdown files under docs/ that tests replay", "paths": ["docs/**/*.bin", "docs/session-logs/**"],
     "targeted": {"sim": ["OrderLogFixtureTests", "DrivenGoldenTests"]}, "integration": {"sim": ["trait:suite=determinism"]}},
    {"id": "docs", "desc": "documentation only", "paths": ["docs/**", "*.md"],
     "targeted": {"checks": ["doc-links"]}},
    {"id": "research-content", "desc": "research, ages and knowledge-text content", "paths": ["Sim.Data/content/research.json", "Sim.Data/content/research-pre-tranche2.json", "Sim.Data/content/ages.json", "Sim.Data/content/knowledge-texts.json", "Sim.Data/content/era-pacing.json"],
     "targeted": {"checks": ["research-audit", "research-calibration-report", "unlock-audit", "tree-closure", "charters"], "sim": ["Research", "Civics", "TreeClosure", "KnowledgeEffects", "FutureEffects", ".AgeProgression", ".AiResearch"]},
     "integration": {"sim": ["trait:suite=determinism", ".Age", "Eureka", ".Institution", "DrivenGoldenTests"], "ui": ["Research", "AgeAndWorld"]}},
    {"id": "unit-content", "desc": "unit families and modernization data", "paths": ["Sim.Data/content/unit-families.json"],
     "targeted": {"checks": ["charters"], "sim": ["UnitModernization", ".Age", ".Founding"]},
     "integration": {"sim": ["trait:suite=determinism", "Snapshot", ".Age"], "ui": [".Unit", "AgeAndWorld"]}},
    {"id": "goods-content", "desc": "goods, recipes, projects and needs content", "paths": ["Sim.Data/content/goods.json", "Sim.Data/content/needs.json"],
     "targeted": {"checks": ["charters"], "sim": [".Goods", "Production", ".Price", ".Trade", ".Harvest", ".Needs", "Construction", ".Food"]},
     "integration": {"sim": ["trait:suite=determinism", "CalibrationBatteryTests", "Snapshot"], "ui": ["Construction", "FoodFlow"]}},
    {"id": "sim-config", "desc": "global simulation configuration (affects every system)", "escalate": true, "paths": ["Sim.Data/content/sim.json", "Sim.Data/content/worldgen.json", "Sim.Data/content/corridors.json", "Sim.Data/content/pipeline*.json", "Sim.Data/content/chronicle.json", "Sim.Data/*.cs", "Sim.Data/*.csproj"],
     "targeted": {"sim": ["Config", "trait:suite=determinism", "CalibrationBatteryTests"]}},
    {"id": "shared-core", "desc": "kernel, world state, schema, serialization, ledger and system registry (deterministic core)", "escalate": true,
     "paths": ["Sim.Core/Kernel/**", "Sim.Core/State/WorldState.cs", "Sim.Core/State/Table.cs", "Sim.Core/State/Conserved.cs", "Sim.Core/State/Ids.cs", "Sim.Core/SystemCatalog.cs", "Sim.Core/Systems/SimConfig.cs", "Sim.Core/*.csproj", "Directory.Build.props", "Sim.slnx", "global.json"],
     "targeted": {"sim": ["Sim.Tests.Kernel", "trait:suite=determinism", "Snapshot", "Replay", "Ledger", "Conservation"]}},
    {"id": "research-engine", "desc": "research, civics and knowledge engine", "paths": ["Sim.Core/Systems/Research/**", "Sim.Core/State/ResearchQuery.cs", "Sim.Core/State/KnowledgeEffects.cs", "Sim.Core/State/KnowledgeOperands.cs", "Sim.Core/State/KnowledgeTransfer.cs", "Sim.Core/State/SettlementKnowledge.cs"],
     "targeted": {"sim": ["Research", "Civics", "Knowledge", ".AiResearch", "Eureka", "FutureEffects"]},
     "integration": {"sim": ["trait:suite=determinism", "Snapshot", ".AgeProgression", "CityState"], "ui": ["Research"]}},
    {"id": "ages-military", "desc": "Ages, unit families, modernization and military queries", "paths": ["Sim.Core/Systems/Ages/**", "Sim.Core/State/MilitaryQuery.cs", "Sim.Core/State/AgeQuery.cs"],
     "targeted": {"sim": [".Age", "UnitModernization"]},
     "integration": {"sim": ["trait:suite=determinism", "Snapshot", ".Founding"], "ui": ["AgeAndWorld", ".Unit"]}},
    {"id": "fog-knowledge", "desc": "fog of war, discovery, polity knowledge and information boundaries", "paths": ["Sim.Core/State/PolityKnowledge.cs", "Sim.Core/State/DiscoveryQuery.cs", "Sim.Core/State/DepositConcealment.cs", "Sim.Core/Systems/Discovery/**"],
     "targeted": {"sim": ["Discovery", "Leak", "PolityKnowledge", ".Prospect"]},
     "integration": {"sim": ["trait:suite=determinism", "Snapshot", ".Ai"], "ui": ["Leak", "Discovery"]}},
    {"id": "ai-policy", "desc": "AI order policies (legal-only, information-restricted)", "paths": ["Sim.Core/AiOrders.cs", "Sim.Core/Systems/**/Ai*.cs"],
     "targeted": {"sim": [".Ai"]}, "integration": {"sim": ["trait:suite=determinism", "Leak"], "ui": ["AiSession"]}},
    {"id": "construction", "desc": "construction, stockpile, reservations and allocation", "paths": ["Sim.Core/Systems/Construction/**", "Sim.Core/State/ConstructionQuery*.cs", "Sim.Core/State/EmpireStockpile.cs", "Sim.Core/State/Reservations.cs", "Sim.Core/State/ResourceAllocation*.cs", "Sim.Core/State/SetAsideQuery.cs"],
     "targeted": {"sim": ["Construction", "Reservation", "Stockpile", ".Building", "Allocation", ".Granary", ".Institution"]},
     "integration": {"sim": ["trait:suite=determinism", "Snapshot"], "ui": ["Construction", "Stockpile", "Allocation"]}},
    {"id": "pathing", "desc": "pathfinding, routes, roads and transport", "paths": ["Sim.Core/Pathing/**", "Sim.Core/State/RouteQuery.cs", "Sim.Core/State/TransportQuery.cs", "Sim.Core/State/RoadPerformance.cs", "Sim.Core/State/RoadDevelopmentQuery.cs", "Sim.Core/Systems/Roads/**", "Sim.Core/Systems/PathBuild/**"],
     "targeted": {"sim": ["Sim.Tests.Pathing", ".Route", ".Road", "Transport", ".Wrap", "Cylinder"]},
     "integration": {"sim": ["trait:suite=determinism", ".Trade", "Migration"], "ui": ["Cylinder", ".Road"]}},
    {"id": "worldgen", "desc": "world generation and founding (moves every golden)", "escalate": true, "paths": ["Sim.Core/Worldgen/**"],
     "targeted": {"sim": ["Sim.Tests.Worldgen", ".Founding", "trait:suite=determinism"]}},
    {"id": "observability", "desc": "observability, forensics and chronicle", "paths": ["Sim.Core/Observability/**", "Sim.Core/Chronicle/**"],
     "targeted": {"sim": ["Sim.Tests.Observability", "Sim.Tests.Forensic", "Chronicle"]}, "integration": {"ui": ["Chronicle", "Annals", "GlassBox"]}},
    {"id": "core-systems", "desc": "a simulation system folder (tests are selected by the folder name and by reference inference)", "paths": ["Sim.Core/Systems/**", "Sim.Core/State/**"],
     "targeted": {"sim": ["{system}"]}, "integration": {"sim": ["trait:suite=determinism", "Snapshot", "CalibrationBatteryTests"]}},
    {"id": "cli", "desc": "command-line front end", "paths": ["Sim.Cli/**"],
     "targeted": {"sim": [".Cli"]}, "integration": {"sim": ["trait:suite=determinism"], "checks": ["ci-xproc-determinism"]}},
    {"id": "ui", "desc": "UI (renders simulation state and emits orders)", "paths": ["Sim.Ui/**", "assets/**"],
     "targeted": {"ui": ["{inferred-or-all}"]}, "integration": {"checks": ["uitests-full", "gui-acceptance"]}},
    {"id": "test-infrastructure", "desc": "shared test utilities (affect many tests)", "escalate": true, "paths": ["Sim.Tests/TestUtil/**", "Sim.Tests/*.csproj", "Sim.Ui.Tests/*.csproj", "Sim.Tests/Conventions/**"],
     "targeted": {"sim": ["Sim.Tests.Conventions", "trait:suite=determinism"]}},
    {"id": "readonly-proof-project", "desc": "the must-not-compile proof project", "paths": ["Sim.Tests.ReadOnlyViolation/**"],
     "targeted": {"checks": ["readonly-proof"]}},
    {"id": "tests", "desc": "test sources (the changed test classes are run)", "paths": ["Sim.Tests/**", "Sim.Ui.Tests/**"],
     "targeted": {}},
    {"id": "unknown", "desc": "no category matched: conservative fallback", "paths": ["**"], "fallback": true,
     "targeted": {"sim": ["Sim.Tests.Kernel", "trait:suite=determinism"]}}
  ]
}
