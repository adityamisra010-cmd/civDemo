  "schema": "civ-sim/world-morphology@1",
  "notice": "VISUAL morphology only. Every number in this file chooses how a REPORTED entity is DRAWN. None is a gameplay rule: nothing here decides that a settlement is a town or a city, that an institution exists, grows or matures, or what a formation can do. The simulation never reads this file. Schema: docs/architecture/world-visualization.md section 5.",
  "sprite": {
    "worldPerUnit": 1.0,
    "minPxPerUnit": 1.2,
    "maxPxPerUnit": 28.0,
    "note": "A settlement is ONE composed sprite (D-038 H3/H4). Its size on screen is clamp(camera pixels per world unit x worldPerUnit, min, max): it grows with zoom and then stops, so it never implies land it does not occupy."
  },
  "lod": {
    "midFromPxPerUnit": 7.5,
    "nearFromPxPerUnit": 14.0,
    "note": "Detail is ADDED with size. Far: footprint only. Mid: institution icons in their slots. Near: building parts, labels."
  },
