  "settlementStages": {
    "note": "The first driver whose input the source REPORTS picks the stage. The live simulation reports sizeTier (CatchmentSummary.SizeTier, D-017): mapped one to one and shown by number, never named. The demo reports only population: its thresholds are DEMONSTRATION values. What makes a settlement a town or a city is a Director decision (WV-01).",
    "drivers": [
      {
        "input": "sizeTier",
        "provenance": "simulation",
        "namedStages": false,
        "thresholds": [
          0,
          1,
          2,
          3,
          4
        ],
        "note": "the simulation's own quantized size step (0..4)"
      },
      {
        "input": "population",
        "provenance": "demonstration",
        "namedStages": true,
        "thresholds": [
          0,
          3000,
          10000,
          40000,
          150000
        ],
        "note": "DEMONSTRATION thresholds on the reported population - view only"
      }
    ],
    "stages": [
      {
        "id": "s1",
        "name": "Small settlement",
        "blocks": 6
      },
      {
        "id": "s2",
        "name": "Growing settlement",
        "blocks": 18
      },
