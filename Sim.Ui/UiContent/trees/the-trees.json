    { "id": "operational", "name": "Operational", "track": "realization", "glyphState": "Complete", "stage": 3, "wash": "realization-progress", "researchRole": "completed",
      "legend": "Researched and working." },
    { "id": "mature", "name": "Mature", "track": "realization", "glyphState": "Complete", "stage": 4, "wash": "full", "researchRole": "completed",
      "legend": "Researched, realized and fully developed." },
    { "id": "degraded", "name": "Degraded", "track": "realization", "glyphState": "Decayed", "stage": 0, "wash": "realization-progress", "researchRole": "completed",
      "legend": "The capability has degraded. The research is not lost, and the Age does not regress." },
    { "id": "in-progress", "name": "In progress", "track": "milestone", "glyphState": "InProgress", "stage": 0, "wash": "milestone-progress", "researchRole": "none",
      "legend": "A milestone that is partly met." },
    { "id": "achieved", "name": "Achieved", "track": "milestone", "glyphState": "Complete", "stage": 0, "wash": "full", "researchRole": "none",
      "legend": "A milestone that is met." }
  ],

  "stateSets": [
    { "id": "research",
      "description": "Research only: knowledge does not decay and is not 'realized'.",
      "states": ["locked", "discovered", "available", "researching", "stalled", "researched"] },
    { "id": "realization",
      "description": "Research, then realization: researched is distinct from developing, operational and mature.",
      "states": ["locked", "discovered", "available", "researching", "stalled", "researched",
                 "developing", "partially-realized", "operational", "mature", "degraded"] },
    { "id": "milestone",
      "description": "A milestone in the graph: met, partly met, or not yet.",
      "states": ["locked", "discovered", "in-progress", "achieved"] }
  ],

