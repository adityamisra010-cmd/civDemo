    { "id": "stalled", "name": "Stalled", "track": "research", "glyphState": "Stalled", "stage": 0, "wash": "research-progress", "researchRole": "researching",
      "legend": "Research started but not advancing." },
    { "id": "researched", "name": "Researched", "track": "research", "glyphState": "Complete", "stage": 0, "wash": "none", "researchRole": "completed",
      "legend": "Research complete. Researched is not realized: the heavy ring is research, the fill is realization." },
    { "id": "developing", "name": "Developing", "track": "realization", "glyphState": "Complete", "stage": 1, "wash": "realization-progress", "researchRole": "completed",
      "legend": "Researched; the capability is being built up." },
    { "id": "partially-realized", "name": "Partially realized", "track": "realization", "glyphState": "Complete", "stage": 2, "wash": "realization-progress", "researchRole": "completed",
