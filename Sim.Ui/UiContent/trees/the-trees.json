    { "id": "TECHNIQUES", "name": "Techniques", "order": 1, "mark": "Techniques",
      "shortDescription": "What the civilization knows how to do reliably." },
    { "id": "INSTITUTIONS", "name": "Institutions", "order": 2, "mark": "Institutions",
      "shortDescription": "Organizations that preserve, reproduce, teach and expand capability." },
    { "id": "INFRASTRUCTURE", "name": "Infrastructure", "order": 3, "mark": "Infrastructure",
      "shortDescription": "Physical systems and networks enabling civilization." },
    { "id": "INDUSTRY", "name": "Industry", "order": 4, "mark": "Industry",
      "shortDescription": "Production capabilities and industrial capacity." },
    { "id": "MILITARY", "name": "Military", "order": 5, "mark": "Military",
      "shortDescription": "Military capabilities, formations, doctrine, equipment, training, logistics, experience and veterancy." },
    { "id": "APPLICATIONS", "name": "Applications", "order": 6, "mark": "Applications",
      "shortDescription": "Tangible things civilization can produce or use." }
  ],

  "states": [
